// รายชื่อ WiFi ที่จะลองเชื่อมตามลำดับ - ลองตัวแรกก่อน ถ้าต่อไม่ติดภายในเวลาที่กำหนดค่อยลองตัวถัดไป
// (ดู WIFI_NETWORKS ใน .ino) ใส่ได้แค่ตัวเดียวก็ได้ถ้าไม่ต้องการ fallback
const WifiCredential WIFI_NETWORKS[] = {
  {"ใส่ชื่อ WiFi ตัวที่ 1 ที่นี่", "ใส่รหัสผ่านที่นี่"},
  {"ใส่ชื่อ WiFi สำรองตัวที่ 2 ที่นี่", "ใส่รหัสผ่านที่นี่"},
};
const int WIFI_NETWORK_COUNT = sizeof(WIFI_NETWORKS) / sizeof(WIFI_NETWORKS[0]);

