<Window x:Class="OnionProcOparetor.Console.ProgramReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Program Control - คิวตรวจสอบ"
        Height="640" Width="1040"
        WindowStartupLocation="CenterOwner"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- Rebuilt 2026-09-03 - header controls now spaced via Grid columns instead of per-control
         Margin; the reasons box now uses the shared Card style (was a hand-copied Border with square
         corners - the only un-rounded container in this window, now consistent with the rest of the
         app). DataGrid columns/bindings unchanged - styles come from Theme/Controls.xaml, merged at
         App level only (see original comment about the XamlParseException this app hit once from a
         Window-scoped style reference). -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="PROGRAM CONTROL" Style="{StaticResource Heading2}" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="FilterCombo" Width="160" VerticalAlignment="Center"
                      SelectionChanged="FilterCombo_SelectionChanged">
                <ComboBoxItem Content="รอตรวจสอบ" Tag="flagged" IsSelected="True"/>
                <ComboBoxItem Content="ที่บล็อกอยู่" Tag="blocked"/>
                <ComboBoxItem Content="ที่อนุญาตไว้" Tag="allowed"/>
                <ComboBoxItem Content="ที่ครูตัดสินเอง" Tag="manual"/>
                <ComboBoxItem Content="ทั้งหมด" Tag="all"/>
            </ComboBox>
            <!-- หมวด: รายการในกล่องนี้สร้างจากข้อมูลจริงตอน refresh (ดู RebuildCategoryCombo) ไม่ได้
                 ประกาศไว้ตายตัวใน XAML เพราะต้องมีจำนวนแถวต่อหมวดกำกับ และต้องซ่อนหมวดที่ไม่มีของ -->
            <ComboBox Grid.Column="3" x:Name="CategoryCombo" Width="200" VerticalAlignment="Center"
                      SelectionChanged="CategoryCombo_SelectionChanged"/>
            <Button Grid.Column="5" Content="REFRESH" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" Click="RefreshButton_Click"/>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="StatusText" Style="{StaticResource Caption}"
                   TextWrapping="Wrap" Margin="0,10,0,10"/>

        <Border Grid.Row="2" CornerRadius="12" ClipToBounds="True"
                Background="{DynamicResource Brush.Background.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
        <DataGrid x:Name="VerdictsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single"
                  Background="Transparent"
                  BorderThickness="0"
                  RowBackground="{DynamicResource Brush.Background.Card}"
                  AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                  HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                  VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                  RowHeight="38" CanUserAddRows="False"
                  SelectionChanged="VerdictsGrid_SelectionChanged"
                  ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                  RowStyle="{StaticResource ConsoleGridRowStyle}"
                  CellStyle="{StaticResource ConsoleGridCellStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="โปรแกรม" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="หมวด" Binding="{Binding CategoryText}" Width="110"/>
                <DataGridTextColumn Header="คะแนน" Binding="{Binding Score}" Width="70"/>
                <DataGridTextColumn Header="สถานะ" Binding="{Binding ActionText}" Width="90"/>
                <DataGridTextColumn Header="ที่มา" Binding="{Binding SourceText}" Width="130"/>
                <DataGridTextColumn Header="พบ (ครั้ง)" Binding="{Binding SightingCount}" Width="80"/>
                <DataGridTextColumn Header="เครื่องล่าสุด" Binding="{Binding LastSeenOnMachine}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        </Border>

        <!-- เหตุผลของคะแนน - ส่วนที่ทำให้ครูตัดสินใจได้จริง ไม่ใช่แค่เห็นตัวเลขลอยๆ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="เหตุผลที่ได้คะแนนนี้" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ReasonsText" FontFamily="Consolas" FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="เลือกโปรแกรมจากตารางด้านบนเพื่อดูเหตุผล"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AllowButton" Content="อนุญาตถาวร" Style="{StaticResource ButtonSecondary}"
                    Padding="16,7" Margin="0,0,10,0" IsEnabled="False" Click="AllowButton_Click"/>
            <Button x:Name="BlockButton" Content="บล็อกถาวร (ทุกเครื่อง)" Style="{StaticResource ButtonPrimary}"
                    Padding="16,7" IsEnabled="False" Click="BlockButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
