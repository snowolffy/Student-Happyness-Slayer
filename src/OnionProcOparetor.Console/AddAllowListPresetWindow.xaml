<Window x:Class="OnionProcOparetor.Console.AddAllowListPresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ชุด Allow-list ใหม่"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- "+ ชุดใหม่" ของหน้า Website Control › ชุด Allow-list (WP2-2, 2026-10-31) - dialog เดียวแบบ
         ขอชื่อชุดเท่านั้น (โดเมนเพิ่มทีหลังในหน้ารายละเอียด) เดินตามรูปแบบเดียวกับ BroadcastMessageWindow -->
    <StackPanel Margin="20">
        <TextBlock Text="ชุด Allow-list ใหม่" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

        <TextBlock Text="ชื่อชุด" Style="{StaticResource Label}" Margin="0,0,0,6"/>
        <TextBox x:Name="NameInputBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,16"/>

        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Grid>
            <Button Content="ยกเลิก" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Margin="0,0,96,0" Click="CancelButton_Click"/>
            <Button Content="สร้างชุด" Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Right" Click="CreateButton_Click"/>
        </Grid>
    </StackPanel>
</Window>
