<UserControl x:Class="OnionProcOparetor.Console.EmergencyCodeQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnionProcOparetor.UI.Controls;assembly=OnionProcOparetor.UI">
    <!-- WP3-4 (2026-10-31) - ตรงตาม docs/wireframes/oc-emergency.dc.html ขั้นที่ 2-3 (สแกน QR /
         พิมพ์ key + ทดสอบรหัส) ย่อมาเป็น dialog เดียวของ Console (ไม่ต้องมีขั้น 1 "ติดตั้งแอป" เพราะ
         เป็นหน้าของครูที่ทำครั้งเดียว) QR สร้างจาก otpauth:// URI ด้วย QRCoder (ฝัง secret ตรงๆ ใน
         URI - ครูเอาไปสแกนที่มือถือของตัวเอง ไม่มีใครอื่นเห็นหน้าต่างนี้)
         UI-3b (2026-11-03): แปลงจาก Window เป็น UserControl ฝังใน DialogHost ของ MainWindow -->
    <Border Style="{StaticResource Card}" Width="440" Margin="24">
        <StackPanel>
            <TextBlock Text="เพิ่มมือถือครู" Style="{StaticResource Heading2}" TextAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock Text="1. เปิดแอป Google Authenticator หรือ Microsoft Authenticator แล้วสแกน QR นี้"
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Border Background="White" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1.5"
                    CornerRadius="6" Width="220" Height="220" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Image x:Name="QrImage" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <TextBlock Text="หรือพิมพ์ key นี้ในแอปเอง (ตั้งค่าแบบ time-based):" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SecretKeyBox" Grid.Column="0" IsReadOnly="True" FontFamily="Consolas"
                         Style="{StaticResource RoundedTextBox}"/>
                <Button x:Name="CopyKeyButton" Grid.Column="2" Content="คัดลอก" Style="{StaticResource ButtonSecondary}"
                        Padding="10,5" FontSize="11" Click="CopyKeyButton_Click"/>
            </Grid>

            <Border Height="1" Margin="0,0,0,14" Background="{DynamicResource Brush.Border.Default}"/>

            <TextBlock Text="2. ทดสอบรหัส 6 หลักที่เห็นในแอปตอนนี้" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TestCodeBox" Grid.Column="0" MaxLength="6" FontSize="20" FontFamily="Consolas"
                         TextAlignment="Center" Style="{StaticResource RoundedTextBox}"/>
                <Button x:Name="TestCodeButton" Grid.Column="2" Content="ทดสอบ" Style="{StaticResource ButtonPrimary}"
                        Click="TestCodeButton_Click"/>
            </Grid>

            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,16"/>

            <TextBlock Text="ข้อควรรู้: secret นี้ถูกฝังในเครื่องนักเรียนตอนติดตั้ง Agent (อยู่รอดผ่าน disk freeze) - ถ้าเปลี่ยน secret ใหม่ ต้องลง Agent MSI ใหม่ทุกเครื่อง"
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <Button Content="ปิด" Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Right"
                    Padding="10,5" FontSize="11" Click="CloseButton_Click" controls:DialogHost.IsDefaultButton="True"/>
        </StackPanel>
    </Border>
</UserControl>
