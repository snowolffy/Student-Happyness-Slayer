<UserControl x:Class="OnionProcOparetor.Console.WebsiteCatalogSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UI-3c (2026-11-03): เดิมเป็น Window ของตัวเอง (Show แบบไม่ modal + singleton reference +
         Activate() กันเปิดซ้ำ - ดู WebsiteBlockTab.xaml.cs) - ย้ายมาเป็น UserControl ใน DialogHost
         ขนาดใหญ่ตามที่ roadmap UI-3c สั่ง ("dialog ใหญ่: WebsiteCatalogSources") DialogHost เป็น modal
         เปิดซ้ำไม่ได้อยู่แล้วโดยธรรมชาติ (คลิกปุ่มเปิดซ้ำไม่ได้เพราะพื้นมืดทับบัง) - singleton
         reference เดิมจึงไม่จำเป็นอีกต่อไป (ดู comment ที่ WebsiteBlockTab.xaml.cs) -->
    <Border Style="{StaticResource Card}" Width="900" Height="560">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="WEBSITE CATALOG SOURCES" Style="{StaticResource Heading2}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="เพิ่ม Source..." Style="{StaticResource ButtonPrimary}"
                    VerticalAlignment="Center" Margin="0,0,10,0" Click="AddSourceButton_Click"/>
            <Button Grid.Column="2" Content="ปิด" Style="{StaticResource ButtonSecondary}"
                    VerticalAlignment="Center" Click="CloseButton_Click"/>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="StatusText" Style="{StaticResource Caption}"
                   TextWrapping="Wrap" Margin="0,10,0,10"/>

        <Grid Grid.Row="2">
            <Border CornerRadius="12" ClipToBounds="True"
                    Background="{DynamicResource Brush.Background.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                <DataGrid x:Name="SourcesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                        Background="Transparent"
                        BorderThickness="0"
                        RowBackground="{DynamicResource Brush.Background.Card}"
                        AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                        HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                        VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                        RowHeight="44" CanUserAddRows="False"
                        ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                        RowStyle="{StaticResource ConsoleGridRowStyle}"
                        CellStyle="{StaticResource ConsoleGridCellStyle}">
                    <DataGrid.Resources>
                        <Style x:Key="CatalogSourceStatusBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                            <Setter Property="Tag" Value="Danger"/>
                            <Setter Property="Content" Value="ปิดใช้"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                    <Setter Property="Tag" Value="Online"/>
                                    <Setter Property="Content" Value="เปิดใช้"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="สถานะ" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{StaticResource CatalogSourceStatusBadge}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ชื่อ" Binding="{Binding Name}" Width="130"/>
                        <DataGridTextColumn Header="URL" Binding="{Binding SourceUrl}" Width="*"/>
                        <DataGridTextColumn Header="เพดาน" Binding="{Binding MaxEntries}" Width="60"/>
                        <DataGridTextColumn Header="ผล sync ล่าสุด" Binding="{Binding StatusText}" Width="220"/>
                        <DataGridTemplateColumn Header="จัดการ" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Sync Now" Style="{StaticResource ButtonSecondary}"
                                                Padding="10,5" FontSize="11"
                                                Click="SyncNowButton_Click" Tag="{Binding Id}" Margin="0,0,4,0"/>
                                        <Button Content="แก้ไข" Style="{StaticResource ButtonSecondary}"
                                                Padding="10,5" FontSize="11"
                                                Click="EditSourceButton_Click" Tag="{Binding}" Margin="0,0,4,0"/>
                                        <Button Content="ลบ" Style="{StaticResource ButtonDanger}"
                                                Padding="10,5" FontSize="11"
                                                Click="DeleteSourceButton_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <ContentControl x:Name="SourcesEmptyText"
                            Style="{StaticResource EmptyState}"
                            Content="ยังไม่มี catalog source"
                            Tag="กด &quot;เพิ่ม Source...&quot; แล้วใส่ URL ของ hosts-file/domain list เช่น รายชื่อโดเมนของเกมใดเกมหนึ่ง"
                            Visibility="Collapsed"/>
        </Grid>
    </Grid>
    </Border>
</UserControl>
