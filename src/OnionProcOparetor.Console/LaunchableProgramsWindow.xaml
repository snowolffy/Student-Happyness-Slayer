<UserControl x:Class="OnionProcOparetor.Console.LaunchableProgramsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UI-3c (2026-11-03): เดิมเป็น Window ของตัวเอง (ShowDialog) - ย้ายมาเป็น UserControl ใน DialogHost
         ขนาดใหญ่ตามที่ roadmap UI-3c สั่ง ("dialog ใหญ่: LaunchablePrograms") "จัดการรายการโปรแกรม"
         (Admin) (WP4-1, 2026-11-01) - เปิดจากหน้าตั้งค่า (ดู SettingsPage.xaml การ์ด "รายการโปรแกรมที่
         เปิดได้ทั้งห้อง") Admin เท่านั้นที่เปิดปุ่มนี้ได้จริง (Server เป็นคนกัน 403 จริงอยู่แล้ว) -->
    <Border Style="{StaticResource Card}" Width="640" Height="560">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="รายการโปรแกรมที่เปิดได้ทั้งห้อง" Style="{StaticResource Heading2}"/>
            <TextBlock Text="Teacher เลือกเปิดได้จากรายการนี้เท่านั้น (ไม่พิมพ์ path เองได้) - path ต้องเหมือนกันทุกเครื่องในแล็บ"
                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ==== ฟอร์มเพิ่ม/แก้ไข ==== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="FormTitleText" Text="เพิ่มโปรแกรมใหม่" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ชื่อที่แสดง" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameTextBox" Style="{StaticResource PlaceholderTextBox}" Tag="Scratch Desktop"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="path ของ .exe" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="PathTextBox" Style="{StaticResource PlaceholderTextBox}" Tag="C:\Program Files\Scratch 3\Scratch.exe"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="arguments (ไม่บังคับ)" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="ArgumentsTextBox" Style="{StaticResource PlaceholderTextBox}" Tag="" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SaveProgramButton" Content="เพิ่ม" Style="{StaticResource ButtonPrimary}" Click="SaveProgramButton_Click"/>
                    <Button x:Name="CancelEditButton" Content="ยกเลิกแก้ไข" Style="{StaticResource ButtonSecondary}"
                            Margin="8,0,0,0" Visibility="Collapsed" Click="CancelEditButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="FormStatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- ==== รายการที่มีอยู่ ==== -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DataGrid x:Name="ProgramsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="{DynamicResource Brush.Background.Card}"
                      AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ชื่อ" Binding="{Binding Name}" Width="140"/>
                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                    <DataGridTextColumn Header="Arguments" Binding="{Binding Arguments}" Width="120"/>
                    <DataGridTemplateColumn Header="" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="แก้ไข" Tag="{Binding}" Style="{StaticResource ButtonSecondary}"
                                            Padding="8,3" FontSize="11" Click="EditProgramButton_Click"/>
                                    <Button Content="ลบ" Tag="{Binding}" Style="{StaticResource ButtonDanger}"
                                            Padding="8,3" FontSize="11" Margin="6,0,0,0" Click="DeleteProgramButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Button Content="ปิด" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
    </Border>
</UserControl>
