<Window x:Class="OnionProcOparetor.Console.FilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="แจก / เก็บไฟล์"
        Width="940" Height="640"
        WindowStartupLocation="CenterOwner"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- "แจก / เก็บไฟล์" (WP4-3, 2026-11-01) - ตาม wireframe docs/wireframes/tc-files.dc.html สองคอลัมน์
         (แจกไฟล์ซ้าย / เก็บงานขวา) จุดที่ต่างจาก wireframe ตั้งใจ (ดูรายงานของ WP4-3):
         - ไม่มี dropdown "วางไว้ที่" (Desktop/Documents) - ใช้ Desktop\ไฟล์จากครู ตายตัวเสมอตามที่
           roadmap ระบุ ("ดาวน์โหลดไฟล์ไปไว้ใน Desktop ของผู้ใช้ (โฟลเดอร์ 'ไฟล์จากครู')")
         - เป้าหมาย (ทั้งห้อง/เครื่องที่เลือก) ใช้ตัวเลือกเดียวที่ด้านบนสุด ร่วมกันทั้งแจกและเก็บ (wireframe
           ไม่ได้วาด target picker ไว้ในแต่ละ panel เลย - เดิมทีน่าจะหมายถึง context เดียวกันทั้งหน้า)
         - เพิ่มช่อง "ปิดรับใน (นาที)" ที่ wireframe ไม่มีวาดไว้ เพื่อให้ตรงกับ roadmap ("งานเก็บไฟล์ (ชื่องาน,
           เป้าหมาย, เวลาปิดรับ)")
         - ไม่มีปุ่ม "ส่งข้อความเตือนคนที่ยังไม่ส่ง" (ยังไม่ทำรอบนี้ - ดูรายงาน WP4-3)
         เปิดจากปุ่ม "แจก/เก็บไฟล์" บนแถบคำสั่งของ Clients (ดู DashboardWindow.FilesButton_Click) -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="แจก / เก็บไฟล์" Style="{StaticResource Heading2}"/>
            <TextBlock Text="ไฟล์วิ่งผ่าน Server ทั้งหมด - เครื่องรีบูตแล้วไฟล์หายตาม disk freeze (ตั้งใจแบบนั้น ไม่ค้างข้ามคาบ)"
                       Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- เป้าหมาย - ใช้ร่วมกันทั้งแจกและเก็บ (ดู comment ด้านบน) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ส่งไปที่: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="TargetRoomRadio" GroupName="FilesTarget" Content="ทั้งห้อง" Margin="0,0,16,0" VerticalAlignment="Center" Checked="TargetRadio_Changed"/>
                <RadioButton x:Name="TargetSelectedRadio" GroupName="FilesTarget" VerticalAlignment="Center" Checked="TargetRadio_Changed"/>
            </StackPanel>
            <ComboBox x:Name="RoomCombo" Grid.Column="2" Width="200" HorizontalAlignment="Left"
                      DisplayMemberPath="Name" SelectionChanged="RoomCombo_SelectionChanged"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- ==== แจกไฟล์ ==== -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Background.Card}" CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock Text="แจกไฟล์" Style="{StaticResource Label}" Margin="0,0,0,10"/>

                    <Button x:Name="ChooseDistributeFileButton" Content="เลือกไฟล์..." HorizontalAlignment="Left"
                            Padding="12,6" Click="ChooseDistributeFileButton_Click"/>
                    <TextBlock x:Name="DistributeFileText" Text="ยังไม่ได้เลือกไฟล์" Margin="0,8,0,4" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DistributeMaxSizeText" Style="{StaticResource Caption}" Margin="0,0,0,14"/>

                    <CheckBox x:Name="OpenAfterDownloadCheck" Content="เปิดไฟล์ให้อัตโนมัติหลังดาวน์โหลด" IsChecked="True" Margin="0,0,0,16"/>

                    <TextBlock x:Name="DistributeStatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Button x:Name="DistributeButton" Content="แจกไฟล์" Style="{StaticResource ButtonPrimary}"
                            HorizontalAlignment="Left" Padding="16,8" Click="DistributeButton_Click"/>
                </StackPanel>
            </Border>

            <!-- ==== เก็บงาน ==== -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.Background.Card}" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="เก็บงาน" Style="{StaticResource Label}" Margin="0,0,0,10"/>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ชื่องาน" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="JobNameBox" Style="{StaticResource PlaceholderTextBox}" Tag="เช่น ส่งงาน Scratch คาบนี้"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ชนิดไฟล์" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="FilePatternBox" Style="{StaticResource PlaceholderTextBox}" Tag="*.sb3, *.docx"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="ปิดรับใน (นาที)" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="ClosesInMinutesBox" Style="{StaticResource PlaceholderTextBox}" Tag="เว้นว่าง=ไม่กำหนด"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <DataGrid x:Name="StatusGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border.Default}"
                                  AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                                  HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                  VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                  RowHeight="34" CanUserAddRows="False"
                                  ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                  CellStyle="{StaticResource ConsoleGridCellStyle}"
                                  RowStyle="{StaticResource ConsoleGridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="นักเรียน" Binding="{Binding StudentDisplayText}" Width="1.3*"/>
                                <DataGridTextColumn Header="เครื่อง" Binding="{Binding MachineName}" Width="*"/>
                                <DataGridTextColumn Header="ไฟล์" Binding="{Binding FileName}" Width="1.3*"/>
                                <DataGridTextColumn Header="สถานะ" Binding="{Binding StatusText}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CollectSummaryText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="CloseJobButton" Content="ปิดงาน" Style="{StaticResource ButtonSecondary}"
                                    Padding="10,5" FontSize="11" Margin="0,0,8,0" Click="CloseJobButton_Click" IsEnabled="False"/>
                            <!-- "เปิดโฟลเดอร์ที่เก็บ" ใช้งานได้จริงเฉพาะตอนที่ Console รันอยู่บนเครื่อง Server เอง
                                 (ส่วนใหญ่ไม่ใช่ - Server จริงอยู่ที่ 192.168.17.249 ส่วน Console รันบนเครื่องครู)
                                 ซ่อนปุ่มนี้ไว้ก่อน (Collapsed) แล้วโชว์เฉพาะตอนที่ RefreshCollectionStatusAsync
                                 เจอว่าโฟลเดอร์มองเห็นได้จากเครื่องนี้จริงๆ (ดู comment ที่นั่น) - 2026-11-03 -->
                            <Button x:Name="OpenFolderButton" Content="เปิดโฟลเดอร์ที่เก็บ" Style="{StaticResource ButtonSecondary}"
                                    Padding="10,5" FontSize="11" Margin="0,0,8,0" Click="OpenFolderButton_Click" Visibility="Collapsed"/>
                            <Button x:Name="DownloadZipButton" Content="ดาวน์โหลดทั้งหมด (.zip)" Style="{StaticResource ButtonSecondary}"
                                    Padding="10,5" FontSize="11" Margin="0,0,8,0" Click="DownloadZipButton_Click" IsEnabled="False"/>
                            <Button x:Name="RefreshStatusButton" Content="รีเฟรช" Style="{StaticResource ButtonSecondary}"
                                    Padding="10,5" FontSize="11" Margin="0,0,8,0" Click="RefreshStatusButton_Click" IsEnabled="False"/>
                            <Button x:Name="CollectNowButton" Content="เก็บงานตอนนี้" Style="{StaticResource ButtonPrimary}"
                                    Padding="14,7" Click="CollectNowButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
