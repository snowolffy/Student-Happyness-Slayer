<Window x:Class="OnionProcOparetor.Console.ScreenBroadcastSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ส่งจอครู"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- "ส่งจอครู" (WP4-4, 2026-11-01) - ขั้นตอน 1 ของ wireframe tc-broadcast.dc.html (คอลัมน์ซ้าย
         "1 · ตั้งค่าก่อนเริ่ม") ขั้นตอน 2 (แถบแดงระหว่างส่ง) อยู่ใน BroadcastWarningBarWindow แยกไฟล์
         เพราะต้องอยู่ได้ทั้งๆ ที่หน้าต่างนี้ปิดไปแล้ว (เหมือนที่ ActionReportWindow แยกจาก OpenUrlWindow)

         ของที่ไม่ได้ทำตาม wireframe รอบนี้ (ดูรายงานของ WP4-4):
         - ไม่มีตัวเลือก "ส่งจอของจอนักเรียน 1 เครื่อง" (ส่งได้แค่จอครูเองตามโจทย์ design notes)
         - ไม่มีปุ่ม "หยุดชั่วคราว" ระหว่างส่ง (มีแค่ "หยุดส่ง") -->
    <StackPanel Margin="20" MaxHeight="640">
        <TextBlock Text="ส่งจอครู" Style="{StaticResource Heading2}"/>
        <TextBlock Text="ส่งจอของเครื่องที่เปิด Console นี้ให้นักเรียนดู - แถบแดงจะค้างบนจอครูตลอดเวลาที่ส่ง"
                   Style="{StaticResource Caption}" Margin="0,2,0,16" TextWrapping="Wrap"/>

        <TextBlock Text="นักเรียนเห็นแบบไหน" Style="{StaticResource Label}" Margin="0,0,0,8"/>
        <RadioButton x:Name="FullscreenLockedRadio" GroupName="ViewerMode" Margin="0,0,0,6" IsChecked="True">
            <StackPanel Margin="4,0,0,0">
                <TextBlock Text="เต็มจอ + ล็อกเมาส์/คีย์บอร์ด" FontWeight="SemiBold"/>
                <TextBlock Text="ตั้งใจดูอย่างเดียว ทำอย่างอื่นไม่ได้" Style="{StaticResource Caption}"/>
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="WindowedRadio" GroupName="ViewerMode" Margin="0,0,0,16">
            <StackPanel Margin="4,0,0,0">
                <TextBlock Text="หน้าต่างลอย" FontWeight="SemiBold"/>
                <TextBlock Text="ดูไปทำตามไปได้ ย่อ/ขยายเองได้ ปิดไม่ได้" Style="{StaticResource Caption}"/>
            </StackPanel>
        </RadioButton>

        <TextBlock Text="ส่งไปที่" Style="{StaticResource Label}" Margin="0,0,0,8"/>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <RadioButton x:Name="TargetRoomRadio" GroupName="BroadcastTarget" Content="ทั้งห้อง" Margin="0,0,0,8" Checked="TargetRadio_Changed"/>
                <RadioButton x:Name="TargetSelectedRadio" GroupName="BroadcastTarget" Checked="TargetRadio_Changed"/>
            </StackPanel>
            <ComboBox x:Name="RoomCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                      VerticalAlignment="Top" DisplayMemberPath="Name" SelectionChanged="RoomCombo_SelectionChanged"/>
        </Grid>

        <Border Background="{DynamicResource Brush.Background.Sunken}" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
            <TextBlock x:Name="SummaryText" FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Grid>
            <Button Content="ยกเลิก" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Margin="0,0,120,0" Click="CancelButton_Click"/>
            <Button x:Name="StartButton" Content="เริ่มส่งจอ" Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Right" Click="StartButton_Click"/>
        </Grid>
    </StackPanel>
</Window>
