<Window x:Class="OnionProcOparetor.Console.EmergencyCodeUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onion ProcOparetor Console - ประวัติการใช้รหัสฉุกเฉิน"
        Width="520" Height="480"
        WindowStartupLocation="CenterOwner"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- WP3-4 (2026-10-31) - ปุ่ม "ดูทั้งหมด" ของการ์ดรหัสฉุกเฉิน แสดงรายการที่ Agent ส่งขึ้นมาจาก
         POST /api/emergency-code/usage (ตอนกลับมาออนไลน์หลัง Server ล่ม) เรียงเวลาล่าสุดก่อน -
         ไม่มี student ผูกด้วยเลย (ปลดแบบไม่ระบุชื่อตามที่ roadmap กำหนด) -->
    <Border Style="{StaticResource Card}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="ประวัติการใช้รหัสฉุกเฉิน" Style="{StaticResource Heading2}" Margin="0,0,0,12"/>

            <ListView x:Name="UsageListView" Grid.Row="1" BorderThickness="0" Background="Transparent">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="เครื่อง" Width="180" DisplayMemberBinding="{Binding MachineName}"/>
                        <GridViewColumn Header="ปลดเมื่อ (เวลาเครื่อง)" Width="190" DisplayMemberBinding="{Binding UsedAtUtc}"/>
                        <GridViewColumn Header="รายงานขึ้น Server เมื่อ" Width="190" DisplayMemberBinding="{Binding ReceivedAtUtc}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock x:Name="EmptyText" Grid.Row="1" Text="ยังไม่มีการใช้รหัสฉุกเฉิน" Style="{StaticResource Caption}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <Button Grid.Row="2" Content="ปิด" Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Right"
                    Padding="10,5" FontSize="11" Margin="0,12,0,0" Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
