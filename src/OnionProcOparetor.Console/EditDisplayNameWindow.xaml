<Window x:Class="OnionProcOparetor.Console.EditDisplayNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="แก้ชื่อที่แสดง"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- WP4b (2026-10-30): เหมือน ResetPasswordWindow ทุกจุด (StackPanel + Card + CenterOwner) ต่างกัน
         แค่ field เป็น TextBox ธรรมดาแทน PasswordBox และ pre-fill ค่าเดิมไว้ให้แก้ต่อได้ -->
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="ชื่อที่แสดง" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBlock Text="ใช้แสดงแทน Username ทุกที่ที่คนเห็น (แถบล่าง Console, Staff session ฯลฯ)" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                <TextBox x:Name="DisplayNameBox" Style="{StaticResource RoundedTextBox}"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <Grid Margin="0,16,0,0">
            <Button Content="ยกเลิก" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Margin="0,0,96,0" Click="CancelButton_Click"/>
            <Button Content="บันทึก" Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Right" Click="SaveButton_Click"/>
        </Grid>
    </StackPanel>
</Window>
