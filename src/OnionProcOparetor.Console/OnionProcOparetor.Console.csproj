<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OnionProcOparetor.Console</AssemblyName>
    <RootNamespace>OnionProcOparetor.Console</RootNamespace>
    <ApplicationIcon>Theme\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- WP UI-1a (2026-11-03): theme token/style/control ร่วมย้ายไปไลบรารีนี้ -->
    <ProjectReference Include="..\OnionProcOparetor.UI\OnionProcOparetor.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Theme\logo.png / logo-source.png เลิกใช้แล้ว (WP UI-7c, 2026-11-03) - โลโก้ XAML ทุกจุด
         เปลี่ยนไปใช้ DrawingImage เวกเตอร์ (Logo.App / Logo.App.Small) ใน OnionProcOparetor.UI
         /Theme/Logos.xaml แทน ไฟล์ PNG สองไฟล์นี้ยังอยู่ใน Theme/ แต่ไม่ได้ฝังเป็น Resource แล้ว -->
    <Resource Include="Theme\icon.ico" />

    <!-- หน้าล็อกอินใหม่ (WP7, 2026-10-30) - ภาพฝั่งซ้ายของการ์ดล็อกอิน (placeholder ตอนนี้)
         สองรายการนี้ชี้ไฟล์เดียวกันโดยเจตนา คนละ item type:
           - Resource: ฝังเข้าตัว exe เป็น pack resource - ใช้เป็น fallback เมื่อไม่มีไฟล์ "ข้างแอป"
             (ดู MainWindow.xaml.cs LoadHeroImage) มีอยู่แน่นอนเสมอไม่ว่าจะลบไฟล์ข้างล่างทิ้งไปหรือไม่
           - None + CopyToOutputDirectory: สำเนาไฟล์จริงที่ Assets\LoginHero.png ข้าง .exe ให้ครู
             เปลี่ยนภาพเองได้โดยไม่ต้อง build ใหม่ (นี่คือไฟล์ที่เกณฑ์ทดสอบ WP7 สั่งให้ลบทิ้งแล้วดูว่า
             แอปไม่ crash) -->
    <Resource Include="Assets\LoginHero.png" />
    <None Include="Assets\LoginHero.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
