<Window x:Class="OnionProcOparetor.Console.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Height="240" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppWindowStyle}">
    <!-- Themed แทน MessageBox.Show เดิม (native OS dialog ที่ดูไม่เข้าธีมของแอพเลย) - drop-in
         replacement ผ่าน static ConfirmWindow.Show(message, title, owner) ดู ConfirmWindow.xaml.cs -->
    <Canvas Margin="20">
        <TextBlock Canvas.Left="0" Canvas.Top="0" x:Name="MessageText" Width="380"
                   Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap"/>

        <Button Canvas.Left="290" Canvas.Top="139" Width="80" x:Name="ConfirmButton" Content="YES"
                Style="{StaticResource ButtonDanger}" Click="ConfirmButton_Click"/>
        <Button Canvas.Left="205" Canvas.Top="139" Width="80" Content="NO"
                Style="{StaticResource ButtonSecondary}" Padding="10,5" FontSize="11" Click="CancelButton_Click" HorizontalAlignment="Center" Height="35" VerticalAlignment="Top"/>
    </Canvas>
</Window>
