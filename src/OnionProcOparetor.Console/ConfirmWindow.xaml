<Window x:Class="OnionProcOparetor.Console.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- UI-3a (2026-11-03): หน้าต่างนี้เหลือไว้เป็น "chrome เปล่า" สำหรับ owner ที่ยังไม่มี DialogHost
         ของตัวเอง (ActionPanelWindow/LaunchableProgramsWindow/RunningProcessesWindow/
         WebsiteCatalogSourcesWindow - จะถูกย้ายเป็น UserControl ใน UI-3c) และสำหรับ debug preview
         harness (สวิตช์ dialog=confirm) เท่านั้น - เนื้อหาจริงอยู่ใน ConfirmDialogContent.xaml ทั้งหมดแล้ว
         (ย้ายออกจากที่นี่ เพื่อใช้ร่วมกับเส้นทาง DialogHost ใหม่ได้โดยไม่ต้องเขียน XAML ซ้ำสองชุด - ดู
         ConfirmWindow.xaml.cs) -->
</Window>
