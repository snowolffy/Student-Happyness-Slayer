<UserControl x:Class="OnionProcOparetor.Console.RunningProcessesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UI-3c (2026-11-03): เดิมเป็น Window ของตัวเอง (Show แบบไม่ modal) - ย้ายมาเป็น UserControl ใน
         แผงสไลด์ขวา (SidePanelHost) - เพิ่มปุ่ม "ปิด" เองเพราะไม่มี chrome ให้กดปิดแล้ว -->
    <Border Style="{StaticResource Card}" Width="520" MaxHeight="640">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="MachineNameText" Style="{StaticResource Heading2}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="รีเฟรช" Style="{StaticResource ButtonSecondary}"
                        Padding="10,5" FontSize="11" Click="RefreshButton_Click"/>
            </Grid>

            <TextBlock Grid.Row="1" x:Name="StatusText" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" Margin="0,10,0,10"/>

            <Grid Grid.Row="2" MinHeight="260">
                <Border CornerRadius="12" ClipToBounds="True"
                        Background="{DynamicResource Brush.Background.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                <DataGrid x:Name="ProcessesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="{DynamicResource Brush.Background.Card}"
                          AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                          HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                          VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                          RowHeight="40" CanUserAddRows="False"
                          ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                          RowStyle="{StaticResource ConsoleGridRowStyle}"
                          CellStyle="{StaticResource ConsoleGridCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                        <DataGridTextColumn Header="PROCESS" Binding="{Binding ProcessName}" Width="120"/>
                        <DataGridTextColumn Header="WINDOW TITLE" Binding="{Binding WindowTitle}" Width="*"/>
                        <DataGridTextColumn Header="PUBLISHER" Binding="{Binding PublisherName}" Width="170"/>
                        <DataGridTextColumn Header="SIGNED" Binding="{Binding IsSignedMatch}" Width="60"/>
                        <!-- ปุ่ม 2 ตัวทำคนละเรื่องกันโดยตั้งใจ (2026-08-31):
                             CREATE RULE  = กฎแบบ publisher (ครอบคลุมทุกโปรแกรมของค่ายนั้น) - ต้องมี publisher
                             BLOCK ทุกเครื่อง = ผูกกับ SHA-256 ของไฟล์นี้ไฟล์เดียว - ใช้ได้แม้ไม่มี publisher
                             ตัวหลังคือทางเดียวที่ใช้ได้กับเกม portable/โหลด ซึ่งเป็นกลุ่มที่อยากบล็อกที่สุด -->
                        <DataGridTemplateColumn Header="ACTIONS" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="สร้างกฎจากโปรแกรมนี้" Style="{StaticResource ButtonSecondary}"
                                                Padding="10,5" FontSize="11" Margin="0,0,6,0"
                                                IsEnabled="{Binding HasPublisher}"
                                                ToolTip="สร้างกฎจาก publisher - ครอบคลุมทุกโปรแกรมของค่ายนี้ (ต้องมี publisher)"
                                                Click="CreateRuleButton_Click" Tag="{Binding}"/>
                                        <Button Content="บล็อกโปรแกรมนี้" Style="{StaticResource ButtonPrimary}"
                                                Padding="12,5" FontSize="11"
                                                IsEnabled="{Binding CanBlockByHash}"
                                                ToolTip="บล็อกไฟล์นี้ถาวรทุกเครื่อง ผูกกับลายนิ้วมือของไฟล์ (ใช้ได้แม้ไม่มี publisher)"
                                                Click="BlockByHashButton_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Border>
                <TextBlock x:Name="EmptyText"
                           Text="ไม่พบโปรแกรมที่มีหน้าต่างอยู่บน desktop" Style="{StaticResource Caption}" TextAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>

            <Button Grid.Row="3" Content="ปิด" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Margin="0,12,0,0" Click="CloseButton_Click"/>
        </Grid>
    </Border>
</UserControl>
