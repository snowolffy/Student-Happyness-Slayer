<Window x:Class="OnionProcOparetor.Console.TeacherDrawToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เครื่องมือเขียน"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True"
        Icon="/Theme/icon.ico">
    <!-- คำขอเพิ่ม 3 พ.ย. 2569 - แผงเครื่องมือเขียน (ปากกา 4 สี/ไฮไลต์/ยางลบ/ล้างทั้งหมด) ลอยอยู่บนจอครู
         เฉพาะตอนเปิดโหมดเขียน - ต้องห้ามติดไปในภาพที่ส่งให้นักเรียน (เป็น control ของครูเอง เหมือนกรอบแดง/
         แถบสถานะ) จึงเรียก ExcludeFromCapture เสมอ (ดู code-behind) ไม่ตั้ง click-through เลย (ต้องรับ
         คลิกปุ่มได้ตลอดเวลาที่เปิดอยู่ ต่างจาก TeacherDrawCanvasWindow) -->
    <Border Background="#1E1E1E" CornerRadius="10" Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35"/>
        </Border.Effect>
        <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal">
            <Button x:Name="HighlighterButton" Content="ไฮไลต์" Margin="8,0,0,0" Padding="10,4" FontSize="12" Click="HighlighterButton_Click"/>
            <Button x:Name="EraserButton" Content="ยางลบ" Margin="6,0,0,0" Padding="10,4" FontSize="12" Click="EraserButton_Click"/>
            <Button x:Name="ClearButton" Content="ล้างทั้งหมด" Margin="6,0,0,0" Padding="10,4" FontSize="12" Click="ClearButton_Click"/>
        </StackPanel>
    </Border>
</Window>
