<Window x:Class="OnionProcOparetor.Console.TeacherDrawCanvasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เขียนบนจอ (ครู)"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="#01000000"
        AllowsTransparency="True"
        ShowActivated="False"
        Icon="/Theme/icon.ico">
    <!-- คำขอเพิ่ม 3 พ.ย. 2569 - "เขียนบนจอ": แผ่นใสทับจอครูทั้งจอ ใช้ InkCanvas ของ WPF เอง (ไม่ต้องเพิ่ม
         NuGet) เส้นที่เขียนตรงนี้ "ต้อง" ติดไปในภาพที่ส่งให้นักเรียนเห็น (ต่างจาก TeacherBroadcastBorderWindow/
         BroadcastWarningBarWindow ที่ต้องห้ามติด) - จึงไม่เรียก TeacherOnlyWindowHelper.ExcludeFromCapture
         ที่นี่เด็ดขาด ปล่อยให้ BitBlt จับภาพ composited ปกติ (DWM render หน้าต่าง Topmost/Layered นี้เข้า
         ไปในภาพอยู่แล้วตามปกติ)

         Background="#01000000" (ไม่ใช่ "Transparent"/alpha 0) - บั๊กจริงที่เจอ 3 พ.ย.: หน้าต่าง
         AllowsTransparency ของ WPF เป็น layered window (UpdateLayeredWindow) ซึ่ง Windows ตัดสินใจ hit-test
         ว่าคลิก "โดน" หน้าต่างนี้หรือ "ทะลุ" ไปโปรแกรมข้างใต้จาก alpha ของพิกเซลตรงนั้นเป็นหลัก (ไม่ใช่แค่
         WS_EX_TRANSPARENT) ถ้าพื้นหลังเป็น alpha=0 ล้วน (ก่อนเขียนเส้นแรก พื้นที่ทั้งแผ่นว่างหมด) คลิก/ลากเมาส์
         จะทะลุหน้าต่างนี้ไปเลยแม้ไม่ได้เปิด click-through (SetClickThrough) ไว้ - InkCanvas เลยไม่เคยได้รับ
         MouseDown ให้เริ่มวาดเส้นสักที (ทดสอบจริงด้วย harness จับภาพ+จำลองลากเมาส์ 3 พ.ย.: alpha=0 ไม่มีเส้น
         ติดเลย, alpha=1 วาดได้ปกติ) alpha=1/255 เตี้ยพอที่ตาเปล่า/JPEG มองไม่เห็นความต่างจากโปร่งใสจริง
         แต่สูงพอให้ Windows นับเป็น "มีเนื้อ" รับ mouse hit-test ได้เสมอตอนไม่ได้ตั้ง click-through -->
    <InkCanvas x:Name="Canvas" Background="#01000000"/>
</Window>
