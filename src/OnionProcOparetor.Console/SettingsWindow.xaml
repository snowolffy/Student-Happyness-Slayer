<Window x:Class="OnionProcOparetor.Console.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- Rebuilt 2026-09-03 - a StackPanel of Cards replaces the old fixed-pixel Grid rows (each
         Border used to carry an explicit Height tuned to its own content). -->
    <StackPanel Margin="20">
        <TextBlock Text="Settings" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="VNC MAX CONCURRENT SESSIONS" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <TextBox x:Name="VncLimitBox" Width="100" HorizontalAlignment="Left" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,8"/>
                <TextBlock Text="จำนวนเครื่องสูงสุดที่เปิดดูหน้าจอ (Screen View) พร้อมกันได้"
                           Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="DASHBOARD AUTO-REFRESH INTERVAL (SECONDS)" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <TextBox x:Name="PollIntervalBox" Width="100" HorizontalAlignment="Left" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,8"/>
                <TextBlock Text="ความถี่โหลดข้อมูล Clients/Rules/Logs/Users ใหม่อัตโนมัติของ Dashboard"
                           Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="DEFAULT SERVER HOST / PORT" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="ServerHostBox" Style="{StaticResource RoundedTextBox}"/>
                    <TextBox Grid.Column="2" x:Name="ServerPortBox" Style="{StaticResource RoundedTextBox}"/>
                </Grid>
                <TextBlock Text="ใช้เป็นค่าเริ่มต้นในหน้า Connect ครั้งถัดไป"
                           Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <CheckBox x:Name="KeepLiveViewOpenCheckBox"
                          Content="คงการเชื่อมต่อไว้เมื่อออกจากแท็บ LIVE VIEW" Margin="0,0,0,8"/>
                <TextBlock Text="ค่า default คือปิดทั้งหมดเมื่อออกจากแท็บ"
                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <CheckBox x:Name="ShowTailscaleActionsCheckBox"
                          Content="แสดงปุ่ม Tailscale ในแผงคำสั่ง" Margin="0,0,0,8"/>
                <TextBlock Text="TAILSCALE LOCK / UNLOCK / STATUS / LOGIN เป็นงานดูแลเครือข่าย ไม่ใช่งานคุมห้องเรียน ค่า default คือซ่อนไว้เพื่อให้แผงคำสั่งเหลือเฉพาะปุ่มที่ใช้จริงทุกวัน"
                           Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="MY ACCOUNT" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                <Button x:Name="ChangeMyPasswordButton" Content="CHANGE MY PASSWORD..." HorizontalAlignment="Left"
                        Style="{StaticResource ButtonSecondary}" Padding="10,9" FontSize="12" Margin="0,0,0,8" Click="ChangeMyPasswordButton_Click"/>
                <TextBlock Text="เปลี่ยน password ของ account ที่ login อยู่ตอนนี้เท่านั้น"
                           Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Grid>
            <Button Content="CANCEL" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Margin="0,0,96,0" Click="CancelButton_Click"/>
            <Button Content="SAVE" Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Right" Click="SaveButton_Click"/>
        </Grid>
    </StackPanel>
</Window>
