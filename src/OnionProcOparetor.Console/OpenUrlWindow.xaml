<UserControl x:Class="OnionProcOparetor.Console.OpenUrlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnionProcOparetor.UI.Controls;assembly=OnionProcOparetor.UI">
    <!-- "เปิด URL / โปรแกรมทั้งห้อง" (WP4-1, 2026-11-01) - ตาม wireframe tc-openurl.dc.html (เลย์เอาต์ปรับ
         เป็นคอลัมน์เดียวให้เข้ากับรูปแบบ dialog อื่นๆ ของแอปนี้ เหมือนที่ ExamModeWindow ทำไว้ก่อนแล้ว -
         จุดต่างที่ตั้งใจ ไม่ใช่จุดพลาด) ของที่ไม่ได้ทำตาม wireframe รอบนี้ (ดูรายงานของ WP4-1):
         "ปิดแท็บอื่นทั้งหมดก่อน" และ "เพิ่มเว็บนี้ใน Allow-list ชั่วคราว" (ต้องมี API เพิ่มจาก WP อื่น)
         รวมถึงรายการ "ใช้ล่าสุด/ปักหมุด" - ตัดออกไปก่อนเพื่อไม่ให้มี UI ที่ไม่ทำงานจริงค้างอยู่
         เปิดจากปุ่ม "เปิด URL/โปรแกรม" บนแถบคำสั่งของ Clients (ดู DashboardWindow.OpenUrlProgramButton_Click)
         UI-3b (2026-11-03): แปลงจาก Window เป็น UserControl ฝังใน DialogHost ของ MainWindow -->
    <Border Style="{StaticResource Card}" Width="640">
    <StackPanel Margin="20" MaxHeight="640">
        <TextBlock Text="เปิดให้ทั้งห้อง" Style="{StaticResource Heading2}"/>
        <TextBlock Text="เรียกจากแผงคำสั่งของ Clients - โปรแกรมเลือกได้เฉพาะรายการที่ Admin ตั้งไว้เท่านั้น"
                   Style="{StaticResource Caption}" Margin="0,2,0,16" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <ToggleButton x:Name="WebsiteModeButton" Content="เว็บไซต์" Style="{StaticResource PillTabButton}"
                          Margin="0,0,8,0" IsChecked="True" Click="ModePill_Click"/>
            <ToggleButton x:Name="ProgramModeButton" Content="โปรแกรม" Style="{StaticResource PillTabButton}"
                          Click="ModePill_Click"/>
        </StackPanel>

        <!-- ==== โหมดเว็บไซต์ ==== -->
        <StackPanel x:Name="WebsitePanel">
            <TextBlock Text="ลิงก์ (http/https เท่านั้น)" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="UrlTextBox" Style="{StaticResource PlaceholderTextBox}"
                     Tag="https://classroom.google.com/c/xxxx" Margin="0,0,0,16" TextChanged="UrlTextBox_TextChanged"/>

            <TextBlock Text="เปิดแบบไหน" Style="{StaticResource Label}" Margin="0,0,0,8"/>
            <RadioButton x:Name="NewTabRadio" GroupName="UrlOpenMode" Margin="0,0,0,6" IsChecked="True">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="แท็บใหม่" FontWeight="SemiBold"/>
                    <TextBlock Text="เปิดเพิ่มในเบราว์เซอร์ที่นักเรียนใช้อยู่" Style="{StaticResource Caption}"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="FullscreenRadio" GroupName="UrlOpenMode" Margin="0,0,0,16">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="เต็มจอ (โหมดตั้งใจ)" FontWeight="SemiBold"/>
                    <TextBlock Text="เปิดเต็มจอ - รองรับ best-effort เฉพาะ Edge/Chrome ที่ path เริ่มต้น (ยังไม่บังคับให้ออกได้ด้วยคำสั่งครูเท่านั้นในรอบนี้)"
                               Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- ==== โหมดโปรแกรม ==== -->
        <StackPanel x:Name="ProgramPanel" Visibility="Collapsed">
            <TextBlock Text="เลือกโปรแกรม" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="ProgramCombo" DisplayMemberPath="Name" Margin="0,0,0,8"
                      SelectionChanged="ProgramCombo_SelectionChanged"/>
            <TextBlock Text="เลือกจากรายการที่ Admin ตั้งไว้เท่านั้น (ไม่ให้พิมพ์ path เอง กันสั่งรันอะไรก็ได้บน 40 เครื่อง) - จัดการรายการได้ที่หน้าตั้งค่า"
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>
        </StackPanel>

        <TextBlock Text="ส่งไปที่" Style="{StaticResource Label}" Margin="0,0,0,8"/>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <RadioButton x:Name="TargetRoomRadio" GroupName="OpenTarget" Content="ทั้งห้อง" Margin="0,0,0,8" Checked="TargetRadio_Changed"/>
                <RadioButton x:Name="TargetSelectedRadio" GroupName="OpenTarget" Checked="TargetRadio_Changed"/>
            </StackPanel>
            <ComboBox x:Name="RoomCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                      VerticalAlignment="Top" DisplayMemberPath="Name" SelectionChanged="RoomCombo_SelectionChanged"/>
        </Grid>

        <Border Background="{DynamicResource Brush.Background.Sunken}" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
            <TextBlock x:Name="SummaryText" FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Grid>
            <Button Content="ปิด" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Margin="0,0,120,0" Click="CancelButton_Click"/>
            <Button x:Name="OpenButton" Content="เปิดทั้งห้อง" Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Right" Click="OpenButton_Click" controls:DialogHost.IsDefaultButton="True"/>
        </Grid>
    </StackPanel>
    </Border>
</UserControl>
