<UserControl x:Class="OnionProcOparetor.Console.WebsiteAllowListPlaceholderTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OnionProcOparetor.UI.Controls;assembly=OnionProcOparetor.UI">
    <!-- แท็บ "ชุด Allow-list" ของหน้า Website Control (WP2-2, 2026-10-31) - เนื้อหาจริงแทน EmptyState
         เดิมของ WP2-1 แล้ว ดู wireframe con-website-allow.dc.html: รายการชุดทางซ้าย (300px) + รายละเอียด
         ของชุดที่เลือกทางขวา (ชื่อ, ทำสำเนา/ลบชุด, เพิ่มโดเมน, รายการโดเมน, ทดสอบ URL)

         ชื่อไฟล์/คลาสยังเป็น WebsiteAllowListPlaceholderTab เดิม (ไม่ rename) ตามที่ WP2-1 เตรียมไว้ -
         ดู WebsiteControlPage.xaml(.cs) ที่ต้องเพิ่ม x:Name="AllowListTab" + เรียก Initialize(apiClient)
         เพิ่มจาก WP2-1 (เดิมแท็บนี้ไม่มี logic จึงไม่ต้องมี ApiClient เลย) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== รายการชุดทั้งหมด ==================== -->
        <DockPanel Grid.Column="0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="ชุดทั้งหมด" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                <Button x:Name="AddPresetButton" Content="+ ชุดใหม่" Style="{StaticResource ButtonSecondary}"
                        Padding="10,5" FontSize="11" HorizontalAlignment="Right"
                        Click="AddPresetButton_Click"/>
            </Grid>

            <ListBox x:Name="PresetsList" BorderThickness="0" Background="Transparent"
                     SelectionChanged="PresetsList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}"
                                            CornerRadius="8" BorderThickness="1.5"
                                            BorderBrush="{DynamicResource Brush.Border.Default}"
                                            Background="{DynamicResource Brush.Background.Card}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Background.Sunken}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding DomainCountText}" FontSize="12"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ==================== รายละเอียดของชุดที่เลือก ==================== -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
            <Grid x:Name="DetailGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,16,16,12">
                    <StackPanel>
                        <TextBlock x:Name="SelectedPresetNameText" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedPresetMetaText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DuplicatePresetButton" Content="ทำสำเนา" Style="{StaticResource ButtonSecondary}"
                                Padding="10,5" FontSize="11" Click="DuplicatePresetButton_Click"/>
                        <Button x:Name="DeletePresetButton" Content="ลบชุด" Style="{StaticResource ButtonDanger}"
                                Padding="10,5" FontSize="11" Margin="8,0,0,0" Click="DeletePresetButton_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="16,0,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewDomainTextBox" Grid.Column="0" Style="{StaticResource PlaceholderTextBox}"
                             Tag="เพิ่มโดเมน เช่น forms.gle" KeyDown="NewDomainTextBox_KeyDown"/>
                    <Button x:Name="AddDomainButton" Grid.Column="1" Content="เพิ่ม" Style="{StaticResource ButtonPrimary}"
                            Margin="8,0,0,0" Click="AddDomainButton_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16,0,16,0">
                    <ItemsControl x:Name="DomainsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border.Default}" Padding="4,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Domain}" FontSize="13" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="ลบ" Tag="{Binding}" Style="{StaticResource ButtonSecondary}"
                                                Padding="8,3" FontSize="11" Click="RemoveDomainButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="16" Background="{DynamicResource Brush.Background.Sunken}">
                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ทดสอบ:" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox x:Name="TestUrlTextBox" Grid.Column="1" Style="{StaticResource PlaceholderTextBox}"
                                 Margin="8,0" Tag="https://docs.google.com/forms/d/…"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="เปิดได้ไหม?" Style="{StaticResource ButtonSecondary}"
                                    Padding="10,5" FontSize="11" Click="TestUrlButton_Click"/>
                            <TextBlock x:Name="TestResultText" FontSize="12" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <ContentControl x:Name="EmptyDetailState" Style="{StaticResource EmptyState}" controls:Nav.Icon="list"
                            Content="เลือกชุดทางซ้ายเพื่อแก้ไข"
                            Tag="หรือกด &quot;+ ชุดใหม่&quot; เพื่อสร้างชุด Allow-list ของตัวเอง"/>
        </Grid>
        </Border>
    </Grid>
</UserControl>
