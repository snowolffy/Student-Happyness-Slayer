<Window x:Class="OnionProcOparetor.Console.RuleOverridesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Config Rule"
        Height="480" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- Rebuilt 2026-09-03 - same Auto/*/Auto row shape as before (a legitimate use of Grid here:
         the rule list is variable-length and needs a flexible scrollable middle region), just
         re-spaced with margins instead of a fixed-pixel Auto/8/*/Auto/40 row set. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="MachineNameText" Style="{StaticResource Heading2}" Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1"
                   Text="Override เฉพาะเครื่องนี้เท่านั้น - ไม่กระทบ global rule หรือเครื่องอื่น ถ้ามี override ค่านี้ชนะ global เสมอ"
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RulesListPanel" Margin="6"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3">
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,90,0"/>
            <Button Content="CLOSE" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
