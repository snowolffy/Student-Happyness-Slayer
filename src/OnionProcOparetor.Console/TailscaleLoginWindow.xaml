<Window x:Class="OnionProcOparetor.Console.TailscaleLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tailscale Login"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppWindowStyle}">
    <!-- โมเดลตาม BroadcastMessageWindow.xaml (precedent เดียวในโปรเจกต์นี้สำหรับ "ให้ครูกรอกข้อความ
         อิสระแล้วผูกกับ command") - WindowStartupLocation="Manual" + WindowCenteringHelper ด้วยเหตุผล
         เดียวกัน (SizeToContent คำนวณ CenterOwner ผิดถ้าไม่ทำแบบนี้) เครื่องเดียวเท่านั้น (ไม่มี
         target-selection radio เหมือน BroadcastMessageWindow เพราะ TailscaleWindow ที่เปิดหน้าต่างนี้
         เป็น single-machine mode อยู่แล้ว) -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="57"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tailscale Login" Style="{StaticResource Heading2}" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Grid.Row="1" Text="Auth key (จาก Tailscale admin console)" Style="{StaticResource Label}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox Grid.Row="2" x:Name="AuthKeyInputBox"
                 Style="{StaticResource RoundedTextBox}" VerticalAlignment="Top"/>

        <TextBlock Grid.Row="3" Width="380" x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0"/>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Button Content="CANCEL" Style="{StaticResource ButtonSecondary}" Width="80"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Left" Height="35" VerticalAlignment="Top" Margin="227,0,0,0" Click="CancelButton_Click"/>
            <Button Content="LOGIN" Style="{StaticResource ButtonPrimary}" Width="70"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="LoginButton_Click"/>
        </Grid>
    </Grid>
</Window>
