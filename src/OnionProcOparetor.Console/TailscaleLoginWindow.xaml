<Window x:Class="OnionProcOparetor.Console.TailscaleLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tailscale Login"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- Rebuilt 2026-09-03 (Fluent-adoption redesign): StackPanel replaces the old fixed-pixel
         RowDefinitions. WindowStartupLocation is CenterOwner like every other sub-window -
         SizeToContent + CenterOwner drifts otherwise, per the original comment history. -->
    <StackPanel Margin="20">
        <TextBlock Text="Tailscale Login" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

        <TextBlock Text="AUTH KEY (จาก Tailscale admin console)" Style="{StaticResource Label}" Margin="0,0,0,6"/>
        <TextBox x:Name="AuthKeyInputBox" Style="{StaticResource RoundedTextBox}"/>

        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <Grid Margin="0,16,0,0">
            <Button Content="CANCEL" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Margin="0,0,86,0" Click="CancelButton_Click"/>
            <Button Content="ล็อกอิน" Style="{StaticResource ButtonPrimary}" Width="70"
                    HorizontalAlignment="Right" Click="LoginButton_Click"/>
        </Grid>
    </StackPanel>
</Window>
