<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors.xaml is NOT merged here any more (2026-09-09). The palette is swapped at runtime by
         ThemeService, so pinning a specific palette file into this dictionary would defeat the swap;
         every colour below is a {DynamicResource} resolved against Application.Resources instead.
         Typography.xaml stays merged because FontFamily.Primary is theme-independent. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ==================== Window base ==================== -->
    <Style x:Key="AppWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ==================== Card (Border) ==================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- ==================== RoundedTextBox ====================
         2026-09-03: tried dropping the custom Template so Fluent's own TextBox template would render
         (ThemeMode="Light" on App.xaml), then tried the documented Border.CornerRadius attached-property
         knob (https://github.com/dotnet/wpf/discussions/9450) to round it. Verified empirically (cropped
         screenshot inspection, not just assumed) that neither actually rounds the corners in this
         build - the box rendered perfectly square either way. Reverted to an explicit ControlTemplate,
         which reliably rounds because CornerRadius is a real property on the Border element below,
         not an attached-property hint a template may or may not read. -->
    <Style x:Key="RoundedTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="Padding" Value="10,4.5"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== RoundedPasswordBox ====================
         Explicit Template restored - same reasoning as RoundedTextBox above. -->
    <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== ButtonPrimary ====================
         Explicit Template restored - same empirical finding as RoundedTextBox above (Fluent's default
         template and the Border.CornerRadius attached property both rendered dead square in this
         build - verified via cropped screenshot, not assumed). An explicit Border-based template
         reliably rounds because CornerRadius here is a real property, not a hint. -->
    <Style x:Key="ButtonPrimary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Default}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Light}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Status.Offline}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== ButtonSecondary ====================
         Explicit Template restored - same reasoning as ButtonPrimary above. -->
    <Style x:Key="ButtonSecondary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== ButtonDanger ====================
         Explicit Template restored - same reasoning as ButtonPrimary above. -->
    <Style x:Key="ButtonDanger" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Default}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger.Light}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Status.Offline}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== PillTabButton (Client/Rule/Logs/User nav) ==================== -->
    <Style x:Key="PillTabButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="16"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Default}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== UnderlineTabItem (TabControl nav) ====================
         Rebuilt 2026-09-03: replaced the old rounded-pill design entirely, after two rounds of
         patching a corner-clipping bug (asymmetric top/bottom curve on the selected pill, root-caused
         via raw pixel sampling to Fluent's default TabControl chrome, then fixed with an explicit
         TabControl.Template in DashboardWindow.xaml) still wasn't good enough on the user's machine.
         Rather than keep patching the same fragile shape, this is a flat underline-indicator style
         instead: no rounded corners anywhere, so there is no corner-clipping class of bug left to hit.
         Selected tab = accent-colored bold text + a 3px accent bar underneath; unselected = plain
         secondary-colored text. Renamed from "PillTabItem" since it's no longer pill-shaped - it isn't
         referenced anywhere except DashboardWindow.xaml (grepped before renaming). -->
    <Style x:Key="UnderlineTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Margin" Value="0,0,24,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- StackPanel, not Grid: a Grid with no explicit ColumnDefinitions gets one
                         implicit column at Width="*" (fill-available), not Auto (size-to-content) -
                         that measured every tab far too narrow before TabPanel had settled on a width
                         to give it, clipping every label (confirmed: "CLIENTS" rendered as "CLIEN",
                         "RULES" as "RU", etc.). StackPanel sizes to its content's natural
                         width/height in both dimensions with no such footgun. -->
                    <StackPanel Background="Transparent">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Border x:Name="Indicator" Height="3" Margin="0,8,0,0" Background="Transparent"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Default}"/>
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Brush.Accent.Default}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== StatusBadge ====================
         Usage: <ContentControl Style="{StaticResource StatusBadge}" Tag="Online" Content="Online"/>
         Tag accepts "Online" / "Offline" / "Warning". -->
    <Style x:Key="StatusBadge" TargetType="ContentControl">
        <Setter Property="Tag" Value="Offline"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Bd" CornerRadius="10" Padding="10,3"
                            Background="{DynamicResource Brush.Status.Offline}">
                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                   Foreground="{DynamicResource Brush.Text.OnAccent}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Online">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Status.Online}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Offline">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Status.Offline}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Warning">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Status.Warning}"/>
                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Danger">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger.Default}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Shared DataGrid look ====================
         ย้ายมาจาก DashboardWindow.xaml's Window.Resources (2026-08-25) - บั๊กจริงที่เจอ: 3 style นี้
         ตั้งใจให้ "shared" ตั้งแต่แรก (ดู comment เดิม "Shared DataGrid look for all 4 tabs") แต่ประกาศไว้
         ใน Window.Resources ของ DashboardWindow เอง ทำให้ "shared" จริงๆ แค่ภายใน 4 แท็บของหน้าต่างนั้น
         เท่านั้น - พอ RunningProcessesWindow (คนละ Window instance) อ้างถึง StaticResource เดียวกันนี้ผ่าน
         DataGrid ของตัวเอง WPF resolve ไม่เจอเลย (StaticResource lookup ไม่ข้าม Window ไปหา Window.Resources
         ของอีกอันได้) เจอจริงจาก field test เป็น XamlParseException ทันทีที่เปิดหน้าต่าง ("Provide value on
         'System.Windows.StaticResourceExtension' threw an exception") - ทั้งที่ dotnet build ผ่านมาตลอด
         เพราะ StaticResource resolve ตอน runtime ไม่ใช่ compile time ย้ายมาไว้ที่นี่ (merged เข้าทุก Window
         ผ่าน App.xaml อยู่แล้ว) ให้ shared จริงตามที่ตั้งใจไว้แต่แรก ไม่ต้อง duplicate ต่อทุกหน้าต่างใหม่ที่มี
         DataGrid -->
    <Style x:Key="ConsoleGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style x:Key="ConsoleGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <!-- Brush.Row.Hover, not an inline SolidColorBrush with Opacity: a Freezable declared
                     inline inside a Style setter gets frozen by WPF, and a frozen brush cannot carry a
                     DynamicResource - the hover colour would stay stuck on whichever theme loaded first. -->
                <Setter Property="Background" Value="{DynamicResource Brush.Row.Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ConsoleGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
