<UserControl x:Class="OnionProcOparetor.Console.PendingCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnionProcOparetor.UI.Controls;assembly=OnionProcOparetor.UI">
    <!-- UI-3c (2026-11-03): เดิมเป็น Window ของตัวเอง (Show แบบไม่ modal, ปิดด้วย chrome ปุ่ม X) -
         ย้ายมาเป็น UserControl ในแผงสไลด์ขวา (SidePanelHost) - เพิ่มปุ่ม "ปิด" เองเพราะไม่มี chrome
         ให้กดปิดแล้ว -->
    <Border Style="{StaticResource Card}" Width="720" MaxHeight="620">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="MachineNameText" Style="{StaticResource Heading2}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="รีเฟรช" Style="{StaticResource ButtonSecondary}"
                        Padding="10,5" FontSize="11" Click="RefreshButton_Click"/>
            </Grid>

            <!-- UI-4 (2026-11-04): ไอคอนหมุน (SpinningLoaderIcon) คู่กับข้อความสถานะ - ดู
                 OnionProcOparetor.UI/Theme/Controls.xaml -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                <controls:IconPresenter x:Name="StatusLoadingIcon" Style="{StaticResource SpinningLoaderIcon}"
                                        Visibility="Collapsed" Margin="0,0,6,0"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="2" MinHeight="200">
                <Border CornerRadius="12" ClipToBounds="True"
                        Background="{DynamicResource Brush.Background.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                <DataGrid x:Name="CommandsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="{DynamicResource Brush.Background.Card}"
                          AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                          HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                          VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                          RowHeight="40" CanUserAddRows="False"
                          ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                          RowStyle="{StaticResource ConsoleGridRowStyle}"
                          CellStyle="{StaticResource ConsoleGridCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="COMMAND ID" Binding="{Binding CommandId}" Width="90"/>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding CommandType}" Width="*"/>
                        <DataGridTextColumn Header="DELIVERY" Binding="{Binding DeliveryStatus}" Width="100"/>
                        <DataGridTemplateColumn Header="ACTIONS" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="ยกเลิก" Style="{StaticResource ButtonSecondary}"
                                            Padding="10,5" FontSize="11"
                                            Click="CancelButton_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Border>
                <TextBlock x:Name="EmptyText"
                           Text="ไม่มีคำสั่งที่ค้างอยู่สำหรับเครื่องนี้" Style="{StaticResource Caption}" TextAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>

            <Button Grid.Row="3" Content="ปิด" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Margin="0,12,0,0" Click="CloseButton_Click"/>
        </Grid>
    </Border>
</UserControl>
