<UserControl x:Class="OnionProcOparetor.Console.LockScreenMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnionProcOparetor.UI.Controls;assembly=OnionProcOparetor.UI">
    <!-- WP3-5 (2026-10-31) - ตรงตาม wireframe docs/wireframes/con-dialogs.dc.html dialog "ล็อกหน้าจอ"
         (note: "ใหม่: แก้ข้อความได้") เว้นว่าง = ใช้ข้อความเริ่มต้นจากหน้าตั้งค่า Sign-in
         (SignInSettings.LockScreenDefaultMessage) - ไม่ได้ตรวจ/เติม default message ตรงนี้เอง ฝาก
         Agent/AgentTray เป็นคนเติมเมื่อ payload ไม่มีข้อความมา (ดู comment ใน ActionPanelWindow.xaml.cs
         LockButton_Click - ยังไม่มีผลจริงจนกว่า WP3-3 จะทำ Agent/AgentTray รองรับ message ใน payload)
         UI-3b (2026-11-03): แปลงจาก Window เป็น UserControl - เรียกได้เฉพาะจาก ActionPanelWindow
         (UI-3c ยังไม่ย้าย ยังเป็น Window ลอย owner=this) ดู ShowViaHost ใน .xaml.cs -->
    <Border Style="{StaticResource Card}" Width="440">
    <StackPanel Margin="20">
        <TextBlock Text="ล็อกหน้าจอ" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

        <TextBlock Text="ข้อความบนจอล็อก (เฉพาะครั้งนี้)" Style="{StaticResource Label}" Margin="0,0,0,6"/>
        <TextBox x:Name="MessageInputBox" Height="90" Style="{StaticResource RoundedTextBox}"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
        <TextBlock Text="เว้นว่าง = ใช้ข้อความเริ่มต้นจากหน้าตั้งค่า"
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Grid>
            <Button Content="ยกเลิก" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Margin="0,0,70,0" Click="CancelButton_Click"/>
            <Button Content="ล็อก" Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Right" Click="LockButton_Click" controls:DialogHost.IsDefaultButton="True"/>
        </Grid>
    </StackPanel>
    </Border>
</UserControl>
