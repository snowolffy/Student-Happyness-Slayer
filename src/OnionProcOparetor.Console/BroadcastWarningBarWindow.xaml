<Window x:Class="OnionProcOparetor.Console.BroadcastWarningBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="กำลังส่งจอครู"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True"
        Icon="/Theme/icon.ico">
    <!-- "ส่งจอครู" (WP4-4, 2026-11-01 / แก้ตามคำขอเพิ่ม 3 พ.ย. 2569) - แถบแดงลอยบนจอครูตลอดเวลาที่ส่ง
         (ขั้นตอน 2 ของ wireframe tc-broadcast.dc.html คอลัมน์ขวา) ตอนนี้หุบเหลือแค่ปุ่มกลมได้ (ตัดสินแล้ว
         3 พ.ย.: "เหลือปุ่มกลมแดงเล็กลากย้ายได้ กดแล้วกางกลับเป็นแถบเต็ม") - สองสถานะอยู่ใน Window เดียวกัน
         สลับ Visibility ใน code-behind (ไม่ใช้ 2 หน้าต่างแยก เพราะต้องคง HWND เดียวไว้ให้ SetWindowDisplayAffinity
         ที่ตั้งไว้ครั้งเดียวตอน SourceInitialized ยังมีผลอยู่ทั้งสองสถานะ)

         ของที่ไม่ได้ทำตาม wireframe รอบนี้: ตัวเลข "X/Y เครื่องรับได้" เป็นค่าตอนเริ่มเท่านั้น ไม่ใช่ตัวเลข
         สดที่อัปเดตตามจริง (เหมือนเดิมจาก WIP ก่อนหน้า) -->
    <Grid>
        <!-- สถานะหุบ: ปุ่มกลมแดงเล็ก ลากย้ายตำแหน่งได้ (DragMove ใน code-behind) -->
        <Border x:Name="CollapsedPill" Width="48" Height="48" CornerRadius="24" Background="#B42318"
                MouseLeftButtonDown="CollapsedPill_MouseLeftButtonDown" Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
            </Border.Effect>
            <TextBlock Text="REC" Foreground="White" FontSize="11" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- สถานะเต็ม: แถบสถานะ + ปุ่มหุบ/เครื่องมือเขียน/ซูม/หยุดส่ง -->
        <Border x:Name="FullBar" Background="#B42318" CornerRadius="10" Padding="16,10" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Foreground="White" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Text="กำลังส่งจอ"/>
                <ToggleButton x:Name="DrawToolButton" Content="เครื่องมือเขียน" Margin="14,0,0,0" Padding="12,4"
                              Background="White" Foreground="#B42318" BorderThickness="0" FontSize="12"
                              VerticalAlignment="Center" Click="DrawToolButton_Click"/>
                <ToggleButton x:Name="ZoomButton" Content="ซูม" Margin="8,0,0,0" Padding="12,4"
                              Background="White" Foreground="#B42318" BorderThickness="0" FontSize="12"
                              VerticalAlignment="Center" Click="ZoomButton_Click"/>
                <Button x:Name="CollapseButton" Content="หุบ" Margin="8,0,0,0" Padding="12,4"
                        Background="#8E2419" Foreground="White" BorderThickness="0" FontSize="12"
                        VerticalAlignment="Center" Click="CollapseButton_Click"/>
                <Button x:Name="StopButton" Content="หยุดส่ง" Margin="8,0,0,0" Padding="12,4"
                        Background="White" Foreground="#B42318" BorderThickness="0" FontSize="12"
                        VerticalAlignment="Center" Click="StopButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
