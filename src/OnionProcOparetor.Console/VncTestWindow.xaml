<Window x:Class="OnionProcOparetor.Console.VncTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VNC Handshake Test (temporary - Step 4b)"
        Height="480" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource AppWindowStyle}">
    <!-- ชั่วคราวสำหรับทดสอบ Step 4b (RFB handshake) เท่านั้น - ไม่ใช่ production UI ตามที่ตกลง
         (ยังไม่ render framebuffer/embed เข้า Dashboard จริง - Step 4c/4d) -->
    <Canvas Margin="20">
        <TextBlock Canvas.Left="0" Canvas.Top="0" Width="520" x:Name="HeaderText" Style="{StaticResource Heading2}" TextWrapping="Wrap"/>

        <Button Canvas.Left="0" Canvas.Top="36" Width="200" x:Name="ConnectButton" Content="CONNECT (TEST HANDSHAKE)"
                Style="{StaticResource ButtonPrimary}" Click="ConnectButton_Click"/>

        <TextBlock Canvas.Left="0" Canvas.Top="76" Width="520" x:Name="ResultText" Style="{StaticResource Body}" TextWrapping="Wrap"/>

        <Border Canvas.Left="0" Canvas.Top="112" Width="520" Height="300" CornerRadius="10"
                Background="{StaticResource Brush.Background.Primary}"
                BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
            <TextBox x:Name="LogTextBox" Margin="10" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                     Background="Transparent" BorderThickness="0"/>
        </Border>

        <Button Canvas.Left="440" Canvas.Top="426" Width="80" Content="CLOSE" Style="{StaticResource ButtonSecondary}"
                Padding="10,5" FontSize="11" Click="CloseButton_Click"/>
    </Canvas>
</Window>
