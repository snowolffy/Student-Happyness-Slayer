<UserControl x:Class="OnionProcOparetor.Console.AddEditWebsiteCatalogSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnionProcOparetor.UI.Controls;assembly=OnionProcOparetor.UI">
    <!-- UI-3b (2026-11-03): แปลงจาก Window เป็น UserControl - เรียกได้เฉพาะจาก
         WebsiteCatalogSourcesWindow (UI-3c ยังไม่ย้าย ยังเป็น Window ลอย owner=this ไม่มี DialogHost
         ของตัวเอง) ดู ShowViaHost ใน .xaml.cs: ตอนนี้ owner ไม่ใช่ MainWindow เลยเดินสาย fallback
         เปิดเป็น Window ลอยแบบเดิมเสมอ จนกว่า UI-3c จะย้าย owner นั้นเป็น UserControl -->
    <Border Style="{StaticResource Card}" Width="480">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="NAME" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,12"
                         ToolTip="ชื่อที่ตั้งเอง เช่น 'Fortnite Block List'"/>

                <TextBlock Text="SOURCE URL" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox x:Name="SourceUrlBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,12"
                         ToolTip="URL ของไฟล์ hosts-file หรือ domain list ทีละบรรทัด (raw text)"/>

                <TextBlock Text="MAX ENTRIES (เพดานจำนวนโดเมน)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox x:Name="MaxEntriesBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,12"
                         ToolTip="ถ้า list ที่ดึงมามีโดเมนเกินจำนวนนี้ จะไม่ import อะไรเลย (กันเผลอชี้ไป list ที่ใหญ่เกินจะใช้ได้จริง)"/>

                <CheckBox x:Name="IsEnabledCheckBox" Content="เปิดใช้งาน source นี้ (sync อัตโนมัติทุก 24 ชม.)"
                          Foreground="{DynamicResource Brush.Text.Primary}"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Grid>
            <Button Content="ยกเลิก" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Margin="0,0,96,0" Click="CancelButton_Click"/>
            <Button Content="บันทึก" Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Right" Click="SaveButton_Click" controls:DialogHost.IsDefaultButton="True"/>
        </Grid>
    </StackPanel>
    </Border>
</UserControl>
