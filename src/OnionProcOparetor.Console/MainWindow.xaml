<Window x:Class="OnionProcOparetor.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnionProcOparetor.UI.Controls;assembly=OnionProcOparetor.UI"
        Title="Onion ProcOparetor Console"
        Width="1000" Height="732"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- WP7 (2026-10-30) หน้าล็อกอินแบบใหม่ ตาม docs/roadmap.md หัวข้อ "Console (WPF): โครงใหม่":
         - เปิดเป็นหน้าต่างขนาด Console ปกติ (เท่า DashboardWindow's 1000x732) ไม่ใช่ dialog เล็ก 560x530
           แบบเดิม - "ไม่ใช่หน้าต่างเล็ก" ตามที่ roadmap สั่งไว้ตรงๆ
         - การ์ดลอยมีเงาตรงกลาง แบ่งสองฝั่ง: ซ้ายเป็นภาพ (HeroImage - โหลดจากไฟล์ข้างแอปก่อน ถ้าไม่มี
           fallback ไปใช้ภาพที่ฝังในตัว exe ดู MainWindow.xaml.cs LoadHeroImage) ขวาเป็นฟอร์มเดิมทุกอย่าง
         - พื้นหลังโรยจุดเรียงแบบตาราง (DotGridRectangle ด้านล่าง - DrawingBrush + TileMode="Tile")
         x:Name/event wiring ของฟอร์ม (ServerIpBox/PortBox/UsernameBox/PasswordBox/ConnectButton/
         StatusText/ServerIpBox_TextChanged/ConnectButton_Click) เหมือนเดิมทุกตัว - ไม่แตะ logic
         การเชื่อมต่อใน .cs เลย นอกจากเพิ่ม toast ตอนสำเร็จและโหลด HeroImage

         UI-2 (2026-11-03): MainWindow ตอนนี้เป็น "เปลือกหน้าต่างเดียว" ตลอดอายุโปรแกรม (ไม่ Close()
         ตัวเองอีกต่อไปตอน login สำเร็จ) - หน้าการ์ดล็อกอินเดิมทั้งหมดถูกครอบด้วย Grid ชื่อ "LoginRoot"
         เพิ่ม ContentControl "DashboardHost" (ว่างจนกว่าจะ login สำเร็จ, โชว์ DashboardWindow ที่เป็น
         UserControl แล้ว - ดู DashboardWindow.xaml) และ Grid ทับหน้า "LoadingOverlay" (ตัวหมุนสั้นๆ
         ตอน transition) ดู MainWindow.xaml.cs ShowDashboardAsync/ReturnToLoginAsync สำหรับลำดับ
         spinner -> fade -> resize หน้าต่างแบบนุ่มนวล -->
    <Grid>
        <!-- ==================== หน้าล็อกอิน (เดิมทั้งหมด) ==================== -->
        <Grid x:Name="LoginRoot">
            <!-- ==================== พื้นหลังจุดเรียงแบบตาราง ====================
                 DrawingBrush แบบ Tile คือวิธีมาตรฐานของ WPF สำหรับลายจุดซ้ำแบบนี้ - ปล่อยให้ WPF ปูกระเบื้อง
                 viewport 28x28 เต็มหน้าต่างเอง ไม่ต้องสร้าง Ellipse ทีละตัว ใช้สี Border.Default เดิม (จุดจาง
                 มาก ไม่แย่งความสนใจจากการ์ด) ผ่าน DynamicResource เพื่อให้ตามธีมสว่าง/มืดเองเหมือนทุกจุดในแอป -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <!-- Viewbox ต้องระบุเอง ไม่งั้น WPF ใช้ขอบของวงกลม (2.4px) เป็น Viewbox แล้วยืดให้เต็ม
                         Viewport ทั้งช่อง จุดจะใหญ่เท่าช่อง - ตรงกับ wireframe con-login: รัศมี 1.2px ห่าง 20px -->
                    <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute"
                                  Viewbox="0,0,20,20" ViewboxUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Brush>
                                    <SolidColorBrush Color="{DynamicResource Color.Border.Default}"/>
                                </GeometryDrawing.Brush>
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="10,10" RadiusX="1.2" RadiusY="1.2"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ==================== การ์ดล็อกอิน: สองฝั่ง ภาพ + ฟอร์ม ====================
                 UI-6 (2026-11-03): การ์ดเหลือ 75% ของเดิมทั้งกว้างและสูง (860x560 -> 645x420) ตามที่
                 roadmap สั่ง - ลดคอลัมน์ภาพ ระยะขอบ และช่องว่างระหว่างองค์ประกอบ (คูณ 0.75 ปัดเศษ) แต่
                 ไม่แตะขนาดตัวอักษร (Heading1/Body/Caption/Label สไตล์เดิมทั้งหมด) และไม่ใช้ Viewbox ย่อ
                 ทั้งก้อนตามที่สั่งห้ามไว้ -->
            <Border x:Name="LoginCard" Width="645" Height="420" CornerRadius="18"
                    Background="{DynamicResource Brush.Background.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.22" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="255"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ==================== ซ้าย: ภาพ ====================
                         Border.Clip แบบเดียวกับที่โลโก้ในแถบขวาใช้ (fixed pixel RectangleGeometry ตรงกับ
                         ขนาดจริงของคอลัมน์นี้ - UI-6: 255x420 ตามคอลัมน์ภาพที่ย่อลง 75%) ปัดมุมซ้ายให้เท่ากับ
                         มุมของการ์ดนอก (18) ส่วนมุมขวาของรูปเป็น 0 เพราะติดกับฝั่งฟอร์ม ไม่ใช่ขอบการ์ด -->
                    <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar.Background}">
                        <Border.Clip>
                            <RectangleGeometry RadiusX="18" RadiusY="18" Rect="0,0,255,420"/>
                        </Border.Clip>
                        <Image x:Name="HeroImage" Stretch="UniformToFill"/>
                    </Border>

                    <!-- ==================== ขวา: ฟอร์มเดิม (UI-6: ระยะขอบ/ช่องว่างย่อ 75%, ตัวอักษรเท่าเดิม) ====================
                         Margin บนล่างของ Grid นี้ (20) กันไม่ให้เนื้อหาเบียดขอบโค้งของการ์ดตอนเนื้อหาสูง
                         ใกล้เคียงความสูงการ์ด (พบจริงจากภาพตรวจ: โลโก้แถวบนชิดขอบการ์ดจนแทบล้น ก่อนเพิ่ม
                         margin นี้) - StackPanel ข้างในยังคง VerticalAlignment="Center" เหมือนเดิม -->
                    <Grid Grid.Column="1" Margin="36,16,36,16">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="36" Height="36" CornerRadius="6">
                                    <!-- ไม่มีพื้นสี่เหลี่ยมหลังโลโก้ (ผู้ใช้สั่ง 3 พ.ย. 2569)
                                         โลโก้เวกเตอร์ (WP UI-7c) - ขนาด 36px ให้สมดุลกับหัวข้อ (ผู้ใช้ 3 พ.ย.) จึงใช้รุ่น full (>32px ตาม
                                         assets/icons/README.md) แทน logo-source.png 256px ที่ย่อแล้วเบลอ -->
                                    <Image Source="{StaticResource Logo.App}" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Onion ProcOparetor" Style="{StaticResource Heading1}"/>
                                    <TextBlock Text="Server Console" Style="{StaticResource Caption}" Opacity="0.75"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="กรุณากรอก Server IP, Username และ Password เพื่อเชื่อมต่อ"
                                       Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SERVER IP" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="ServerIpBox" Style="{StaticResource RoundedTextBox}" TextChanged="ServerIpBox_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PORT" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="PortBox" Style="{StaticResource RoundedTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <!--
                                WP1b (2026-10-30): เลือกต่อ HTTP หรือ HTTPS - ค่าเริ่มต้นยังเป็น HTTP (unchecked)
                                ตามที่ roadmap ระบุไว้ว่าช่วงย้ายระบบต้องมีตัวเลือก "ยอมรับ HTTP เดิม" จนกว่าทั้ง
                                แล็บจะย้ายไป HTTPS จริง เลือก HTTPS ครั้งแรกกับ Server ที่ยังไม่รู้จัก cert จะเจอ
                                หน้าต่าง "ไว้ใจ certificate นี้" ก่อนต่อจริงได้ (ดู ConnectButton_Click)
                            -->
                            <CheckBox x:Name="UseHttpsCheckBox" Content="เชื่อมต่อด้วย HTTPS"
                                      Margin="0,0,0,6"/>

                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="USERNAME" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                                <TextBox x:Name="UsernameBox" Style="{StaticResource RoundedTextBox}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource RoundedPasswordBox}"/>
                            </StackPanel>

                            <Button x:Name="ConnectButton" Content="เชื่อมต่อ"
                                    Style="{StaticResource ButtonPrimary}" Padding="14,5" Click="ConnectButton_Click"/>

                            <!-- StatusText: MinHeight เผื่อพื้นที่ "ตลอดเวลา" (ไม่ว่าจะมีข้อความหรือไม่) ไว้
                                 สำหรับข้อความ error/สถานะยาวสุด 2 บรรทัด (เช่น exception ของ cert/network
                                 จริงที่ยาวกว่า "เชื่อมต่อไม่สำเร็จ: Username หรือ Password ไม่ถูกต้อง") - รอบ
                                 แก้ก่อนหน้าเผื่อพื้นที่แค่ตอนมีข้อความ (TextBlock ว่างสูงบรรทัดเดียว) ทำให้
                                 StackPanel ทั้งก้อน "โตขึ้น" ตอนข้อความยาวจนเกินงบที่เหลือ แล้วโดน Border
                                 (CornerRadius) clip บรรทัดสุดท้ายทิ้งเงียบๆ (ยืนยันจากภาพตรวจจริงของ
                                 orchestrator) MinHeight นี้ทำให้ความสูงของ StackPanel "คงที่" เสมอ ไม่ขยับ
                                 ตามเนื้อหา - วัดจริงด้วย TransformToAncestor ใน .xaml.cs (ดู
                                 LogLoginCardOverflowIfAny) ว่าไม่ล้นจริงทั้งตอนว่างและตอนมีข้อความยาว -->
                            <TextBlock x:Name="StatusText" Margin="0,5,0,0" MinHeight="30" VerticalAlignment="Top"
                                       TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== หน้าหลัก (DashboardWindow UserControl) ====================
             UI-2 (2026-11-03): ว่างเปล่า/Collapsed จนกว่า login สำเร็จ - ShowDashboardAsync สร้าง
             DashboardWindow ใหม่ทุกครั้งที่ login สำเร็จ (ตรงกับพฤติกรรมเดิมที่สร้าง DashboardWindow ใหม่
             ทุกครั้งตอน login) แล้วเซ็ตเป็น Content ที่นี่ -->
        <ContentControl x:Name="DashboardHost" Visibility="Collapsed" Opacity="0" Focusable="False"/>

        <!-- ==================== ตัวหมุนโหลด (spinner) ====================
             แสดงสั้นๆ ระหว่าง login เสร็จ -> เปิดหน้าหลัก (และตอนย้อนกลับ) ตามที่ roadmap WP UI-2 สั่ง
             ("แสดงตัวหมุนโหลดสั้นๆ แล้ว fade เข้าหน้าหลัก") - อยู่บนสุดของ Grid เสมอ (ประกาศหลังสุด) -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Opacity="0"
              Background="{DynamicResource Brush.Background.Primary}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Width="40" Height="40" Stretch="Fill"
                      Stroke="{DynamicResource Brush.Accent.Default}" StrokeThickness="4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 20,2 A 18,18 0 0 1 38,20">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" CenterX="20" CenterY="20"/>
                    </Path.RenderTransform>
                </Path>
                <TextBlock x:Name="LoadingOverlayText" Text="กำลังเข้าสู่ระบบ..." Style="{StaticResource Caption}"
                           Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ==================== UI-3a (2026-11-03): แผงสไลด์ขวา + dialog ลอย ====================
             ประกาศหลังสุดทั้งคู่ (z-order สูงสุด) - SidePanelHost ก่อน DialogHost เสมอ เพื่อให้ dialog
             ลอย (เช่น ยืนยันลบ ที่เปิดจากในแผงสไลด์ขวาของ UI-3c) ทับแผงสไลด์ได้ ไม่ใช่กลับกัน ดูลายแผน
             เต็มใน docs/architecture.md หัวข้อ "UI-3a: DialogHost/SidePanelHost" -->
        <controls:SidePanelHost x:Name="AppSidePanel"/>
        <controls:DialogHost x:Name="AppDialogHost"/>
    </Grid>
</Window>
