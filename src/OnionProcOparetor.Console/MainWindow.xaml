<Window x:Class="OnionProcOparetor.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onion ProcOparetor Console"
        Width="1000" Height="732"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- WP7 (2026-10-30) หน้าล็อกอินแบบใหม่ ตาม docs/roadmap.md หัวข้อ "Console (WPF): โครงใหม่":
         - เปิดเป็นหน้าต่างขนาด Console ปกติ (เท่า DashboardWindow's 1000x732) ไม่ใช่ dialog เล็ก 560x530
           แบบเดิม - "ไม่ใช่หน้าต่างเล็ก" ตามที่ roadmap สั่งไว้ตรงๆ
         - การ์ดลอยมีเงาตรงกลาง แบ่งสองฝั่ง: ซ้ายเป็นภาพ (HeroImage - โหลดจากไฟล์ข้างแอปก่อน ถ้าไม่มี
           fallback ไปใช้ภาพที่ฝังในตัว exe ดู MainWindow.xaml.cs LoadHeroImage) ขวาเป็นฟอร์มเดิมทุกอย่าง
         - พื้นหลังโรยจุดเรียงแบบตาราง (DotGridRectangle ด้านล่าง - DrawingBrush + TileMode="Tile")
         x:Name/event wiring ของฟอร์ม (ServerIpBox/PortBox/UsernameBox/PasswordBox/ConnectButton/
         StatusText/ServerIpBox_TextChanged/ConnectButton_Click) เหมือนเดิมทุกตัว - ไม่แตะ logic
         การเชื่อมต่อใน .cs เลย นอกจากเพิ่ม toast ตอนสำเร็จและโหลด HeroImage -->
    <Grid>
        <!-- ==================== พื้นหลังจุดเรียงแบบตาราง ====================
             DrawingBrush แบบ Tile คือวิธีมาตรฐานของ WPF สำหรับลายจุดซ้ำแบบนี้ - ปล่อยให้ WPF ปูกระเบื้อง
             viewport 28x28 เต็มหน้าต่างเอง ไม่ต้องสร้าง Ellipse ทีละตัว ใช้สี Border.Default เดิม (จุดจาง
             มาก ไม่แย่งความสนใจจากการ์ด) ผ่าน DynamicResource เพื่อให้ตามธีมสว่าง/มืดเองเหมือนทุกจุดในแอป -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <SolidColorBrush Color="{DynamicResource Color.Border.Default}"/>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="2,2" RadiusX="1.4" RadiusY="1.4"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ==================== การ์ดล็อกอิน: สองฝั่ง ภาพ + ฟอร์ม ==================== -->
        <Border Width="860" Height="560" CornerRadius="18"
                Background="{DynamicResource Brush.Background.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.22" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== ซ้าย: ภาพ ====================
                     Border.Clip แบบเดียวกับที่โลโก้ในแถบขวาใช้ (fixed pixel RectangleGeometry ตรงกับ
                     ขนาดจริงของคอลัมน์นี้ - 340x560) ปัดมุมซ้ายให้เท่ากับมุมของการ์ดนอก (18) ส่วนมุมขวา
                     ของรูปเป็น 0 เพราะติดกับฝั่งฟอร์ม ไม่ใช่ขอบการ์ด -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar.Background}">
                    <Border.Clip>
                        <RectangleGeometry RadiusX="18" RadiusY="18" Rect="0,0,340,560"/>
                    </Border.Clip>
                    <Image x:Name="HeroImage" Stretch="UniformToFill"/>
                </Border>

                <!-- ==================== ขวา: ฟอร์มเดิม ==================== -->
                <Grid Grid.Column="1" Margin="48,0,48,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.Accent.Dark}">
                                <Border.Clip>
                                    <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,40,40"/>
                                </Border.Clip>
                                <Image Source="/Theme/logo-source.png" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Onion ProcOparetor" Style="{StaticResource Heading1}"/>
                                <TextBlock Text="Server Console" Style="{StaticResource Caption}" Opacity="0.75"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="กรุณากรอก Server IP, Username และ Password เพื่อเชื่อมต่อ"
                                   Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SERVER IP" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <TextBox x:Name="ServerIpBox" Style="{StaticResource RoundedTextBox}" TextChanged="ServerIpBox_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PORT" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <TextBox x:Name="PortBox" Style="{StaticResource RoundedTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!--
                            WP1b (2026-10-30): เลือกต่อ HTTP หรือ HTTPS - ค่าเริ่มต้นยังเป็น HTTP (unchecked)
                            ตามที่ roadmap ระบุไว้ว่าช่วงย้ายระบบต้องมีตัวเลือก "ยอมรับ HTTP เดิม" จนกว่าทั้ง
                            แล็บจะย้ายไป HTTPS จริง เลือก HTTPS ครั้งแรกกับ Server ที่ยังไม่รู้จัก cert จะเจอ
                            หน้าต่าง "ไว้ใจ certificate นี้" ก่อนต่อจริงได้ (ดู ConnectButton_Click)
                        -->
                        <CheckBox x:Name="UseHttpsCheckBox" Content="เชื่อมต่อด้วย HTTPS"
                                  Margin="0,0,0,16"/>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="USERNAME" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <TextBox x:Name="UsernameBox" Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource RoundedPasswordBox}"/>
                        </StackPanel>

                        <Button x:Name="ConnectButton" Content="เชื่อมต่อ"
                                Style="{StaticResource ButtonPrimary}" Click="ConnectButton_Click"/>

                        <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
