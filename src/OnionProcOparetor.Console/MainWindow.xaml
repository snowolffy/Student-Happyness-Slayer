<Window x:Class="OnionProcOparetor.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onion ProcOparetor Console"
        Height="365" Width="558"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppWindowStyle}"
        Background="{StaticResource Brush.Background.Primary}">
    <!--
        Grid layout with every element positioned via Margin="Left,Top,0,0" + HorizontalAlignment
        ="Left" VerticalAlignment="Top" - a direct stand-in for the old Canvas.Left/Canvas.Top
        values, since nothing here needs to reflow (ResizeMode stays NoResize). The card Border's
        Padding is 9 instead of the original 24 - the old inner Canvas used to counteract that 24
        with a Margin="-15,-15,-15,-15" hack (24-15=9), so reducing Padding up front gets the same
        absolute positions without any negative margin anywhere.
    -->
    <Grid Margin="0,0,0,1">
        <!-- ==================== Logo + title ==================== -->
        <Rectangle Height="67" Width="558" Fill="{StaticResource Brush.Accent.Default}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Border Width="48" Height="48" CornerRadius="12"
                Background="{StaticResource Brush.Accent.Default}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0">
            <Border.Clip>
                <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,48,48"/>
            </Border.Clip>
            <Image Source="/Theme/logo.png" Stretch="UniformToFill"/>
        </Border>
        <TextBlock Width="250" Text="Onion ProcOparetor" Style="{StaticResource Heading1}" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" Margin="65,13,0,0"/>
        <TextBlock Width="150" Text="Server Console" Style="{StaticResource Caption}" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" Margin="65,39,0,0"/>

        <!-- ==================== Connect form ==================== -->
        <Border Width="536" Height="248" CornerRadius="12"
                Background="{StaticResource Brush.Background.Card}"
                BorderBrush="{StaticResource Brush.Border.Default}"
                BorderThickness="1" Padding="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,75,0,0">
            <Grid>
                <TextBlock Width="516"
                           Text="Please enter your Server IP, Username and Password to connect"
                           Style="{StaticResource Body}" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0"/>

                <!-- Height="34" is an instance-level override, not a Padding change - RoundedTextBox's
                     Padding="10,5" (Theme/Controls.xaml) stays untouched everywhere else. 28px was
                     tried first and clipped text badly (confirmed live); 34px matches the box height
                     already proven to work with this same Padding elsewhere (Settings/Dashboard). -->
                <TextBlock Text="SERVER IP" Style="{StaticResource Label}" HorizontalAlignment="Left" Height="15" VerticalAlignment="Top" Margin="10,22,0,0"/>
                <TextBox Width="367" x:Name="ServerIpBox" Style="{StaticResource RoundedTextBox}" HorizontalAlignment="Left" Height="34" VerticalAlignment="Top" Margin="10,39,0,0" TextChanged="ServerIpBox_TextChanged"/>

                <TextBlock Text="PORT" Style="{StaticResource Label}" HorizontalAlignment="Left" Height="15" VerticalAlignment="Top" Margin="389,22,0,0"/>
                <TextBox Width="116" x:Name="PortBox" Style="{StaticResource RoundedTextBox}" HorizontalAlignment="Left" Height="34" VerticalAlignment="Top" Margin="388,39,0,0"/>

                <TextBlock Text="USERNAME" Style="{StaticResource Label}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,75,0,0"/>
                <TextBox Width="494" x:Name="UsernameBox" Style="{StaticResource RoundedTextBox}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="34" Margin="10,90,0,0"/>

                <TextBlock Text="PASSWORD" Style="{StaticResource Label}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,126,0,0"/>
                <PasswordBox Width="494" x:Name="PasswordBox" Style="{StaticResource RoundedPasswordBox}" HorizontalAlignment="Left" Height="34" VerticalAlignment="Top" Margin="10,141,0,0"/>

                <Button Width="344" x:Name="ConnectButton" Content="CONNECT"
                        Style="{StaticResource ButtonPrimary}"
                        Click="ConnectButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="85,178,0,0"/>

                <TextBlock Width="344" x:Name="StatusText"
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" Height="16" Margin="86,216,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
