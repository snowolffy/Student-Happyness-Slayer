<Window x:Class="OnionProcOparetor.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onion ProcOparetor Console"
        Width="560" Height="530"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- Rebuilt 2026-09-03 (Fluent-adoption redesign) - Button/TextBox/PasswordBox now render through
         Fluent's own templates (see Theme/Controls.xaml). Replaced the old absolute
         Margin="Left,Top,0,0" positioning (a Canvas-in-disguise left over from the original
         Canvas->Grid port) with real Grid rows/columns and StackPanel-driven vertical stacking, so
         nothing here is pinned to a magic pixel offset. x:Name/event wiring is unchanged from before -
         MainWindow.xaml.cs was not touched. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== Header ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Accent.Default}" Padding="20,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource Brush.Accent.Dark}">
                    <Border.Clip>
                        <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,48,48"/>
                    </Border.Clip>
                    <Image Source="/Theme/logo-source.png" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Onion ProcOparetor" Style="{StaticResource Heading1}" Foreground="White"/>
                    <TextBlock Text="Server Console" Style="{StaticResource Caption}" Foreground="White" Opacity="0.85"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== Connect form ==================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Please enter your Server IP, Username and Password to connect"
                           Style="{StaticResource Body}" TextWrapping="Wrap"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SERVER IP" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <TextBox x:Name="ServerIpBox" Style="{StaticResource RoundedTextBox}" TextChanged="ServerIpBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PORT" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <TextBox x:Name="PortBox" Style="{StaticResource RoundedTextBox}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="USERNAME" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBox x:Name="UsernameBox" Style="{StaticResource RoundedTextBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="6">
                    <TextBlock Text="PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource RoundedPasswordBox}"/>
                </StackPanel>

                <Button Grid.Row="8" x:Name="ConnectButton" Content="เชื่อมต่อ"
                        Style="{StaticResource ButtonPrimary}" Click="ConnectButton_Click"/>

                <TextBlock Grid.Row="10" x:Name="StatusText" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
