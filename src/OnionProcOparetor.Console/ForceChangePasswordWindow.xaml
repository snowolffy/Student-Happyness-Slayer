<Window x:Class="OnionProcOparetor.Console.ForceChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onion ProcOparetor Console - เปลี่ยน Password"
        Height="440" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppWindowStyle}">
    <!-- Grid layout with fixed-pixel RowDefinitions matching the old Canvas.Top deltas - see SettingsWindow.xaml for the same pattern. -->
    <Grid>
        <Border Width="372" Height="360" Style="{StaticResource Card}" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,40,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="29"/>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="59"/>
                    <RowDefinition Height="17"/>
                    <RowDefinition Height="51"/>
                    <RowDefinition Height="29"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Width="324" Text="ต้องเปลี่ยน Password"
                           Style="{StaticResource Heading2}" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBlock Grid.Row="1" Width="324"
                           Text="บัญชี Administrator ยังใช้ password ว่างเปล่าอยู่ กรุณาตั้ง password ใหม่ก่อนใช้งานต่อ"
                           Style="{StaticResource Body}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <TextBlock Grid.Row="2" Text="NEW PASSWORD" Style="{StaticResource Label}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <PasswordBox Grid.Row="3" Width="324" x:Name="NewPasswordBox" Style="{StaticResource RoundedPasswordBox}" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <TextBlock Grid.Row="4" Text="CONFIRM NEW PASSWORD" Style="{StaticResource Label}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <PasswordBox Grid.Row="5" Width="324" x:Name="ConfirmPasswordBox" Style="{StaticResource RoundedPasswordBox}" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <TextBlock Grid.Row="6" Width="324" Text="ต้องมีความยาวอย่างน้อย 8 ตัวอักษร"
                           Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button Grid.Row="7" Width="324" x:Name="ChangePasswordButton" Content="CHANGE PASSWORD"
                        Style="{StaticResource ButtonPrimary}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Click="ChangePasswordButton_Click"/>

                <TextBlock Grid.Row="8" Width="324" x:Name="StatusText" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid>
        </Border>
    </Grid>
</Window>
