<UserControl x:Class="OnionProcOparetor.Console.ForceChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnionProcOparetor.UI.Controls;assembly=OnionProcOparetor.UI">
    <!-- UI-3a (2026-11-03): แปลงจาก Window ของตัวเอง (ShowDialog แยกหน้าต่าง) เป็น UserControl ที่ฝัง
         เข้า DialogHost ของ MainWindow แทน (ดู MainWindow.xaml.cs ConnectButton_Click) - logic ภายใน
         (ChangePasswordButton_Click, validation, StatusText) เหมือนเดิมทุกอย่าง เปลี่ยนแค่วิธีรายงานผล
         กลับ: จาก Window.DialogResult+Close() เป็น event ResultChosen (ดู .xaml.cs) ให้ caller (ไม่ว่า
         จะเป็น DialogHost หรือโค้ดอื่นในอนาคต) เป็นคนตัดสินใจว่าจะปิดยังไง - ตัวอย่างแปลงไว้ให้ UI-3b/3c
         ทำตามรูปแบบนี้ได้ทันที: Window เดิม -> UserControl + Border Style="Card" ของตัวเอง (เพราะ
         DialogHost ไม่วาด chrome ให้) + event ผลลัพธ์ของตัวเอง แทนการพึ่ง DialogResult -->
    <Border Style="{StaticResource Card}" Width="420">
        <StackPanel>
            <TextBlock Text="ต้องเปลี่ยน Password" Style="{StaticResource Heading2}" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="บัญชี Administrator ยังใช้ password ว่างเปล่าอยู่ กรุณาตั้ง password ใหม่ก่อนใช้งานต่อ"
                       Style="{StaticResource Body}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="NEW PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,16"/>

            <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,8"/>

            <TextBlock Text="ต้องมีความยาวอย่างน้อย 8 ตัวอักษร" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,0,0,16"/>

            <!-- UI-3a: ติด DialogHost.IsDefaultButton เพื่อให้กด Enter ในหน้านี้ = กดปุ่มนี้แทน -->
            <Button x:Name="ChangePasswordButton" Content="เปลี่ยนรหัสผ่าน" Style="{StaticResource ButtonPrimary}"
                    Click="ChangePasswordButton_Click" controls:DialogHost.IsDefaultButton="True"/>

            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
