<Window x:Class="OnionProcOparetor.Console.ForceChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onion ProcOparetor Console - เปลี่ยน Password"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- Rebuilt 2026-09-03 - SizeToContent="Height" replaces the old fixed Height="440" + hand-tuned
         pixel RowDefinitions (which didn't account for the OS title bar - the same class of bug this
         redesign already found and fixed once in MainWindow.xaml). CenterScreen doesn't have the
         SizeToContent+CenterOwner drift issue the Manual-positioned dialogs in this app have, so no
         WindowCenteringHelper needed here. -->
    <Border Style="{StaticResource Card}" Margin="24">
        <StackPanel>
            <TextBlock Text="ต้องเปลี่ยน Password" Style="{StaticResource Heading2}" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="บัญชี Administrator ยังใช้ password ว่างเปล่าอยู่ กรุณาตั้ง password ใหม่ก่อนใช้งานต่อ"
                       Style="{StaticResource Body}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="NEW PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,16"/>

            <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,8"/>

            <TextBlock Text="ต้องมีความยาวอย่างน้อย 8 ตัวอักษร" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,0,0,16"/>

            <Button x:Name="ChangePasswordButton" Content="CHANGE PASSWORD" Style="{StaticResource ButtonPrimary}" Click="ChangePasswordButton_Click"/>

            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</Window>
