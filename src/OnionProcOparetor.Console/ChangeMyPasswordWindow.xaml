<UserControl x:Class="OnionProcOparetor.Console.ChangeMyPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnionProcOparetor.UI.Controls;assembly=OnionProcOparetor.UI">
    <!-- UI-3b (2026-11-03): แปลงจาก Window เป็น UserControl ฝังใน DialogHost ของ MainWindow - Border
         Style="Card" ด้านล่างเป็น chrome ของ dialog เองอยู่แล้วตั้งแต่ก่อน UI-3b (ไม่ต้องเพิ่มเลเยอร์ใหม่) -->
    <Border Style="{StaticResource Card}" Width="420" Margin="24">
        <StackPanel>
            <TextBlock Text="เปลี่ยน Password ของฉัน" Style="{StaticResource Heading2}" TextAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="NEW PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,16"/>

            <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,8"/>

            <TextBlock Text="ต้องมีความยาวอย่างน้อย 8 ตัวอักษร" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,0,0,16"/>

            <Grid>
                <Button Content="ยกเลิก" Style="{StaticResource ButtonSecondary}"
                        Padding="10,5" FontSize="11" HorizontalAlignment="Left" Click="CancelButton_Click"/>
                <Button x:Name="ChangePasswordButton" Content="เปลี่ยนรหัสผ่าน"
                        Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Right" Click="ChangePasswordButton_Click"
                        controls:DialogHost.IsDefaultButton="True"/>
            </Grid>

            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
