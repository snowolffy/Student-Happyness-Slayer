<Window x:Class="OnionProcOparetor.Console.ChangeMyPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onion ProcOparetor Console - เปลี่ยน Password"
        Height="400" Width="420"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppWindowStyle}">
    <!-- โมเดลตาม ForceChangePasswordWindow.xaml (UI/ช่องกรอกเหมือนกันทุกอย่าง ใช้ API endpoint เดียวกัน
         ผ่าน ApiClient.ChangePasswordAsync ที่มีอยู่แล้ว) - ต่างกันแค่ตรง flow ตอนสำเร็จ: ตัวนี้เป็น
         voluntary (เปิดจาก SettingsWindow ตอนไหนก็ได้ ไม่ใช่แค่ตอน login ครั้งแรก) ปิดตัวเองเป็น dialog
         ธรรมดา (DialogResult=true) แทนที่จะเปิด DashboardWindow ใหม่ซ้อนขึ้นมา เพราะผู้เรียกอยู่ใน
         Dashboard อยู่แล้ว - WindowStartupLocation="Manual" + WindowCenteringHelper ด้วยเหตุผลเดียวกับ
         หน้าต่างอื่นๆ ในโปรเจกต์นี้ที่ไม่ใช้ SizeToContent -->
    <Grid>
        <Border Width="372" Height="320" Style="{StaticResource Card}" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,20,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="29"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="59"/>
                    <RowDefinition Height="17"/>
                    <RowDefinition Height="51"/>
                    <RowDefinition Height="29"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Width="324" Text="เปลี่ยน Password ของฉัน"
                           Style="{StaticResource Heading2}" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <TextBlock Grid.Row="1" Text="NEW PASSWORD" Style="{StaticResource Label}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <PasswordBox Grid.Row="2" Width="324" x:Name="NewPasswordBox" Style="{StaticResource RoundedPasswordBox}" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <TextBlock Grid.Row="3" Text="CONFIRM NEW PASSWORD" Style="{StaticResource Label}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <PasswordBox Grid.Row="4" Width="324" x:Name="ConfirmPasswordBox" Style="{StaticResource RoundedPasswordBox}" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <TextBlock Grid.Row="5" Width="324" Text="ต้องมีความยาวอย่างน้อย 8 ตัวอักษร"
                           Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Grid Grid.Row="6" Width="324">
                    <Button Content="CANCEL" Style="{StaticResource ButtonSecondary}" Width="100"
                            Padding="10,5" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Top" Click="CancelButton_Click"/>
                    <Button x:Name="ChangePasswordButton" Content="CHANGE PASSWORD" Width="200"
                            Style="{StaticResource ButtonPrimary}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="ChangePasswordButton_Click"/>
                </Grid>

                <TextBlock Grid.Row="7" Width="324" x:Name="StatusText" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
