<Window x:Class="OnionProcOparetor.Console.ChangeMyPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onion ProcOparetor Console - เปลี่ยน Password"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- Rebuilt 2026-09-03 - SizeToContent="Height" replaces the old fixed Height="400" + hand-tuned
         pixel RowDefinitions, same reasoning as ForceChangePasswordWindow. WindowStartupLocation
         stays Manual + WindowCenteringHelper (code-behind) since this one is opened via ShowDialog
         with an Owner, unlike ForceChangePasswordWindow. -->
    <Border Style="{StaticResource Card}" Margin="24">
        <StackPanel>
            <TextBlock Text="เปลี่ยน Password ของฉัน" Style="{StaticResource Heading2}" TextAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="NEW PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,16"/>

            <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,8"/>

            <TextBlock Text="ต้องมีความยาวอย่างน้อย 8 ตัวอักษร" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,0,0,16"/>

            <Grid>
                <Button Content="CANCEL" Style="{StaticResource ButtonSecondary}"
                        Padding="10,5" FontSize="11" HorizontalAlignment="Left" Click="CancelButton_Click"/>
                <Button x:Name="ChangePasswordButton" Content="CHANGE PASSWORD"
                        Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Right" Click="ChangePasswordButton_Click"/>
            </Grid>

            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</Window>
