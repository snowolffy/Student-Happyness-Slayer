<Window x:Class="OnionProcOparetor.Console.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password"
        Height="280" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppWindowStyle}">
    <!--
        Grid layout with fixed-pixel RowDefinitions matching the old Canvas.Top deltas - see
        SettingsWindow.xaml for the same pattern. NOTE: TitleText and the card Border share Row 0
        on purpose - in the original Canvas, the Border had no Canvas.Top set (defaulted to 0),
        same as TitleText, so the two already overlapped and TitleText rendered invisibly behind
        the card (confirmed via screenshot before this conversion). Row 0 is sized to the card's
        own height (not 0) so the card still renders at full size; StatusText/buttons keep their
        original absolute positions since those are the actually-visible parts.
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="167"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Style="{StaticResource Heading2}" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Border Grid.Row="0" Width="380" Height="167" CornerRadius="10" Padding="14"
                Background="{StaticResource Brush.Background.Primary}"
                BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="41"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="NEW PASSWORD" Style="{StaticResource Label}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBlock Grid.Row="1" Width="324" Text="At least 8 characters."
                           Style="{StaticResource Caption}" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <PasswordBox Grid.Row="2" Width="250" x:Name="NewPasswordBox"
                             Style="{StaticResource RoundedPasswordBox}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Width="380" x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Grid Grid.Row="2">
            <Button Content="RESET" Style="{StaticResource ButtonPrimary}" Width="70"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="300,0,0,0" Click="ResetButton_Click"/>
            <Button Content="CANCEL" Style="{StaticResource ButtonSecondary}" Width="80"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Left" Height="35" VerticalAlignment="Top" Margin="215,0,0,0" Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
