<Window x:Class="OnionProcOparetor.Console.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppWindowStyle}">
    <!--
        WindowStartupLocation="Manual" + WindowCenteringHelper (ดู code-behind): CenterOwner คำนวณ
        ตำแหน่งผิดเมื่อใช้ร่วมกับ SizeToContent (หน้าต่างเลื่อนไปทางขวา/ล่างจากจุดกึ่งกลางจริง) เลย
        คำนวณเองใน Loaded event แทนที่ตอนขนาดจริง resolve เสร็จแล้ว

        Grid layout with fixed-pixel RowDefinitions matching the old Canvas.Top deltas - see
        SettingsWindow.xaml for the same pattern. NOTE: TitleText and the card Border share Row 0
        on purpose - in the original Canvas, the Border had no Canvas.Top set (defaulted to 0),
        same as TitleText, so the two already overlapped and TitleText rendered invisibly behind
        the card (confirmed via screenshot before this conversion). Row 0 is sized to the card's
        own height (not 0) so the card still renders at full size; StatusText/buttons keep their
        original absolute positions since those are the actually-visible parts.

        Row 1 (StatusText) is "Auto" rather than the original 12px Canvas delta: StatusText holds
        a real validation message at runtime ("Password ต้องมีความยาวอย่างน้อย 8 ตัวอักษร") which
        needs more than 12px even on one line - WPF doesn't clip Grid children to their row bounds,
        so the fixed 12px just let the text visually bleed into the button row below it instead of
        actually being constrained. Auto measures the real text height so it can't happen again.

        Row 2 (RESET/CANCEL) is "Auto" and the Window uses SizeToContent="Height" rather than a
        hand-computed fixed Height: the old fixed Height="280" didn't account for the OS title bar's
        actual height, so this "*" row got squeezed down to almost nothing and RESET rendered mostly
        below the visible window (confirmed via screenshot - RESET wasn't visible at all, same failure
        as ActionPanelWindow.xaml's CLOSE button). Letting WPF measure removes the guesswork.
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="167"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Style="{StaticResource Heading2}" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Border Height="167" CornerRadius="10" Padding="14"
                Background="{StaticResource Brush.Background.Primary}"
                BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="41"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="NEW PASSWORD" Style="{StaticResource Label}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <TextBlock Grid.Row="1" Width="324" Text="At least 8 characters."
                           Style="{StaticResource Caption}" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <PasswordBox Grid.Row="2" Width="250" x:Name="NewPasswordBox"
                             Style="{StaticResource RoundedPasswordBox}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Width="380" x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Button Content="RESET" Style="{StaticResource ButtonPrimary}" Click="ResetButton_Click" Margin="310,0,0,0"/>
            <Button Content="CANCEL" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" Margin="215,0,85,0" Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
