<Window x:Class="OnionProcOparetor.Console.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- Rebuilt 2026-09-03 - StackPanel replaces the old shared-row Canvas-carryover hack (TitleText
         and the card Border no longer need to overlap in the same Grid row - that workaround is gone
         entirely now that this is a real vertical stack). WindowCenteringHelper still runs
         post-Loaded for the same SizeToContent/CenterOwner reason as before. -->
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="NEW PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBlock Text="At least 8 characters." Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource RoundedPasswordBox}"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <Grid Margin="0,16,0,0">
            <Button Content="CANCEL" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Margin="0,0,96,0" Click="CancelButton_Click"/>
            <Button Content="RESET" Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Right" Click="ResetButton_Click"/>
        </Grid>
    </StackPanel>
</Window>
