<UserControl x:Class="OnionProcOparetor.Console.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnionProcOparetor.UI.Controls;assembly=OnionProcOparetor.UI">
    <!-- UI-3b (2026-11-03): แปลงจาก Window เป็น UserControl ฝังใน DialogHost ของ MainWindow -->
    <Border Style="{StaticResource Card}" Width="420">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="NEW PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBlock Text="At least 8 characters." Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource RoundedPasswordBox}"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <Grid Margin="0,16,0,0">
            <Button Content="ยกเลิก" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Margin="0,0,96,0" Click="CancelButton_Click"/>
            <Button Content="ตั้งรหัสผ่านใหม่" Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Right" Click="ResetButton_Click" controls:DialogHost.IsDefaultButton="True"/>
        </Grid>
    </StackPanel>
    </Border>
</UserControl>
