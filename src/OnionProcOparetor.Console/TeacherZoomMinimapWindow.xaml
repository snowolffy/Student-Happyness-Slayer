<Window x:Class="OnionProcOparetor.Console.TeacherZoomMinimapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="แผนที่ซูม (ครู)"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Background="#1E1E1E"
        Icon="/Theme/icon.ico">
    <!-- UI-9 (2026-11-04) - "หน้าต่างแผนที่เล็กแสดงส่วนของจอที่ซูมอยู่ ลากกรอบในแผนที่เพื่อย้ายตำแหน่งได้"
         (ตัดสินแล้วใน roadmap UI-9) แสดงภาพย่อของจอทั้งจอ (capture รอบๆ ~400ms แยกจากเฟรมที่ส่งจริง - ดู
         code-behind) ทับด้วยกรอบแดงบอกตำแหน่ง/ขนาดพื้นที่ที่กำลังซูมอยู่ (จาก ScreenCaptureService.LastCropRegion)
         ลากภายในกรอบ (MapGrid) เพื่อปักหมุดตำแหน่งซูมใหม่ (SetManualPanCenter) - ลากที่แถบหัวด้านบนเพื่อย้าย
         ตำแหน่งตัวหน้าต่างเอง (แยกจากการลากปักหมุด)

         เป็นหน้าต่าง "ครูเห็นอย่างเดียว" เหมือนกรอบแดง/แถบสถานะ/กล่องเครื่องมือ จึงต้อง
         SetWindowDisplayAffinity(WDA_EXCLUDEFROMCAPTURE) เสมอ (ดู TeacherOnlyWindowHelper) - ผลพลอยได้ที่ดี:
         ภาพย่อที่ capture ด้วย BitBlt ตัวเดียวกันก็จะไม่เห็นกรอบแดง/แถบ/กล่องเครื่องมือของตัวเองเช่นกัน
         (ตรงกับภาพจริงที่นักเรียนเห็นพอดี เพราะใช้กลไกจับภาพเดียวกัน) -->
    <Border Background="#1E1E1E" CornerRadius="10" Padding="8">
        <StackPanel>
            <TextBlock x:Name="DragHandle" Text="แผนที่จอ - ลากในกรอบเพื่อย้ายตำแหน่งซูม" Foreground="#BBBBBB"
                       FontSize="11" Margin="2,0,2,6" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                       Cursor="SizeAll"/>
            <Grid x:Name="MapGrid" Width="220" Height="124" Background="#000000"
                  MouseLeftButtonDown="MapGrid_MouseLeftButtonDown" MouseMove="MapGrid_MouseMove"
                  MouseLeftButtonUp="MapGrid_MouseLeftButtonUp" Cursor="Cross" ClipToBounds="True">
                <Image x:Name="MapImage" Stretch="Fill"/>
                <Canvas x:Name="OverlayCanvas">
                    <Rectangle x:Name="CropRect" Stroke="#E53935" StrokeThickness="2" Fill="#33E53935"
                               Visibility="Collapsed" IsHitTestVisible="False"/>
                </Canvas>
            </Grid>
        </StackPanel>
    </Border>
</Window>
