<Window x:Class="OnionProcOparetor.Console.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Height="400" Width="384"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- Grid layout with fixed-pixel RowDefinitions matching the old Canvas.Top deltas - see
         ClientSettingsWindow.xaml/SettingsWindow.xaml for the same pattern. Old Canvas hand-centered
         the logo/button via Canvas.Left math (148 = (344-48)/2, 127 = (344-90)/2) tuned by eye in the
         Designer at one specific DPI/font metrics - HorizontalAlignment="Center" here does the same
         centering but recalculates it for real at layout time, so it can't drift out of position. -->
    <Grid Margin="19,20,21,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== Logo mark (WP UI-7c, 2026-11-03: vector DrawingImage "full" from
             app.svg instead of the pre-downscaled logo-source.png 256px PNG - this is the one place
             the mark gets shown at meaningfully larger badge sizes, 48px) ==================== -->
        <Border Grid.Row="0" Width="48" Height="48" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Top">
            <!-- ไม่มีพื้นสี่เหลี่ยมหลังโลโก้ (ผู้ใช้สั่ง 3 พ.ย. 2569) -->
            <Image Source="{StaticResource Logo.App}" Stretch="Uniform"/>
        </Border>

        <!-- ==================== Name / tagline ==================== -->
        <TextBlock Grid.Row="1" Width="344" Text="Onion ProcOparetor" VerticalAlignment="Top"
                    Style="{StaticResource Heading1}" TextAlignment="Center"/>
        <TextBlock Grid.Row="2" Width="344" Text="We peel, We See, We Oparete" VerticalAlignment="Top"
                    FontFamily="{StaticResource FontFamily.Primary}" FontStyle="Italic" FontWeight="Light"
                    FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" TextAlignment="Center"/>
        <TextBlock Grid.Row="3" Width="344" Text="by OnionProcOparetor" VerticalAlignment="Top"
                    Style="{StaticResource Caption}" TextAlignment="Center"/>

        <Border Grid.Row="4" Width="344" Height="1" VerticalAlignment="Top" Background="{DynamicResource Brush.Border.Default}"/>

        <!-- ==================== Version / build / copyright ==================== -->
        <TextBlock Grid.Row="5" Width="344" x:Name="VersionText" VerticalAlignment="Top"
                    Style="{StaticResource Body}" TextAlignment="Center"/>
        <TextBlock Grid.Row="6" Width="344" x:Name="BuildText" VerticalAlignment="Top"
                    Style="{StaticResource Caption}" TextAlignment="Center"/>
        <TextBlock Grid.Row="7" Width="344" VerticalAlignment="Top"
                    Text="© 2026 OnionProcOparetor. All rights reserved."
                    Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap"/>

        <Button Grid.Row="8" Width="90" Content="ปิด" Style="{StaticResource ButtonSecondary}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Click="CloseButton_Click"/>
    </Grid>
</Window>
