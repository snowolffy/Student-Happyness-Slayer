<UserControl x:Class="OnionProcOparetor.Console.WebsiteControlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OnionProcOparetor.Console">
    <!-- Website Control เป็นหน้าใน shell (WP6, 2026-10-30) - เดิมเป็นหน้าต่างลอย WebsiteControlWindow
         ยังแยกจากหน้า "กฎโปรแกรม" ตามที่ตั้งใจไว้ตั้งแต่ 2026-09-11 (ไม่ให้กฎบล็อกโปรแกรมกับกฎบล็อกเว็บ
         ปนกันจนงง) และใช้ global enforcement ตัวเดียวกับ Program Control (ประกาศบนแถบหัวของ shell)

         WP2-1 (2026-10-31): แตกเป็น 4 แท็บตามที่ C1 ตัดสินไว้ (docs/roadmap.md "งานแทรกหลังขั้น 1: C1")
         ดู wireframe con-website.dc.html - บล็อกเว็บ(ของเดิม ย้ายไป WebsiteBlockTab.xaml) / ชุด
         Allow-list (ว่าง รอ WP2-2) / ป้องกันการเลี่ยง (ของจริง WP2-1 - WebsiteAntiEvasionTab.xaml) /
         ประวัติเว็บ (ว่าง รอ WP2-4) แต่ละแท็บเป็น UserControl แยกไฟล์ตั้งใจ เพื่อให้ WP ถัดไปแก้แค่ไฟล์
         ของแท็บตัวเอง ไม่ต้องแตะไฟล์นี้เลย (ยกเว้นถ้าอยาก rename/ย้ายลำดับแท็บ)

         ใช้ TabControl ตัวที่สอง (ซ้อนอยู่ใน TabItem "Website Control" ของ MainTabControl ใน
         DashboardWindow.xaml) กับ UnderlineTabItem ที่มีอยู่แล้วใน Theme/Controls.xaml (เดิมประกาศไว้
         แต่ไม่มีใครใช้ - ชื่อบอกอยู่แล้วว่าออกแบบไว้สำหรับ "TabControl nav" แบบนี้พอดี) ไม่ต้องสร้าง
         style ใหม่ Template ด้านล่างทำแค่ตัดกรอบ Fluent theme เริ่มต้นออก + ขีดเส้นใต้แถบแท็บบาง ๆ
         ตาม .tabs{border-bottom} ของ wireframe -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Website Control" Style="{StaticResource Heading2}" VerticalAlignment="Center"/>
            <TextBlock Text="Chrome + Edge" Style="{StaticResource Caption}" Margin="10,4,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="InnerTabControl" Background="Transparent" BorderThickness="0"
                    ItemContainerStyle="{StaticResource UnderlineTabItem}" Margin="0,12,0,0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1.5">
                            <!-- StackPanel แทน TabPanel ตั้งใจ (บั๊กจริงที่เจอตอนถ่ายภาพทดสอบ): TabPanel
                                 วัดความกว้างแต่ละ TabItem แบบจำกัด (ออกแบบมาให้ "ขึ้นบรรทัดใหม่" ได้เมื่อแท็บ
                                 เยอะ) ทำให้หัวข้อแท็บภาษาไทยที่มีจุดตัดคำ (เช่น "บล็อกเว็บ", "ประวัติเว็บ")
                                 ถูกตัดคำท้ายไปอยู่ "บรรทัดที่ 2" ที่มองไม่เห็น (StackPanel แนวตั้งของ
                                 UnderlineTabItem เผื่อพื้นที่สูงไว้แค่บรรทัดเดียว) ส่วนหัวข้อที่ไม่มีจุดตัดคำ
                                 ("ป้องกันการเลี่ยง") ไม่โดนเพราะล้นแนวนอนแทนที่จะตัดบรรทัด - StackPanel แนวนอน
                                 วัดลูกด้วยความกว้างไม่จำกัดเสมอ (ไม่มีแนวคิด "ขึ้นบรรทัดใหม่") จึงไม่ตัดอะไรทิ้ง
                                 เหมาะกับแท็บจำนวนน้อยคงที่แบบนี้ (4 แท็บ ไม่มีวันต้องขึ้นบรรทัดใหม่จริง) -->
                            <StackPanel IsItemsHost="True" Orientation="Horizontal" Background="Transparent"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem Header="บล็อกเว็บ">
                <local:WebsiteBlockTab x:Name="BlockTab" Margin="0,14,0,0"/>
            </TabItem>
            <TabItem Header="ชุด Allow-list">
                <local:WebsiteAllowListPlaceholderTab Margin="0,14,0,0"/>
            </TabItem>
            <TabItem Header="ป้องกันการเลี่ยง">
                <local:WebsiteAntiEvasionTab x:Name="AntiEvasionTab" Margin="0,14,0,0"/>
            </TabItem>
            <TabItem Header="ประวัติเว็บ">
                <local:WebsiteHistoryPlaceholderTab Margin="0,14,0,0"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
