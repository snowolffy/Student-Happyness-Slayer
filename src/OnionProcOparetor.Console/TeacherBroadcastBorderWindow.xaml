<Window x:Class="OnionProcOparetor.Console.TeacherBroadcastBorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="กำลังส่งจอครู (กรอบแดง)"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="#E53935"
        Focusable="False"
        ShowActivated="False"
        Icon="/Theme/icon.ico">
    <!-- คำขอเพิ่ม 3 พ.ย. 2569 - กรอบแดงรอบจอครูตลอดเวลาที่ส่ง หนา 4px ไม่กะพริบ กดทะลุได้ และไม่ติดไปในภาพ
         ที่ส่งให้นักเรียน

         หน้าต่างนี้คือ "แถบทึบสีแดง 1 เส้น" กรอบจริงประกอบจาก 4 หน้าต่าง (บน/ล่าง/ซ้าย/ขวา - ดู .xaml.cs)
         ห้ามกลับไปใช้ AllowsTransparency="True" แบบกรอบกลวงหน้าต่างเดียว: ทดสอบจริง 3 พ.ย. แล้วว่า
         SetWindowDisplayAffinity(WDA_EXCLUDEFROMCAPTURE) ล้มทุกครั้งกับหน้าต่างโปร่งใสของ WPF
         (UpdateLayeredWindow, GetLastError=8) แต่ใช้ได้กับหน้าต่างทึบ แม้จะเติม WS_EX_LAYERED|WS_EX_TRANSPARENT
         เองเพื่อให้คลิกทะลุ -->
</Window>
