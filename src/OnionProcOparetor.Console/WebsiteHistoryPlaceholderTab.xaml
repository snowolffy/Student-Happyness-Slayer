<UserControl x:Class="OnionProcOparetor.Console.WebsiteHistoryPlaceholderTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OnionProcOparetor.Console.Controls">
    <!-- แท็บ "ประวัติเว็บ" ของหน้า Website Control (WP2-4, 2026-10-31) - เนื้อหาจริงแทน EmptyState เดิม
         ของ WP2-1 แล้ว ดู wireframe con-website-history.dc.html: ตัวกรอง (ช่วงเวลา/ห้องเรียน/นักเรียน-
         เครื่อง/โดเมน/เฉพาะที่ถูกบล็อก) + ตารางประวัติ (checkbox เลือกได้) + aside "เว็บที่เข้าบ่อยช่วงนี้"

         ชื่อไฟล์/คลาสยังเป็น WebsiteHistoryPlaceholderTab เดิม (ไม่ rename) ตามที่ WP2-1 เตรียมไว้ -
         ดู WebsiteControlPage.xaml(.cs) ที่เพิ่ม x:Name="HistoryTab" + เรียก Initialize(apiClient)
         เหมือนที่ WP2-2 ทำกับ AllowListTab (จุดเดียวที่ WP นี้แตะไฟล์นั้น)

         ต่างจาก wireframe เล็กน้อย: ใช้ DatePicker 2 ตัว (จาก/ถึง) แทนช่อง text เดี่ยวที่โชว์ช่วงเวลา
         เต็ม "29/10/2569 10:00 – 11:30" เพราะแอปนี้ยังไม่มี control ช่วงเวลาแบบนั้น (ไม่มีเวลาของวัน
         ด้วย - กรองเป็นวันพอ ไม่ใช่ชั่วโมง:นาที) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== แถบตัวกรอง ==================== -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" Margin="0,0,10,8" VerticalAlignment="Center">
                <TextBlock Text="จาก" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="12"/>
                <DatePicker x:Name="FromDatePicker" Width="130" SelectedDateChanged="FilterChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,8" VerticalAlignment="Center">
                <TextBlock Text="ถึง" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="12"/>
                <DatePicker x:Name="ToDatePicker" Width="130" SelectedDateChanged="FilterChanged"/>
            </StackPanel>
            <ComboBox x:Name="ClassNameCombo" Width="150" Height="35" Margin="0,0,10,8"
                      VerticalAlignment="Center" SelectionChanged="FilterChanged"/>
            <TextBox x:Name="SearchBox" Height="35" Width="170" Margin="0,0,10,8"
                     VerticalAlignment="Center" Style="{StaticResource SearchTextBox}"
                     Tag="นักเรียน / เครื่อง..." TextChanged="SearchBox_TextChanged"/>
            <TextBox x:Name="DomainBox" Height="35" Width="150" Margin="0,0,10,8"
                     VerticalAlignment="Center" Style="{StaticResource SearchTextBox}"
                     Tag="โดเมน..." TextChanged="SearchBox_TextChanged"/>
            <CheckBox x:Name="BlockedOnlyCheck" Content="เฉพาะที่ถูกบล็อก" Margin="0,0,10,8"
                      VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <Button x:Name="BlockSelectedButton" Content="+ บล็อกโดเมนที่เลือก" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" Margin="0,0,0,8" VerticalAlignment="Center"
                    Click="BlockSelectedButton_Click"/>
        </WrapPanel>

        <!-- ==================== ตาราง + aside ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True"
                    Background="{DynamicResource Brush.Background.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                <DataGrid x:Name="VisitsGrid" AutoGenerateColumns="False" IsReadOnly="False"
                        Background="Transparent"
                        BorderThickness="0"
                        RowBackground="{DynamicResource Brush.Background.Card}"
                        AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                        HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                        VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                        RowHeight="38" CanUserAddRows="False"
                        ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                        RowStyle="{StaticResource ConsoleGridRowStyle}"
                        CellStyle="{StaticResource ConsoleGridCellStyle}">
                    <DataGrid.Resources>
                        <Style x:Key="WebVisitResultBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                            <Setter Property="Tag" Value="{Binding ResultBadgeTag}"/>
                            <Setter Property="Content" Value="{Binding ResultText}"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="30" MinWidth="30"/>
                        <DataGridTextColumn controls:TimeColumn.Header="เวลา" Binding="{Binding VisitedAt, Converter={StaticResource DisplayTimeConverter}}" SortMemberPath="VisitedAt" Width="115" MinWidth="115" IsReadOnly="True"/>
                        <DataGridTextColumn Header="นักเรียน" Binding="{Binding StudentDisplayText}" Width="110" MinWidth="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="เครื่อง" Binding="{Binding MachineName}" Width="80" MinWidth="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="โดเมน" Binding="{Binding Domain}" Width="*" MinWidth="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="ชื่อหน้า" Binding="{Binding PageTitle}" Width="*" MinWidth="110" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="ผล" Width="82" MinWidth="82">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{StaticResource WebVisitResultBadge}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <ContentControl x:Name="VisitsEmptyText"
                            Grid.Column="0"
                            Style="{StaticResource EmptyState}" controls:Nav.Icon="clock"
                            Content="ไม่มีประวัติเว็บในช่วงที่เลือก"
                            Tag="Agent ส่งประวัติการเข้าเว็บของ Chrome/Edge ขึ้น Server ทุก 1 นาที - รอสักครู่แล้วลองโหลดใหม่"
                            Visibility="Collapsed"/>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="เว็บที่เข้าบ่อยช่วงนี้" FontSize="14" FontWeight="SemiBold"/>
                    <ItemsControl x:Name="TopDomainsList" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Domain}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="12" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    </Grid>
                                    <Border Height="6" CornerRadius="3" Margin="0,3,0,0" HorizontalAlignment="Left"
                                            Background="{DynamicResource Brush.Accent.Default}"
                                            Width="{Binding BarWidth}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Text="ใช้หาเว็บเกมใหม่ที่ยังไม่อยู่ใน blocklist - ข้อมูลมาจาก History ของ Chrome/Edge ที่ Agent ส่งขึ้น Server ทุกนาที (ทันก่อนรีบูตล้าง)"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" Click="PrevPageButton_Click">
                <StackPanel Orientation="Horizontal">
                    <controls:IconPresenter Icon="chevron-left" IconSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="ก่อนหน้า" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" Click="NextPageButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ถัดไป" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <controls:IconPresenter Icon="chevron-right" IconSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="4" x:Name="PageInfoText" VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.Text.Secondary}"/>
        </Grid>
    </Grid>
</UserControl>
