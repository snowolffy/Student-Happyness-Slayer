<Window x:Class="OnionProcOparetor.Console.AddEditRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rule"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- Rebuilt 2026-09-03 - outer layout is now a single StackPanel (was a Grid of Auto rows
         wrapping the same StackPanel-based form) for consistency with the rest of the app's rebuilt
         dialogs. Still one form shared by Add / Edit / create-from-process (see code-behind). -->
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="NAME" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,12"
                         ToolTip="ชื่อกฎ (ไว้แสดงผลใน GUI)"/>

                <TextBlock Text="PUBLISHER" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox x:Name="PublisherBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,12"
                         ToolTip="ชื่อ Publisher ที่ต้องการจับคู่ เช่น 'Valve Corporation' - เงื่อนไขบังคับเสมอ"/>

                <TextBlock Text="PROCESS NAME CONTAINS (OPTIONAL)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox x:Name="ProcessNameContainsBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,12"
                         ToolTip="[OPTIONAL] narrow เพิ่มจากชื่อไฟล์ เช่น 'notepad' - เว้นว่างได้ถ้าไม่รู้ชื่อไฟล์ล่วงหน้า"/>

                <CheckBox x:Name="RequireSignedMatchCheckBox" Content="ต้องมีลายเซ็นดิจิทัลตรงกัน (Authenticode)"
                          Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8"/>
                <CheckBox x:Name="KillProcessCheckBox" Content="ปิดโปรแกรมทันทีที่ตรงกับกฎ"
                          Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8"/>
                <CheckBox x:Name="IsEnabledCheckBox" Content="เปิดใช้งานกฎนี้"
                          Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>

                <!-- WP2-3 (2026-10-31): เลือกห้องที่กฎนี้ใช้ด้วย - รายการห้องโหลด async ตอน Loaded
                     (ดู code-behind) ตัวเลือกแรกเสมอคือ "ทุกห้อง" (Tag=null) -->
                <TextBlock Text="ใช้กับ (ห้อง)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <ComboBox x:Name="RoomCombo" Height="35" Margin="0,0,0,12"/>

                <TextBlock Text="ACTION COMMAND (OPTIONAL)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox x:Name="ActionCommandBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,12"
                         ToolTip="path ของ .exe/.bat/.ps1 ที่จะรันเมื่อ match (ไม่บังคับ)"/>

                <TextBlock Text="ACTION ARGUMENTS (OPTIONAL)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <TextBox x:Name="ActionArgumentsBox" Style="{StaticResource RoundedTextBox}"
                         ToolTip="arguments ที่จะส่งให้ ACTION COMMAND (ไม่บังคับ)"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Grid>
            <Button Content="ยกเลิก" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Margin="0,0,96,0" Click="CancelButton_Click"/>
            <Button Content="บันทึกกฎ" Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Right" Click="SaveButton_Click"/>
        </Grid>
    </StackPanel>
</Window>
