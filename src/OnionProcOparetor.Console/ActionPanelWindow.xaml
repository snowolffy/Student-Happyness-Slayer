<Window x:Class="OnionProcOparetor.Console.ActionPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actions"
        Height="648" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppWindowStyle}">
    <!-- Grid layout with fixed-pixel RowDefinitions matching the old Canvas.Top deltas - see SettingsWindow.xaml for the same pattern. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="420"/>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Width="380" x:Name="HeaderText" Style="{StaticResource Heading2}" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <!-- Target picker - แสดงเฉพาะ bulk mode (ให้เลือกได้ว่าจะ apply กับ "เครื่องที่เลือกไว้" หรือ "ทุกเครื่อง") -->
        <StackPanel Grid.Row="1" x:Name="TargetPanel" HorizontalAlignment="Left" VerticalAlignment="Top">
            <RadioButton x:Name="ApplyToSelectedRadio" GroupName="ActionTarget" Content="เครื่องที่เลือกไว้" Margin="0,0,0,4"/>
            <RadioButton x:Name="ApplyToAllRadio" GroupName="ActionTarget" Content="ทุกเครื่อง"/>
        </StackPanel>

        <Border Grid.Row="2" Width="380" Height="420" CornerRadius="10" Padding="14"
                Background="{StaticResource Brush.Background.Primary}"
                BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="96"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Width="352" x:Name="ToggleButton" Content="TOGGLE ENFORCEMENT"
                        Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ToggleButton_Click"/>

                <Button Grid.Row="1" Width="352" x:Name="SettingsButton" Content="SETTINGS..."
                        Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="SettingsButton_Click"/>

                <Button Grid.Row="2" Width="352" x:Name="ConfigRuleButton" Content="CONFIG RULE..."
                        Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ConfigRuleButton_Click"/>

                <Grid Grid.Row="3">
                    <Button Width="172" x:Name="LockButton" Content="LOCK WORKSTATION"
                            Style="{StaticResource ButtonSecondary}" Padding="10,9" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" Click="LockButton_Click"/>
                    <Button Width="172" x:Name="UnlockButton" Content="UNLOCK WORKSTATION"
                            Style="{StaticResource ButtonSecondary}" Padding="10,9" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="180,0,0,0" Click="UnlockButton_Click"/>
                </Grid>

                <Grid Grid.Row="4">
                    <Button Width="172" x:Name="RestartButton" Content="RESTART"
                            Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="RestartButton_Click"/>
                    <Button Width="172" x:Name="ShutdownButton" Content="SHUTDOWN"
                            Style="{StaticResource ButtonDanger}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="180,0,0,0" Click="ShutdownButton_Click"/>
                </Grid>

                <Button Grid.Row="5" Width="352" x:Name="ViewScreenButton" Content="VIEW SCREEN"
                        Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ViewScreenButton_Click"/>

                <Button Grid.Row="6" Width="352" x:Name="DeleteButton" Content="DELETE"
                        Style="{StaticResource ButtonDanger}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="DeleteButton_Click"/>
            </Grid>
        </Border>

        <!-- 2026-08-02 stabilization pass: StatusText เดิมอยู่ห่างจาก CLOSE แค่ 22px - status 2 บรรทัด
             (เช่น bulk-action ที่ list เครื่องที่ล้มเหลว) ชนปุ่มได้ - ขยับลงมาให้มีที่หายใจมากขึ้น -->
        <TextBlock Grid.Row="3" Width="380" x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Button Grid.Row="4" Content="CLOSE" Style="{StaticResource ButtonSecondary}" Width="80"
                Padding="10,5" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="300,0,0,0" Click="CloseButton_Click"/>
    </Grid>
</Window>
