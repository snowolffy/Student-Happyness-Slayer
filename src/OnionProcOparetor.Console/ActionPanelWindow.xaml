<UserControl x:Class="OnionProcOparetor.Console.ActionPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- UI-3c (2026-11-03): เดิมเป็น Window ของตัวเอง (ShowDialog) - ย้ายมาเป็น UserControl ในแผงสไลด์
         ขวา (SidePanelHost) ตามที่ roadmap UI-3c สั่ง ("แผงขวาของเครื่องเดียว... ActionPanel") -
         Settings/ConfigRule ที่เปิดจากในแผงนี้ (ซึ่งครอง SidePanelHost อยู่แล้ว) ใช้ DialogHost แทน
         (ลอยทับแผงนี้ได้ - ดู docs/architecture.md หัวข้อ "UI-3a") Screen View/Processes/PendingCommands
         ยังเป็นสัญญาณกลับไปให้ DashboardWindow เปิดต่อเหมือนเดิมทุกประการ ไม่เปลี่ยน -->
    <Border Style="{StaticResource Card}" Width="380" MaxHeight="680">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText" Style="{StaticResource Heading2}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <!-- Target picker - แสดงเฉพาะ bulk mode (ให้เลือกได้ว่าจะ apply กับ "เครื่องที่เลือกไว้" หรือ "ทุกเครื่อง") -->
        <StackPanel Grid.Row="1" x:Name="TargetPanel" Margin="0,0,0,16">
            <RadioButton x:Name="ApplyToSelectedRadio" GroupName="ActionTarget" Content="เครื่องที่เลือกไว้" Margin="0,0,0,4"/>
            <RadioButton x:Name="ApplyToAllRadio" GroupName="ActionTarget" Content="ทุกเครื่อง"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <Button x:Name="ToggleButton" Content="TOGGLE ENFORCEMENT"
                        Style="{StaticResource ButtonSecondary}" Margin="0,0,0,12" Click="ToggleButton_Click"/>

                <Button x:Name="SettingsButton" Content="ตั้งค่าเครื่องนี้..."
                        Style="{StaticResource ButtonSecondary}" Margin="0,0,0,4" Click="SettingsButton_Click"/>

                <Button x:Name="ConfigRuleButton" Content="ยกเว้นกฎเฉพาะเครื่องนี้..."
                        Style="{StaticResource ButtonSecondary}" Margin="0,0,0,12" Click="ConfigRuleButton_Click"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="LockButton" Content="ล็อกหน้าจอ"
                            Style="{StaticResource ButtonSecondary}" Padding="10,9" FontSize="12" Click="LockButton_Click"/>
                    <Button Grid.Column="2" x:Name="UnlockButton" Content="ปลดล็อกหน้าจอ"
                            Style="{StaticResource ButtonSecondary}" Padding="10,9" FontSize="12" Click="UnlockButton_Click"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="RestartButton" Content="รีสตาร์ทเครื่อง"
                            Style="{StaticResource ButtonSecondary}" Click="RestartButton_Click"/>
                    <Button Grid.Column="2" x:Name="ShutdownButton" Content="ปิดเครื่อง"
                            Style="{StaticResource ButtonDanger}" Click="ShutdownButton_Click"/>
                </Grid>

                <!-- เวลานับถอยหลังก่อน Shutdown/Restart จริง - มีผลเฉพาะ 2 ปุ่มด้านบนเท่านั้น -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="หน่วงเวลาก่อนดำเนินการ" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    <TextBox x:Name="DelaySecondsBox" Width="56" Margin="8,0,0,0"
                             Style="{StaticResource RoundedTextBox}" VerticalAlignment="Center"
                             VerticalContentAlignment="Center" TextAlignment="Center" MaxLength="3"
                             PreviewTextInput="DelaySecondsBox_PreviewTextInput"
                             ToolTip="จำนวนวินาทีที่เตือน user ก่อน Shutdown/Restart จริง (1-120 วินาที)"/>
                    <TextBlock Text="วินาที (1-120)" Style="{StaticResource Caption}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="ViewScreenButton" Content="ดูหน้าจอ"
                        Style="{StaticResource ButtonSecondary}" Margin="0,0,0,4" Click="ViewScreenButton_Click"/>

                <Button x:Name="ViewProcessesButton" Content="ดูโปรแกรมที่เปิดอยู่..."
                        Style="{StaticResource ButtonSecondary}" Margin="0,0,0,12" Click="ViewProcessesButton_Click"/>

                <!-- Tailscale: remote lock/unlock (AlwaysOn policy toggle - กันนักเรียน disconnect เอง)
                     + status/login (on-demand เท่านั้น ไม่มี persistent badge ที่ dashboard - ดู
                     CommandProcessor.cs's SetTailscaleLockdown/GetTailscaleStatus/RunTailscaleLogin) -->
                <Grid x:Name="TailscaleLockRow" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="TailscaleLockButton" Content="ล็อก Tailscale"
                            Style="{StaticResource ButtonSecondary}" Padding="10,9" FontSize="12" Click="TailscaleLockButton_Click"/>
                    <Button Grid.Column="2" x:Name="TailscaleUnlockButton" Content="ปลดล็อก Tailscale"
                            Style="{StaticResource ButtonSecondary}" Padding="10,9" FontSize="12" Click="TailscaleUnlockButton_Click"/>
                </Grid>

                <Grid x:Name="TailscaleStatusRow" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="TailscaleStatusButton" Content="ดูสถานะ Tailscale"
                            Style="{StaticResource ButtonSecondary}" Padding="10,9" FontSize="12" Click="TailscaleStatusButton_Click"/>
                    <Button Grid.Column="2" x:Name="TailscaleLoginButton" Content="ล็อกอิน Tailscale..."
                            Style="{StaticResource ButtonSecondary}" Padding="10,9" FontSize="12" Click="TailscaleLoginButton_Click"/>
                </Grid>

                <!-- ดูคำสั่งที่ยังค้าง Pending อยู่ของเครื่องนี้ + ยกเลิกได้ -->
                <Button x:Name="PendingCommandsButton" Content="ดูคำสั่งที่ค้างอยู่..."
                        Style="{StaticResource ButtonSecondary}" Margin="0,0,0,12" Click="PendingCommandsButton_Click"/>

                <Button x:Name="DeleteButton" Content="ลบเครื่องนี้ออกจากระบบ"
                        Style="{StaticResource ButtonDanger}" Click="DeleteButton_Click"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>

        <Button Grid.Row="4" Content="ปิด" Style="{StaticResource ButtonSecondary}" Width="80"
                Padding="10,5" FontSize="11" HorizontalAlignment="Right" Click="CloseButton_Click"/>
    </Grid>
    </ScrollViewer>
    </Border>
</UserControl>
