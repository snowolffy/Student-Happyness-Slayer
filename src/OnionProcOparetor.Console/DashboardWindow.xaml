                                    VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                    RowHeight="40" CanUserAddRows="False"
                                    ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                    RowStyle="{StaticResource ConsoleGridRowStyle}"
                                    CellStyle="{StaticResource ConsoleGridCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ชื่อผู้ใช้" Binding="{Binding Username}" Width="150"/>
                                    <DataGridTextColumn Header="บัญชีระบบ" Binding="{Binding IsBuiltIn}" Width="80"/>
                                    <DataGridTextColumn Header="ใช้รหัสผ่านเริ่มต้น" Binding="{Binding HasDefaultPassword}" Width="130"/>
                                    <DataGridTextColumn controls:TimeColumn.Header="สร้างเมื่อ" Binding="{Binding CreatedAt, Converter={StaticResource DisplayTimeConverter}}" SortMemberPath="CreatedAt" Width="160"/>
                                    <DataGridTextColumn controls:TimeColumn.Header="ล็อกอินล่าสุด" Binding="{Binding LastLoginAt, Converter={StaticResource DisplayTimeConverter}}" SortMemberPath="LastLoginAt" Width="160"/>
                                    <DataGridTemplateColumn Header="จัดการ" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <!--
                                                        ปุ่ม RESET PW: ใช้ได้กับทุก account รวม built-in
                                                        (ต่างจาก DELETE ที่ต้องกันไว้เพราะลบ built-in ไม่ได้เลย)
