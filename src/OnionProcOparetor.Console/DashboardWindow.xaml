<UserControl x:Class="OnionProcOparetor.Console.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnionProcOparetor.UI.Controls;assembly=OnionProcOparetor.UI"
        xmlns:appctl="clr-namespace:OnionProcOparetor.Console.Controls"
        xmlns:local="clr-namespace:OnionProcOparetor.Console"
        Background="{DynamicResource Brush.Background.Primary}">
    <!--
        UI-2 (2026-11-03): เดิมเป็น Window แยก (DashboardWindow) เปิดทับ MainWindow ตอน login สำเร็จ -
        ย้ายมาเป็น UserControl ฝังอยู่ใน MainWindow เดียวกัน (ดู MainWindow.xaml.cs ShowDashboardAsync/
        ReturnToLoginAsync) เพื่อให้ login -> dashboard -> logout เป็น "หน้าต่างเดียว" จริง (HWND ไม่เปลี่ยน
        เลยทั้ง process) ตามที่ roadmap WP UI-2 สั่ง - ทุกอย่างข้างในยังเหมือนเดิมหมด (TabControl/sidebar/
        แท็บย่อยทั้งหมด) เปลี่ยนแค่ root element กับจุดที่พึ่ง Window ของตัวเองตรงๆ (ดู comment ที่
        DashboardWindow.xaml.cs ส่วน CanCloseHost/ShutdownAsync/LogoutRequested)

        Layout: Toolbar -> TabControl with 6 tabs: CLIENTS / RULES / LOGS / USERS / SCREEN VIEW / LIVE VIEW
        -> footer status bar, on a root Grid (Auto/*/Auto rows) so the window can actually be resized -
        was Canvas before (2026-08-05 Phase 1 UI rebuild converted it back to Grid, per the "if you need a
        resizable Dashboard again, switch back to Grid" note that used to live right here). Each tab's own
        content is a Grid too (Auto rows for title/toolbar/search, * for the DataGrid so it fills whatever
        space is left) instead of a Canvas with pixel-fixed positions. Shared DataGrid header/row/cell
        styles (ConsoleGridColumnHeaderStyle/ConsoleGridRowStyle/ConsoleGridCellStyle) moved to
        Theme/Controls.xaml (2026-08-25) so other Windows (e.g. RunningProcessesWindow) can actually
        resolve them too - StaticResource lookups don't cross between separate Window.Resources, which
        was a real crash (XamlParseException on open) until they became genuinely app-wide.
        MinWidth/MinHeight are set to keep the toolbar buttons and the 6 tab headers from overlapping/
        wrapping at small sizes - re-check these if a tab's content changes materially later.
    -->
    <UserControl.Resources>
        <!-- ==================== GhostMenuButton (UI-4, 2026-11-04) ====================
             ปุ่มเต็มความกว้าง ชิดซ้าย ไม่มีกรอบ - ใช้ในเมนู "คำสั่งอื่นๆ" ของแถบคำสั่ง Clients
             (ClientsMoreActionsPopup) ไม่ใช้ MenuItem/ContextMenu มาตรฐานของ WPF ตรงๆ เพราะไม่มี
             Style ธีมมืด/สว่างให้เลยในไลบรารีนี้ (ดู Theme/Controls.xaml) - ยืมโครงจาก GhostIconButton
             แต่ปรับ ContentPresenter ให้ชิดซ้ายแทนกึ่งกลาง -->
        <Style x:Key="GhostMenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Row.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== LiveViewFilterToggle (UI-5, 2026-11-04) ====================
             ปุ่มตัวกรองยกมือ/ออนไลน์/มีเหตุการณ์ของแท็บ Live View - แยกจาก StatCardFilter (RadioButton,
             เลือกได้ทีละตัว) เพราะตัวกรองสามตัวนี้ "เปิดพร้อมกันได้" (เช่น ยกมือ+ออนไลน์พร้อมกัน) จึงต้องเป็น
             ToggleButton อิสระ ไม่ใช่กลุ่ม RadioButton เดียวกัน -->
        <Style x:Key="LiveViewFilterToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Card}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Default}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- ==================== โครงหน้าจอ: sidebar ซ้าย + เนื้อหาขวา (2026-09-09) ====================
             เดิมเป็น "แถบเครื่องมือบน + แท็บเรียงแนวนอน" เปลี่ยนมาเป็น sidebar ให้ตรงกับ OnlineConsole
             โดย **ยังเป็น TabControl ตัวเดิมทุกประการ** - เปลี่ยนแค่ ControlTemplate ให้ panel ที่
             IsItemsHost ไปอยู่คอลัมน์ซ้าย และเปลี่ยน ItemContainerStyle เป็นแถวเมนู ผลคือ
             MainTabControl_SelectionChanged / ScreenViewTabItem / AuditLogTabItem / LiveViewTabItem
             และโค้ดที่สั่งสลับแท็บเองยังทำงานเหมือนเดิมทั้งหมด ไม่ต้องแก้ code-behind เลย

             แถบบนกับแถบสถานะล่างส่งเข้า template ผ่าน Nav.TopBar / Nav.StatusBar แทนที่จะย้ายเข้าไป
             เขียนใน template ตรง ๆ เพราะ element ที่อยู่ใน ControlTemplate จะไม่มี field ให้ code-behind
             เรียกถึงด้วย x:Name (คนละ namescope) - ดูเหตุผลเต็มใน Controls/Nav.cs

             ลำดับแท็บถูกจัดใหม่ให้กลุ่มติดกัน (ตรวจตรา / กฎและการบังคับใช้ / ระบบ) ตาม NavMenu.razor
             ซึ่งปลอดภัยเพราะไม่มีโค้ดตรงไหนอ้างแท็บด้วย index เลย มีแต่ SelectedItem กับชื่อ TabItem
        -->
        <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0"
                    ItemContainerStyle="{StaticResource SidebarTabItem}"
                    SelectionChanged="MainTabControl_SelectionChanged">

            <!-- ==================== แถบหัว + ประกาศสถานะทั้งระบบ (WP6) ====================
                 AnnouncementBar สูง 60px คงที่ทุกกรณี: ปกติแสดงปลายทางที่ต่ออยู่กับเวลาอัพเดตล่าสุด
                 พอมีเรื่องระดับทั้งระบบ (gate ปิด / Server หลุด / การอัปเดตสดหลุด) ทั้งแถบเปลี่ยนสี
                 เป็นประกาศพร้อมปุ่มแก้ในตัว - ไม่มีแถบแทรกเพิ่มเหมือน GlobalOffBanner เดิม ตาราง
                 ทุกหน้าจึงไม่ขยับแม้แต่พิกเซลเดียวตอนประกาศโผล่หรือหายไป

                 ทำไมยังมีปุ่ม "เปิดการบังคับใช้กลับ" ที่นี่ทั้งที่แท็บ Clients มีสวิตช์ของตัวเอง:
                 แถบหัวเห็นจากทุกหน้า สวิตช์อยู่หน้าเดียว ถ้าเอาออก คนที่อยู่หน้าอื่นจะเห็นคำเตือน
                 แต่กดแก้ไม่ได้ ซึ่งคือบั๊กเดิม 2026-09-04 เป๊ะ ๆ (12d774a "visible and reachable")

                 ข้อความผลลัพธ์ (สำเร็จ/ล้มเหลว) ไม่อยู่ที่แถบนี้อีกแล้ว ย้ายไปเป็น toast มุมขวาล่าง
                 (Services/ToastService) StatusText ที่เหลือบอกแค่ "อัพเดตล่าสุดเมื่อไหร่" -->
            <controls:Nav.TopBar>
                <!-- UI-8 (2026-11-04): Margin="0,0,0,12" เดิมเว้นช่องให้การ์ดเนื้อหาด้านล่างลอยแยกจากแถบนี้ -
                     เอาออกเพราะตอนนี้แถบนี้ชิดขอบบน/ซ้าย/ขวาเต็ม (ดู AnnouncementBar._root) เส้นคั่น 1px
                     ที่ขอบล่างของแถบทำหน้าที่แยกจากเนื้อหาแทน ระยะห่างจากการ์ดเนื้อหามาจาก Margin ของการ์ด
                     เนื้อหาเองแล้ว (Row 1 ด้านล่าง) -->
                <!-- UI-13: แถบนี้ Collapsed ตอนไม่มีประกาศ (ดู AnnouncementBar.Render) - ข้อความ Server / เวลาอัพเดต /
                     ปุ่มรีเฟรชย้ายลงแถบสถานะล่าง (Nav.StatusBar) แล้ว -->
                <appctl:AnnouncementBar x:Name="HeaderBar"/>
            </controls:Nav.TopBar>

            <controls:Nav.StatusBar>
                <!-- ==================== Footer status bar ====================
                     UI-8 (2026-11-04): เลิกเป็นการ์ดลอย (เดิม Margin="0,10,0,0" + CornerRadius="12" ลอยเหนือ
                     ขอบล่างของหน้าต่าง) ตาม roadmap สั่งให้แถบนี้ "ชิดขอบล่าง เต็มความกว้างตั้งแต่ขอบ sidebar
                     ถึงขอบหน้าต่าง ใช้พื้นระดับเดียวกับการ์ด คั่นด้วยเส้น 1px ไม่มีเงา ไม่มีมุมโค้ง" - Margin/
                     CornerRadius ถูกเอาออก BorderThickness เหลือแค่เส้นบน (คั่นจากเนื้อหา) Padding ซ้าย/ขวา
                     ยังคง 16 ให้ตัวหนังสือ "Server:/User:" เรียงแนวเดียวกับระยะขอบการ์ดเนื้อหาด้านบน -->
                <!-- UI-13: แถบสถานะล่าง - ซ้าย: ไอคอน wifi + Server ที่ต่ออยู่ · ขวา: เวลาอัพเดตล่าสุด + ปุ่มรีเฟรช
                     (ย้ายมาจากแถบบน) · User/ออกจากระบบย้ายไป footer ของ sidebar · ข้อความ Server ยาวให้ตัดด้วย …
                     (คอลัมน์ * ไม่ดันปุ่มรีเฟรชหลุดที่ความกว้างขั้นต่ำ 1000px) -->
                <Border Height="44" BorderThickness="0,1,0,0" Padding="16,0"
                        Background="{DynamicResource Brush.Background.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Default}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:IconPresenter Grid.Column="0" Icon="wifi" IconSize="16" VerticalAlignment="Center"
                                                Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        <TextBlock Grid.Column="1" x:Name="ServerLabel" Style="{StaticResource Caption}"
                                   Margin="8,0,12,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" x:Name="StatusText" Style="{StaticResource Caption}"
                                   MaxWidth="220" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Grid.Column="3" x:Name="RefreshButton" Content="รีเฟรช"
                                Style="{StaticResource ButtonSecondary}" Padding="12,4" FontSize="11"
                                Click="RefreshButton_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </controls:Nav.StatusBar>

            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ========== Sidebar ========== -->
                        <Border x:Name="SidebarRoot" Grid.Column="0" Width="248"
                                Background="{DynamicResource Brush.Sidebar.Background}"
                                BorderBrush="{DynamicResource Brush.Sidebar.Border}"
                                BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="14,16,12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10">
                                        <!-- ไม่มีพื้นสี่เหลี่ยมหลังโลโก้ (ผู้ใช้สั่ง 3 พ.ย. 2569)
                                             โลโก้เวกเตอร์ (WP UI-7c) - "full" เพราะแสดงจริง 36px (>32px ตาม
                                             assets/icons/README.md) แทน logo.png 256px ที่ย่อแล้วเบลอ -->
                                        <Image Source="{StaticResource Logo.App}" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel x:Name="BrandText" Grid.Column="1" Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Onion ProcOparetor" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Sidebar.Text}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Server Console" FontSize="11"
                                                   Foreground="{DynamicResource Brush.Sidebar.TextSecondary}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- StackPanel ไม่ใช่ TabPanel เหมือนเดิม (เหตุผลเดิมจากปี 2026-09-03 ยังใช้ได้:
                                     TabPanel มี layout บีบความกว้างของตัวเองที่ ControlTemplate ไหนก็แก้ไม่ได้
                                     ทำให้ป้ายชื่อโดนตัด) แค่เปลี่ยนจาก Horizontal เป็นแนวตั้งซึ่งเป็นค่า default
                                     ครอบ ScrollViewer ไว้เพราะเมนู 10 รายการ + หัวข้อกลุ่ม 4 กลุ่ม สูงเกินจอเตี้ย ๆ ได้ -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel IsItemsHost="True" Background="Transparent"/>
                                </ScrollViewer>

                                <StackPanel Grid.Row="2" Margin="0,8,0,10">
                                    <Border Height="1" Margin="12,0,12,6"
                                            Background="{DynamicResource Brush.Sidebar.Border}"/>
                                    <!-- Program Review / Website Control / Settings เคยเป็นปุ่มเปิดหน้าต่างลอยอยู่ตรงนี้
                                         ตอนนี้กลายเป็นหน้าในกลุ่ม "กฎ" และ "ระบบ" ของ sidebar แล้ว (WP6) ท้าย sidebar
                                         จึงเหลือเฉพาะสิ่งที่ "สั่งงาน" ไม่ใช่ "ที่ที่ไปได้" -->
                                    <!-- UI-13: แถวผู้ใช้ + ออกจากระบบ (ย้ายมาจากแถบสถานะล่าง) ชื่อมาจาก Nav.UserName ที่ตั้งจาก
                                         code-behind (element ใน template ไม่มี field) · หด sidebar = เหลือไอคอนอย่างเดียว
                                         (Row ซ่อนข้อความตาม Nav.IsCollapsed) ToolTip บอกชื่อ -->
                                    <Border x:Name="SidebarUserRow" Margin="8,1" Height="34" CornerRadius="8"
                                            ToolTip="{Binding (controls:Nav.UserName), RelativeSource={RelativeSource TemplatedParent}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:IconPresenter x:Name="SidebarUserIcon" Grid.Column="0" Icon="users" IconSize="18"
                                                                    Margin="12,0,0,0" VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource Brush.Sidebar.Text}"/>
                                            <TextBlock x:Name="SidebarUserName" Grid.Column="1" Margin="12,0,12,0"
                                                       VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.Sidebar.Text}"
                                                       Text="{Binding (controls:Nav.UserName), RelativeSource={RelativeSource TemplatedParent}}"/>
                                        </Grid>
                                    </Border>
                                    <!-- ไม่เรียก API (ยังไม่มี endpoint invalidate token) - ถามยืนยันก่อน แล้วค่อย LogoutRequested
                                         (MainWindow.xaml.cs sub event นี้) ดู LogoutButton_Click -->
                                    <Button x:Name="LogoutButton" Style="{StaticResource SidebarActionButton}"
                                            controls:Nav.Icon="log-out" Content="ออกจากระบบ"
                                            ToolTip="ออกจากระบบ"
                                            Click="LogoutButton_Click"/>
                                    <Button x:Name="ThemeToggleButton" Style="{StaticResource SidebarActionButton}"
                                            controls:Nav.Icon="moon" Content="ธีมมืด"
                                            ToolTip="สลับธีมสว่าง/มืด"
                                            Click="ThemeToggleButton_Click"/>
                                    <Button x:Name="SidebarCollapseButton" Style="{StaticResource SidebarActionButton}"
                                            controls:Nav.Icon="chevron-left" Content="ย่อเมนู"
                                            ToolTip="ย่อ/ขยายเมนู"
                                            Click="SidebarCollapseButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ========== เนื้อหา ==========
                             UI-8 (2026-11-04): เดิม Grid นี้มี Margin="16,16,16,10" ครอบทั้งแถบบน/ล่างด้วย
                             ทำให้สองแถบดูเป็น "การ์ดลอย" เหมือนการ์ดเนื้อหา - roadmap สั่งให้แถบบน/ล่างชิดขอบ
                             บน/ล่าง เต็มความกว้างตั้งแต่ขอบ sidebar ถึงขอบหน้าต่าง ส่วนเนื้อหายังเป็นการ์ดมี
                             ระยะขอบเหมือนเดิม จึงย้าย Margin ออกจาก Grid แม่ (เหลือ 0 ทุกด้าน) มาไว้ที่การ์ด
                             เนื้อหาอย่างเดียว (Row 1) - Row 0/2 (ContentPresenter ของ TopBar/StatusBar) ไม่มี
                             Margin เลยจึงชิดขอบซ้าย (sidebar)/ขวา/บน/ล่างของพื้นที่นี้โดยตรง -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ContentPresenter Grid.Row="0"
                                              Content="{Binding (controls:Nav.TopBar), RelativeSource={RelativeSource TemplatedParent}}"/>

                            <Border Grid.Row="1" Margin="16,16,16,16" CornerRadius="12" Padding="16"
                                    Background="{DynamicResource Brush.Background.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="1">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>

                            <ContentPresenter Grid.Row="2"
                                              Content="{Binding (controls:Nav.StatusBar), RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Nav.IsCollapsed ตั้งที่ TabControl ตัวเดียวจาก code-behind แล้วไหลลงไปทั้งต้นไม้เอง
                             (property นี้ประกาศเป็น Inherits) แถวเมนูทุกแถวกับปุ่มท้าย sidebar จึงรู้พร้อมกัน
                             โดยไม่ต้องไล่หา element ข้าม namescope -->
                        <Trigger Property="controls:Nav.IsCollapsed" Value="True">
                            <Setter TargetName="SidebarRoot" Property="Width" Value="64"/>
                            <Setter TargetName="BrandText" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="SidebarUserName" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="SidebarUserIcon" Property="Margin" Value="0"/>
                            <Setter TargetName="SidebarUserIcon" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="SidebarUserIcon" Property="Grid.ColumnSpan" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </TabControl.Template>

                <!-- ========== Home tab (UI-4, 2026-11-04) ==========
                     หน้าแรกหลังล็อกอิน (roadmap WP UI-4) - อยู่ก่อน ClientsTabItem เสมอ จึงเป็นแท็บที่ถูก
                     เลือกอยู่ก่อนตามพฤติกรรม default ของ TabControl (ไม่มี TabItem ไหนตั้ง IsSelected ไว้)
                     เนื้อหาทั้งหมดอยู่ใน DashboardHomePage.xaml(.cs) แยกไฟล์ (ตามที่ roadmap ระบุชื่อไว้) -->
                <TabItem x:Name="HomeTabItem" Header="หน้าแรก" controls:Nav.Icon="layout-dashboard" controls:Nav.Group="ภาพรวม">
                    <local:DashboardHomePage x:Name="HomePage"/>
                </TabItem>

                <!-- ========== Clients tab ========== -->
                <TabItem x:Name="ClientsTabItem" Header="Clients" controls:Nav.Icon="monitor" controls:Nav.Group="ห้องเรียน">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- หัวข้อ + ช่องค้นหา -->
                            <RowDefinition Height="Auto"/>   <!-- การ์ดตัวเลข = ตัวกรอง -->
                            <RowDefinition Height="Auto"/>   <!-- แถบคำสั่ง: ทั้งห้อง (ซ้าย) + ที่เลือก (ขวา) -->
                            <RowDefinition Height="*"/>      <!-- ตาราง + แผงรายละเอียด -->
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Client Management" Style="{StaticResource Heading2}" VerticalAlignment="Center"/>
                            <!-- ตัวเลือกห้อง (WP3, 2026-10-30) - กรองตารางข้างล่างเหมือนการ์ดตัวเลข/ช่องค้นหา
                                 ข้อมูลห้องมาจาก GET /api/rooms (DashboardWindow.LoadRoomsAsync) ส่วนตัวกรองจริง
                                 ทำฝั่ง client จากข้อมูลที่โหลดมาแล้ว (RoomId ติดมากับทุกเครื่องจาก GET /api/clients
                                 อยู่แล้ว) ไม่ต้องยิง request ใหม่ทุกครั้งที่สลับห้อง - เลือกไว้แล้วจำลง
                                 console-settings.json ด้วย (ดู RoomFilterCombo_SelectionChanged) -->
                            <ComboBox Grid.Column="2" x:Name="RoomFilterCombo" Width="200" Height="34" Margin="0,0,10,0"
                                     VerticalAlignment="Center" DisplayMemberPath="Label"
                                     SelectionChanged="RoomFilterCombo_SelectionChanged"/>
                            <TextBox Grid.Column="3" x:Name="ClientsSearchBox" Width="240" Height="34"
                                    Style="{StaticResource SearchTextBox}" VerticalAlignment="Center"
                                    Tag="ค้นหาชื่อเครื่อง..." TextChanged="ClientsSearchBox_TextChanged"/>
                        </Grid>

                        <!-- ==================== การ์ดตัวเลขสรุป = ตัวกรองไปในตัว ====================
                             แนวปฏิบัติของ dashboard ยุคนี้คือ "ตัวเลขสำคัญไม่กี่ตัวใหญ่ ๆ ข้างบน ที่เหลือ
                             เจาะลงไปได้ในคลิกเดียว" ที่นี่การเจาะลงไปคือตัวการ์ดเอง - กดแล้วตารางข้างล่าง
                             กรองตามทันที ไม่ต้องมี dropdown ตัวกรองแยกอีกตัวที่ซ่อนทั้งตัวเลือกและค่าปัจจุบัน

                             เลือก 4 ตัวนี้เพราะตอบคำถามที่ครูถามจริงตอนเดินเข้าห้อง: มากี่เครื่อง หายไปกี่เครื่อง
                             และมีเครื่องไหนที่กฎไม่ทำงานอยู่บ้าง ตัวเลขทั้งหมดคำนวณจากข้อมูลที่โหลดมาแล้ว
                             ไม่ต้องยิง API เพิ่มแม้แต่ครั้งเดียว -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton x:Name="ClientStatAll" Style="{StaticResource StatCardFilter}"
                                         GroupName="ClientStatFilter" IsChecked="True" Tag="0" Content="ทั้งหมด"
                                         Checked="ClientStatFilter_Checked"/>
                            <RadioButton x:Name="ClientStatOnline" Style="{StaticResource StatCardFilter}"
                                         GroupName="ClientStatFilter" Tag="0" Content="ออนไลน์"
                                         Foreground="{DynamicResource Brush.Status.Online}"
                                         Checked="ClientStatFilter_Checked"/>
                            <RadioButton x:Name="ClientStatOffline" Style="{StaticResource StatCardFilter}"
                                         GroupName="ClientStatFilter" Tag="0" Content="ออฟไลน์"
                                         Foreground="{DynamicResource Brush.Status.Offline}"
                                         Checked="ClientStatFilter_Checked"/>
                            <RadioButton x:Name="ClientStatNotEnforcing" Style="{StaticResource StatCardFilter}"
                                         GroupName="ClientStatFilter" Tag="0" Content="กฎไม่ทำงาน"
                                         Foreground="{DynamicResource Brush.Status.WarningText}"
                                         ToolTip="เครื่องที่ Agent ไม่ได้บังคับใช้กฎอยู่จริง (รวมกรณีที่ถูกปิดด้วย gate ทั้งระบบ)"
                                         Checked="ClientStatFilter_Checked"/>
                        </StackPanel>

                        <!-- ==================== แถบคำสั่ง ====================
                             ซ้าย = สิ่งที่ทำกับ "ทั้งห้อง" ทำได้เสมอโดยไม่ต้องเลือกเครื่องก่อน
                             ขวา  = สิ่งที่ทำกับ "เครื่องที่เลือกไว้" โผล่เมื่อมี selection

                             ทั้งสองกลุ่มอยู่ **แถวเดียวกัน** และกลุ่มขวาใช้ Visibility="Hidden" ไม่ใช่
                             "Collapsed" - นี่คือแก้บั๊กจริง ไม่ใช่เรื่องจัดหน้า: ของเดิมแถบเลือกเป็นแถว
                             แยกที่ Collapsed อยู่ พอคลิกเลือกเครื่องหนึ่ง แถวนั้นแทรกเข้ามาแล้ว
                             **ดันตารางลงไปทั้งแถบ** คลิกครั้งถัดไปจึงไปโดนเครื่องคนละตัวกับที่เล็งไว้
                             ในหน้าจอที่มีปุ่ม SHUTDOWN อยู่ด้วย นั่นไม่ใช่ปัญหาความสวยงาม

                             Hidden กันที่ไว้เท่าเดิมทุกประการ ความสูงของแถวจึงคงที่ไม่ว่าจะเลือกหรือไม่
                             และไม่ต้องไปตรึงความสูงเป็นตัวเลข ซึ่งจะพังเมื่อ DPI หรือขนาดฟอนต์ต่างไป -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- ไม่ตั้ง MinWidth: ข้อความสองสถานะยาวใกล้กันอยู่แล้ว การตรึงความกว้าง
                                     มีแต่จะกินที่ของกลุ่มขวาจนโดนตัด -->
                                <Button x:Name="GlobalEnforcementButton" Style="{StaticResource ButtonSecondary}"
                                        Padding="12,6" FontSize="11"
                                        Click="GlobalEnforcementButton_Click" VerticalAlignment="Center"/>
                                <Button Content="คำสั่ง (ทุกเครื่อง)" Style="{StaticResource ButtonSecondary}"
                                        Padding="12,6" FontSize="11" Margin="8,0,0,0"
                                        ToolTip="เปิดแผงคำสั่งโดยตั้งเป้าเป็นทุกเครื่องไว้ให้ - เปลี่ยนเป้าในแผงได้"
                                        Click="RoomActionsButton_Click" VerticalAlignment="Center"/>
                                <Button Content="ส่งข้อความขึ้นจอ" Style="{StaticResource ButtonSecondary}"
                                        Padding="12,6" FontSize="11" Margin="8,0,0,0"
                                        ToolTip="ส่งข้อความขึ้นจอนักเรียน - เลือกได้ว่าทุกเครื่องหรือเฉพาะที่เลือกไว้"
                                        Click="BroadcastMessageButton_Click" VerticalAlignment="Center"/>
                                <!-- UI-4 (2026-11-04): 7 ปุ่มเดิมเต็มแถวจนล้นในจอเล็ก (ค้างมาตั้งแต่ WP4) - เหลือ
                                     3 ปุ่มที่ใช้บ่อยสุดแสดงตรง (toggle/คำสั่งทั้งห้อง/ส่งข้อความ) ที่เหลือ 4 ปุ่ม
                                     ย้ายเข้าเมนู "คำสั่งอื่นๆ" (Popup ธีมเดียวกับการ์ด ไม่ใช้ ContextMenu ของ WPF
                                     ตรงๆ เพราะไม่มี Style ธีมมืด/สว่างให้เลย - ดู ClientsMoreActionsButton_Click) -->
                                <Button x:Name="ClientsMoreActionsButton" Content="คำสั่งอื่นๆ ▾"
                                        Style="{StaticResource ButtonSecondary}"
                                        Padding="12,6" FontSize="11" Margin="8,0,0,0"
                                        ToolTip="เปิดโหมดสอบ / เปิด URL หรือโปรแกรม / แจก-เก็บไฟล์ / ส่งจอครู"
                                        Click="ClientsMoreActionsButton_Click" VerticalAlignment="Center"/>
                                <Popup x:Name="ClientsMoreActionsPopup" PlacementTarget="{Binding ElementName=ClientsMoreActionsButton}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Style="{StaticResource Card}" Padding="6" MinWidth="200">
                                        <StackPanel>
                                            <!-- "เปิดโหมดสอบ" (WP2-2, 2026-10-31) - บล็อกทุกเว็บยกเว้น allow-list ชั่วคราว
                                                 ดู wireframe nf-exam.dc.html + ExamModeWindow -->
                                            <Button Content="เปิดโหมดสอบ" Style="{StaticResource GhostMenuButton}"
                                                    ToolTip="allow-list ชั่วคราวสำหรับสอบ - เลือกได้ว่าทั้งห้องหรือเฉพาะที่เลือกไว้"
                                                    Click="MoreActions_OpenExamMode_Click"/>
                                            <!-- "เปิด URL/โปรแกรมทั้งห้อง" (WP4-1, 2026-11-01) - ดู wireframe tc-openurl.dc.html + OpenUrlWindow -->
                                            <Button Content="เปิด URL/โปรแกรม" Style="{StaticResource GhostMenuButton}"
                                                    ToolTip="เปิดเว็บหรือโปรแกรมจากรายการที่ Admin ตั้งไว้ - เลือกได้ว่าทั้งห้องหรือเฉพาะที่เลือกไว้"
                                                    Click="MoreActions_OpenUrlProgram_Click"/>
                                            <!-- "แจก/เก็บไฟล์" (WP4-3, 2026-11-01) - ดู wireframe tc-files.dc.html + FilesWindow -->
                                            <Button Content="แจก/เก็บไฟล์" Style="{StaticResource GhostMenuButton}"
                                                    ToolTip="แจกไฟล์ให้นักเรียน หรือเก็บงานจากนักเรียน - เลือกได้ว่าทั้งห้องหรือเฉพาะที่เลือกไว้"
                                                    Click="MoreActions_Files_Click"/>
                                            <!-- "ส่งจอครู" (WP4-4, 2026-11-01) - ดู wireframe tc-broadcast.dc.html + ScreenBroadcastSetupWindow -->
                                            <Button Content="ส่งจอครู" Style="{StaticResource GhostMenuButton}"
                                                    ToolTip="ส่งจอของเครื่องนี้ให้นักเรียนดู - เลือกได้ว่าทั้งห้องหรือเฉพาะที่เลือกไว้"
                                                    Click="MoreActions_ScreenBroadcast_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>

                        </Grid>

                        <!-- ==================== ตาราง + แผงข้อมูลเครื่อง (inspector) ====================
                             แผงโผล่เมื่อเลือกเครื่อง "ตัวเดียว" (เลือกหลายตัวคือโหมดสั่งงานหมู่ ซึ่งแถบเลือก
                             ด้านบนรับหน้าที่อยู่แล้ว) ตอบคำถามที่ครูถามบ่อยที่สุดโดยไม่ต้องเปิดหน้าต่างใหม่ -
                             IP อะไร เห็นล่าสุดเมื่อไหร่ ต่อมาทางไหน กฎทำงานไหม - และรวมทางเข้าหน้าต่างราย
                             client ทั้ง 6 บานไว้ที่เดียว

                             WP6 (2026-10-30): แผง **สไลด์ทับอยู่บนตาราง** ใน cell เดียวกัน ไม่ใช่คอลัมน์ที่สอง
                             ของเดิมเป็นคอลัมน์ Auto ข้างตาราง พอเลือกเครื่อง ตารางถูกบีบแคบลง 270px ทันที
                             คอลัมน์ทุกคอลัมน์กระโดด คลิกถัดไปเลยไม่โดนที่เล็งไว้ - บั๊กตระกูลเดียวกับแถบเลือก
                             เครื่อง (console-ui-notes §5) ตอนนี้ตารางมีขนาดเท่าเดิมเสมอไม่ว่าแผงจะเปิดหรือปิด
                             แผงหุบเหลือแถบแคบได้ (ดูคอลัมน์ขวาของตารางได้โดยไม่ต้องปิดแผง) ปิดด้วย ✕ หรือ Esc

                             หมายเหตุสำหรับคนที่มาทำต่อ: ปุ่มในแผงยัง "เปิดหน้าต่างเดิม" อยู่ ไม่ได้ยุบเนื้อหา
                             หน้าต่างเหล่านั้นเข้ามาในแผง - RunningProcesses กับ ActionReport รับสตรีมสดผ่าน
                             SignalR และ ActionPanel สั่งงานเป็นชุด การรื้อต้องทดสอบกับ Agent จริงในห้องแล็บ -->
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <!-- Border+ClipToBounds rounds the DataGrid's corners - DataGrid itself has no
                                 CornerRadius property (it's not a Border subclass), so the grid's own
                                 Background/Border are moved out to this wrapper and the grid goes transparent. -->
                            <Border CornerRadius="12" ClipToBounds="True"
                                    Background="{DynamicResource Brush.Background.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <DataGrid x:Name="ClientsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                    SelectionMode="Extended" SelectionUnit="FullRow"
                                    SelectionChanged="ClientsGrid_SelectionChanged"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    RowBackground="{DynamicResource Brush.Background.Card}"
                                    AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                                    HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                    VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                    RowHeight="40" CanUserAddRows="False"
                                    ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                    CellStyle="{StaticResource ConsoleGridCellStyle}">
                                <!-- ไฮไลต์แถวที่ยกมืออยู่ (WP4-2, 2026-11-01) - ตาม wireframe tc-raisehand.dc.html
                                     ("เครื่องที่ยกมือเป็นกรอบสีส้ม") HasRaisedHand มาจาก DashboardWindow.ApplyClientsFilter
                                     เติมให้หลัง merge กับคิวยกมือล่าสุด ไม่ได้มาจาก GET /api/clients ตรงๆ (ดู
                                     ClientMachineDto.HasRaisedHand) ใช้สีพื้นแทนกรอบ เพราะ DataGridRow เทมเพลตปกติไม่
                                     วาด BorderBrush ของแถวให้เห็นชัดเท่าสีพื้น (สีเดียวกับ RaiseHandBadgeWindow ของ AgentTray) -->
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ConsoleGridRowStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRaisedHand}" Value="True">
                                                <Setter Property="Background" Value="#FDF3E7"/>
                                                <Setter Property="ToolTip" Value="ยกมืออยู่ - รอครู (ดูแท็บ &quot;คิวยกมือ&quot;)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Resources>
                                    <!-- แยก 2 badge ชัดเจน เป็นคนละคอลัมน์ ไม่ปนกันเหมือนเดิม (บั๊กจริงที่เจอตอน
                                         field test 2026-08-20: badge เดิมรวม 4 สถานะ DISABLED/ONLINE/OFFLINE/MISSING
                                         ไว้ในตัวเดียว ทำให้ครูงงว่า "ออนไลน์" กับ "เปิดใช้งานกฎ" คือเรื่องเดียวกันไหม
                                         แถม MISSING ยังกระพริบทะลุไปโผล่คอลัมน์/แถวอื่นด้วย เพราะ Storyboard
                                         RepeatBehavior="Forever" ผูกกับ Style ที่ share กันทุกแถวใน DataGrid ที่มี
                                         virtualization - container ถูก recycle ระหว่าง storyboard ยังเล่นอยู่)

                                         STATUS = เครื่องติดต่อได้ไหมจริงๆ (IsOnline จาก Server - ดู ClientMachine.
                                         IsOnline/AgentConnectionRegistry) ไม่เกี่ยวกับ enforcement เลย ไม่มี state
                                         MISSING แยกอีกต่อไป และไม่มีการกระพริบใดๆ ทั้งสิ้น -->
                                    <Style x:Key="ClientOnlineStatusBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                        <Setter Property="Tag" Value="Offline"/>
                                        <Setter Property="Content" Value="OFFLINE"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Tag" Value="Online"/>
                                                <Setter Property="Content" Value="ONLINE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>

                                    <!-- ENFORCEMENT = ตอนนี้ Agent เครื่องนี้บังคับใช้กฎอยู่จริงไหม - ใช้ชื่อเดียวกับปุ่ม
                                         "ENABLE/DISABLE ENFORCEMENT" ใน ActionPanelWindow ให้สอดคล้องกัน
                                         DISABLED ใช้สี Warning (เหลือง) ไม่ใช่ Danger (แดง) เพราะเป็นสถานะปกติที่ครู
                                         ตั้งใจปิดเอง ไม่ใช่ error

                                         2026-09-04: เปลี่ยนจากอ่าน IsEnabled รายเครื่องตรงๆ มาอ่าน "ผลจริง" ที่รวม gate
                                         ทั้งห้องแล้ว (ดู ClientMachineDto.EnforcementBadgeText/Tag) - เดิมคอลัมน์นี้ขึ้น
                                         ENABLED ทั้งตารางในขณะที่ Agent ทุกตัวไม่ได้บังคับใช้อะไรเลยเพราะ GlobalState
                                         ถูกปิดไว้ ซึ่งเป็นข้อมูลที่ผิดในจังหวะที่ครูต้องการมันที่สุด -->
                                    <Style x:Key="ClientEnforcementBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                        <Setter Property="Tag" Value="{Binding EnforcementBadgeTag}"/>
                                        <Setter Property="Content" Value="{Binding EnforcementBadgeText}"/>
                                    </Style>

                                    <!-- CONNECTION = ตอนนี้ Agent poll เข้ามาผ่านทางไหน (UsingFallback จาก Server -
                                         last-known ค่าจาก poll ล่าสุด ดู ClientMachine.UsingFallback) เหลือง (Warning)
                                         ไม่ใช่แดง เพราะ fallback ทำงานได้ปกติ แค่ไม่ใช่เส้นทางหลัก ไม่ใช่ error -->
                                    <Style x:Key="ClientConnectionPathBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                        <Setter Property="Tag" Value="Online"/>
                                        <Setter Property="Content" Value="LAN"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsingFallback}" Value="True">
                                                <Setter Property="Tag" Value="Warning"/>
                                                <Setter Property="Content" Value="TAILSCALE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="สถานะ" Width="90" SortMemberPath="IsOnline">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource ClientOnlineStatusBadge}"
                                                                ToolTip="{Binding LastSeenAt, Converter={StaticResource DisplayTimeConverter}, ConverterParameter='เห็นล่าสุด: {0}'}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="บังคับใช้กฎ" Width="110" SortMemberPath="IsEnabled">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource ClientEnforcementBadge}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="เชื่อมต่อผ่าน" Width="120" SortMemberPath="UsingFallback">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource ClientConnectionPathBadge}"
                                                                ToolTip="เชื่อมต่อผ่าน LAN ปกติ หรือ Tailscale fallback (ค่าล่าสุดจาก poll)"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="ชื่อเครื่อง" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MachineName}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding MachineName}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- คอลัมน์นักเรียน (WP3-5, 2026-10-31) - "ชื่อ · รหัส" หรือ "—" ถ้ายังไม่มีใคร login
                                         ตรงตาม wireframe con-clients.dc.html คอลัมน์ "นักเรียน" - ข้อมูลมาจาก
                                         ClientMachineDto.CurrentStudent* ที่ GET /api/clients เติมมาให้แล้ว (WP3-1) -->
                                    <DataGridTemplateColumn Header="นักเรียน" Width="170" SortMemberPath="CurrentStudentName">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StudentDisplayText}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding StudentDisplayText}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Client GUID" Width="240">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ClientGuid}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ClientGuid}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn appctl:TimeColumn.Header="เห็นล่าสุด" Binding="{Binding LastSeenAt, Converter={StaticResource DisplayTimeConverter}}" SortMemberPath="LastSeenAt" Width="170"/>
                                    <DataGridTemplateColumn Header="จัดการ" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ButtonSecondary}"
                                                        Padding="10,5" FontSize="11"
                                                        Click="ClientActionsButton_Click" Tag="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="คำสั่ง" VerticalAlignment="Center"/>
                                                        <controls:IconPresenter Icon="more-horizontal" IconSize="14"
                                                                                Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            </Border>
                            <ContentControl x:Name="ClientsEmptyText"
                                            Style="{StaticResource EmptyState}" controls:Nav.Icon="monitor"
                                            Content="ยังไม่มีเครื่องในระบบ" Tag="เครื่องจะขึ้นมาเองเมื่อ Agent ติดตั้งแล้ว poll เข้ามาครั้งแรก"
                                            Visibility="Collapsed"/>

                            <!-- UI-4 (2026-11-04): ที่จอด ClientInspector เวลาไม่ได้แสดง - ย้ายไปแสดงผ่าน
                                 MainWindow.SidePanel แทนการวาดอยู่ใน cell นี้เหมือนเดิม (ตามที่ผู้ใช้สั่งให้
                                 แผงขวาวิ่งเต็มความสูงหน้าต่างเหมือน SidePanelHost ตัวอื่นๆ - ดู
                                 ShowClientInspectorInSidePanel/UpdateClientInspector) ContentControl นี้ตั้ง
                                 Collapsed ค้างตลอด (ไม่มีโค้ดไหนเปลี่ยนค่านี้) มีไว้แค่ให้ x:Name="ClientInspector"
                                 ข้างในมีที่อยู่ใน visual tree ให้ InitializeComponent สร้างได้ตอนเปิดหน้าต่าง -->
                            <ContentControl Visibility="Collapsed" Focusable="False">
                            <Border x:Name="ClientInspector" Width="284" HorizontalAlignment="Right"
                                    Visibility="Collapsed" CornerRadius="0" VerticalAlignment="Stretch"
                                    Background="{DynamicResource Brush.Background.CardRaised}"
                                    BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.28" Color="Black"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="InspectorSlide" X="0"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <!-- ===== แผงเต็ม ===== -->
                                    <Grid x:Name="InspectorExpanded">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="16,12,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:IconPresenter Grid.Column="0" Icon="monitor" IconSize="18" VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource Brush.Accent.Text}"/>
                                            <TextBlock x:Name="InspectorMachineName" Grid.Column="1" Margin="8,0,6,0"
                                                       VerticalAlignment="Center" FontSize="15" FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                                            <Button Grid.Column="2" Style="{StaticResource GhostIconButton}"
                                                    ToolTip="หุบแผงเหลือแถบแคบ (ดูคอลัมน์ขวาของตาราง)"
                                                    Click="InspectorCollapseButton_Click">
                                                <controls:IconPresenter Icon="chevron-right" IconSize="16"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                            <Button Grid.Column="3" Style="{StaticResource GhostIconButton}"
                                                    ToolTip="ปิดแผง (Esc)" Click="InspectorCloseButton_Click">
                                                <controls:IconPresenter Icon="x" IconSize="16"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                        </Grid>

                                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" Padding="16,0,16,16"
                                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <WrapPanel>
                                                    <ContentControl x:Name="InspectorStatusBadge" Style="{StaticResource StatusBadge}" Margin="0,0,6,6"/>
                                                    <ContentControl x:Name="InspectorEnforcementBadge" Style="{StaticResource StatusBadge}" Margin="0,0,6,6"/>
                                                    <ContentControl x:Name="InspectorConnectionBadge" Style="{StaticResource StatusBadge}" Margin="0,0,6,6"/>
                                                </WrapPanel>

                                                <Border Height="1" Margin="0,8,0,12"
                                                        Background="{DynamicResource Brush.Border.Default}"/>

                                                <!-- การ์ด "นักเรียนที่ใช้อยู่" (WP3-5, 2026-10-31) - โผล่เฉพาะตอนมีคน
                                                     login อยู่บนเครื่องนี้ ตรงตาม wireframe con-clients.dc.html
                                                     (กล่องสีฟ้าอ่อนใน inspector) - ซ่อนไปเลยถ้าไม่มีใคร login แทนที่จะ
                                                     โชว์ "—" ค้างไว้ เพราะไม่มีประโยชน์ที่จะเปลืองที่ตอนไม่มีข้อมูล -->
                                                <Border x:Name="InspectorStudentCard" Padding="8" Margin="0,0,0,8" CornerRadius="6"
                                                        Background="{DynamicResource Brush.Badge.Accent.Background}" Visibility="Collapsed">
                                                    <StackPanel>
                                                        <TextBlock Text="นักเรียนที่ใช้อยู่" Style="{StaticResource Caption}"/>
                                                        <TextBlock x:Name="InspectorStudentName" FontWeight="Bold" FontSize="13" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="InspectorStudentDetail" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- ปุ่มอยู่เหนือรายละเอียด ไม่ใช่ใต้: พอเลือกเครื่องแล้ว สิ่งที่ตั้งใจ
                                                     จะทำไม่ควรอยู่ใต้เส้นที่ต้องเลื่อนลงไปหา -->
                                                <Button Content="ดูหน้าจอเครื่องนี้" Style="{StaticResource ButtonPrimary}"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                                        Click="InspectorViewScreenButton_Click"/>
                                                <Button Content="ดูโปรแกรมที่เปิดอยู่" Style="{StaticResource ButtonSecondary}"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                                        Click="InspectorProcessesButton_Click"/>
                                                <!-- ปุ่ม "บังคับ logout นักเรียน" (WP3-5, 2026-10-31) - โผล่เฉพาะตอนมีคน
                                                     login อยู่ ตรงตาม wireframe con-clients.dc.html ใช้ API ของ WP3-1
                                                     (POST /api/students/sessions/{id}/force-logout) - sessionId ดึงจาก
                                                     GET /api/students/sessions/active/{clientGuid} ตอนกดปุ่ม เพราะ
                                                     GET /api/clients ไม่มี sessionId ติดมาด้วย (ดู InspectorForceLogoutButton_Click) -->
                                                <Button x:Name="InspectorForceLogoutButton" Content="บังคับ logout นักเรียน"
                                                        Style="{StaticResource ButtonSecondary}"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,6" Visibility="Collapsed"
                                                        Click="InspectorForceLogoutButton_Click"/>
                                                <Button Content="ดูคำสั่งที่ค้างอยู่" Style="{StaticResource ButtonSecondary}"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                                        Click="InspectorPendingCommandsButton_Click"/>
                                                <Button Content="ตั้งค่าเครื่องนี้" Style="{StaticResource ButtonSecondary}"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                                        Click="InspectorClientSettingsButton_Click"/>
                                                <Button Content="ยกเว้นกฎเฉพาะเครื่องนี้" Style="{StaticResource ButtonSecondary}"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                                        Click="InspectorRuleOverridesButton_Click"/>
                                                <!-- ข้อความ (C1, 2026-10-31): "คำสั่งอื่นๆ..." ตรงกับ wireframe
                                                     con-clients.dc.html ที่ผูกปุ่มนี้ไปที่ con-actionpanel.dc.html
                                                     โดยตรง (ปุ่มนี้เปิด ActionPanelWindow เดียวกันจริงๆ - ดู
                                                     InspectorActionsButton_Click) -->
                                                <Button Content="คำสั่งอื่นๆ..." Style="{StaticResource ButtonSecondary}"
                                                        HorizontalAlignment="Stretch"
                                                        Click="InspectorActionsButton_Click"/>

                                                <Border Height="1" Margin="0,14,0,10"
                                                        Background="{DynamicResource Brush.Border.Default}"/>

                                                <TextBlock Text="IP ล่าสุด" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="InspectorIp" Style="{StaticResource Body}" Margin="0,1,0,8"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- ป้ายนี้เปลี่ยนตามโหมดเวลา (เวลาไทย/UTC) ใน UpdateClientInspector -->
                                                <TextBlock x:Name="InspectorLastSeenLabel" Text="เห็นล่าสุด" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="InspectorLastSeen" Style="{StaticResource Body}" Margin="0,1,0,8"/>

                                                <TextBlock Text="รอบ poll" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="InspectorPollInterval" Style="{StaticResource Body}" Margin="0,1,0,8"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="Client GUID" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="InspectorGuid" Style="{StaticResource Caption}" Margin="0,1,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- ===== แถบแคบตอนหุบ =====
                                         เหลือปุ่มกางกลับ ปุ่มปิด และไอคอนเครื่องที่บอกชื่อใน ToolTip - พอให้รู้ว่า
                                         "ยังมีแผงของเครื่องไหนค้างอยู่" โดยไม่บังคอลัมน์ขวาของตาราง -->
                                    <StackPanel x:Name="InspectorCollapsedStrip" Visibility="Collapsed" Margin="0,10,0,0">
                                        <Button Style="{StaticResource GhostIconButton}" HorizontalAlignment="Center"
                                                ToolTip="กางแผงข้อมูลเครื่อง" Click="InspectorExpandButton_Click">
                                            <controls:IconPresenter Icon="chevron-left" IconSize="16"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostIconButton}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                ToolTip="ปิดแผง (Esc)" Click="InspectorCloseButton_Click">
                                            <controls:IconPresenter Icon="x" IconSize="16"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Border Height="1" Margin="10,8" Background="{DynamicResource Brush.Border.Default}"/>
                                        <controls:IconPresenter x:Name="InspectorCollapsedIcon" Icon="monitor" IconSize="18"
                                                                HorizontalAlignment="Center"
                                                                Foreground="{DynamicResource Brush.Accent.Text}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </ContentControl>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========== คิวยกมือ (WP4-2, 2026-11-01) - ตาม docs/wireframes/tc-raisehand.dc.html
                     ฝั่ง "ครู (Console)" wireframe วางไว้เป็นแผงข้างของ Clients/ผังที่นั่ง แต่ที่นี่แยกเป็น
                     หน้าของตัวเองในกลุ่ม "ห้องเรียน" แทน เพื่อไม่ต้องแก้โครง inspector panel ที่ WP6 สร้างไว้
                     (slide จากขวาทับ grid, ยังไม่รองรับ "โหมดเนื้อหาอื่นที่ไม่ใช่เครื่อง") - รายงานไว้เป็น
                     จุดต่างจาก wireframe ที่ orchestrator/ผู้ใช้ตัดสินได้ว่าจะย้ายเข้า inspector ทีหลังไหม ========== -->
                <TabItem x:Name="RaiseHandTabItem" Header="คิวยกมือ" controls:Nav.Icon="alert-triangle" controls:Nav.Group="">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="RaiseHandCountText" Text="คิวยกมือ (0)" Style="{StaticResource Heading2}"/>
                                <TextBlock Text="นักเรียนยกมือขอความช่วยเหลือจากจอล็อก/เมนู tray - กดซ้ำได้หลัง 1 นาที" FontSize="12"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="ClearRaiseHandQueueButton" Content="ล้างคิวทั้งหมด" Style="{StaticResource ButtonSecondary}"
                                    VerticalAlignment="Center" Click="ClearRaiseHandQueueButton_Click"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Border CornerRadius="12" ClipToBounds="True"
                                    Background="{DynamicResource Brush.Background.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <DataGrid x:Name="RaiseHandGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    RowBackground="{DynamicResource Brush.Background.Card}"
                                    AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                                    HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                    VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                    RowHeight="44" CanUserAddRows="False"
                                    ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                    RowStyle="{StaticResource ConsoleGridRowStyle}"
                                    CellStyle="{StaticResource ConsoleGridCellStyle}">
                                <DataGrid.Resources>
                                    <Style x:Key="RaiseHandNoteText" TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Note}"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Margin" Value="0,3,0,0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNote}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="คิวที่" Binding="{Binding QueuePosition}" Width="50"/>
                                    <DataGridTextColumn Header="เครื่อง" Binding="{Binding MachineName}" Width="110"/>
                                    <DataGridTextColumn Header="นักเรียน" Binding="{Binding StudentDisplayText}" Width="120"/>
                                    <DataGridTemplateColumn Header="เหตุผล" Width="*" MinWidth="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <ContentControl Style="{StaticResource StatusBadge}" Tag="Warning" Content="{Binding Reason}" HorizontalAlignment="Left"/>
                                                    <TextBlock Style="{StaticResource RaiseHandNoteText}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="รอมา" Binding="{Binding WaitedText}" Width="90"/>
                                    <DataGridTemplateColumn Header="จัดการ" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="ไปช่วยแล้ว" Style="{StaticResource ButtonPrimary}"
                                                        Padding="8,5" FontSize="11"
                                                        Click="ResolveRaiseHandButton_Click" Tag="{Binding Id}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            </Border>
                            <ContentControl x:Name="RaiseHandEmptyText"
                                            Style="{StaticResource EmptyState}" controls:Nav.Icon="alert-triangle"
                                            Content="ไม่มีใครยกมืออยู่ตอนนี้" Tag="รายการจะขึ้นที่นี่ทันทีเมื่อมีนักเรียนกดยกมือจากเมนู tray"
                                            Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========== Screen View tab (Step 4d) ========== -->
                <TabItem x:Name="ScreenViewTabItem" Header="Screen View" controls:Nav.Icon="video" controls:Nav.Group="">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="VncHeaderText"
                                    Text="ยังไม่ได้เลือกเครื่อง - เลือกเครื่องในแท็บ Clients แล้วกด &quot;ดูหน้าจอเครื่องนี้&quot;" Style="{StaticResource Heading2}"
                                    TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Width="100" Content="หยุดดูหน้าจอ" Style="{StaticResource ButtonSecondary}"
                                    Padding="10,5" FontSize="11" Click="VncDisconnectButton_Click" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Grid.Row="1" x:Name="VncStatusText" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,10,0,0"/>

                        <Border Grid.Row="2" CornerRadius="10" Background="Black" Margin="0,10,0,0"
                                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <Image x:Name="VncScreenImage" Stretch="Uniform" Margin="3"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ========== Live View tab (UI-5, 2026-11-04) - เลือกห้องแล้วเห็นทุกเครื่องทันที
                     ไม่ต้องติ๊กทีละเครื่องเหมือนเดิม (Step 4f) - ดู SyncLiveViewGrid/ComputeLiveViewTargets
                     ใน .xaml.cs สำหรับตรรกะเพิ่ม/ลด cell อัตโนมัติตามห้อง+ตัวกรองที่เลือก ========== -->
                <TabItem x:Name="LiveViewTabItem" Header="Live View" controls:Nav.Icon="grid" controls:Nav.Group="">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- หัวข้อ + ตัวเลือกห้อง + สถานะ -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Live View" Style="{StaticResource Heading2}" VerticalAlignment="Center"/>
                            <!-- เลือกห้อง = เห็นทุกเครื่องในห้องนั้นทันที (ไม่ต้องกด "เพิ่ม" อีกต่อไป) -
                                 ตัวเลือกใช้ RoomFilterOption เดียวกับตัวกรองห้องของแท็บ Clients (ดู BuildRoomFilterOptions) -->
                            <ComboBox Grid.Column="2" x:Name="LiveViewRoomCombo" VerticalAlignment="Center"
                                      DisplayMemberPath="Label" SelectionChanged="LiveViewRoomCombo_SelectionChanged"/>
                            <TextBlock Grid.Column="3" x:Name="LiveViewStatusText" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap"/>
                        </Grid>

                        <!-- แถบตัวกรอง + ปุ่มคำสั่งพร้อมกัน + สไลเดอร์ขนาดภาพย่อ -->
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0" x:Name="LiveViewFilterHandButton" Content="ยกมือ"
                                          Style="{StaticResource LiveViewFilterToggle}" Click="LiveViewFilterButton_Click"/>
                            <ToggleButton Grid.Column="2" x:Name="LiveViewFilterOnlineButton" Content="ออนไลน์"
                                          Style="{StaticResource LiveViewFilterToggle}" Click="LiveViewFilterButton_Click"/>
                            <ToggleButton Grid.Column="4" x:Name="LiveViewFilterEventButton" Content="มีเหตุการณ์"
                                          Style="{StaticResource LiveViewFilterToggle}" Click="LiveViewFilterButton_Click"/>

                            <!-- เปิดเฉพาะมีเครื่องถูกเลือกไว้ (Ctrl+คลิกใน grid) - ใช้ ActionPanelWindow เดิม (bulk mode) -->
                            <Button Grid.Column="6" x:Name="LiveViewBulkActionsButton" Content="คำสั่ง..."
                                    Style="{StaticResource ButtonSecondary}" Padding="12,6" IsEnabled="False"
                                    Click="LiveViewBulkActionsButton_Click"/>

                            <TextBlock Grid.Column="8" Text="ขนาดภาพ" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider Grid.Column="9" x:Name="LiveViewSizeSlider" VerticalAlignment="Center"
                                    Minimum="140" Maximum="320" Value="220" TickFrequency="20" IsSnapToTickEnabled="True"
                                    ValueChanged="LiveViewSizeSlider_ValueChanged"/>
                        </Grid>

                        <!-- Grid area - WrapPanel แทน UniformGrid เดิม เพื่อให้ปรับขนาด cell เองได้ (ไม่ถูกบีบให้เท่ากันหมดทั้งแถว) -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Border CornerRadius="10" Background="Black"
                                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                                    <WrapPanel x:Name="LiveViewGrid"/>
                                </ScrollViewer>
                            </Border>
                            <TextBlock x:Name="LiveViewEmptyText" Style="{StaticResource Caption}" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                       Text="ไม่มีเครื่องตรงกับตัวกรอง/ห้องที่เลือก - ลองเปลี่ยนห้องหรือล้างตัวกรอง"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========== Rules tab ========== -->
                <TabItem Header="กฎโปรแกรม" controls:Nav.Icon="shield" controls:Nav.Group="กฎ">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Rule Management" Style="{StaticResource Heading2}"/>
                            <Button Grid.Column="1" Content="เพิ่มกฎ..." Style="{StaticResource ButtonPrimary}"
                                    VerticalAlignment="Center" Click="AddRuleButton_Click"/>
                        </Grid>

                        <TextBox Grid.Row="2" x:Name="RulesSearchBox" Width="250" Height="40" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Style="{StaticResource SearchTextBox}"
                                Tag="ค้นหาชื่อกฎ/publisher..." TextChanged="RulesSearchBox_TextChanged"/>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Border CornerRadius="12" ClipToBounds="True"
                                    Background="{DynamicResource Brush.Background.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    RowBackground="{DynamicResource Brush.Background.Card}"
                                    AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                                    HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                    VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                    RowHeight="40" CanUserAddRows="False"
                                    ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                    RowStyle="{StaticResource ConsoleGridRowStyle}"
                                    CellStyle="{StaticResource ConsoleGridCellStyle}">
                                <DataGrid.Resources>
                                    <Style x:Key="RuleStatusBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                        <Setter Property="Tag" Value="Danger"/>
                                        <Setter Property="Content" Value="DISABLED"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                <Setter Property="Tag" Value="Online"/>
                                                <Setter Property="Content" Value="ENABLED"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="สถานะ" Width="90" SortMemberPath="IsEnabled">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource RuleStatusBadge}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="ชื่อกฎ" Binding="{Binding Name}" Width="130"/>
                                    <DataGridTextColumn Header="ผู้เผยแพร่" Binding="{Binding PublisherName}" Width="170"/>
                                    <DataGridTextColumn Header="ชื่อไฟล์มีคำว่า" Binding="{Binding ProcessNameContains}" Width="110"/>
                                    <DataGridTextColumn Header="ต้องมีลายเซ็น" Binding="{Binding RequireSignedMatch}" Width="90"/>
                                    <DataGridTextColumn Header="ปิดโปรแกรม" Binding="{Binding KillProcess}" Width="50"/>
                                    <DataGridTextColumn Header="คำสั่งที่รัน" Binding="{Binding ActionCommand}" Width="150"/>
                                    <DataGridTextColumn Header="ใช้กับ" Binding="{Binding ScopeText}" Width="110"/>
                                    <DataGridTemplateColumn Header="จัดการ" Width="250">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="แก้ไข" Style="{StaticResource ButtonSecondary}"
                                                            Padding="10,5" FontSize="11"
                                                            Click="EditRuleButton_Click" Tag="{Binding}" Margin="0,0,4,0"/>
                                                    <Button Content="{Binding ToggleActionText}" Style="{StaticResource ButtonSecondary}"
                                                            Padding="10,5" FontSize="11" MinWidth="66"
                                                            Click="ToggleRuleButton_Click" Tag="{Binding Id}" Margin="0,0,4,0"/>
                                                    <Button Content="ลบกฎ" Style="{StaticResource ButtonDanger}"
                                                            Padding="10,5" FontSize="11"
                                                            Click="DeleteRuleButton_Click" Tag="{Binding Id}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            </Border>
                            <ContentControl x:Name="RulesEmptyText"
                                            Style="{StaticResource EmptyState}" controls:Nav.Icon="shield"
                                            Content="ยังไม่มีกฎ" Tag="กด &quot;เพิ่มกฎ...&quot; เพื่อสร้างกฎแรก - ตราบใดที่ยังไม่มีกฎ จะไม่มีโปรแกรมไหนถูกปิด"
                                            Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========== Program Review (WP6: เดิมเป็นหน้าต่างลอย ProgramReviewWindow) ==========
                     คิวตรวจสอบโปรแกรมที่ระบบเจอแต่ตัดสินเองไม่ได้ - อยู่กลุ่ม "กฎ" คู่กับกฎโปรแกรม
                     เพราะผลของการตัดสินที่นี่ก็คือกฎอนุญาต/บล็อกถาวรเหมือนกัน -->
                <TabItem x:Name="ProgramReviewTabItem" Header="Program Review" controls:Nav.Icon="search" controls:Nav.Group="">
                    <local:ProgramReviewPage x:Name="ProgramReviewPage" Margin="0,12,0,0"/>
                </TabItem>

                <!-- ========== Website Control (WP6: เดิมเป็นหน้าต่างลอย WebsiteControlWindow) ==========
                     ยังเป็นหน้าแยกจากกฎโปรแกรมตามที่ตั้งใจไว้ตั้งแต่ 2026-09-11 (ไม่ให้กฎบล็อกแอปกับ
                     บล็อกเว็บปนกัน) แค่ย้ายจากหน้าต่างลอยมาเป็นหน้าในกลุ่มเดียวกัน -->
                <TabItem x:Name="WebsiteControlTabItem" Header="Website Control" controls:Nav.Icon="wifi" controls:Nav.Group="">
                    <local:WebsiteControlPage x:Name="WebsiteControlPage" Margin="0,12,0,0"/>
                </TabItem>

                <!-- ========== Logs tab (WP3-5, 2026-10-31: รวม Activity Logs + Audit Log เป็นหน้าเดียว
                     2 แท็บย่อย ตรงตาม wireframe docs/wireframes/con-logs.dc.html - เดิมเป็น 2 TabItem
                     บน sidebar คนละรายการ (เหลือ 1 รายการ sidebar ชื่อ "Logs / Audit" ตอนนี้) เนื้อหา/
                     ชื่อ control/event handler ของทั้งสองฝั่งเหมือนเดิมทุกตัว ย้ายมาอยู่ใต้ Grid คนละอัน
                     ที่สลับ Visibility กันเท่านั้น (ดู SetLogsSubTab ใน .xaml.cs) ========== -->
                <TabItem x:Name="LogsTabItem" Header="Logs / Audit" controls:Nav.Icon="file-text" controls:Nav.Group="บันทึก">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- หัวข้อ -->
                            <RowDefinition Height="Auto"/>   <!-- แท็บย่อย Activity/Audit -->
                            <RowDefinition Height="*"/>      <!-- เนื้อหาของแท็บย่อยที่เลือก -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Logs" Style="{StaticResource Heading2}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ActivityLogSubTabButton" Content="Activity (โปรแกรมที่ถูกจับ)"
                                    Style="{StaticResource ButtonPrimary}" Padding="12,6" FontSize="12"
                                    Click="LogsSubTabButton_Click"/>
                            <Button x:Name="AuditLogSubTabButton" Content="Audit (ใครทำอะไร)"
                                    Style="{StaticResource ButtonSecondary}" Padding="12,6" FontSize="12" Margin="8,0,0,0"
                                    Click="LogsSubTabButton_Click"/>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <!-- ===== แท็บย่อย Activity (เดิมคือ TabItem "Logs") ===== -->
                            <Grid x:Name="ActivityLogSubTabContent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" x:Name="LogsSearchBox" Width="250" Height="35" HorizontalAlignment="Left"
                                        Style="{StaticResource SearchTextBox}"
                                        Tag="ค้นหา machine/process/publisher..." TextChanged="LogsSearchBox_TextChanged"/>

                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Border CornerRadius="12" ClipToBounds="True"
                                            Background="{DynamicResource Brush.Background.Card}"
                                            BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                    <DataGrid x:Name="LogsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            RowBackground="{DynamicResource Brush.Background.Card}"
                                            AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                                            HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                            VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                            RowHeight="40" CanUserAddRows="False"
                                            ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                            RowStyle="{StaticResource ConsoleGridRowStyle}"
                                            CellStyle="{StaticResource ConsoleGridCellStyle}">
                                        <DataGrid.Resources>
                                            <Style x:Key="LogSignedBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                                <Setter Property="Tag" Value="Danger"/>
                                                <Setter Property="Content" Value="UNSIGNED"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WasSignedMatch}" Value="True">
                                                        <Setter Property="Tag" Value="Online"/>
                                                        <Setter Property="Content" Value="SIGNED"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn appctl:TimeColumn.Header="เวลา" Binding="{Binding Timestamp, Converter={StaticResource DisplayTimeConverter}}" SortMemberPath="Timestamp" Width="150"/>
                                            <DataGridTextColumn Header="เครื่อง" Binding="{Binding MachineName}" Width="130"/>
                                            <DataGridTextColumn Header="ไฟล์โปรแกรม" Binding="{Binding ProcessPath}" Width="220"/>
                                            <DataGridTextColumn Header="ผู้เผยแพร่" Binding="{Binding DetectedPublisher}" Width="160"/>
                                            <DataGridTemplateColumn Header="มีลายเซ็น" Width="100" SortMemberPath="WasSignedMatch">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ContentControl Style="{StaticResource LogSignedBadge}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="กฎที่ตรง" Binding="{Binding MatchedRuleName}" Width="120"/>
                                            <DataGridTextColumn Header="สิ่งที่ทำ" Binding="{Binding ActionTaken}" Width="150"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    </Border>
                                    <ContentControl x:Name="LogsEmptyText"
                                                    Style="{StaticResource EmptyState}" controls:Nav.Icon="file-text"
                                                    Content="ยังไม่มี log" Tag="log จะถูกบันทึกเมื่อ Agent ตรวจพบหรือปิดโปรแกรมตามกฎ"
                                                    Visibility="Collapsed"/>
                                </Grid>
                            </Grid>

                            <!-- ===== แท็บย่อย Audit (เดิมคือ TabItem "Audit Log") - ไม่ผูกกับ auto-refresh
                                 ทุก tick แบบแท็บ Activity (ดู DashboardWindow.xaml.cs LoadActivityLogPageAsync)
                                 โหลดเฉพาะตอนแท็บย่อยนี้ active เท่านั้น กัน volume สูงไม่ให้โหลดทั้งหมดฝั่ง
                                 client ทุก 10 วิ ===== -->
                            <Grid x:Name="AuditLogSubTabContent" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="AuditLogCategoryFilter" Width="160" Height="35" VerticalAlignment="Center"
                                            SelectedIndex="0" SelectionChanged="AuditLogFilter_Changed">
                                        <ComboBoxItem Content="ทุกหมวด"/>
                                        <ComboBoxItem Content="AdminAction"/>
                                        <ComboBoxItem Content="AgentConnectivity"/>
                                        <ComboBoxItem Content="SystemEvent"/>
                                    </ComboBox>
                                    <ComboBox Grid.Column="2" x:Name="AuditLogSeverityFilter" Width="160" Height="35" VerticalAlignment="Center"
                                            SelectedIndex="0" SelectionChanged="AuditLogFilter_Changed">
                                        <ComboBoxItem Content="ทุกระดับ"/>
                                        <ComboBoxItem Content="Info ขึ้นไป"/>
                                        <ComboBoxItem Content="Warning ขึ้นไป"/>
                                        <ComboBoxItem Content="Error ขึ้นไป"/>
                                    </ComboBox>
                                    <TextBox Grid.Column="4" x:Name="AuditLogClientGuidFilter" Width="260" Height="35" VerticalAlignment="Center"
                                            Style="{StaticResource SearchTextBox}"
                                            Tag="Client GUID (เว้นว่าง = ทุกเครื่อง)" TextChanged="AuditLogClientGuidFilter_TextChanged"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource ButtonSecondary}"
                                            Padding="10,5" FontSize="11" Click="AuditLogPrevButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:IconPresenter Icon="chevron-left" IconSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="ก่อนหน้า" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}"
                                            Padding="10,5" FontSize="11" Click="AuditLogNextButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ถัดไป" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <controls:IconPresenter Icon="chevron-right" IconSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Column="4" x:Name="AuditLogPageInfoText" VerticalAlignment="Center"
                                            Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                    <Border CornerRadius="12" ClipToBounds="True"
                                            Background="{DynamicResource Brush.Background.Card}"
                                            BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                    <DataGrid x:Name="AuditLogGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            RowBackground="{DynamicResource Brush.Background.Card}"
                                            AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                                            HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                            VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                            RowHeight="40" CanUserAddRows="False"
                                            ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                            RowStyle="{StaticResource ConsoleGridRowStyle}"
                                            CellStyle="{StaticResource ConsoleGridCellStyle}">
                                        <DataGrid.Resources>
                                            <Style x:Key="AuditLogSeverityBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                                <Setter Property="Tag" Value="Online"/>
                                                <Setter Property="Content" Value="{Binding Severity}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                        <Setter Property="Tag" Value="Warning"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                        <Setter Property="Tag" Value="Danger"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                        <Setter Property="Tag" Value="Danger"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn appctl:TimeColumn.Header="เวลา" Binding="{Binding Timestamp, Converter={StaticResource DisplayTimeConverter}}" SortMemberPath="Timestamp" Width="150"/>
                                            <DataGridTextColumn Header="หมวด" Binding="{Binding Category}" Width="130"/>
                                            <DataGridTemplateColumn Header="ระดับ" Width="90" SortMemberPath="Severity">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ContentControl Style="{StaticResource AuditLogSeverityBadge}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="เหตุการณ์" Binding="{Binding EventType}" Width="150"/>
                                            <DataGridTextColumn Header="รายละเอียด" Binding="{Binding Description}" Width="*"/>
                                            <DataGridTextColumn Header="เครื่อง" Binding="{Binding TargetMachineName}" Width="130"/>
                                            <DataGridTextColumn Header="ผู้ใช้ที่ทำ" Binding="{Binding ActorUsername}" Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    </Border>
                                    <ContentControl x:Name="AuditLogEmptyText"
                                                    Style="{StaticResource EmptyState}" controls:Nav.Icon="clock"
                                                    Content="ยังไม่มี activity log" Tag="ทุกการกระทำจากหน้า Console จะถูกบันทึกไว้ที่นี่"
                                                    Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========== Attendance tab (ประวัติการใช้เครื่อง, WP3-5, 2026-10-31) ==========
                     ตรงตาม wireframe docs/wireframes/nf-attendance.dc.html - ใช้ดูประกอบเท่านั้น ไม่ใช่
                     ใบเช็คชื่อทางการ (ดู docs/roadmap.md "ไม่มีตาราง/คาบเรียน") โหลดเฉพาะตอนแท็บนี้ active
                     เท่านั้น (pattern เดียวกับ Audit Log ข้างบน) -->
                <TabItem x:Name="AttendanceTabItem" Header="ประวัติการใช้เครื่อง" controls:Nav.Icon="activity" controls:Nav.Group="">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ประวัติการใช้เครื่อง" Style="{StaticResource Heading2}"/>
                                <TextBlock Text="ใครใช้เครื่องไหน เมื่อไร นานเท่าไร - ไว้ดูประกอบ ไม่ใช่ใบเช็คชื่อ"
                                           Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                            <ComboBox x:Name="AttendanceRoomFilterCombo" Width="180" Height="34" Margin="0,0,8,0"
                                     VerticalAlignment="Center" DisplayMemberPath="Label"
                                     SelectionChanged="AttendanceFilter_Changed"/>
                            <ComboBox x:Name="AttendanceClassFilterCombo" Width="160" Height="34" Margin="0,0,8,0"
                                     VerticalAlignment="Center" SelectionChanged="AttendanceFilter_Changed"/>
                            <TextBox x:Name="AttendanceSearchBox" Width="200" Height="34"
                                    Style="{StaticResource SearchTextBox}" VerticalAlignment="Center" Margin="0,0,8,0"
                                    Tag="ค้นหานักเรียน..." TextChanged="AttendanceSearchBox_TextChanged"/>
                            <Button Content="รีเฟรช" Style="{StaticResource ButtonSecondary}"
                                    Padding="12,6" FontSize="12" Click="AttendanceRefreshButton_Click"/>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Border CornerRadius="12" ClipToBounds="True"
                                    Background="{DynamicResource Brush.Background.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                <DataGrid x:Name="AttendanceGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        RowBackground="{DynamicResource Brush.Background.Card}"
                                        AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                                        HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                        VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                        RowHeight="40" CanUserAddRows="False"
                                        ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                        RowStyle="{StaticResource ConsoleGridRowStyle}"
                                        CellStyle="{StaticResource ConsoleGridCellStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="นักเรียน" Binding="{Binding Student.FullName}" Width="170"/>
                                        <DataGridTextColumn Header="ห้องเรียน" Binding="{Binding Student.ClassName}" Width="100"/>
                                        <DataGridTextColumn Header="เครื่อง" Binding="{Binding MachineName}" Width="110"/>
                                        <DataGridTextColumn appctl:TimeColumn.Header="เข้า" Binding="{Binding StartedAt, Converter={StaticResource DisplayTimeConverter}}" SortMemberPath="StartedAt" Width="150"/>
                                        <DataGridTextColumn appctl:TimeColumn.Header="ออก" Binding="{Binding EndedAt, Converter={StaticResource DisplayTimeConverter}}" SortMemberPath="EndedAt" Width="150"/>
                                        <DataGridTextColumn Header="นาน" Binding="{Binding DurationText}" Width="100"/>
                                        <DataGridTextColumn Header="ออกโดย" Binding="{Binding EndReasonText}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <ContentControl x:Name="AttendanceEmptyText"
                                            Style="{StaticResource EmptyState}" controls:Nav.Icon="activity"
                                            Content="ไม่มีประวัติการใช้เครื่องในช่วงที่เลือก" Tag="ลองล้างตัวกรองหรือเลือกช่วงเวลาอื่น"
                                            Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========== Users tab ========== -->
                <TabItem x:Name="UsersTabItem" Header="ผู้ใช้" controls:Nav.Icon="users" controls:Nav.Group="ระบบ">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="User Management" Style="{StaticResource Heading2}"/>

                        <!--
                            x:Name="AddUserPanel" (WP4b, 2026-10-30): ซ่อนทั้งก้อนสำหรับ Teacher - endpoint
                            POST /api/admin/users เป็น Admin เท่านั้น (RequireAdmin ฝั่ง Server ตอบ 403) ซ่อน
                            แทนปิดปุ่มเฉยๆ เพราะ Teacher เข้าแท็บนี้ไม่ได้อยู่แล้ว (GET /api/admin/users ก็
                            Admin เท่านั้นเหมือนกัน - ดู ApplyRolePermissions ที่ซ่อน UsersTabItem ทั้งแท็บ)
                            คงพาเนลนี้ไว้เผื่ออนาคตเปิดให้ Teacher ดู read-only
                        -->
                        <!-- บั๊ก (C1, 2026-10-31 -> แก้ WP2-1): ปุ่ม "เพิ่มผู้ใช้" ถูกตัดขอบที่ความกว้าง
                             ~1000px - เดิมใช้ Grid คอลัมน์ Auto ตายตัว 5 ช่อง (150+160+170+110 + ปุ่ม)
                             รวมกันกว้างกว่าพื้นที่ที่เหลือตอนหน้าต่าง/sidebar แคบลง คอลัมน์ "*" ที่ตั้งใจ
                             ดันปุ่มไปชิดขวาหดเป็น 0 ไม่ได้ช่วยเพราะ Grid ไม่ยอมบีบคอลัมน์ Auto ที่เหลือ
                             ผลคือ AddUserButton (คอลัมน์สุดท้าย) ล้นขอบ Border ออกไปแบบมองไม่เห็น เปลี่ยน
                             เป็น WrapPanel แทน (ตรงกับ wireframe con-users.dc.html ที่ใช้ flex-wrap: wrap
                             อยู่แล้ว) ช่องจะขึ้นบรรทัดใหม่เองเมื่อแคบเกินไป ไม่มีอะไรล้น/ถูกตัดอีก -->
                        <Border x:Name="AddUserPanel" Grid.Row="1" CornerRadius="10" Padding="12" Margin="0,10,0,0"
                                Background="{DynamicResource Brush.Background.Primary}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1">
                            <WrapPanel Orientation="Horizontal">
                                <TextBox x:Name="NewUserUsernameBox" Width="150" Height="35" VerticalAlignment="Center" Margin="0,0,8,8"
                                         Style="{StaticResource PlaceholderTextBox}" Tag="Username"
                                         ToolTip="Username" TextChanged="NewUserUsernameBox_TextChanged"/>
                                <!-- ชื่อที่แสดง: ว่างไว้ได้ - Server fallback เป็น Username เอง (WP4b, 2026-10-30)
                                     ลำดับช่อง (C1, 2026-10-31): สลับมาอยู่ก่อน Password ตาม wireframe con-users.dc.html
                                     (Username -> ชื่อที่แสดง -> Password -> Role) -->
                                <TextBox x:Name="NewUserDisplayNameBox" Width="160" Height="35" VerticalAlignment="Center" Margin="0,0,8,8"
                                         Style="{StaticResource PlaceholderTextBox}" Tag="ชื่อที่แสดง (ว่างไว้ = ใช้ Username)"
                                         ToolTip="ชื่อที่แสดง (ว่างไว้ = ใช้ Username)"/>
                                <PasswordBox x:Name="NewUserPasswordBox" Width="170" Height="35" VerticalAlignment="Center" Margin="0,0,8,8"
                                             Style="{StaticResource PlaceholderPasswordBox}" Tag="Password (อย่างน้อย 8 ตัว)"
                                             ToolTip="Password (อย่างน้อย 8 ตัวอักษร)"/>
                                <ComboBox x:Name="NewUserRoleCombo" Width="110" Height="35" VerticalAlignment="Center" Margin="0,0,8,8"
                                          ToolTip="Role ของบัญชีใหม่" SelectedIndex="0">
                                    <ComboBoxItem Content="Admin" Tag="0"/>
                                    <ComboBoxItem Content="Teacher" Tag="1"/>
                                </ComboBox>
                                <Button x:Name="AddUserButton" Content="เพิ่มผู้ใช้" Style="{StaticResource ButtonPrimary}"
                                        VerticalAlignment="Center" Margin="0,0,0,8" Click="AddUserButton_Click"/>
                            </WrapPanel>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Border CornerRadius="12" ClipToBounds="True"
                                    Background="{DynamicResource Brush.Background.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    RowBackground="{DynamicResource Brush.Background.Card}"
                                    AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                                    HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                    VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                    RowHeight="40" CanUserAddRows="False"
                                    ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                    RowStyle="{StaticResource ConsoleGridRowStyle}"
                                    CellStyle="{StaticResource ConsoleGridCellStyle}">
                                <DataGrid.Columns>
                                    <!-- ชื่อที่แสดง + Role (WP4b, 2026-10-30) - Role มาจาก Server เป็น string อยู่แล้ว ("Admin"/"Teacher")
                                         ลำดับคอลัมน์ (C1, 2026-10-31): ชื่อที่แสดงอยู่ก่อน Username ตาม wireframe con-users.dc.html
                                         เพราะชื่อที่แสดงคือสิ่งที่คนเห็นจริงทุกที่ (Staff session, "ล็อกโดย...") Username
                                         แค่ใช้ล็อกอิน แก้ไม่ได้ -->
                                    <DataGridTextColumn Header="ชื่อที่แสดง" Binding="{Binding DisplayName}" Width="150"/>
                                    <DataGridTextColumn Header="ชื่อผู้ใช้" Binding="{Binding Username}" Width="120"/>
                                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="80"/>
                                    <DataGridTextColumn Header="บัญชีระบบ" Binding="{Binding IsBuiltIn}" Width="80"/>
                                    <DataGridTextColumn Header="ใช้รหัสผ่านเริ่มต้น" Binding="{Binding HasDefaultPassword}" Width="130"/>
                                    <DataGridTextColumn appctl:TimeColumn.Header="สร้างเมื่อ" Binding="{Binding CreatedAt, Converter={StaticResource DisplayTimeConverter}}" SortMemberPath="CreatedAt" Width="160"/>
                                    <DataGridTextColumn appctl:TimeColumn.Header="ล็อกอินล่าสุด" Binding="{Binding LastLoginAt, Converter={StaticResource DisplayTimeConverter}}" SortMemberPath="LastLoginAt" Width="160"/>
                                    <DataGridTemplateColumn Header="จัดการ" Width="380">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <!--
                                                        ปุ่มแก้ชื่อที่แสดง: ใช้ได้กับทุก account รวม built-in
                                                        (เจ้าของบัญชีแก้เองได้ Admin แก้ให้คนอื่นได้ - Server ตัดสิน)
                                                    -->
                                                    <Button Content="แก้ชื่อที่แสดง" Tag="{Binding}"
                                                            Click="EditDisplayNameButton_Click"
                                                            Style="{StaticResource ButtonSecondary}"
                                                            Padding="10,5" FontSize="11"
                                                            Margin="0,0,4,0"/>

                                                    <!--
                                                        ปุ่มเปลี่ยน Role (WP4b): disable ถ้าเป็น built-in account
                                                        (ต้องเป็น Admin เสมอกัน lockout - Server ปฏิเสธเหมือนกัน)
                                                    -->
                                                    <Button Content="เปลี่ยน Role" Tag="{Binding}"
                                                            Click="ChangeUserRoleButton_Click"
                                                            Padding="10,5" FontSize="11"
                                                            Margin="0,0,4,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="ToolTip" Value="เปลี่ยน role ของ built-in account ไม่ได้"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!--
                                                        ปุ่ม RESET PW: ใช้ได้กับทุก account รวม built-in
                                                        (ต่างจาก DELETE ที่ต้องกันไว้เพราะลบ built-in ไม่ได้เลย)
                                                    -->
                                                    <Button Content="รีเซ็ตรหัสผ่าน" Tag="{Binding}"
                                                            Click="ResetUserPasswordButton_Click"
                                                            Style="{StaticResource ButtonSecondary}"
                                                            Padding="10,5" FontSize="11"
                                                            Margin="0,0,4,0"/>

                                                    <!--
                                                        ปุ่มลบ: disable ถ้าเป็น built-in account (กัน lockout)
                                                        ใช้ DataTrigger เทียบ IsBuiltIn แทนการเขียน converter class ใหม่

                                                        ข้อความ (C1, 2026-10-31): "ลบ" แทน "DELETE" เดิม - ตรงกับ
                                                        wireframe con-users.dc.html และปุ่มลบที่อื่นในแอป (เช่น
                                                        WebsiteCatalogSourcesWindow) ที่ใช้ "ลบ" อยู่แล้วทั้งหมด
                                                        DELETE ตัวเดียวที่เหลือเป็นภาษาอังกฤษแบบไม่มีเหตุผลรองรับ
                                                    -->
                                                    <Button Content="ลบ" Tag="{Binding Id}"
                                                            Click="DeleteUserButton_Click"
                                                            Padding="10,5" FontSize="11">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonDanger}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="ToolTip" Value="ลบ built-in account ไม่ได้"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            </Border>
                            <ContentControl x:Name="UsersEmptyText"
                                            Style="{StaticResource EmptyState}" controls:Nav.Icon="users"
                                            Content="ยังไม่มีผู้ใช้เพิ่มเติม" Tag="เพิ่มบัญชีให้ครูคนอื่นได้จากช่องด้านบน"
                                            Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========== ตั้งค่า (WP6: เดิมเป็นหน้าต่าง SettingsWindow ที่เปิดจากเมนูเฟือง) ========== -->
                <TabItem x:Name="SettingsTabItem" Header="ตั้งค่า" controls:Nav.Icon="settings" controls:Nav.Group="">
                    <local:SettingsPage x:Name="SettingsPage" Margin="0,12,0,0"/>
                </TabItem>

            </TabControl>

        <!-- ==================== Live View full-screen overlay (Step 4f) ====================
             sibling ของ Toolbar/Main content/Footer ที่ root Grid เดียวกัน แต่ต้องเป็น element
             *สุดท้าย* ใน Grid เท่านั้น (children วาดทับบนสุดตามลำดับ declare เหมือนตอนเป็น Canvas -
             ย้ายมาอยู่หลังสุดไว้เหมือนเดิม) Grid.Row="0" Grid.RowSpan="3" ครอบคลุมพื้นที่เดียวกับ root
             Grid ทั้งหมด (toolbar/content/footer) เพื่อให้เป็น "full-screen" (เทียบกับ DashboardWindow เอง)
             จริงตามที่ขอ - เดิม hardcode Width="968" Height="648" ตรงกับขนาด Canvas เดิมพอดี ตอนนี้ไม่ต้อง
             set ขนาดเองแล้ว (Grid เติมเต็ม cell ที่ span ให้อัตโนมัติ) เพื่อให้ resize หน้าต่างระหว่างเปิด
             full-screen ได้จริง - ปุ่ม "กลับไป Grid" อยู่มุมบนซ้ายชัดเจนเสมอเป็นทางเดียวที่กดออกจากโหมดนี้ได้

             Step 4h: Focusable="True" + FocusVisualStyle="{x:Null}" - overlay Border เองเป็นตัวรับ
             keyboard focus โดยตรง (ไม่ต้องมี invisible focus-sink control แยก) PreviewKeyDown/Up ผูกไว้ที่
             Border นี้ (tunnel event เลยรับได้ไม่ว่า element ลูกตัวไหนจะถืออยู่จริง) ส่วน mouse
             move/down/up/wheel ผูกที่ FullscreenImage โดยตรง (ดู DashboardWindow.xaml.cs ส่วน "Live View
             full-screen input capture") - TryMapFullscreenPointToTarget อ่าน FullscreenImage.ActualWidth/
             ActualHeight สดทุกครั้งที่มี mouse event อยู่แล้ว (ไม่ cache) เลยรองรับ resize ได้เองโดยไม่ต้อง
             แก้ logic นั้นเลย ตราบใดที่ FullscreenImage ยังอยู่ใน container ที่ stretch จริง (Border Grid.Row="1"
             ด้านล่างนี้ stretch เต็ม Grid.Row="*" ของ overlay เอง) - verify ด้วยการ resize จริงระหว่างเปิด
             full-screen แล้วดูว่าพิกัดคลิกยังตรงตำแหน่งเป้าหมาย ไม่ใช่แค่เชื่อ logic เฉยๆ -->
        <Border x:Name="LiveViewFullscreenOverlay"
                Background="{DynamicResource Brush.Background.Primary}" Visibility="Collapsed"
                Focusable="True" FocusVisualStyle="{x:Null}"
                PreviewKeyDown="LiveViewFullscreenOverlay_PreviewKeyDown"
                PreviewKeyUp="LiveViewFullscreenOverlay_PreviewKeyUp"
                IsKeyboardFocusWithinChanged="LiveViewFullscreenOverlay_IsKeyboardFocusWithinChanged">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- เว้นระยะจากมุมซ้ายบน (2026-09-10) - เดิมปุ่มชิดขอบจนดูเหมือนหลุดออกนอกกรอบ
                     และบนจอที่ขอบมนของ Windows จะเฉียดมุมพอดี -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,14,16,12">
                    <Button Style="{StaticResource ButtonPrimary}"
                            Padding="14,8" Click="BackToGridButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconPresenter Icon="chevron-left" IconSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="กลับไปจอรวม" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Toggle target input: กันนักเรียนแย่งเมาส์/คีย์บอร์ดขณะครูควบคุมผ่าน full-screen VNC
                         (ดู PhysicalInputBlocker ฝั่ง AgentTray) - default ปิด (ไม่บล็อก) ตั้งแต่เข้า
                         fullscreen ทุกครั้ง (ดู ExpandLiveViewCell ที่ reset _targetInputBlocked) Content/
                         Style สลับใน code-behind ตาม _targetInputBlocked ไม่ใช่ XAML trigger เพราะต้อง sync
                         กับผลจริงของ SendCommandAsync ด้วย (ไม่ optimistic toggle เฉยๆ) -->
                    <Button x:Name="ToggleTargetInputButton" Content="BLOCK STUDENT INPUT"
                            Style="{StaticResource ButtonSecondary}"
                            Padding="14,8" Margin="10,0,0,0" Click="ToggleTargetInputButton_Click"/>
                    <!-- สั่งงานเครื่องที่กำลังดูอยู่ได้โดยไม่ต้องออกจากเต็มจอก่อน - ที่ผ่านมาต้องกลับไป
                         จอรวม แล้วไปแท็บ Clients แล้วค่อยหาเครื่องเดิมให้เจอ -->
                    <Button x:Name="FullscreenActionsButton" Content="คำสั่ง..."
                            Style="{StaticResource ButtonSecondary}"
                            Padding="14,8" Margin="10,0,0,0" Click="FullscreenActionsButton_Click"/>
                    <TextBlock x:Name="FullscreenHeaderText" Style="{StaticResource Heading2}"
                               Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FullscreenStatusText" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource Brush.Danger.Default}"
                               Margin="20,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ระยะขอบตรงกับ toolbar ด้านบน (16) เพื่อให้ทั้งหน้าเป็นกรอบเดียวกัน - เดิม toolbar
                     เว้นระยะแล้วแต่จอวิดีโอยังชิดขอบหน้าต่าง ทำให้ดูเหมือนวางคนละชั้น -->
                <Border Grid.Row="1" Background="Black" CornerRadius="10" Margin="16,0,16,14"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                    <!-- Step 4h: คุมเมาส์เต็มพื้นที่ Image นี้ - Stretch="Uniform" ทำให้ภาพ letterbox
                         (แถบดำซ้าย-ขวาหรือบน-ล่าง) ถ้าอัตราส่วน target ไม่ตรงกับพื้นที่แสดงผลพอดี ต้องแปลง
                         พิกัดคลิกกลับเป็นพิกัดจริงของ target เอง (ดู TryMapFullscreenPointToTarget) -->
                    <Image x:Name="FullscreenImage" Stretch="Uniform"
                           PreviewMouseMove="FullscreenImage_PreviewMouseMove"
                           PreviewMouseDown="FullscreenImage_PreviewMouseDown"
                           PreviewMouseUp="FullscreenImage_PreviewMouseUp"
                           PreviewMouseWheel="FullscreenImage_PreviewMouseWheel"/>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== Toast มุมขวาล่าง (WP6) ====================
             element สุดท้ายของ root Grid = วาดทับทุกอย่างรวมถึง overlay ดูจอเต็มจอ (ผลของคำสั่งที่สั่ง
             จากหน้าเต็มจอต้องเห็นได้โดยไม่ต้องออกมาก่อน) ระยะล่าง 80 = เหนือแถบสถานะล่าง ระยะขวาถูก
             ขยับหลบแผงข้อมูลเครื่องจาก code-behind (UpdateToastOffset) ไม่มี Background จึงไม่บังคลิก
             นอกตัว toast -->
        <appctl:ToastHost x:Name="Toasts" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,34,80"/>
    </Grid>
</UserControl>
