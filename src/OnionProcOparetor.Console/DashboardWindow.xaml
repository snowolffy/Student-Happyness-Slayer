<Window x:Class="OnionProcOparetor.Console.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnionProcOparetor.Console.Controls"
        xmlns:local="clr-namespace:OnionProcOparetor.Console"
        Title="Onion ProcOparetor Console - Dashboard"
        Height="732" Width="1000"
        MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}"
        Background="{DynamicResource Brush.Background.Primary}">
    <!--
        Layout: Toolbar -> TabControl with 6 tabs: CLIENTS / RULES / LOGS / USERS / SCREEN VIEW / LIVE VIEW
        -> footer status bar, on a root Grid (Auto/*/Auto rows) so the window can actually be resized -
        was Canvas before (2026-08-05 Phase 1 UI rebuild converted it back to Grid, per the "if you need a
        resizable Dashboard again, switch back to Grid" note that used to live right here). Each tab's own
        content is a Grid too (Auto rows for title/toolbar/search, * for the DataGrid so it fills whatever
        space is left) instead of a Canvas with pixel-fixed positions. Shared DataGrid header/row/cell
        styles (ConsoleGridColumnHeaderStyle/ConsoleGridRowStyle/ConsoleGridCellStyle) moved to
        Theme/Controls.xaml (2026-08-25) so other Windows (e.g. RunningProcessesWindow) can actually
        resolve them too - StaticResource lookups don't cross between separate Window.Resources, which
        was a real crash (XamlParseException on open) until they became genuinely app-wide.
        MinWidth/MinHeight are set to keep the toolbar buttons and the 6 tab headers from overlapping/
        wrapping at small sizes - re-check these if a tab's content changes materially later.
    -->
    <Grid>
        <!-- ==================== โครงหน้าจอ: sidebar ซ้าย + เนื้อหาขวา (2026-09-09) ====================
             เดิมเป็น "แถบเครื่องมือบน + แท็บเรียงแนวนอน" เปลี่ยนมาเป็น sidebar ให้ตรงกับ OnlineConsole
             โดย **ยังเป็น TabControl ตัวเดิมทุกประการ** - เปลี่ยนแค่ ControlTemplate ให้ panel ที่
             IsItemsHost ไปอยู่คอลัมน์ซ้าย และเปลี่ยน ItemContainerStyle เป็นแถวเมนู ผลคือ
             MainTabControl_SelectionChanged / ScreenViewTabItem / AuditLogTabItem / LiveViewTabItem
             และโค้ดที่สั่งสลับแท็บเองยังทำงานเหมือนเดิมทั้งหมด ไม่ต้องแก้ code-behind เลย

             แถบบนกับแถบสถานะล่างส่งเข้า template ผ่าน Nav.TopBar / Nav.StatusBar แทนที่จะย้ายเข้าไป
             เขียนใน template ตรง ๆ เพราะ element ที่อยู่ใน ControlTemplate จะไม่มี field ให้ code-behind
             เรียกถึงด้วย x:Name (คนละ namescope) - ดูเหตุผลเต็มใน Controls/Nav.cs

             ลำดับแท็บถูกจัดใหม่ให้กลุ่มติดกัน (ตรวจตรา / กฎและการบังคับใช้ / ระบบ) ตาม NavMenu.razor
             ซึ่งปลอดภัยเพราะไม่มีโค้ดตรงไหนอ้างแท็บด้วย index เลย มีแต่ SelectedItem กับชื่อ TabItem
        -->
        <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0"
                    ItemContainerStyle="{StaticResource SidebarTabItem}"
                    SelectionChanged="MainTabControl_SelectionChanged">

            <!-- ==================== แถบหัว + ประกาศสถานะทั้งระบบ (WP6) ====================
                 AnnouncementBar สูง 60px คงที่ทุกกรณี: ปกติแสดงปลายทางที่ต่ออยู่กับเวลาอัพเดตล่าสุด
                 พอมีเรื่องระดับทั้งระบบ (gate ปิด / Server หลุด / การอัปเดตสดหลุด) ทั้งแถบเปลี่ยนสี
                 เป็นประกาศพร้อมปุ่มแก้ในตัว - ไม่มีแถบแทรกเพิ่มเหมือน GlobalOffBanner เดิม ตาราง
                 ทุกหน้าจึงไม่ขยับแม้แต่พิกเซลเดียวตอนประกาศโผล่หรือหายไป

                 ทำไมยังมีปุ่ม "เปิดการบังคับใช้กลับ" ที่นี่ทั้งที่แท็บ Clients มีสวิตช์ของตัวเอง:
                 แถบหัวเห็นจากทุกหน้า สวิตช์อยู่หน้าเดียว ถ้าเอาออก คนที่อยู่หน้าอื่นจะเห็นคำเตือน
                 แต่กดแก้ไม่ได้ ซึ่งคือบั๊กเดิม 2026-09-04 เป๊ะ ๆ (12d774a "visible and reachable")

                 ข้อความผลลัพธ์ (สำเร็จ/ล้มเหลว) ไม่อยู่ที่แถบนี้อีกแล้ว ย้ายไปเป็น toast มุมขวาล่าง
                 (Services/ToastService) StatusText ที่เหลือบอกแค่ "อัพเดตล่าสุดเมื่อไหร่" -->
            <controls:Nav.TopBar>
                <controls:AnnouncementBar x:Name="HeaderBar" Margin="0,0,0,12">
                    <controls:AnnouncementBar.NormalContent>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:IconPresenter Icon="wifi" IconSize="16" VerticalAlignment="Center"
                                                        Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <TextBlock x:Name="ServerLabel" Text="" Style="{StaticResource Caption}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Width="170" x:Name="StatusText" Style="{StaticResource Caption}"
                                       TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </Grid>
                    </controls:AnnouncementBar.NormalContent>
                    <controls:AnnouncementBar.TrailingContent>
                        <Button x:Name="RefreshButton" Content="รีเฟรช"
                                Style="{StaticResource ButtonSecondary}" Padding="14,7"
                                Click="RefreshButton_Click" VerticalAlignment="Center"/>
                    </controls:AnnouncementBar.TrailingContent>
                </controls:AnnouncementBar>
            </controls:Nav.TopBar>

            <controls:Nav.StatusBar>
                <!-- ==================== Footer status bar ==================== -->
                <Border Height="52" Margin="0,10,0,0" CornerRadius="12"
                        Background="{DynamicResource Brush.Background.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1" Padding="16,10">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Server:" Style="{StaticResource Label}"/>
                        <TextBlock Grid.Column="1" Width="300" x:Name="FooterServerText" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="User:" Style="{StaticResource Label}"/>
                        <TextBlock Grid.Column="4" Width="200" x:Name="FooterUserText" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
                    </Grid>
                </Border>
            </controls:Nav.StatusBar>

            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ========== Sidebar ========== -->
                        <Border x:Name="SidebarRoot" Grid.Column="0" Width="248"
                                Background="{DynamicResource Brush.Sidebar.Background}"
                                BorderBrush="{DynamicResource Brush.Sidebar.Border}"
                                BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="14,16,12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                            Background="{DynamicResource Brush.Accent.Default}">
                                        <Border.Clip>
                                            <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,36,36"/>
                                        </Border.Clip>
                                        <Image Source="/Theme/logo.png" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel x:Name="BrandText" Grid.Column="1" Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Onion ProcOparetor" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Sidebar.Text}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Server Console" FontSize="11"
                                                   Foreground="{DynamicResource Brush.Sidebar.TextSecondary}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- StackPanel ไม่ใช่ TabPanel เหมือนเดิม (เหตุผลเดิมจากปี 2026-09-03 ยังใช้ได้:
                                     TabPanel มี layout บีบความกว้างของตัวเองที่ ControlTemplate ไหนก็แก้ไม่ได้
                                     ทำให้ป้ายชื่อโดนตัด) แค่เปลี่ยนจาก Horizontal เป็นแนวตั้งซึ่งเป็นค่า default
                                     ครอบ ScrollViewer ไว้เพราะเมนู 10 รายการ + หัวข้อกลุ่ม 4 กลุ่ม สูงเกินจอเตี้ย ๆ ได้ -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel IsItemsHost="True" Background="Transparent"/>
                                </ScrollViewer>

                                <StackPanel Grid.Row="2" Margin="0,8,0,10">
                                    <Border Height="1" Margin="12,0,12,8"
                                            Background="{DynamicResource Brush.Sidebar.Border}"/>
                                    <!-- Program Review / Website Control / Settings เคยเป็นปุ่มเปิดหน้าต่างลอยอยู่ตรงนี้
                                         ตอนนี้กลายเป็นหน้าในกลุ่ม "กฎ" และ "ระบบ" ของ sidebar แล้ว (WP6) ท้าย sidebar
                                         จึงเหลือเฉพาะสิ่งที่ "สั่งงาน" ไม่ใช่ "ที่ที่ไปได้" -->
                                    <Button x:Name="ThemeToggleButton" Style="{StaticResource SidebarActionButton}"
                                            controls:Nav.Icon="moon" Content="ธีมมืด"
                                            ToolTip="สลับธีมสว่าง/มืด"
                                            Click="ThemeToggleButton_Click"/>
                                    <Button x:Name="SidebarCollapseButton" Style="{StaticResource SidebarActionButton}"
                                            controls:Nav.Icon="chevron-left" Content="ย่อเมนู"
                                            ToolTip="ย่อ/ขยายเมนู"
                                            Click="SidebarCollapseButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ========== เนื้อหา ========== -->
                        <Grid Grid.Column="1" Margin="16,16,16,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ContentPresenter Grid.Row="0"
                                              Content="{Binding (controls:Nav.TopBar), RelativeSource={RelativeSource TemplatedParent}}"/>

                            <Border Grid.Row="1" CornerRadius="12" Padding="16"
                                    Background="{DynamicResource Brush.Background.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="1">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>

                            <ContentPresenter Grid.Row="2"
                                              Content="{Binding (controls:Nav.StatusBar), RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Nav.IsCollapsed ตั้งที่ TabControl ตัวเดียวจาก code-behind แล้วไหลลงไปทั้งต้นไม้เอง
                             (property นี้ประกาศเป็น Inherits) แถวเมนูทุกแถวกับปุ่มท้าย sidebar จึงรู้พร้อมกัน
                             โดยไม่ต้องไล่หา element ข้าม namescope -->
                        <Trigger Property="controls:Nav.IsCollapsed" Value="True">
                            <Setter TargetName="SidebarRoot" Property="Width" Value="64"/>
                            <Setter TargetName="BrandText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </TabControl.Template>

                <!-- ========== Clients tab ========== -->
                <TabItem x:Name="ClientsTabItem" Header="Clients" controls:Nav.Icon="monitor" controls:Nav.Group="ห้องเรียน">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- หัวข้อ + ช่องค้นหา -->
                            <RowDefinition Height="Auto"/>   <!-- การ์ดตัวเลข = ตัวกรอง -->
                            <RowDefinition Height="Auto"/>   <!-- แถบคำสั่ง: ทั้งห้อง (ซ้าย) + ที่เลือก (ขวา) -->
                            <RowDefinition Height="*"/>      <!-- ตาราง + แผงรายละเอียด -->
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Client Management" Style="{StaticResource Heading2}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="ClientsSearchBox" Width="240" Height="34"
                                    Style="{StaticResource SearchTextBox}" VerticalAlignment="Center"
                                    Tag="ค้นหาชื่อเครื่อง..." TextChanged="ClientsSearchBox_TextChanged"/>
                        </Grid>

                        <!-- ==================== การ์ดตัวเลขสรุป = ตัวกรองไปในตัว ====================
                             แนวปฏิบัติของ dashboard ยุคนี้คือ "ตัวเลขสำคัญไม่กี่ตัวใหญ่ ๆ ข้างบน ที่เหลือ
                             เจาะลงไปได้ในคลิกเดียว" ที่นี่การเจาะลงไปคือตัวการ์ดเอง - กดแล้วตารางข้างล่าง
                             กรองตามทันที ไม่ต้องมี dropdown ตัวกรองแยกอีกตัวที่ซ่อนทั้งตัวเลือกและค่าปัจจุบัน

                             เลือก 4 ตัวนี้เพราะตอบคำถามที่ครูถามจริงตอนเดินเข้าห้อง: มากี่เครื่อง หายไปกี่เครื่อง
                             และมีเครื่องไหนที่กฎไม่ทำงานอยู่บ้าง ตัวเลขทั้งหมดคำนวณจากข้อมูลที่โหลดมาแล้ว
                             ไม่ต้องยิง API เพิ่มแม้แต่ครั้งเดียว -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton x:Name="ClientStatAll" Style="{StaticResource StatCardFilter}"
                                         GroupName="ClientStatFilter" IsChecked="True" Tag="0" Content="ทั้งหมด"
                                         Checked="ClientStatFilter_Checked"/>
                            <RadioButton x:Name="ClientStatOnline" Style="{StaticResource StatCardFilter}"
                                         GroupName="ClientStatFilter" Tag="0" Content="ออนไลน์"
                                         Foreground="{DynamicResource Brush.Status.Online}"
                                         Checked="ClientStatFilter_Checked"/>
                            <RadioButton x:Name="ClientStatOffline" Style="{StaticResource StatCardFilter}"
                                         GroupName="ClientStatFilter" Tag="0" Content="ออฟไลน์"
                                         Foreground="{DynamicResource Brush.Status.Offline}"
                                         Checked="ClientStatFilter_Checked"/>
                            <RadioButton x:Name="ClientStatNotEnforcing" Style="{StaticResource StatCardFilter}"
                                         GroupName="ClientStatFilter" Tag="0" Content="กฎไม่ทำงาน"
                                         Foreground="{DynamicResource Brush.Status.WarningText}"
                                         ToolTip="เครื่องที่ Agent ไม่ได้บังคับใช้กฎอยู่จริง (รวมกรณีที่ถูกปิดด้วย gate ทั้งระบบ)"
                                         Checked="ClientStatFilter_Checked"/>
                        </StackPanel>

                        <!-- ==================== แถบคำสั่ง ====================
                             ซ้าย = สิ่งที่ทำกับ "ทั้งห้อง" ทำได้เสมอโดยไม่ต้องเลือกเครื่องก่อน
                             ขวา  = สิ่งที่ทำกับ "เครื่องที่เลือกไว้" โผล่เมื่อมี selection

                             ทั้งสองกลุ่มอยู่ **แถวเดียวกัน** และกลุ่มขวาใช้ Visibility="Hidden" ไม่ใช่
                             "Collapsed" - นี่คือแก้บั๊กจริง ไม่ใช่เรื่องจัดหน้า: ของเดิมแถบเลือกเป็นแถว
                             แยกที่ Collapsed อยู่ พอคลิกเลือกเครื่องหนึ่ง แถวนั้นแทรกเข้ามาแล้ว
                             **ดันตารางลงไปทั้งแถบ** คลิกครั้งถัดไปจึงไปโดนเครื่องคนละตัวกับที่เล็งไว้
                             ในหน้าจอที่มีปุ่ม SHUTDOWN อยู่ด้วย นั่นไม่ใช่ปัญหาความสวยงาม

                             Hidden กันที่ไว้เท่าเดิมทุกประการ ความสูงของแถวจึงคงที่ไม่ว่าจะเลือกหรือไม่
                             และไม่ต้องไปตรึงความสูงเป็นตัวเลข ซึ่งจะพังเมื่อ DPI หรือขนาดฟอนต์ต่างไป -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- ไม่ตั้ง MinWidth: ข้อความสองสถานะยาวใกล้กันอยู่แล้ว การตรึงความกว้าง
                                     มีแต่จะกินที่ของกลุ่มขวาจนโดนตัด -->
                                <Button x:Name="GlobalEnforcementButton" Style="{StaticResource ButtonSecondary}"
                                        Padding="12,6" FontSize="11"
                                        Click="GlobalEnforcementButton_Click" VerticalAlignment="Center"/>
                                <Button Content="คำสั่ง (ทุกเครื่อง)" Style="{StaticResource ButtonSecondary}"
                                        Padding="12,6" FontSize="11" Margin="8,0,0,0"
                                        ToolTip="เปิดแผงคำสั่งโดยตั้งเป้าเป็นทุกเครื่องไว้ให้ - เปลี่ยนเป้าในแผงได้"
                                        Click="RoomActionsButton_Click" VerticalAlignment="Center"/>
                                <Button Content="ส่งข้อความขึ้นจอ" Style="{StaticResource ButtonSecondary}"
                                        Padding="12,6" FontSize="11" Margin="8,0,0,0"
                                        ToolTip="ส่งข้อความขึ้นจอนักเรียน - เลือกได้ว่าทุกเครื่องหรือเฉพาะที่เลือกไว้"
                                        Click="BroadcastMessageButton_Click" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1" x:Name="ClientsSelectionBar" Style="{StaticResource SelectionBar}"
                                    Padding="12,5" Margin="12,0,0,0" Visibility="Hidden"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:IconPresenter Icon="check-circle" IconSize="16" VerticalAlignment="Center"
                                                            Foreground="{DynamicResource Brush.Accent.Text}"/>
                                    <TextBlock x:Name="SelectedClientsCountText" Text="" Margin="7,0,10,0"
                                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.Accent.Text}"/>
                                    <Button Content="คำสั่ง" Style="{StaticResource ButtonPrimary}"
                                            Padding="12,5" FontSize="11"
                                            ToolTip="เปิดแผงคำสั่งกับเครื่องที่เลือกไว้"
                                            Click="BulkActionsButton_Click" VerticalAlignment="Center"/>
                                    <!-- ปุ่มล้างเป็นไอคอนอย่างเดียว: ข้อความ "ล้างการเลือก" ทำให้แถวยาวเกิน
                                         ความกว้างต่ำสุดของหน้าต่างจนโดนตัดหายไปนอกจอ -->
                                    <Button Style="{StaticResource ButtonSecondary}"
                                            Padding="7,5" Margin="6,0,0,0"
                                            ToolTip="ล้างการเลือก"
                                            Click="ClearClientSelectionButton_Click" VerticalAlignment="Center">
                                        <controls:IconPresenter Icon="x" IconSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ==================== ตาราง + แผงข้อมูลเครื่อง (inspector) ====================
                             แผงโผล่เมื่อเลือกเครื่อง "ตัวเดียว" (เลือกหลายตัวคือโหมดสั่งงานหมู่ ซึ่งแถบเลือก
                             ด้านบนรับหน้าที่อยู่แล้ว) ตอบคำถามที่ครูถามบ่อยที่สุดโดยไม่ต้องเปิดหน้าต่างใหม่ -
                             IP อะไร เห็นล่าสุดเมื่อไหร่ ต่อมาทางไหน กฎทำงานไหม - และรวมทางเข้าหน้าต่างราย
                             client ทั้ง 6 บานไว้ที่เดียว

                             WP6 (2026-10-30): แผง **สไลด์ทับอยู่บนตาราง** ใน cell เดียวกัน ไม่ใช่คอลัมน์ที่สอง
                             ของเดิมเป็นคอลัมน์ Auto ข้างตาราง พอเลือกเครื่อง ตารางถูกบีบแคบลง 270px ทันที
                             คอลัมน์ทุกคอลัมน์กระโดด คลิกถัดไปเลยไม่โดนที่เล็งไว้ - บั๊กตระกูลเดียวกับแถบเลือก
                             เครื่อง (console-ui-notes §5) ตอนนี้ตารางมีขนาดเท่าเดิมเสมอไม่ว่าแผงจะเปิดหรือปิด
                             แผงหุบเหลือแถบแคบได้ (ดูคอลัมน์ขวาของตารางได้โดยไม่ต้องปิดแผง) ปิดด้วย ✕ หรือ Esc

                             หมายเหตุสำหรับคนที่มาทำต่อ: ปุ่มในแผงยัง "เปิดหน้าต่างเดิม" อยู่ ไม่ได้ยุบเนื้อหา
                             หน้าต่างเหล่านั้นเข้ามาในแผง - RunningProcesses กับ ActionReport รับสตรีมสดผ่าน
                             SignalR และ ActionPanel สั่งงานเป็นชุด การรื้อต้องทดสอบกับ Agent จริงในห้องแล็บ -->
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <!-- Border+ClipToBounds rounds the DataGrid's corners - DataGrid itself has no
                                 CornerRadius property (it's not a Border subclass), so the grid's own
                                 Background/Border are moved out to this wrapper and the grid goes transparent. -->
                            <Border CornerRadius="12" ClipToBounds="True"
                                    Background="{DynamicResource Brush.Background.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <DataGrid x:Name="ClientsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                    SelectionMode="Extended" SelectionUnit="FullRow"
                                    SelectionChanged="ClientsGrid_SelectionChanged"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    RowBackground="{DynamicResource Brush.Background.Card}"
                                    AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                                    HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                    VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                                    RowHeight="40" CanUserAddRows="False"
                                    ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                    RowStyle="{StaticResource ConsoleGridRowStyle}"
                                    CellStyle="{StaticResource ConsoleGridCellStyle}">
                                <DataGrid.Resources>
                                    <!-- แยก 2 badge ชัดเจน เป็นคนละคอลัมน์ ไม่ปนกันเหมือนเดิม (บั๊กจริงที่เจอตอน
                                         field test 2026-08-20: badge เดิมรวม 4 สถานะ DISABLED/ONLINE/OFFLINE/MISSING
                                         ไว้ในตัวเดียว ทำให้ครูงงว่า "ออนไลน์" กับ "เปิดใช้งานกฎ" คือเรื่องเดียวกันไหม
                                         แถม MISSING ยังกระพริบทะลุไปโผล่คอลัมน์/แถวอื่นด้วย เพราะ Storyboard
                                         RepeatBehavior="Forever" ผูกกับ Style ที่ share กันทุกแถวใน DataGrid ที่มี
                                         virtualization - container ถูก recycle ระหว่าง storyboard ยังเล่นอยู่)

                                         STATUS = เครื่องติดต่อได้ไหมจริงๆ (IsOnline จาก Server - ดู ClientMachine.
                                         IsOnline/AgentConnectionRegistry) ไม่เกี่ยวกับ enforcement เลย ไม่มี state
                                         MISSING แยกอีกต่อไป และไม่มีการกระพริบใดๆ ทั้งสิ้น -->
                                    <Style x:Key="ClientOnlineStatusBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                        <Setter Property="Tag" Value="Offline"/>
                                        <Setter Property="Content" Value="OFFLINE"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Tag" Value="Online"/>
                                                <Setter Property="Content" Value="ONLINE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>

                                    <!-- ENFORCEMENT = ตอนนี้ Agent เครื่องนี้บังคับใช้กฎอยู่จริงไหม - ใช้ชื่อเดียวกับปุ่ม
                                         "ENABLE/DISABLE ENFORCEMENT" ใน ActionPanelWindow ให้สอดคล้องกัน
                                         DISABLED ใช้สี Warning (เหลือง) ไม่ใช่ Danger (แดง) เพราะเป็นสถานะปกติที่ครู
                                         ตั้งใจปิดเอง ไม่ใช่ error

                                         2026-09-04: เปลี่ยนจากอ่าน IsEnabled รายเครื่องตรงๆ มาอ่าน "ผลจริง" ที่รวม gate
                                         ทั้งห้องแล้ว (ดู ClientMachineDto.EnforcementBadgeText/Tag) - เดิมคอลัมน์นี้ขึ้น
                                         ENABLED ทั้งตารางในขณะที่ Agent ทุกตัวไม่ได้บังคับใช้อะไรเลยเพราะ GlobalState
                                         ถูกปิดไว้ ซึ่งเป็นข้อมูลที่ผิดในจังหวะที่ครูต้องการมันที่สุด -->
                                    <Style x:Key="ClientEnforcementBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                        <Setter Property="Tag" Value="{Binding EnforcementBadgeTag}"/>
                                        <Setter Property="Content" Value="{Binding EnforcementBadgeText}"/>
                                    </Style>

                                    <!-- CONNECTION = ตอนนี้ Agent poll เข้ามาผ่านทางไหน (UsingFallback จาก Server -
                                         last-known ค่าจาก poll ล่าสุด ดู ClientMachine.UsingFallback) เหลือง (Warning)
                                         ไม่ใช่แดง เพราะ fallback ทำงานได้ปกติ แค่ไม่ใช่เส้นทางหลัก ไม่ใช่ error -->
                                    <Style x:Key="ClientConnectionPathBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                        <Setter Property="Tag" Value="Online"/>
                                        <Setter Property="Content" Value="LAN"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsingFallback}" Value="True">
                                                <Setter Property="Tag" Value="Warning"/>
                                                <Setter Property="Content" Value="TAILSCALE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="สถานะ" Width="90" SortMemberPath="IsOnline">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource ClientOnlineStatusBadge}"
                                                                ToolTip="{Binding LastSeenAt, Converter={StaticResource DisplayTimeConverter}, ConverterParameter='เห็นล่าสุด: {0}'}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="บังคับใช้กฎ" Width="110" SortMemberPath="IsEnabled">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource ClientEnforcementBadge}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="เชื่อมต่อผ่าน" Width="120" SortMemberPath="UsingFallback">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource ClientConnectionPathBadge}"
                                                                ToolTip="เชื่อมต่อผ่าน LAN ปกติ หรือ Tailscale fallback (ค่าล่าสุดจาก poll)"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="ชื่อเครื่อง" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MachineName}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding MachineName}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Client GUID" Width="240">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ClientGuid}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ClientGuid}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn controls:TimeColumn.Header="เห็นล่าสุด" Binding="{Binding LastSeenAt, Converter={StaticResource DisplayTimeConverter}}" SortMemberPath="LastSeenAt" Width="170"/>
                                    <DataGridTemplateColumn Header="จัดการ" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ButtonSecondary}"
                                                        Padding="10,5" FontSize="11"
                                                        Click="ClientActionsButton_Click" Tag="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="คำสั่ง" VerticalAlignment="Center"/>
                                                        <controls:IconPresenter Icon="more-horizontal" IconSize="14"
                                                                                Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            </Border>
                            <ContentControl x:Name="ClientsEmptyText"
                                            Style="{StaticResource EmptyState}" controls:Nav.Icon="monitor"
                                            Content="ยังไม่มีเครื่องในระบบ" Tag="เครื่องจะขึ้นมาเองเมื่อ Agent ติดตั้งแล้ว poll เข้ามาครั้งแรก"
                                            Visibility="Collapsed"/>

                            <Border x:Name="ClientInspector" Width="284" HorizontalAlignment="Right"
                                    Visibility="Collapsed" CornerRadius="12"
                                    Background="{DynamicResource Brush.Background.CardRaised}"
                                    BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.28" Color="Black"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="InspectorSlide" X="0"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <!-- ===== แผงเต็ม ===== -->
                                    <Grid x:Name="InspectorExpanded">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="16,12,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:IconPresenter Grid.Column="0" Icon="monitor" IconSize="18" VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource Brush.Accent.Text}"/>
                                            <TextBlock x:Name="InspectorMachineName" Grid.Column="1" Margin="8,0,6,0"
                                                       VerticalAlignment="Center" FontSize="15" FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                                            <Button Grid.Column="2" Style="{StaticResource GhostIconButton}"
                                                    ToolTip="หุบแผงเหลือแถบแคบ (ดูคอลัมน์ขวาของตาราง)"
                                                    Click="InspectorCollapseButton_Click">
                                                <controls:IconPresenter Icon="chevron-right" IconSize="16"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                            <Button Grid.Column="3" Style="{StaticResource GhostIconButton}"
                                                    ToolTip="ปิดแผง (Esc)" Click="InspectorCloseButton_Click">
                                                <controls:IconPresenter Icon="x" IconSize="16"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                        </Grid>

                                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" Padding="16,0,16,16"
                                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <WrapPanel>
                                                    <ContentControl x:Name="InspectorStatusBadge" Style="{StaticResource StatusBadge}" Margin="0,0,6,6"/>
                                                    <ContentControl x:Name="InspectorEnforcementBadge" Style="{StaticResource StatusBadge}" Margin="0,0,6,6"/>
                                                    <ContentControl x:Name="InspectorConnectionBadge" Style="{StaticResource StatusBadge}" Margin="0,0,6,6"/>
                                                </WrapPanel>

                                                <Border Height="1" Margin="0,8,0,12"
                                                        Background="{DynamicResource Brush.Border.Default}"/>

                                                <!-- ปุ่มอยู่เหนือรายละเอียด ไม่ใช่ใต้: พอเลือกเครื่องแล้ว สิ่งที่ตั้งใจ
                                                     จะทำไม่ควรอยู่ใต้เส้นที่ต้องเลื่อนลงไปหา -->
                                                <Button Content="ดูหน้าจอเครื่องนี้" Style="{StaticResource ButtonPrimary}"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                                        Click="InspectorViewScreenButton_Click"/>
                                                <Button Content="ดูโปรแกรมที่เปิดอยู่" Style="{StaticResource ButtonSecondary}"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                                        Click="InspectorProcessesButton_Click"/>
                                                <Button Content="ดูคำสั่งที่ค้างอยู่" Style="{StaticResource ButtonSecondary}"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                                        Click="InspectorPendingCommandsButton_Click"/>
                                                <Button Content="ตั้งค่าเครื่องนี้" Style="{StaticResource ButtonSecondary}"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                                        Click="InspectorClientSettingsButton_Click"/>
                                                <Button Content="ยกเว้นกฎเฉพาะเครื่องนี้" Style="{StaticResource ButtonSecondary}"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                                        Click="InspectorRuleOverridesButton_Click"/>
                                                <Button Content="เปิดแผงคำสั่ง..." Style="{StaticResource ButtonSecondary}"
                                                        HorizontalAlignment="Stretch"
                                                        Click="InspectorActionsButton_Click"/>

                                                <Border Height="1" Margin="0,14,0,10"
                                                        Background="{DynamicResource Brush.Border.Default}"/>

                                                <TextBlock Text="IP ล่าสุด" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="InspectorIp" Style="{StaticResource Body}" Margin="0,1,0,8"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- ป้ายนี้เปลี่ยนตามโหมดเวลา (เวลาไทย/UTC) ใน UpdateClientInspector -->
                                                <TextBlock x:Name="InspectorLastSeenLabel" Text="เห็นล่าสุด" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="InspectorLastSeen" Style="{StaticResource Body}" Margin="0,1,0,8"/>

                                                <TextBlock Text="รอบ poll" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="InspectorPollInterval" Style="{StaticResource Body}" Margin="0,1,0,8"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="Client GUID" Style="{StaticResource Label}"/>
                                                <TextBlock x:Name="InspectorGuid" Style="{StaticResource Caption}" Margin="0,1,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- ===== แถบแคบตอนหุบ =====
                                         เหลือปุ่มกางกลับ ปุ่มปิด และไอคอนเครื่องที่บอกชื่อใน ToolTip - พอให้รู้ว่า
                                         "ยังมีแผงของเครื่องไหนค้างอยู่" โดยไม่บังคอลัมน์ขวาของตาราง -->
                                    <StackPanel x:Name="InspectorCollapsedStrip" Visibility="Collapsed" Margin="0,10,0,0">
                                        <Button Style="{StaticResource GhostIconButton}" HorizontalAlignment="Center"
                                                ToolTip="กางแผงข้อมูลเครื่อง" Click="InspectorExpandButton_Click">
                                            <controls:IconPresenter Icon="chevron-left" IconSize="16"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostIconButton}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                ToolTip="ปิดแผง (Esc)" Click="InspectorCloseButton_Click">
                                            <controls:IconPresenter Icon="x" IconSize="16"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Border Height="1" Margin="10,8" Background="{DynamicResource Brush.Border.Default}"/>
                                        <controls:IconPresenter x:Name="InspectorCollapsedIcon" Icon="monitor" IconSize="18"
                                                                HorizontalAlignment="Center"
                                                                Foreground="{DynamicResource Brush.Accent.Text}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========== Screen View tab (Step 4d) ========== -->
                <TabItem x:Name="ScreenViewTabItem" Header="Screen View" controls:Nav.Icon="video" controls:Nav.Group="">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="VncHeaderText"
                                    Text="ยังไม่ได้เลือกเครื่อง - เลือกเครื่องในแท็บ Clients แล้วกด &quot;ดูหน้าจอเครื่องนี้&quot;" Style="{StaticResource Heading2}"
                                    TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Width="100" Content="หยุดดูหน้าจอ" Style="{StaticResource ButtonSecondary}"
                                    Padding="10,5" FontSize="11" Click="VncDisconnectButton_Click" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Grid.Row="1" x:Name="VncStatusText" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,10,0,0"/>

                        <Border Grid.Row="2" CornerRadius="10" Background="Black" Margin="0,10,0,0"
                                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <Image x:Name="VncScreenImage" Stretch="Uniform" Margin="3"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ========== Live View tab (Step 4f) - CCTV-wall grid ========== -->
                <TabItem x:Name="LiveViewTabItem" Header="Live View" controls:Nav.Icon="grid" controls:Nav.Group="">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Live View" Style="{StaticResource Heading2}"/>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- เลือกเครื่อง - reuse _allClients เดิม ไม่ query ใหม่ (ดู ApplyLiveViewClientList ใน .xaml.cs) -->
                            <Border Grid.Column="0" CornerRadius="10" Padding="10"
                                    Background="{DynamicResource Brush.Background.Primary}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="เลือกเครื่อง"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                    <ListBox Grid.Row="1" x:Name="LiveViewClientListBox" SelectionMode="Extended"
                                             Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MachineName}" Padding="4,3" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Rebuilt 2026-09-03 - AddSelectedToGridButton/LiveViewStatusText used to both sit in
                                         Grid.Row="1" (the same row as the ListBox above) with Grid.RowSpan="2" and a
                                         Margin="0,306,0,10" magic offset trying to push the status text below the button
                                         by guessing a fixed pixel position - broke as soon as the panel's actual height
                                         differed from what that guess assumed (confirmed: it grows and covers the
                                         ListBox). Each now has its own dedicated Auto row below the list instead. -->
                                    <Button Grid.Row="2" x:Name="AddSelectedToGridButton" Content="เพิ่มเครื่องที่เลือกเข้าจอรวม"
                                            Style="{StaticResource ButtonPrimary}" Margin="0,10,0,4"
                                            Click="AddSelectedToGridButton_Click"/>

                                    <TextBlock Grid.Row="3" x:Name="LiveViewStatusText" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- Grid area - ช่องขนาดปรับอัตโนมัติตามจำนวนเครื่องผ่าน UniformGrid (auto-compute แถว/คอลัมน์ในตัว) -->
                            <Border Grid.Column="2" CornerRadius="10"
                                    Background="Black" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                <UniformGrid x:Name="LiveViewGrid"/>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========== Rules tab ========== -->
                <TabItem Header="กฎโปรแกรม" controls:Nav.Icon="shield" controls:Nav.Group="กฎ">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Rule Management" Style="{StaticResource Heading2}"/>
                            <Button Grid.Column="1" Content="เพิ่มกฎ..." Style="{StaticResource ButtonPrimary}"
                                    VerticalAlignment="Center" Click="AddRuleButton_Click"/>
                        </Grid>

                        <TextBox Grid.Row="2" x:Name="RulesSearchBox" Width="250" Height="40" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Style="{StaticResource SearchTextBox}"
                                Tag="ค้นหาชื่อกฎ/publisher..." TextChanged="RulesSearchBox_TextChanged"/>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Border CornerRadius="12" ClipToBounds="True"
                                    Background="{DynamicResource Brush.Background.Card}"
