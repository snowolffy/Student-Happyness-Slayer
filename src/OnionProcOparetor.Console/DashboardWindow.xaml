<Window x:Class="OnionProcOparetor.Console.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onion ProcOparetor Console - Dashboard"
        Height="732" Width="1000"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppWindowStyle}"
        Background="{StaticResource Brush.Background.Primary}">
    <!--
        Layout: Toolbar -> TabControl with 6 tabs: CLIENTS / RULES / LOGS / USERS / SCREEN VIEW / LIVE VIEW
        -> footer status bar, on a root Grid (Auto/*/Auto rows) so the window can actually be resized -
        was Canvas before (2026-08-05 Phase 1 UI rebuild converted it back to Grid, per the "if you need a
        resizable Dashboard again, switch back to Grid" note that used to live right here). Each tab's own
        content is a Grid too (Auto rows for title/toolbar/search, * for the DataGrid so it fills whatever
        space is left) instead of a Canvas with pixel-fixed positions. Shared DataGrid header/row/cell
        styles for all 4 grids are still defined once below in Window.Resources instead of repeating them
        per DataGrid - that part didn't need to change.
        MinWidth/MinHeight are set to keep the toolbar buttons and the 6 tab headers from overlapping/
        wrapping at small sizes - re-check these if a tab's content changes materially later.
    -->
    <Window.Resources>
        <!-- Shared DataGrid look for all 4 tabs (Clients/Rules/Logs/Users) - kept here instead of
             repeating the same header/row/cell styling inline in every DataGrid.Resources block. -->
        <Style x:Key="ConsoleGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Brush.Background.Primary}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="ConsoleGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="{StaticResource Color.Accent.Light}" Opacity="0.15"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ConsoleGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Background.Primary}"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== Toolbar (logo/title, last-updated, global actions) ==================== -->
        <Border Grid.Row="0" Height="60" CornerRadius="12" Margin="0,0,0,12"
                Background="{StaticResource Brush.Background.Card}"
                BorderBrush="{StaticResource Brush.Border.Default}"
                BorderThickness="1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                        Background="{StaticResource Brush.Accent.Default}" VerticalAlignment="Center">
                    <Border.Clip>
                        <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,36,36"/>
                    </Border.Clip>
                    <Image Source="/Theme/logo.png" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Onion ProcOparetor" Style="{StaticResource Heading2}"/>
                    <TextBlock x:Name="ServerLabel" Text="" Style="{StaticResource Caption}"/>
                </StackPanel>

                <TextBlock Grid.Column="3" Width="150" x:Name="StatusText" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                <Button Grid.Column="4" Width="44" x:Name="SettingsMenuButton" Content="&#9881;"
                        Style="{StaticResource ButtonSecondary}"
                        FontSize="16" Padding="0"
                        ToolTip="Settings / About"
                        Click="SettingsMenuButton_Click" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Grid.Column="5" Width="90" x:Name="RefreshButton" Content="REFRESH"
                        Style="{StaticResource ButtonSecondary}"
                        Click="RefreshButton_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ==================== Main content ==================== -->
        <Border Grid.Row="1" CornerRadius="12" Margin="0,0,0,5"
                Background="{StaticResource Brush.Background.Card}"
                BorderBrush="{StaticResource Brush.Border.Default}"
                BorderThickness="1" Padding="0">
            <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" Margin="16"
                        ItemContainerStyle="{StaticResource PillTabItem}"
                        SelectionChanged="MainTabControl_SelectionChanged">

                <!-- ========== Clients tab ========== -->
                <TabItem Header="CLIENTS" Margin="0,0,-1,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Client Management" Style="{StaticResource Heading2}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Width="110" Content="ACTIONS" Style="{StaticResource ButtonSecondary}"
                                    Padding="10,5" FontSize="11" Margin="20,0,0,0"
                                    Click="BulkActionsButton_Click" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Width="180" Content="BROADCAST MESSAGE" Style="{StaticResource ButtonSecondary}"
                                    Padding="10,5" FontSize="11" Margin="10,0,0,0"
                                    Click="BroadcastMessageButton_Click" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" x:Name="SelectedClientsCountText"
                                    Foreground="{StaticResource Brush.Text.Secondary}" Text="" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBox Grid.Row="1" x:Name="ClientsSearchBox" Width="250" Height="36" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Style="{StaticResource RoundedTextBox}"
                                Tag="ค้นหา machine name..." TextChanged="ClientsSearchBox_TextChanged"/>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <DataGrid x:Name="ClientsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                    SelectionMode="Extended" SelectionUnit="FullRow"
                                    SelectionChanged="ClientsGrid_SelectionChanged"
                                    Background="{StaticResource Brush.Background.Card}"
                                    BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1"
                                    RowBackground="{StaticResource Brush.Background.Card}"
                                    AlternatingRowBackground="{StaticResource Brush.Background.Card}"
                                    HorizontalGridLinesBrush="{StaticResource Brush.Border.Default}"
                                    VerticalGridLinesBrush="{StaticResource Brush.Border.Default}"
                                    RowHeight="40" CanUserAddRows="False"
                                    ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                    RowStyle="{StaticResource ConsoleGridRowStyle}"
                                    CellStyle="{StaticResource ConsoleGridCellStyle}">
                                <DataGrid.Resources>
                                    <!-- แยก 2 badge ชัดเจน เป็นคนละคอลัมน์ ไม่ปนกันเหมือนเดิม (บั๊กจริงที่เจอตอน
                                         field test 2026-08-20: badge เดิมรวม 4 สถานะ DISABLED/ONLINE/OFFLINE/MISSING
                                         ไว้ในตัวเดียว ทำให้ครูงงว่า "ออนไลน์" กับ "เปิดใช้งานกฎ" คือเรื่องเดียวกันไหม
                                         แถม MISSING ยังกระพริบทะลุไปโผล่คอลัมน์/แถวอื่นด้วย เพราะ Storyboard
                                         RepeatBehavior="Forever" ผูกกับ Style ที่ share กันทุกแถวใน DataGrid ที่มี
                                         virtualization - container ถูก recycle ระหว่าง storyboard ยังเล่นอยู่)

                                         STATUS = เครื่องติดต่อได้ไหมจริงๆ (IsOnline จาก Server - ดู ClientMachine.
                                         IsOnline/AgentConnectionRegistry) ไม่เกี่ยวกับ enforcement เลย ไม่มี state
                                         MISSING แยกอีกต่อไป และไม่มีการกระพริบใดๆ ทั้งสิ้น -->
                                    <Style x:Key="ClientOnlineStatusBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                        <Setter Property="Tag" Value="Offline"/>
                                        <Setter Property="Content" Value="OFFLINE"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Tag" Value="Online"/>
                                                <Setter Property="Content" Value="ONLINE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>

                                    <!-- ENFORCEMENT = ครูเปิดใช้งานการบังคับใช้กฎเครื่องนี้ไว้ไหม (IsEnabled) - ใช้ชื่อ
                                         เดียวกับปุ่ม "ENABLE/DISABLE ENFORCEMENT" ใน ActionPanelWindow ให้สอดคล้องกัน
                                         DISABLED ใช้สี Warning (เหลือง) ไม่ใช่ Danger (แดง) เพราะเป็นสถานะปกติที่ครู
                                         ตั้งใจปิดเอง ไม่ใช่ error -->
                                    <Style x:Key="ClientEnforcementBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                        <Setter Property="Tag" Value="Warning"/>
                                        <Setter Property="Content" Value="DISABLED"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                <Setter Property="Tag" Value="Online"/>
                                                <Setter Property="Content" Value="ENABLED"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>

                                    <!-- CONNECTION = ตอนนี้ Agent poll เข้ามาผ่านทางไหน (UsingFallback จาก Server -
                                         last-known ค่าจาก poll ล่าสุด ดู ClientMachine.UsingFallback) เหลือง (Warning)
                                         ไม่ใช่แดง เพราะ fallback ทำงานได้ปกติ แค่ไม่ใช่เส้นทางหลัก ไม่ใช่ error -->
                                    <Style x:Key="ClientConnectionPathBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                        <Setter Property="Tag" Value="Online"/>
                                        <Setter Property="Content" Value="LAN"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsingFallback}" Value="True">
                                                <Setter Property="Tag" Value="Warning"/>
                                                <Setter Property="Content" Value="TAILSCALE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="STATUS" Width="90" SortMemberPath="IsOnline">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource ClientOnlineStatusBadge}"
                                                                ToolTip="{Binding LastSeenAt, StringFormat='Last seen: {0:yyyy-MM-dd HH:mm:ss} UTC'}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="ENFORCEMENT" Width="110" SortMemberPath="IsEnabled">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource ClientEnforcementBadge}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="CONNECTION" Width="100" SortMemberPath="UsingFallback">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource ClientConnectionPathBadge}"
                                                                ToolTip="เชื่อมต่อผ่าน LAN ปกติ หรือ Tailscale fallback (ค่าล่าสุดจาก poll)"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="MACHINE NAME" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MachineName}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding MachineName}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="CLIENT GUID" Width="240">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ClientGuid}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ClientGuid}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="LAST SEEN (UTC)" Binding="{Binding LastSeenAt}" Width="170"/>
                                    <DataGridTemplateColumn Header="ACTIONS" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="ACTIONS ▾" Style="{StaticResource ButtonSecondary}"
                                                        Padding="10,5" FontSize="11"
                                                        Click="ClientActionsButton_Click" Tag="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="ClientsEmptyText"
                                    Text="ยังไม่มีเครื่องในระบบ" Style="{StaticResource Caption}" TextAlignment="Center"
                                    VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========== Rules tab ========== -->
                <TabItem Header="RULES" Margin="8,0,-8,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Rule Management" Style="{StaticResource Heading2}"/>
                            <Button Grid.Column="1" Content="ADD RULE..." Style="{StaticResource ButtonPrimary}"
                                    VerticalAlignment="Center" Click="AddRuleButton_Click"/>
                        </Grid>

                        <TextBox Grid.Row="2" x:Name="RulesSearchBox" Width="250" Height="40" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Style="{StaticResource RoundedTextBox}"
                                Tag="ค้นหาชื่อกฎ/publisher..." TextChanged="RulesSearchBox_TextChanged"/>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                    Background="{StaticResource Brush.Background.Card}"
                                    BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1"
                                    RowBackground="{StaticResource Brush.Background.Card}"
                                    AlternatingRowBackground="{StaticResource Brush.Background.Card}"
                                    HorizontalGridLinesBrush="{StaticResource Brush.Border.Default}"
                                    VerticalGridLinesBrush="{StaticResource Brush.Border.Default}"
                                    RowHeight="40" CanUserAddRows="False"
                                    ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                    RowStyle="{StaticResource ConsoleGridRowStyle}"
                                    CellStyle="{StaticResource ConsoleGridCellStyle}">
                                <DataGrid.Resources>
                                    <Style x:Key="RuleStatusBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                        <Setter Property="Tag" Value="Danger"/>
                                        <Setter Property="Content" Value="DISABLED"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                <Setter Property="Tag" Value="Online"/>
                                                <Setter Property="Content" Value="ENABLED"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="STATUS" Width="90" SortMemberPath="IsEnabled">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource RuleStatusBadge}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="130"/>
                                    <DataGridTextColumn Header="PUBLISHER" Binding="{Binding PublisherName}" Width="170"/>
                                    <DataGridTextColumn Header="NAME CONTAINS" Binding="{Binding ProcessNameContains}" Width="110"/>
                                    <DataGridTextColumn Header="SIGNED ONLY" Binding="{Binding RequireSignedMatch}" Width="90"/>
                                    <DataGridTextColumn Header="KILL" Binding="{Binding KillProcess}" Width="50"/>
                                    <DataGridTextColumn Header="ACTION COMMAND" Binding="{Binding ActionCommand}" Width="150"/>
                                    <DataGridTemplateColumn Header="ACTIONS" Width="230">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="EDIT" Style="{StaticResource ButtonSecondary}"
                                                            Padding="10,5" FontSize="11"
                                                            Click="EditRuleButton_Click" Tag="{Binding}" Margin="0,0,4,0"/>
                                                    <Button Content="TOGGLE" Style="{StaticResource ButtonSecondary}"
                                                            Padding="10,5" FontSize="11"
                                                            Click="ToggleRuleButton_Click" Tag="{Binding Id}" Margin="0,0,4,0"/>
                                                    <Button Content="DELETE" Style="{StaticResource ButtonDanger}"
                                                            Padding="10,5" FontSize="11"
                                                            Click="DeleteRuleButton_Click" Tag="{Binding Id}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="RulesEmptyText"
                                    Text="ยังไม่มีกฎ" Style="{StaticResource Caption}" TextAlignment="Center"
                                    VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========== Logs tab ========== -->
                <TabItem Header="LOGS" Margin="16,0,-23,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Activity Logs" Style="{StaticResource Heading2}"/>

                        <TextBox Grid.Row="1" x:Name="LogsSearchBox" Width="250" Height="35" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Style="{StaticResource RoundedTextBox}"
                                Tag="ค้นหา machine/process/publisher..." TextChanged="LogsSearchBox_TextChanged"/>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <DataGrid x:Name="LogsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                    Background="{StaticResource Brush.Background.Card}"
                                    BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1"
                                    RowBackground="{StaticResource Brush.Background.Card}"
                                    AlternatingRowBackground="{StaticResource Brush.Background.Card}"
                                    HorizontalGridLinesBrush="{StaticResource Brush.Border.Default}"
                                    VerticalGridLinesBrush="{StaticResource Brush.Border.Default}"
                                    RowHeight="40" CanUserAddRows="False"
                                    ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                    RowStyle="{StaticResource ConsoleGridRowStyle}"
                                    CellStyle="{StaticResource ConsoleGridCellStyle}">
                                <DataGrid.Resources>
                                    <Style x:Key="LogSignedBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                        <Setter Property="Tag" Value="Danger"/>
                                        <Setter Property="Content" Value="UNSIGNED"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WasSignedMatch}" Value="True">
                                                <Setter Property="Tag" Value="Online"/>
                                                <Setter Property="Content" Value="SIGNED"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TIME (UTC)" Binding="{Binding Timestamp}" Width="150"/>
                                    <DataGridTextColumn Header="MACHINE" Binding="{Binding MachineName}" Width="130"/>
                                    <DataGridTextColumn Header="PROCESS" Binding="{Binding ProcessPath}" Width="220"/>
                                    <DataGridTextColumn Header="PUBLISHER" Binding="{Binding DetectedPublisher}" Width="160"/>
                                    <DataGridTemplateColumn Header="SIGNED" Width="90" SortMemberPath="WasSignedMatch">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource LogSignedBadge}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="RULE" Binding="{Binding MatchedRuleName}" Width="120"/>
                                    <DataGridTextColumn Header="ACTION TAKEN" Binding="{Binding ActionTaken}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="LogsEmptyText"
                                    Text="ยังไม่มี log" Style="{StaticResource Caption}" TextAlignment="Center"
                                    VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========== Audit Log tab ==========
                     ตั้งชื่อ "AUDIT LOG" (ไม่ใช้ "Activity Logs" ซ้ำกับหัวข้อในแท็บ LOGS ข้างบน - แท็บนั้น
                     คือ log การตรวจจับ process ที่ agent ส่งเข้ามา คนละเรื่องกับแท็บนี้ที่เป็น audit การกระทำ
                     ของครู + agent connectivity + system warning/error)
                     ไม่ผูกกับ auto-refresh ทุก tick แบบแท็บอื่น (ดู DashboardWindow.xaml.cs
                     LoadActivityLogPageAsync) - โหลดเฉพาะตอนแท็บนี้ active เท่านั้น กัน volume สูงไม่ให้
                     โหลดทั้งหมดฝั่ง client ทุก 10 วิ -->
                <TabItem x:Name="AuditLogTabItem" Header="AUDIT LOG" Margin="31,0,-23,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Audit Log" Style="{StaticResource Heading2}"/>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="AuditLogCategoryFilter" Width="160" Height="35" VerticalAlignment="Center"
                                    SelectedIndex="0" SelectionChanged="AuditLogFilter_Changed">
                                <ComboBoxItem Content="ทุกหมวด"/>
                                <ComboBoxItem Content="AdminAction"/>
                                <ComboBoxItem Content="AgentConnectivity"/>
                                <ComboBoxItem Content="SystemEvent"/>
                            </ComboBox>
                            <ComboBox Grid.Column="2" x:Name="AuditLogSeverityFilter" Width="160" Height="35" VerticalAlignment="Center"
                                    SelectedIndex="0" SelectionChanged="AuditLogFilter_Changed">
                                <ComboBoxItem Content="ทุกระดับ"/>
                                <ComboBoxItem Content="Info ขึ้นไป"/>
                                <ComboBoxItem Content="Warning ขึ้นไป"/>
                                <ComboBoxItem Content="Error ขึ้นไป"/>
                            </ComboBox>
                            <TextBox Grid.Column="4" x:Name="AuditLogClientGuidFilter" Width="220" Height="35" VerticalAlignment="Center"
                                    Style="{StaticResource RoundedTextBox}"
                                    Tag="Client GUID (เว้นว่าง = ทุกเครื่อง)" TextChanged="AuditLogClientGuidFilter_TextChanged"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="◀ PREV" Style="{StaticResource ButtonSecondary}"
                                    Padding="10,5" FontSize="11" Click="AuditLogPrevButton_Click"/>
                            <Button Grid.Column="2" Content="NEXT ▶" Style="{StaticResource ButtonSecondary}"
                                    Padding="10,5" FontSize="11" Click="AuditLogNextButton_Click"/>
                            <TextBlock Grid.Column="4" x:Name="AuditLogPageInfoText" VerticalAlignment="Center"
                                    Foreground="{StaticResource Brush.Text.Secondary}"/>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <DataGrid x:Name="AuditLogGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                    Background="{StaticResource Brush.Background.Card}"
                                    BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1"
                                    RowBackground="{StaticResource Brush.Background.Card}"
                                    AlternatingRowBackground="{StaticResource Brush.Background.Card}"
                                    HorizontalGridLinesBrush="{StaticResource Brush.Border.Default}"
                                    VerticalGridLinesBrush="{StaticResource Brush.Border.Default}"
                                    RowHeight="40" CanUserAddRows="False"
                                    ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                    RowStyle="{StaticResource ConsoleGridRowStyle}"
                                    CellStyle="{StaticResource ConsoleGridCellStyle}">
                                <DataGrid.Resources>
                                    <Style x:Key="AuditLogSeverityBadge" TargetType="ContentControl" BasedOn="{StaticResource StatusBadge}">
                                        <Setter Property="Tag" Value="Online"/>
                                        <Setter Property="Content" Value="{Binding Severity}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                <Setter Property="Tag" Value="Warning"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                <Setter Property="Tag" Value="Danger"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                <Setter Property="Tag" Value="Danger"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TIME (UTC)" Binding="{Binding Timestamp}" Width="150"/>
                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="130"/>
                                    <DataGridTemplateColumn Header="SEVERITY" Width="90" SortMemberPath="Severity">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Style="{StaticResource AuditLogSeverityBadge}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="EVENT" Binding="{Binding EventType}" Width="150"/>
                                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="MACHINE" Binding="{Binding TargetMachineName}" Width="130"/>
                                    <DataGridTextColumn Header="ADMIN" Binding="{Binding ActorUsername}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="AuditLogEmptyText"
                                    Text="ยังไม่มี activity log" Style="{StaticResource Caption}" TextAlignment="Center"
                                    VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========== Users tab ========== -->
                <TabItem Header="USERS" Margin="29,0,-30,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="User Management" Style="{StaticResource Heading2}"/>

                        <Border Grid.Row="1" CornerRadius="10" Padding="12" Margin="0,10,0,0"
                                Background="{StaticResource Brush.Background.Primary}"
                                BorderBrush="{StaticResource Brush.Border.Default}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="NewUserUsernameBox" Width="160" Height="35" VerticalAlignment="Center"
                                         Style="{StaticResource RoundedTextBox}"
                                         ToolTip="Username" TextChanged="NewUserUsernameBox_TextChanged"/>
                                <PasswordBox Grid.Column="2" x:Name="NewUserPasswordBox" Width="160" Height="35" VerticalAlignment="Center"
                                             Style="{StaticResource RoundedPasswordBox}"
                                             ToolTip="Password (อย่างน้อย 8 ตัวอักษร)"/>
                                <Button Grid.Column="4" Content="ADD USER" Style="{StaticResource ButtonPrimary}"
                                        VerticalAlignment="Center" Click="AddUserButton_Click"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                    Background="{StaticResource Brush.Background.Card}"
                                    BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1"
                                    RowBackground="{StaticResource Brush.Background.Card}"
                                    AlternatingRowBackground="{StaticResource Brush.Background.Card}"
                                    HorizontalGridLinesBrush="{StaticResource Brush.Border.Default}"
                                    VerticalGridLinesBrush="{StaticResource Brush.Border.Default}"
                                    RowHeight="40" CanUserAddRows="False"
                                    ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                                    RowStyle="{StaticResource ConsoleGridRowStyle}"
                                    CellStyle="{StaticResource ConsoleGridCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="150"/>
                                    <DataGridTextColumn Header="BUILT-IN" Binding="{Binding IsBuiltIn}" Width="80"/>
                                    <DataGridTextColumn Header="DEFAULT PASSWORD" Binding="{Binding HasDefaultPassword}" Width="130"/>
                                    <DataGridTextColumn Header="CREATED (UTC)" Binding="{Binding CreatedAt}" Width="160"/>
                                    <DataGridTextColumn Header="LAST LOGIN (UTC)" Binding="{Binding LastLoginAt}" Width="160"/>
                                    <DataGridTemplateColumn Header="ACTIONS" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <!--
                                                        ปุ่ม RESET PW: ใช้ได้กับทุก account รวม built-in
                                                        (ต่างจาก DELETE ที่ต้องกันไว้เพราะลบ built-in ไม่ได้เลย)
                                                    -->
                                                    <Button Content="RESET PW" Tag="{Binding}"
                                                            Click="ResetUserPasswordButton_Click"
                                                            Style="{StaticResource ButtonSecondary}"
                                                            Padding="10,5" FontSize="11"
                                                            Margin="0,0,4,0"/>

                                                    <!--
                                                        ปุ่ม DELETE: disable ถ้าเป็น built-in account (กัน lockout)
                                                        ใช้ DataTrigger เทียบ IsBuiltIn แทนการเขียน converter class ใหม่
                                                    -->
                                                    <Button Content="DELETE" Tag="{Binding Id}"
                                                            Click="DeleteUserButton_Click"
                                                            Padding="10,5" FontSize="11">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonDanger}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="ToolTip" Value="ลบ built-in account ไม่ได้"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="UsersEmptyText"
                                    Text="ยังไม่มีผู้ใช้เพิ่มเติม" Style="{StaticResource Caption}" TextAlignment="Center"
                                    VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ========== Screen View tab (Step 4d) ========== -->
                <TabItem x:Name="ScreenViewTabItem" Header="SCREEN VIEW" Margin="36,0,-44,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="VncHeaderText"
                                    Text="ยังไม่ได้เลือกเครื่อง - กด VIEW SCREEN จากรายการ Clients" Style="{StaticResource Heading2}"
                                    TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Width="100" Content="DISCONNECT" Style="{StaticResource ButtonSecondary}"
                                    Padding="10,5" FontSize="11" Click="VncDisconnectButton_Click" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Grid.Row="1" x:Name="VncStatusText" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,10,0,0"/>

                        <Border Grid.Row="2" CornerRadius="10" Background="Black" Margin="0,10,0,0"
                                BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
                            <Image x:Name="VncScreenImage" Stretch="Uniform" Margin="3"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ========== Live View tab (Step 4f) - CCTV-wall grid ========== -->
                <TabItem x:Name="LiveViewTabItem" Header="LIVE VIEW" Margin="50,0,-54,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Live View" Style="{StaticResource Heading2}"/>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- เลือกเครื่อง - reuse _allClients เดิม ไม่ query ใหม่ (ดู ApplyLiveViewClientList ใน .xaml.cs) -->
                            <Border Grid.Column="0" CornerRadius="10" Padding="10"
                                    Background="{StaticResource Brush.Background.Primary}"
                                    BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="เลือกเครื่อง"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                    <ListBox Grid.Row="1" x:Name="LiveViewClientListBox" SelectionMode="Extended"
                                             Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MachineName}" Padding="4,3" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Button Grid.Row="2" x:Name="AddSelectedToGridButton" Content="ADD SELECTED TO GRID"
                                            Style="{StaticResource ButtonPrimary}" Margin="0,25,0,4"
                                            Click="AddSelectedToGridButton_Click" Grid.RowSpan="2"/>

                                    <TextBlock Grid.Row="1" x:Name="LiveViewStatusText" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,306,0,10" Grid.RowSpan="2"/>
                                </Grid>
                            </Border>

                            <!-- Grid area - ช่องขนาดปรับอัตโนมัติตามจำนวนเครื่องผ่าน UniformGrid (auto-compute แถว/คอลัมน์ในตัว) -->
                            <Border Grid.Column="2" CornerRadius="10"
                                    Background="Black" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
                                <UniformGrid x:Name="LiveViewGrid"/>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>

        <!-- ==================== Footer status bar ==================== -->
        <Border Grid.Row="2" Height="52" CornerRadius="12"
                Background="{StaticResource Brush.Background.Card}"
                BorderBrush="{StaticResource Brush.Border.Default}"
                BorderThickness="1" Padding="16,10">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Server:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Column="1" Width="300" x:Name="FooterServerText" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
                <TextBlock Grid.Column="3" Text="User:" Style="{StaticResource Label}"/>
                <TextBlock Grid.Column="4" Width="200" x:Name="FooterUserText" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
            </Grid>
        </Border>

        <!-- ==================== Live View full-screen overlay (Step 4f) ====================
             sibling ของ Toolbar/Main content/Footer ที่ root Grid เดียวกัน แต่ต้องเป็น element
             *สุดท้าย* ใน Grid เท่านั้น (children วาดทับบนสุดตามลำดับ declare เหมือนตอนเป็น Canvas -
             ย้ายมาอยู่หลังสุดไว้เหมือนเดิม) Grid.Row="0" Grid.RowSpan="3" ครอบคลุมพื้นที่เดียวกับ root
             Grid ทั้งหมด (toolbar/content/footer) เพื่อให้เป็น "full-screen" (เทียบกับ DashboardWindow เอง)
             จริงตามที่ขอ - เดิม hardcode Width="968" Height="648" ตรงกับขนาด Canvas เดิมพอดี ตอนนี้ไม่ต้อง
             set ขนาดเองแล้ว (Grid เติมเต็ม cell ที่ span ให้อัตโนมัติ) เพื่อให้ resize หน้าต่างระหว่างเปิด
             full-screen ได้จริง - ปุ่ม "กลับไป Grid" อยู่มุมบนซ้ายชัดเจนเสมอเป็นทางเดียวที่กดออกจากโหมดนี้ได้

             Step 4h: Focusable="True" + FocusVisualStyle="{x:Null}" - overlay Border เองเป็นตัวรับ
             keyboard focus โดยตรง (ไม่ต้องมี invisible focus-sink control แยก) PreviewKeyDown/Up ผูกไว้ที่
             Border นี้ (tunnel event เลยรับได้ไม่ว่า element ลูกตัวไหนจะถืออยู่จริง) ส่วน mouse
             move/down/up/wheel ผูกที่ FullscreenImage โดยตรง (ดู DashboardWindow.xaml.cs ส่วน "Live View
             full-screen input capture") - TryMapFullscreenPointToTarget อ่าน FullscreenImage.ActualWidth/
             ActualHeight สดทุกครั้งที่มี mouse event อยู่แล้ว (ไม่ cache) เลยรองรับ resize ได้เองโดยไม่ต้อง
             แก้ logic นั้นเลย ตราบใดที่ FullscreenImage ยังอยู่ใน container ที่ stretch จริง (Border Grid.Row="1"
             ด้านล่างนี้ stretch เต็ม Grid.Row="*" ของ overlay เอง) - verify ด้วยการ resize จริงระหว่างเปิด
             full-screen แล้วดูว่าพิกัดคลิกยังตรงตำแหน่งเป้าหมาย ไม่ใช่แค่เชื่อ logic เฉยๆ -->
        <Border x:Name="LiveViewFullscreenOverlay" Grid.Row="0" Grid.RowSpan="3"
                Background="{StaticResource Brush.Background.Primary}" Visibility="Collapsed"
                Focusable="True" FocusVisualStyle="{x:Null}"
                PreviewKeyDown="LiveViewFullscreenOverlay_PreviewKeyDown"
                PreviewKeyUp="LiveViewFullscreenOverlay_PreviewKeyUp"
                IsKeyboardFocusWithinChanged="LiveViewFullscreenOverlay_IsKeyboardFocusWithinChanged">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="← BACK TO GRID" Style="{StaticResource ButtonPrimary}"
                            Padding="14,8" Click="BackToGridButton_Click"/>
                    <!-- Toggle target input: กันนักเรียนแย่งเมาส์/คีย์บอร์ดขณะครูควบคุมผ่าน full-screen VNC
                         (ดู PhysicalInputBlocker ฝั่ง AgentTray) - default ปิด (ไม่บล็อก) ตั้งแต่เข้า
                         fullscreen ทุกครั้ง (ดู ExpandLiveViewCell ที่ reset _targetInputBlocked) Content/
                         Style สลับใน code-behind ตาม _targetInputBlocked ไม่ใช่ XAML trigger เพราะต้อง sync
                         กับผลจริงของ SendCommandAsync ด้วย (ไม่ optimistic toggle เฉยๆ) -->
                    <Button x:Name="ToggleTargetInputButton" Content="BLOCK STUDENT INPUT"
                            Style="{StaticResource ButtonSecondary}"
                            Padding="14,8" Margin="10,0,0,0" Click="ToggleTargetInputButton_Click"/>
                    <TextBlock x:Name="FullscreenHeaderText" Style="{StaticResource Heading2}"
                               Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FullscreenStatusText" Style="{StaticResource Caption}"
                               Foreground="{StaticResource Brush.Danger.Default}"
                               Margin="20,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Row="1" Background="Black" CornerRadius="10"
                        BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
                    <!-- Step 4h: คุมเมาส์เต็มพื้นที่ Image นี้ - Stretch="Uniform" ทำให้ภาพ letterbox
                         (แถบดำซ้าย-ขวาหรือบน-ล่าง) ถ้าอัตราส่วน target ไม่ตรงกับพื้นที่แสดงผลพอดี ต้องแปลง
                         พิกัดคลิกกลับเป็นพิกัดจริงของ target เอง (ดู TryMapFullscreenPointToTarget) -->
                    <Image x:Name="FullscreenImage" Stretch="Uniform"
                           PreviewMouseMove="FullscreenImage_PreviewMouseMove"
                           PreviewMouseDown="FullscreenImage_PreviewMouseDown"
                           PreviewMouseUp="FullscreenImage_PreviewMouseUp"
                           PreviewMouseWheel="FullscreenImage_PreviewMouseWheel"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
