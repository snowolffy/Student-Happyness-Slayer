<Window x:Class="OnionProcOparetor.Console.BroadcastMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Broadcast Message"
        Height="440" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppWindowStyle}">
    <!-- Grid layout with fixed-pixel RowDefinitions matching the old Canvas.Top deltas - see SettingsWindow.xaml for the same pattern. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="57"/>
            <RowDefinition Height="21"/>
            <RowDefinition Height="136"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="21"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Broadcast Message" Style="{StaticResource Heading2}" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Grid.Row="1" Text="หัวข้อ (ไม่บังคับ)" Style="{StaticResource Label}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox Grid.Row="2" Width="400" x:Name="TitleInputBox"
                 Style="{StaticResource RoundedTextBox}" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Grid.Row="3" Text="ข้อความ" Style="{StaticResource Label}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox Grid.Row="4" Width="400" Height="120" x:Name="MessageInputBox"
                 Style="{StaticResource RoundedTextBox}" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <RadioButton Grid.Row="5" x:Name="SendToSelectedRadio" GroupName="BroadcastTarget"
                     Content="ส่งไปเครื่องที่เลือกไว้" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <RadioButton Grid.Row="6" x:Name="SendToAllRadio" GroupName="BroadcastTarget"
                     Content="ส่งไปทุกเครื่อง" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock Grid.Row="7" Width="380" x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0"/>

        <Grid Grid.Row="8">
            <Button Content="SEND" Style="{StaticResource ButtonPrimary}" Width="70"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="316,0,0,0" Click="SendButton_Click"/>
            <Button Content="CANCEL" Style="{StaticResource ButtonSecondary}" Width="80"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Left" Height="35" VerticalAlignment="Top" Margin="227,0,0,0" Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
