<UserControl x:Class="OnionProcOparetor.Console.BroadcastMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnionProcOparetor.UI.Controls;assembly=OnionProcOparetor.UI">
    <!-- UI-3b (2026-11-03): แปลงจาก Window ของตัวเองเป็น UserControl ฝังใน DialogHost ของ MainWindow
         ตามแบบแผนของ ForceChangePasswordWindow (UI-3a) - ตัด Window-only attribute (Title/
         SizeToContent/WindowStartupLocation/ResizeMode/Icon/Style) ทิ้ง เพิ่ม Border Style="Card" ครอบ
         เป็น chrome ของ dialog เอง (DialogHost ไม่วาด chrome ให้) logic เดิมไม่เปลี่ยน -->
    <Border Style="{StaticResource Card}" Width="440">
    <StackPanel Margin="20">
        <TextBlock Text="Broadcast Message" Style="{StaticResource Heading2}" Margin="0,0,0,16"/>

        <TextBlock Text="หัวข้อ (ไม่บังคับ)" Style="{StaticResource Label}" Margin="0,0,0,6"/>
        <TextBox x:Name="TitleInputBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,16"/>

        <TextBlock Text="ข้อความ" Style="{StaticResource Label}" Margin="0,0,0,6"/>
        <TextBox x:Name="MessageInputBox" Height="120" Style="{StaticResource RoundedTextBox}"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

        <RadioButton x:Name="SendToSelectedRadio" GroupName="BroadcastTarget"
                     Content="ส่งไปเครื่องที่เลือกไว้" Margin="0,0,0,8"/>
        <RadioButton x:Name="SendToAllRadio" GroupName="BroadcastTarget"
                     Content="ส่งไปทุกเครื่อง" Margin="0,0,0,16"/>

        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Grid>
            <Button Content="ยกเลิก" Style="{StaticResource ButtonSecondary}"
                    Padding="10,5" FontSize="11" HorizontalAlignment="Right" Margin="0,0,96,0" Click="CancelButton_Click"/>
            <Button Content="ส่งข้อความ" Style="{StaticResource ButtonPrimary}"
                    HorizontalAlignment="Right" Click="SendButton_Click" controls:DialogHost.IsDefaultButton="True"/>
        </Grid>
    </StackPanel>
    </Border>
</UserControl>
