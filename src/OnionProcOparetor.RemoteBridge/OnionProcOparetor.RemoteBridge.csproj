<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OnionProcOparetor.RemoteBridge</AssemblyName>
    <RootNamespace>OnionProcOparetor.RemoteBridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- เหตุผลเดียวกับ OnionProcOparetor.AgentTray - Hardcodet.NotifyIcon.Wpf (ไม่ใช่ .NetCore) ตัว
         .NetCore เจอ MissingMethodException บน .NET 10 -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- RemoteTriggerListener ใช้ Kestrel (WebApplication) แทน System.Net.HttpListener โดยตั้งใจ -
         พบจริงตอนทดสอบผ่าน Tailscale Funnel (2026-09-13): HttpListener/Http.sys ปฏิเสธ request ที่
         Host header ไม่ตรงกับ prefix ที่ผูกไว้เป๊ะๆ (ที่นี่คือ "localhost") ด้วย 400 Bad Request ก่อน
         โค้ดของเราจะได้เห็น request เลยด้วยซ้ำ - Funnel proxy ส่ง Host header เป็นชื่อ .ts.net จริง
         มาให้เสมอ ไม่ใช่ "localhost" Kestrel ผูก IP:port ตรงๆ ไม่สนใจ Host header เลยไม่มีปัญหานี้ -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Theme\icon.ico" Condition="Exists('Theme\icon.ico')" />
  </ItemGroup>
</Project>
