<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:OnionProcOparetor.UI.Controls">

    <!-- Colors.xaml is NOT merged here any more (2026-09-09). The palette is swapped at runtime by
         ThemeService, so pinning a specific palette file into this dictionary would defeat the swap;
         every colour below is a {DynamicResource} resolved against Application.Resources instead.
         Typography.xaml stays merged because FontFamily.Primary is theme-independent. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- "DisplayTimeConverter" ไม่ได้ประกาศในไฟล์นี้อีกต่อไป (WP UI-1a, 2026-11-03): แต่ละแอปแปลงเวลา
         ต่างกัน (Console มีโหมดไทย/UTC ผ่าน Services/TimeDisplay.cs, RosterManager แปลงเป็นเวลาท้องถิ่น
         เครื่องตรงๆ) จึงยังประกาศ key "DisplayTimeConverter" เองในไฟล์ App.xaml ของแต่ละแอป (หลัง merge
         Controls.xaml นี้) คอลัมน์เวลาด้านล่างอ้าง StaticResource key นี้เหมือนเดิมทุกจุด ไม่ต้องแก้ -->

    <!-- ==================== SpinningLoaderIcon (UI-4, 2026-11-04) ====================
         ไอคอน "loader-circle" หมุนตลอดเวลาที่แสดงอยู่ - ใช้แทนข้อความ "กำลังโหลด..." เฉยๆ ทั่วทั้งแอป
         (MainWindow.xaml LoadingOverlay ใช้ pattern เดียวกันแต่ผูกกับ DispatcherTimer ของตัวเองเพราะ
         ต้อง Start/StopSpinner ตรงจังหวะ fade - ตัวนี้สำหรับจุดที่แค่ "โชว์/ซ่อนตามการโหลด" เฉยๆ เช่น
         ป้าย "กำลังโหลด..." ในหน้าต่างย่อยต่างๆ)

         ไม่ต้องมี code-behind เลย: Trigger บน Visibility เริ่ม Storyboard ตอนโผล่ (Visible) และ
         สั่งหยุดตอนหาย (Collapsed/Hidden) ด้วย EnterActions/ExitActions ของ Trigger เอง (ต่างจาก
         EventTrigger ซึ่งไม่มี "ExitActions" ให้ผูกกับการหายไป) - ผู้ใช้ style นี้แค่ toggle
         Visibility ของ IconPresenter ตามปกติ (เหมือนป้าย "กำลังโหลด..." เดิมที่ toggle ข้อความ) -->
    <Style x:Key="SpinningLoaderIcon" TargetType="controls:IconPresenter">
        <Setter Property="Icon" Value="loader-circle"/>
        <Setter Property="IconSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Default}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="0"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Visibility" Value="Visible">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SpinLoaderStoryboard">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="RenderTransform.Angle"
                                From="0" To="360" Duration="0:0:0.9"
                                RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="SpinLoaderStoryboard"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== GhostIconButton (WP6) ====================
         ปุ่มไอคอนอย่างเดียวไม่มีกรอบ สำหรับ ✕ ปิด / หุบ-กาง ในแผงข้อมูลเครื่องและ toast
         ใส่ IconPresenter เป็น Content แล้วผูก Foreground กับปุ่ม เพื่อให้ไอคอนเข้มขึ้นตอนชี้ -->
    <Style x:Key="GhostIconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Row.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Window base ==================== -->
    <Style x:Key="AppWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- ==================== AppDialogWindow ====================
         แถบหัวหน้าต่างที่เราวาดเอง ใช้กับหน้าต่างย่อยทุกบาน

         เหตุผลหลักไม่ใช่ความสวย: บน Windows 10 build นี้แถบหัวของ Windows ไม่ยอมเป็นสีเข้ม แม้จะ
         ตั้ง DWMWA_USE_IMMERSIVE_DARK_MODE สำเร็จ (อ่านค่ากลับมาได้ 1 แต่ยังวาดขาว - ของนี้เริ่ม
         ทำงานจริงบน Windows 11) ดู ThemeService.ApplyToWindow ที่ยังคงเรียกไว้เผื่อเครื่อง Windows 11
         โหมดมืดจึงมีแถบขาวพาดหัวทุกหน้าต่างถ้าไม่วาดเอง

         แถบหัวนี้ **เข้มเสมอทั้งธีมสว่างและธีมมืด** (2026-09-10 ตามที่ผู้ใช้ขอ) ใช้ชุด Brush.Sidebar.*
         ซึ่งมีไว้สำหรับ "พื้นผิวที่เข้มไม่ว่าธีมไหน" อยู่แล้ว จึงไม่ต้องสร้าง token ชุดที่สามขึ้นมาอีก และ
         ได้ผลพลอยได้คือแถบหัวกับ sidebar เป็นชั้นสีเดียวกันต่อเนื่องกันทั้งหน้าต่าง

         ใช้ WindowChrome ไม่ใช่ WindowStyle="None" เปล่า ๆ: WindowChrome ยกเฉพาะ "การวาด" ของ
         non-client area มาให้เรา แต่ยังคง **พฤติกรรม** ของ Windows ไว้ครบ - ลากไปชน snap ที่ขอบจอ
         ปุ่มบนแถบงาน เงา การ resize ด้วยขอบ ทั้งหมดยังทำงานตามปกติ ต่างจาก WindowStyle="None"
         อย่างเดียวที่ต้องเขียนเลียนแบบเองทุกอย่างและมักจะได้ไม่ครบ
         CaptionHeight=38 ทำให้ 38px บนสุดลากย้ายหน้าต่างได้ ส่วนปุ่มปิดต้องประกาศ
         WindowChrome.IsHitTestVisibleInChrome="True" ไม่งั้นการลากจะกินคลิกไปหมด -->
    <Style x:Key="AppDialogWindow" TargetType="Window" BasedOn="{StaticResource AppWindowStyle}">
        <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="38" GlassFrameThickness="0" CornerRadius="0"
                              ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <!-- Padding บน Border ตัวนอกคือท่าแก้ปัญหาคลาสสิกของ WindowChrome: ตอนหน้าต่างถูก
                         maximize Windows จะขยายเลยขอบจอออกไปด้านละ ~7px (เผื่อขอบ resize ที่ปกติมองไม่เห็น)
                         ถ้าไม่ชดเชย ขอบบนของแถบหัวกับปุ่มปิดจะถูกตัดหายไปนอกจอ -->
                    <Border x:Name="WindowRoot"
                            Background="{DynamicResource Brush.Background.Primary}"
                            BorderBrush="{DynamicResource Brush.Sidebar.Border}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource Brush.Sidebar.Background}"
                                    BorderBrush="{DynamicResource Brush.Sidebar.Border}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- ไอคอนแอปในแถบหัว: แถบหัวของ Windows เคยวาดให้อยู่แล้ว พอวาด
                                             แถบเองต้องใส่กลับเข้ามา ไม่งั้นหน้าต่างจะดูไม่มีเจ้าของ
                                             ผูกกับ Window.Icon เพื่อให้ตรงกับที่โผล่บนแถบงานเสมอ -->
                                        <Image Source="{TemplateBinding Icon}" Width="16" Height="16"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{TemplateBinding Title}"
                                                   Margin="9,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource FontFamily.Primary}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Sidebar.Text}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Button x:Name="MinimizeButton" Width="46" Height="37"
                                                controls:DialogChrome.IsMinimizeButton="True"
                                                controls:Nav.Icon="minus"
                                                ToolTip="ย่อ" Visibility="Collapsed"
                                                Style="{DynamicResource DialogChromeButton}"/>
                                        <Button x:Name="MaximizeButton" Width="46" Height="37"
                                                controls:DialogChrome.IsMaximizeButton="True"
                                                controls:Nav.Icon="square"
                                                ToolTip="ขยาย / คืนขนาด" Visibility="Collapsed"
                                                Style="{DynamicResource DialogChromeButton}"/>
                                        <Button Width="46" Height="37"
                                                controls:DialogChrome.IsCloseButton="True"
                                                ToolTip="ปิด"
                                                Style="{DynamicResource DialogCloseButton}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- AdornerDecorator จำเป็นเมื่อเขียน Window template เอง: adorner layer
                                 เป็นของที่ template มาตรฐานใส่มาให้ ถ้าไม่มี ToolTip/validation error
                                 template/drag adorner จะไม่ปรากฏเลยในหน้าต่างเหล่านี้ -->
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- ปุ่มย่อ/ขยายโผล่ตาม ResizeMode ของหน้าต่างนั้น ๆ - dialog ส่วนใหญ่เป็น
                             NoResize จึงมีแค่ปุ่มปิด เหมือนที่ Windows เองทำ -->
                        <Trigger Property="ResizeMode" Value="CanResize">
                            <Setter TargetName="MinimizeButton" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="MaximizeButton" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanResizeWithGrip">
                            <Setter TargetName="MinimizeButton" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="MaximizeButton" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="MinimizeButton" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="WindowRoot" Property="Padding" Value="7"/>
                            <Setter TargetName="WindowRoot" Property="BorderThickness" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ปุ่มย่อ/ขยายในแถบหัว - hover เป็นสีพื้นธรรมดา ไม่ใช่สีแดง (แดงสงวนไว้ให้ปุ่มปิดเท่านั้น
         ตามที่ Windows เองทำ) ไอคอนมาจาก Nav.Icon เพื่อให้ปุ่มเดียวกันใช้ได้ทั้งย่อและขยาย -->
    <Style x:Key="DialogChromeButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Sidebar.TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <controls:IconPresenter
                            Icon="{Binding (controls:Nav.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                            IconSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Sidebar.BackgroundRaised}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Sidebar.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ปุ่มปิดในแถบหัว - แดงตอน hover ตามแบบที่ Windows เองทำ เพื่อให้ยังรู้สึกเป็นปุ่มปิดของระบบ -->
    <Style x:Key="DialogCloseButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Sidebar.TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <controls:IconPresenter Icon="x" IconSize="16"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger.Default}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Card (Border) ==================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- ==================== RoundedTextBox ====================
         2026-09-03: tried dropping the custom Template so Fluent's own TextBox template would render
         (ThemeMode="Light" on App.xaml), then tried the documented Border.CornerRadius attached-property
         knob (https://github.com/dotnet/wpf/discussions/9450) to round it. Verified empirically (cropped
         screenshot inspection, not just assumed) that neither actually rounds the corners in this
         build - the box rendered perfectly square either way. Reverted to an explicit ControlTemplate,
         which reliably rounds because CornerRadius is a real property on the Border element below,
         not an attached-property hint a template may or may not read. -->
    <Style x:Key="RoundedTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="Padding" Value="10,4.5"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== RoundedPasswordBox ====================
         Explicit Template restored - same reasoning as RoundedTextBox above. -->
    <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== ButtonPrimary ====================
         Explicit Template restored - same empirical finding as RoundedTextBox above (Fluent's default
         template and the Border.CornerRadius attached property both rendered dead square in this
         build - verified via cropped screenshot, not assumed). An explicit Border-based template
         reliably rounds because CornerRadius here is a real property, not a hint. -->
    <Style x:Key="ButtonPrimary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Default}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.OnAccent}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Light}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Status.Offline}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== ButtonSecondary ====================
         Explicit Template restored - same reasoning as ButtonPrimary above. -->
    <Style x:Key="ButtonSecondary" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== ButtonDanger ====================
         Explicit Template restored - same reasoning as ButtonPrimary above. -->
    <Style x:Key="ButtonDanger" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Fill}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger.Light}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger.Dark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Status.Offline}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== PillTabButton (Client/Rule/Logs/User nav) ==================== -->
    <Style x:Key="PillTabButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="16"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Default}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.OnAccent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== UnderlineTabItem (TabControl nav) ====================
         Rebuilt 2026-09-03: replaced the old rounded-pill design entirely, after two rounds of
         patching a corner-clipping bug (asymmetric top/bottom curve on the selected pill, root-caused
         via raw pixel sampling to Fluent's default TabControl chrome, then fixed with an explicit
         TabControl.Template in DashboardWindow.xaml) still wasn't good enough on the user's machine.
         Rather than keep patching the same fragile shape, this is a flat underline-indicator style
         instead: no rounded corners anywhere, so there is no corner-clipping class of bug left to hit.
         Selected tab = accent-colored bold text + a 3px accent bar underneath; unselected = plain
         secondary-colored text. Renamed from "PillTabItem" since it's no longer pill-shaped - it isn't
         referenced anywhere except DashboardWindow.xaml (grepped before renaming). -->
    <Style x:Key="UnderlineTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Margin" Value="0,0,24,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- StackPanel, not Grid: a Grid with no explicit ColumnDefinitions gets one
                         implicit column at Width="*" (fill-available), not Auto (size-to-content) -
                         that measured every tab far too narrow before TabPanel had settled on a width
                         to give it, clipping every label (confirmed: "CLIENTS" rendered as "CLIEN",
                         "RULES" as "RU", etc.). StackPanel sizes to its content's natural
                         width/height in both dimensions with no such footgun. -->
                    <StackPanel Background="Transparent">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Border x:Name="Indicator" Height="3" Margin="0,8,0,0" Background="Transparent"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Default}"/>
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Brush.Accent.Default}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== StatusBadge ====================
         Usage: <ContentControl Style="{StaticResource StatusBadge}" Tag="Online" Content="Online"/>
         Tag รับ "Online" / "Offline" / "Warning" / "Danger" / "Accent"

         2026-09-09: เปลี่ยนจาก "ถมสีทึบ + ตัวหนังสือขาว" มาเป็น "เม็ดสีอ่อน + ตัวหนังสือสีสถานะ +
         จุดนำหน้า" ให้ตรงกับ .badge ของฝั่งเว็บ นอกจากเรื่องความเหมือนกันแล้วยังแก้ปัญหาจริงสองอย่าง:

         1. badge สีทึบ 3 อันเรียงกันในหนึ่งแถวของตาราง 40 แถว กลายเป็นกำแพงสีที่แย่งสายตาไปจาก
            ข้อมูลในตารางเอง แบบเม็ดสีอ่อนยังอ่านสถานะได้จากสีเหมือนเดิมแต่ไม่ตะโกน
         2. badge "Warning" เดิมใช้ตัวหนังสือ Brush.Text.Primary บนพื้นเหลือง ซึ่งพอเข้าธีมมืด
            Text.Primary กลายเป็นขาวนวล = ขาวบนเหลือง อ่านไม่ออก ตอนนี้ตัวหนังสือใช้ Status.WarningText
            ที่ถูกเลือกมาให้อ่านออกในธีมของมันเอง

         จุดนำหน้าไม่ใช่ของประดับ: มันคือตัวที่ทำให้แยกสถานะได้โดยไม่ต้องพึ่งสีอย่างเดียว และเป็น
         ของเดียวกับ .badge::before ฝั่งเว็บ -->
    <Style x:Key="StatusBadge" TargetType="ContentControl">
        <Setter Property="Tag" Value="Offline"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Offline}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Bd" CornerRadius="999" Padding="9,3"
                            Background="{DynamicResource Brush.Badge.Offline.Background}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{TemplateBinding Foreground}"/>
                            <TextBlock Text="{TemplateBinding Content}" Margin="6,0,0,0"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Online">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Badge.Online.Background}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Online}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Offline">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Badge.Offline.Background}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Offline}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Warning">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Badge.Warning.Background}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.WarningText}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Danger">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Badge.Danger.Background}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Default}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Accent">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Badge.Accent.Background}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ปุ่มที่วางอยู่บนพื้นสีสถานะ (แถบเตือน gate ปิด) - เป็นเม็ดสีเข้มบนพื้นเหลือง
         ButtonPrimary ใช้ไม่ได้ตรงนี้เพราะส้มบนเหลืองแยกกันแทบไม่ออก และ ButtonSecondary ก็จะกลืน
         ไปกับพื้นการ์ดในธีมสว่าง -->
    <Style x:Key="ButtonOnStatus" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Text.OnStatusFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== StatCardFilter ====================
         การ์ดตัวเลขสรุปบนหัวหน้า Clients ที่ "กดเพื่อกรองตารางข้างล่าง" ได้

         เป็น RadioButton ไม่ใช่ Button/ToggleButton โดยเจตนา: การกรองเป็นตัวเลือกที่เลือกได้ทีละอัน
         ซึ่งเป็นความหมายของ RadioButton พอดี เลยได้พฤติกรรม "กดอันใหม่แล้วอันเก่าคลายเอง" ฟรี
         ไม่ต้องเขียน code-behind ไล่ปลดการ์ดอื่น และคนที่ใช้ keyboard ก็ได้ลูกศรเลื่อนในกลุ่มมาให้ด้วย

         Content = ป้ายกำกับ, Tag = ตัวเลข (code-behind เขียนทับทุกครั้งที่ข้อมูลเปลี่ยน) ที่ต้องแยก
         สองที่แบบนี้เพราะ ContentControl มีช่องใส่ "เนื้อหา" ช่องเดียว แต่การ์ดนี้มีสองบรรทัดที่
         อัพเดตคนละจังหวะกัน -->
    <Style x:Key="StatCardFilter" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="MinWidth" Value="118"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="12" Padding="14,9" BorderThickness="1"
                            Background="{DynamicResource Brush.Background.Card}"
                            BorderBrush="{DynamicResource Brush.Border.Default}">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="22" FontWeight="Bold"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Background.CardRaised}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Badge.Accent.Background}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== SearchTextBox ====================
         RoundedTextBox + แว่นขยาย + ข้อความ placeholder ที่ "แสดงจริง"

         ของเดิมตั้ง Tag="ค้นหา machine name..." ไว้ทุกช่องค้นหาแต่ template ไม่เคยวาดมันออกมาเลย
         ช่องค้นหาจึงเป็นกล่องเปล่าที่ไม่มีอะไรบอกว่าใส่อะไรได้ - ตรงนี้ทำให้ Tag ทำงานจริงตามที่
         ตั้งใจไว้ตั้งแต่แรก โดยไม่ต้องแก้ call site สักที่ -->
    <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
        <Setter Property="Padding" Value="34,4.5,10,4.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <controls:IconPresenter Icon="search" IconSize="16"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Margin="10,0,0,0"
                                                    Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== PlaceholderTextBox / PlaceholderPasswordBox ====================
         เหมือน RoundedTextBox/RoundedPasswordBox ทุกอย่าง แต่วาดข้อความ placeholder จาก Tag ตอนที่
         ช่องยังว่าง - ใช้กับช่องกรอกที่ไม่มีป้ายกำกับอยู่ข้าง ๆ (เช่นช่องเพิ่มผู้ใช้ในแท็บ Users ซึ่ง
         เดิมเป็นกล่องเปล่าสองกล่องเรียงกัน บอกไม่ได้เลยว่าอันไหนคือ username ถ้าไม่เอาเมาส์ไปชี้)

         PasswordBox ไม่มี property Text ให้ trigger เกาะ (จงใจ ด้วยเหตุผลด้านความปลอดภัย) จึงต้องใช้
         PasswordChanged จาก code-behind ไม่ได้ - ที่นี่ใช้วิธีผูกกับ IsKeyboardFocusWithin แทน คือ
         ซ่อน placeholder ทันทีที่ช่องได้ focus ซึ่งครอบคลุมกรณีจริงทั้งหมด (จะพิมพ์ก็ต้อง focus ก่อน)
         และไม่ต้องแตะ code-behind ของทุกหน้าต่างที่ใช้ -->
    <Style x:Key="PlaceholderTextBox" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlaceholderPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource RoundedPasswordBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== EmptyState ====================
         แทนข้อความเปล่าบรรทัดเดียวกลางตารางว่าง ๆ ("ยังไม่มีเครื่องในระบบ") ด้วยไอคอน + ประโยคหลัก +
         บรรทัดบอกว่าให้ทำอะไรต่อ

         Content = ประโยคหลัก, Tag = บรรทัดรอง (ซ่อนเองถ้าไม่ใส่), Nav.Icon = ไอคอน
         code-behind สลับข้อความได้ระหว่าง "ยังไม่มีข้อมูลเลย" กับ "กรองแล้วไม่เจอ" ซึ่งเป็นคนละ
         สถานการณ์และมีทางออกคนละแบบ - ของเดิมพูดเหมือนกันทั้งสองกรณี -->
    <Style x:Key="EmptyState" TargetType="ContentControl">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel>
                        <controls:IconPresenter
                            Icon="{Binding (controls:Nav.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                            IconSize="32" HorizontalAlignment="Center" Opacity="0.55"
                            Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        <TextBlock Text="{TemplateBinding Content}" Margin="0,10,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   FontFamily="{StaticResource FontFamily.Primary}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   FontFamily="{StaticResource FontFamily.Primary}"
                                   FontSize="11" MaxWidth="320" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" Opacity="0.8"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Hint" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== SelectionBar ====================
         แถบที่โผล่มาเมื่อเลือกเครื่องไว้อย่างน้อยหนึ่งเครื่อง พร้อมปุ่มที่ทำกับ "เครื่องที่เลือกอยู่"

         ที่ต้องมี (ไม่ใช่แค่ความสวย): ActionPanelWindow รับ List<ClientMachineDto> มาตั้งแต่แรกและ
         ตารางก็ SelectionMode="Extended" อยู่แล้ว คือทำงานกับหลายเครื่องพร้อมกันได้มาตลอด แต่ทางเข้า
         คือปุ่ม ACTIONS ที่นิ่งอยู่มุมบนตลอดเวลา ไม่มีอะไรบอกว่ามันผูกกับสิ่งที่เลือกไว้ - ความสามารถ
         ที่สำคัญที่สุดสำหรับห้อง 40 เครื่องเลยถูกซ่อนอยู่หลังปุ่มที่ดูเหมือนปุ่มทั่วไป -->
    <Style x:Key="SelectionBar" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Accent.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Default}"/>
    </Style>

    <!-- ==================== Shared DataGrid look ====================
         ย้ายมาจาก DashboardWindow.xaml's Window.Resources (2026-08-25) - บั๊กจริงที่เจอ: 3 style นี้
         ตั้งใจให้ "shared" ตั้งแต่แรก (ดู comment เดิม "Shared DataGrid look for all 4 tabs") แต่ประกาศไว้
         ใน Window.Resources ของ DashboardWindow เอง ทำให้ "shared" จริงๆ แค่ภายใน 4 แท็บของหน้าต่างนั้น
         เท่านั้น - พอ RunningProcessesWindow (คนละ Window instance) อ้างถึง StaticResource เดียวกันนี้ผ่าน
         DataGrid ของตัวเอง WPF resolve ไม่เจอเลย (StaticResource lookup ไม่ข้าม Window ไปหา Window.Resources
         ของอีกอันได้) เจอจริงจาก field test เป็น XamlParseException ทันทีที่เปิดหน้าต่าง ("Provide value on
         'System.Windows.StaticResourceExtension' threw an exception") - ทั้งที่ dotnet build ผ่านมาตลอด
         เพราะ StaticResource resolve ตอน runtime ไม่ใช่ compile time ย้ายมาไว้ที่นี่ (merged เข้าทุก Window
         ผ่าน App.xaml อยู่แล้ว) ให้ shared จริงตามที่ตั้งใจไว้แต่แรก ไม่ต้อง duplicate ต่อทุกหน้าต่างใหม่ที่มี
         DataGrid -->
    <Style x:Key="ConsoleGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style x:Key="ConsoleGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <!-- Brush.Row.Hover, not an inline SolidColorBrush with Opacity: a Freezable declared
                     inline inside a Style setter gets frozen by WPF, and a frozen brush cannot carry a
                     DynamicResource - the hover colour would stay stuck on whichever theme loaded first. -->
                <Setter Property="Background" Value="{DynamicResource Brush.Row.Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ConsoleGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Primary}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ====================================================================================
         SIDEBAR (2026-09-09)
         ====================================================================================
         แถวเมนูใน sidebar ของ DashboardWindow ซึ่งจริง ๆ แล้วคือ TabItem ของ TabControl เดิม
         เปลี่ยนแค่หน้าตา ไม่ได้เปลี่ยนกลไก จึงไม่ต้องแตะ event wiring เดิมเลยแม้แต่บรรทัดเดียว
         (MainTabControl_SelectionChanged, ScreenViewTabItem, AuditLogTabItem, โค้ดที่สั่งสลับ
         แท็บเอง ทำงานเหมือนเดิมทั้งหมด)

         สีในนี้ใช้ชุด Brush.Sidebar.* ซึ่ง "เข้มทั้งในธีมสว่างและธีมมืด" โดยเจตนา เหมือนฝั่งเว็บ
         (ดูหัวไฟล์ theme.css) เพราะ nav สีขาวบนหน้าขาวจะกลืนกันจนไม่รู้ว่าเป็นคนละชั้น และสีส้ม
         accent ต้องมีพื้นเข้มให้เด้งออกมา
         ==================================================================================== -->
    <Style x:Key="SidebarTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Sidebar.TextSecondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <StackPanel>
                        <!-- หัวข้อกลุ่มวาดโดยแถวแรกของกลุ่มเอง ไม่ใช่ element แยก เพราะ TabControl มี
                             items host ได้ panel เดียว จะแทรกอะไรคั่นกลางระหว่าง item ไม่ได้ (ดู Nav.Group) -->
                        <!-- ระยะหัวกลุ่ม/ความสูงแถวถูกบีบลงเล็กน้อย (WP6) - sidebar มี 10 เมนูใน 4 กลุ่มแล้ว
                             ขนาดเดิม (หัวกลุ่ม 16/6, แถว 40) ล้นความสูงหน้าต่างเริ่มต้น 732px จน "ตั้งค่า"
                             ตกขอบล่างไปอยู่ใต้ scroll -->
                        <TextBlock x:Name="GroupHeader" Margin="20,10,12,4"
                                   Text="{Binding (controls:Nav.Group), RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{DynamicResource Brush.Sidebar.TextSecondary}"
                                   FontFamily="{StaticResource FontFamily.Primary}"
                                   FontSize="10" FontWeight="SemiBold" Opacity="0.7"/>

                        <Border x:Name="Row" Height="38" CornerRadius="8" Margin="8,1"
                                Background="Transparent"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- แถบ accent ซ้ายมือบอกแถวที่เลือกอยู่ จำเป็นเพิ่มจากพื้นหลังที่เปลี่ยนสี
                                     เพราะพื้น active เป็นส้มโปร่ง 16% ซึ่งบาง และมันเป็นตัวบอกสถานะตัวเดียว
                                     ที่ยังเห็นชัดตอน sidebar หดเหลือแต่ไอคอน -->
                                <Border x:Name="ActiveBar" Grid.Column="0" Grid.ColumnSpan="2"
                                        Width="3" Height="20" CornerRadius="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="-5,0,0,0" Visibility="Collapsed"
                                        Background="{DynamicResource Brush.Accent.Default}"/>

                                <controls:IconPresenter x:Name="RowIcon" Grid.Column="0"
                                                        Icon="{Binding (controls:Nav.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                                        IconSize="18" Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{TemplateBinding Foreground}"/>

                                <TextBlock x:Name="RowLabel" Grid.Column="1" Margin="12,0,12,0"
                                           Text="{TemplateBinding Header}"
                                           FontFamily="{StaticResource FontFamily.Primary}"
                                           FontSize="13" FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!-- แถวที่ไม่ได้ขึ้นกลุ่มใหม่ (Nav.Group ว่าง) ไม่ต้องเว้นที่ให้หัวข้อ -->
                        <Trigger Property="controls:Nav.Group" Value="">
                            <Setter TargetName="GroupHeader" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Sidebar.BackgroundRaised}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Sidebar.Text}"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Sidebar.ActiveBackground}"/>
                            <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Light}"/>
                        </Trigger>

                        <!-- sidebar หด: เหลือแต่ไอคอนกลางแถว ข้อความและหัวข้อกลุ่มหายไป และแถวได้ ToolTip
                             เป็นชื่อเมนูแทน ไม่งั้นไอคอนเปล่า ๆ จะเดาไม่ออกว่าอันไหนคืออะไร -->
                        <DataTrigger Binding="{Binding (controls:Nav.IsCollapsed), RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="RowLabel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="GroupHeader" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="RowIcon" Property="Margin" Value="0"/>
                            <Setter TargetName="RowIcon" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="RowIcon" Property="Grid.ColumnSpan" Value="2"/>
                            <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource Self}}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ปุ่มท้าย sidebar (PROGRAMS / SETTINGS / สลับธีม / หด-กาง) หน้าตาเหมือนแถวเมนู แต่เป็น Button
         เพราะมันเปิดหน้าต่างหรือสั่งงาน ไม่ใช่การสลับแท็บ -->
    <Style x:Key="SidebarActionButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Sidebar.TextSecondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Row" CornerRadius="8" Margin="8,1" Background="Transparent"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:IconPresenter x:Name="RowIcon" Grid.Column="0"
                                                    Icon="{Binding (controls:Nav.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                                    IconSize="18" Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter x:Name="RowLabel" Grid.Column="1" Margin="12,0,12,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Sidebar.BackgroundRaised}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Sidebar.Text}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding (controls:Nav.IsCollapsed), RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="RowLabel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="RowIcon" Property="Margin" Value="0"/>
                            <Setter TargetName="RowIcon" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="RowIcon" Property="Grid.ColumnSpan" Value="2"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
