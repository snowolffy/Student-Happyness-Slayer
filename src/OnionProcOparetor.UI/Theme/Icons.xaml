    <!-- minus / square - ปุ่มย่อและปุ่มขยายในแถบหัวหน้าต่างที่เราวาดเอง (AppDialogWindow)
         เพิ่มพร้อมกันทั้งสองฝั่งตามสัญญา "Icons.xaml กับ Icon.razor ต้องมีชุดเดียวกันเสมอ" -->
    <GeometryGroup x:Key="Icon.Minus" FillRule="Nonzero">
