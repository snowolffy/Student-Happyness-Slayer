        <RectangleGeometry Rect="3,3,7,7"/>
        <RectangleGeometry Rect="14,3,7,7"/>
        <RectangleGeometry Rect="14,14,7,7"/>
        <RectangleGeometry Rect="3,14,7,7"/>
