<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ====================================================================================
         ACCENT (DARK) - คู่กับ Accent.Light.xaml ดู comment ที่นั่นสำหรับรายละเอียดชุด token
         และสาเหตุที่แยกออกมาจาก Colors.Dark.xaml

         The accent itself does NOT change (#F5A623 works on both grounds) but Accent.Text does -
         on a dark card the darkened #B4740C is the unreadable one, so it flips to the light shade.
         ==================================================================================== -->

    <sys:String x:Key="Theme.AccentName">Dark</sys:String>

    <!-- ==================== Accent (amber/orange) ==================== -->
    <Color x:Key="Color.Accent.Default">#F5A623</Color>          <!-- css:accent: unchanged in dark, on purpose -->
    <Color x:Key="Color.Accent.Light">#F7B84D</Color>
    <Color x:Key="Color.Accent.Dark">#D6890F</Color>
    <Color x:Key="Color.Accent.Text">#F7B84D</Color>             <!-- css:accent-text: flips to the LIGHT shade on a dark card -->
    <Color x:Key="Color.Accent.OnAccent">#FFFFFF</Color>         <!-- Deliberately the SAME as light - see Accent.Light.xaml -->

    <SolidColorBrush x:Key="Brush.Accent.Default" Color="{StaticResource Color.Accent.Default}"/>
    <SolidColorBrush x:Key="Brush.Accent.Light" Color="{StaticResource Color.Accent.Light}"/>
    <SolidColorBrush x:Key="Brush.Accent.Dark" Color="{StaticResource Color.Accent.Dark}"/>
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="{StaticResource Color.Accent.Text}"/>
    <SolidColorBrush x:Key="Brush.Accent.OnAccent" Color="{StaticResource Color.Accent.OnAccent}"/>

    <!-- ==================== Badge/selection tint ==================== -->
    <Color x:Key="Color.Badge.Accent.Background">#29F5A623</Color>
    <SolidColorBrush x:Key="Brush.Badge.Accent.Background" Color="{StaticResource Color.Badge.Accent.Background}"/>

    <!-- ==================== Sidebar active row (selection) ==================== -->
    <Color x:Key="Color.Sidebar.ActiveBackground">#29F5A623</Color>
    <SolidColorBrush x:Key="Brush.Sidebar.ActiveBackground" Color="{StaticResource Color.Sidebar.ActiveBackground}"/>

    <!-- ==================== Row hover (DataGrid / GhostIconButton) ==================== -->
    <Color x:Key="Color.Row.Hover">#26F7B84D</Color>
    <SolidColorBrush x:Key="Brush.Row.Hover" Color="{StaticResource Color.Row.Hover}"/>

</ResourceDictionary>
