<UserControl x:Class="OnionProcOparetor.RosterManager.Controls.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OnionProcOparetor.UI.Controls;assembly=OnionProcOparetor.UI"
             xmlns:services="clr-namespace:OnionProcOparetor.RosterManager.Services">
    <!-- ตัวแสดง toast มุมขวาล่าง (WP6) - วางไว้ชั้นบนสุดของหน้าต่าง โดยไม่มี Background เลย
         พื้นที่รอบ ๆ toast จึงไม่รับคลิก (null background = ไม่ hit-test) คลิกทะลุไปถึงตารางข้างหลังได้
         ตามปกติ มีแต่ตัว toast เองที่รับเมาส์

         อันใหม่สุดอยู่ล่างสุด (ใกล้มุมจอที่สุด) อันเก่าถูกดันขึ้น - ตำแหน่งที่ตาจะหาเมื่อเพิ่งกดอะไรไป
         คือจุดเดิมเสมอ ไม่ใช่ไล่หาว่าอันใหม่ไปโผล่ตรงไหนของกอง -->
    <UserControl.Resources>
        <!-- ลิงก์ในตัว toast ("ดูผล") - ตัวหนังสือสี accent ไม่ใช่ปุ่มทึบ เพราะ toast ไม่ควรแย่งความเด่น
             จากปุ่มในหน้าจอ แต่ต้องดูออกว่ากดได้ จึงขีดเส้นใต้ตอนชี้ -->
        <Style x:Key="ToastLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.Primary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ToastTemplate" DataType="{x:Type services:ToastItem}">
            <Border x:Name="Card" Width="340" Margin="0,8,0,0" CornerRadius="10"
                    Background="{DynamicResource Brush.Background.CardRaised}"
                    BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1"
                    MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave"
                    RenderTransformOrigin="0.5,1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.22" Color="Black"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <!-- โผล่แบบเลื่อนขึ้นสั้น ๆ - ไม่ได้ทำเพื่อความสวย แต่การเคลื่อนไหวเล็ก ๆ ตรงมุมจอ
                         คือสิ่งที่ทำให้ตาเหลือบไปเห็นว่ามีผลลัพธ์ใหม่ โดยไม่ต้องกะพริบหรือส่งเสียง -->
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="12" To="0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- แถบสีซ้ายบอกชนิด - อ่านออกจากหางตาโดยไม่ต้องอ่านข้อความ -->
                    <Border x:Name="KindBar" Grid.Column="0" Width="4" CornerRadius="10,0,0,10"
                            Background="{DynamicResource Brush.Status.Online}"/>

                    <controls:IconPresenter x:Name="KindIcon" Grid.Column="1" Icon="{Binding IconName}"
                                            IconSize="18" Margin="12,12,0,0" VerticalAlignment="Top"
                                            Foreground="{DynamicResource Brush.Status.Online}"/>

                    <StackPanel Grid.Column="2" Margin="10,11,4,11" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                   FontFamily="{StaticResource FontFamily.Primary}" FontSize="13"
                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                        <Button x:Name="ActionLink" Content="{Binding ActionText}" Margin="0,6,0,0"
                                HorizontalAlignment="Left" Visibility="Collapsed"
                                Style="{StaticResource ToastLinkButton}" Click="ActionLink_Click"/>
                    </StackPanel>

                    <Button Grid.Column="3" Style="{StaticResource GhostIconButton}" Padding="4" Margin="0,8,8,0"
                            VerticalAlignment="Top" ToolTip="ปิด" Click="CloseButton_Click">
                        <controls:IconPresenter Icon="x" IconSize="14"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Info">
                    <Setter TargetName="KindBar" Property="Background" Value="{DynamicResource Brush.Accent.Default}"/>
                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource Brush.Accent.Text}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter TargetName="KindBar" Property="Background" Value="{DynamicResource Brush.Danger.Default}"/>
                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource Brush.Danger.Default}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasAction}" Value="True">
                    <Setter TargetName="ActionLink" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ItemsControl x:Name="ToastList" ItemTemplate="{StaticResource ToastTemplate}"
                  VerticalAlignment="Bottom" Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel VerticalAlignment="Bottom"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>
