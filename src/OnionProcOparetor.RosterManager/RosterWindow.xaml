<Window x:Class="OnionProcOparetor.RosterManager.RosterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnionProcOparetor.RosterManager.Controls"
        Title="Roster Manager · Onion ProcOparetor"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        MinWidth="1080" MinHeight="680"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}"
        Closed="RosterWindow_Closed">
    <!-- WP3-2 (2026-10-31): หน้าหลักตาม docs/wireframes/nf-roster.dc.html
         sidebar ชั้น/ห้อง (ซ้าย) + ตารางนักเรียน (กลาง) + แผงรายละเอียด/bulk action (ขวา)
         ความต่างจาก wireframe ที่ตั้งใจ (ระบุในรายงานด้วย):
           - checkbox ต่อแถวในตารางถูกแทนด้วยการเลือกหลายแถวปกติ (Ctrl/Shift คลิก) - ผลลัพธ์เดียวกัน
             แต่ไม่มีช่อง checkbox แยกให้เห็นเป็นคอลัมน์
           - แถบสถานะ/ประกาศของทั้งระบบ เป็นแถบเดียวที่ขยับข้อความแทนศูนย์ประกาศเต็มรูปแบบของ Console
             (Services/AnnouncementCenter.cs) - Roster Manager มีเรื่องที่ต้องประกาศพร้อมกันไม่เกิน 1
             เรื่องในเวลาเดียว (โหลดรายชื่อไม่สำเร็จ) จึงไม่จำเป็นต้องมีคิว "+N" แบบ Console -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== แถบสถานะบน (ผู้ใช้ปัจจุบัน + server + ออกจากระบบ) ==================== -->
        <Border Grid.Row="0" Height="48" Background="{DynamicResource Brush.Sidebar.Background}"
                BorderBrush="{DynamicResource Brush.Sidebar.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <TextBlock x:Name="SessionInfoText" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource Brush.Sidebar.TextSecondary}"/>
                <Button x:Name="LogoutButton" Content="ออกจากระบบ" HorizontalAlignment="Right"
                        Style="{StaticResource ButtonSecondary}" Padding="12,5" Click="LogoutButton_Click"/>
            </Grid>
        </Border>

        <!-- ==================== แถบประกาศ (ย่อ) - ซ่อนเมื่อไม่มีปัญหา ==================== -->
        <Border x:Name="BannerBorder" Grid.Row="1" Visibility="Collapsed" Padding="14,10"
                Background="{DynamicResource Brush.Danger.Fill}">
            <Grid>
                <TextBlock x:Name="BannerText" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource Brush.Text.OnAccent}" TextWrapping="Wrap"/>
                <Button x:Name="BannerFixButton" Content="ลองใหม่" HorizontalAlignment="Right"
                        Style="{StaticResource ButtonOnStatus}" Padding="10,4" Click="BannerFixButton_Click"/>
            </Grid>
        </Border>

        <!-- ==================== ตัวหลัก ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- ==== sidebar: ชั้น/ห้อง ==== -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Background.Primary}"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,14">
                    <TextBlock DockPanel.Dock="Top" Text="ชั้น / ห้อง" Style="{StaticResource Label}" Margin="10,0,0,8"/>
                    <ListBox x:Name="ClassList" DockPanel.Dock="Top" BorderThickness="0" Background="Transparent"
                             SelectionChanged="ClassList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="12" Opacity="0.7"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                    Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Default}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Background.CardRaised}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ==== กลาง: หัว + filter + ตาราง ==== -->
            <DockPanel Grid.Column="1" Margin="20,16,16,16">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid Margin="0,0,0,10">
                        <TextBlock x:Name="HeaderTitleText" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ImportButton" Content="นำเข้า CSV…" Style="{StaticResource ButtonSecondary}" Margin="0,0,8,0" Click="ImportButton_Click"/>
                            <Button x:Name="PrintButton" Content="พิมพ์ใบรหัสผ่าน…" Style="{StaticResource ButtonSecondary}" Margin="0,0,8,0" Click="PrintButton_Click"/>
                            <Button x:Name="PromoteButton" Content="เลื่อนชั้นปีการศึกษาใหม่…" Style="{StaticResource ButtonSecondary}" Margin="0,0,8,0" Click="PromoteButton_Click"/>
                            <Button x:Name="AddButton" Content="เพิ่มนักเรียน…" Style="{StaticResource ButtonPrimary}" Click="AddButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="SearchBox" Width="260" Style="{StaticResource SearchTextBox}" Margin="0,0,8,0"
                                     TextChanged="SearchBox_TextChanged" Tag="ค้นหา ชื่อ / รหัส / เมล"/>
                            <ComboBox x:Name="StatusFilterCombo" Width="160" SelectionChanged="StatusFilterCombo_SelectionChanged">
                                <ComboBoxItem Content="ทุกสถานะ" Tag=""/>
                                <ComboBoxItem Content="ปกติ" Tag="normal"/>
                                <ComboBoxItem Content="ถูกล็อก" Tag="locked"/>
                                <ComboBoxItem Content="ต้องเปลี่ยนรหัส" Tag="mustchange"/>
                                <ComboBoxItem Content="ปิดใช้งาน" Tag="disabled"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectionCountText" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                            <Button x:Name="BulkResetButton" Content="รีเซ็ตรหัสที่เลือก" Style="{StaticResource ButtonSecondary}"
                                    Padding="10,5" Margin="0,0,8,0" Visibility="Collapsed" Click="BulkResetButton_Click"/>
                            <Button x:Name="BulkMoveButton" Content="ย้ายห้อง" Style="{StaticResource ButtonSecondary}"
                                    Padding="10,5" Visibility="Collapsed" Click="BulkMoveButton_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Border CornerRadius="10" ClipToBounds="True"
                        Background="{DynamicResource Brush.Background.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                    <DataGrid x:Name="StudentsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              SelectionChanged="StudentsGrid_SelectionChanged"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="{DynamicResource Brush.Background.Card}"
                              AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                              HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                              VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                              RowHeight="38" CanUserAddRows="False"
                              ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                              RowStyle="{StaticResource ConsoleGridRowStyle}"
                              CellStyle="{StaticResource ConsoleGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="รหัส" Binding="{Binding StudentCode}" Width="90"/>
                            <DataGridTextColumn Header="ชื่อ-สกุล" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="ชั้น/ห้อง" Binding="{Binding ClassName}" Width="90"/>
                            <DataGridTextColumn Header="เมลโรงเรียน" Binding="{Binding SchoolEmail}" Width="200"/>
                            <DataGridTemplateColumn Header="สถานะบัญชี" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Style="{StaticResource StatusBadge}" Content="{Binding StatusLabel}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ล็อกอินล่าสุด" Width="150"
                                                 Binding="{Binding LastLoginAt, Converter={StaticResource DisplayTimeConverter}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>

            <!-- ==== ขวา: แผงรายละเอียด/bulk ==== -->
            <Border Grid.Column="2" Margin="0,16,16,16" CornerRadius="10"
                    Background="{DynamicResource Brush.Background.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                <Grid Margin="16">
                    <TextBlock x:Name="InspectorEmptyText" Text="เลือกนักเรียนเพื่อดูรายละเอียด"
                               Style="{StaticResource Body}" TextWrapping="Wrap" Opacity="0.7"/>

                    <StackPanel x:Name="InspectorSinglePanel" Visibility="Collapsed">
                        <TextBlock x:Name="InspectorName" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="InspectorMeta" Style="{StaticResource Caption}" Margin="0,2,0,10" TextWrapping="Wrap"/>
                        <ContentControl x:Name="InspectorStatusBadge" Style="{StaticResource StatusBadge}" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                        <Button x:Name="InspectorUnlockButton" Content="ปลดล็อกบัญชี" Style="{StaticResource ButtonPrimary}" Margin="0,0,0,8" Click="InspectorUnlockButton_Click"/>
                        <Button x:Name="InspectorResetButton" Content="รีเซ็ตรหัสผ่าน…" Style="{StaticResource ButtonSecondary}" Margin="0,0,0,8" Click="InspectorResetButton_Click"/>
                        <Button x:Name="InspectorEditButton" Content="แก้ข้อมูล…" Style="{StaticResource ButtonSecondary}" Margin="0,0,0,8" Click="InspectorEditButton_Click"/>
                        <Border BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,1,0,0" Margin="0,6,0,10" Padding="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="ใช้งานล่าสุด" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <StackPanel x:Name="InspectorHistoryList"/>
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom">
                            <Button x:Name="InspectorToggleDisableButton" Content="ปิดใช้งานบัญชี" Style="{StaticResource ButtonDanger}" Click="InspectorToggleDisableButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="InspectorMultiPanel" Visibility="Collapsed">
                        <TextBlock x:Name="InspectorMultiCountText" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>
                        <Button Content="รีเซ็ตรหัสที่เลือก" Style="{StaticResource ButtonPrimary}" Margin="0,0,0,8" Click="BulkResetButton_Click"/>
                        <Button Content="ย้ายห้อง" Style="{StaticResource ButtonSecondary}" Click="BulkMoveButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== toast มุมขวาล่าง (WP3-2 ใช้ซ้ำแบบเดียวกับ Console WP6) ==================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="Transparent" IsHitTestVisible="False"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20">
            <controls:ToastHost IsHitTestVisible="True"/>
        </Grid>
    </Grid>
</Window>
