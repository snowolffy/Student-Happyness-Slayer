<Window x:Class="OnionProcOparetor.RosterManager.ImportWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="นำเข้ารายชื่อจาก CSV / Excel"
        Width="1280" Height="800"
        WindowStartupLocation="CenterOwner"
        MinWidth="1080" MinHeight="680"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- ตาม docs/wireframes/nf-import.dc.html + nf-password.dc.html (ขั้น 1-2 = นำเข้า CSV, ขั้น 3 =
         ตั้งรหัสผ่านเริ่มต้น) ขั้น 4 "เสร็จ + พิมพ์ใบรหัส" ของ wireframe ทำโดยส่งต่อไปเปิด
         PrintSlipsWindow ทันทีหลัง commit สำเร็จ (nf-print) แทนการทำเป็นขั้นที่ 4 ในหน้าต่างเดียวกัน

         ตามที่ docs/roadmap.md ระบุไว้ตรงๆ: "นำเข้า CSV ไม่ต้องตรวจ 'ห้องไม่รู้จัก' และ 'ไม่มีเมล'" (Server
         ไม่ถือเป็น error สองอย่างนี้อยู่แล้ว - ดู RosterEndpoints.ProcessImportAsync) หน้านี้แค่แสดงผลตรวจที่
         Server คืนมาตรงๆ ไม่เพิ่มการตรวจเองฝั่ง client -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== step indicator ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Background.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Step1Label" Text="① เลือกไฟล์" FontSize="13" Margin="0,0,28,0"/>
                <TextBlock x:Name="Step2Label" Text="② จับคู่คอลัมน์ + ตรวจ" FontSize="13" Margin="0,0,28,0"/>
                <TextBlock x:Name="Step3Label" Text="③ ตั้งรหัสผ่านเริ่มต้น" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- ==================== ขั้น 1: เลือกไฟล์ ==================== -->
        <StackPanel x:Name="Step1Panel" Grid.Row="1" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="นำเข้ารายชื่อนักเรียนจากไฟล์ CSV" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="ไฟล์ต้องมีแถวหัวคอลัมน์ (รหัสนักเรียน ชื่อ-สกุล ชั้น/ห้อง และเมล/วันเกิดถ้ามี)"
                       Style="{StaticResource Body}" Margin="0,0,0,18"/>
            <Button x:Name="ChooseFileButton" Content="เลือกไฟล์ CSV…" Style="{StaticResource ButtonPrimary}"
                    Width="200" Click="ChooseFileButton_Click"/>
            <TextBlock x:Name="ChosenFileText" Margin="0,14,0,0" Style="{StaticResource Caption}"/>
        </StackPanel>

        <!-- ==================== ขั้น 2: จับคู่คอลัมน์ + ตรวจ ==================== -->
        <Grid x:Name="Step2Panel" Grid.Row="1" Margin="24" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="FileSummaryText" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="รหัสนักเรียน" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="StudentCodeColumnCombo" Margin="0,0,0,10"/>
                        <TextBlock Text="ชื่อ-สกุล" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="FullNameColumnCombo" Margin="0,0,0,10"/>
                        <TextBlock Text="เมลโรงเรียน (ไม่บังคับ)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="EmailColumnCombo" Margin="0,0,0,10"/>
                        <TextBlock Text="ชั้น/ห้อง" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ClassNameColumnCombo" Margin="0,0,0,10"/>
                        <TextBlock Text="วันเกิด (ไม่บังคับ - ใช้ตั้งรหัสแบบวันเกิดได้)" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="BirthDateColumnCombo"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ถ้ามีรหัสนักเรียนซ้ำกับในระบบ" FontWeight="Bold" Margin="0,0,0,8"/>
                        <RadioButton x:Name="UpdateExistingRadio" GroupName="dup" IsChecked="True"
                                     Content="อัปเดตชื่อ/ห้อง ไม่แตะรหัสผ่าน" Margin="0,0,0,6"/>
                        <RadioButton x:Name="SkipExistingRadio" GroupName="dup" Content="ข้ามแถวนั้น"/>
                    </StackPanel>
                </Border>

                <Button x:Name="CheckButton" Content="ตรวจสอบไฟล์" Style="{StaticResource ButtonPrimary}" Click="CheckButton_Click" Margin="0,0,0,10"/>

                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel Margin="0,0,20,0" HorizontalAlignment="Center">
                            <TextBlock x:Name="NewCountText" Text="-" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="เพิ่มใหม่" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,0" HorizontalAlignment="Center">
                            <TextBlock x:Name="DupCountText" Text="-" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="ซ้ำ" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="ErrorCountText" Text="-" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="มีปัญหา" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid>
                        <TextBlock Text="แถวที่มีปัญหาจะไม่ถูกนำเข้า แก้ในไฟล์แล้วนำเข้าซ้ำได้" VerticalAlignment="Center"
                                   Style="{StaticResource Caption}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="ย้อนกลับ" Style="{StaticResource ButtonSecondary}" Margin="0,0,8,0" Click="BackToStep1Button_Click"/>
                            <Button x:Name="NextToStep3Button" Content="ถัดไป: ตั้งรหัสผ่าน" Style="{StaticResource ButtonPrimary}"
                                    IsEnabled="False" Click="NextToStep3Button_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border CornerRadius="10" ClipToBounds="True"
                        Background="{DynamicResource Brush.Background.Card}"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                    <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0"
                              RowBackground="{DynamicResource Brush.Background.Card}"
                              AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                              HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                              VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                              RowHeight="34"
                              ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                              RowStyle="{StaticResource ConsoleGridRowStyle}"
                              CellStyle="{StaticResource ConsoleGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="แถว" Binding="{Binding RowNumber}" Width="55"/>
                            <DataGridTextColumn Header="รหัส" Binding="{Binding StudentCode}" Width="90"/>
                            <DataGridTextColumn Header="ชื่อ-สกุล" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="เมล" Binding="{Binding Email}" Width="180"/>
                            <DataGridTextColumn Header="ห้อง" Binding="{Binding ClassName}" Width="90"/>
                            <DataGridTemplateColumn Header="ผลตรวจ" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Style="{StaticResource StatusBadge}" Content="{Binding ResultLabel}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </Grid>

        <!-- ==================== ขั้น 3: ตั้งรหัสผ่านเริ่มต้น ==================== -->
        <Grid x:Name="Step3Panel" Grid.Row="1" Margin="40" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <TextBlock x:Name="Step3TitleText" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" TextWrapping="Wrap"/>

                <RadioButton x:Name="Random6Radio" GroupName="pw" IsChecked="True" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="สุ่มตัวเลข 6 หลัก ต่อคน (แนะนำ)" FontWeight="Bold"/>
                        <TextBlock Text="แต่ละคนได้รหัสไม่ซ้ำกัน พิมพ์เป็นใบแจกในขั้นถัดไป · ปลอดภัยที่สุด"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="BirthDateRadio" GroupName="pw" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ใช้วันเกิด (ววดดปปปป)" FontWeight="Bold"/>
                        <TextBlock Text="ต้องมีคอลัมน์วันเกิดในไฟล์ · เพื่อนที่รู้วันเกิดก็เข้าบัญชีกันได้"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="SameForAllRadio" GroupName="pw" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="รหัสเดียวกันทั้งชุด" FontWeight="Bold"/>
                        <TextBlock Text="ทุกคนรู้รหัสของกันและกันจนกว่าจะเปลี่ยน" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                        <TextBox x:Name="FixedPasswordBox" Style="{StaticResource RoundedTextBox}" Width="160"
                                 Margin="0,6,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </RadioButton>

                <CheckBox x:Name="ForceChangeCheckBox" Content="บังคับเปลี่ยนรหัสตอนล็อกอินครั้งแรก (แนะนำสำหรับทุกแบบ)"
                          IsChecked="True" Margin="0,10,0,0"/>

                <Grid Margin="0,30,0,0">
                    <Button Content="ย้อนกลับ" Style="{StaticResource ButtonSecondary}" HorizontalAlignment="Left" Click="BackToStep2Button_Click"/>
                    <Button x:Name="CommitButton" Content="นำเข้า + สร้างใบรหัส" Style="{StaticResource ButtonPrimary}"
                            HorizontalAlignment="Right" Click="CommitButton_Click"/>
                </Grid>
                <TextBlock x:Name="CommitStatusText" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="สรุปก่อนนำเข้า" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="Step3SummaryText" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="รหัสเริ่มต้นแสดงได้ครั้งเดียวตอนนี้และในใบพิมพ์ · ระบบเก็บแบบเข้ารหัส (hash) ย้อนดูภายหลังไม่ได้ ถ้าหายต้องรีเซ็ตใหม่"
                               Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
