<Window x:Class="OnionProcOparetor.RosterManager.ChangeMyPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เปลี่ยนรหัสผ่าน"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- บัญชีที่ยังไม่เคยเปลี่ยน password จาก default (ว่างเปล่า) ต้องเปลี่ยนก่อนใช้ Roster Manager
         เพราะ RosterEndpoints ทุกตัวเช็ค admin.HasDefaultPassword แล้วตอบ 403 ถ้ายังไม่เปลี่ยน -
         หน้าต่างเล็กนี้แทนที่ Console's ForceChangePasswordWindow (ไม่ต้องทำเต็มเหมือน Console เพราะ
         Roster Manager ไม่มี Dashboard ให้เปิดต่อ แค่เปลี่ยนรหัสแล้วไปหน้า Roster ตรง) -->
    <StackPanel Margin="28">
        <TextBlock Text="ต้องเปลี่ยนรหัสผ่านก่อนใช้งาน" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Text="บัญชีนี้ยังใช้รหัสผ่านเริ่มต้นอยู่ กรุณาตั้งรหัสผ่านใหม่ก่อนเข้าใช้ Roster Manager"
                   Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,18"/>

        <TextBlock Text="รหัสผ่านใหม่" Style="{StaticResource Label}" Margin="0,0,0,6"/>
        <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,14"/>

        <TextBlock Text="ยืนยันรหัสผ่านใหม่" Style="{StaticResource Label}" Margin="0,0,0,6"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,18"/>

        <Button x:Name="SaveButton" Content="บันทึกและเข้าใช้งาน" Style="{StaticResource ButtonPrimary}" Click="SaveButton_Click"/>
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"/>
    </StackPanel>
</Window>
