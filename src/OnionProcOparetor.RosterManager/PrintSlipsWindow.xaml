<Window x:Class="OnionProcOparetor.RosterManager.PrintSlipsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="พิมพ์ใบรหัสผ่าน"
        Width="1100" Height="760"
        WindowStartupLocation="CenterOwner"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- ตาม docs/wireframes/nf-print.dc.html - ปุ่ม "บันทึกเป็น PDF" และ "พิมพ์" ทั้งคู่เปิด PrintDialog
         ของ Windows เหมือนกัน (ดู docs/roadmap.md WP3-2 "บันทึกเป็น PDF ได้ผ่าน 'Microsoft Print to
         PDF'") - ความต่างอยู่ที่ "เครื่องพิมพ์" ที่ครูเลือกในกล่องโต้ตอบนั้นเอง ไม่ใช่โค้ดคนละเส้นทาง -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Brush.Background.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,1,0">
            <StackPanel Margin="18">
                <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="พิมพ์ใบรหัสตอนนี้ เพราะหลังปิดหน้านี้จะดูรหัสเริ่มต้นไม่ได้อีก (เก็บแบบ hash ย้อนดูไม่ได้)"
                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <TextBlock Text="ต่อหน้า A4" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <ComboBox x:Name="PerPageCombo" SelectedIndex="0" Margin="0,0,0,14" SelectionChanged="PerPageCombo_SelectionChanged">
                    <ComboBoxItem Content="10 ใบ (2×5)" Tag="10"/>
                    <ComboBoxItem Content="16 ใบ (4×4)" Tag="16"/>
                </ComboBox>

                <CheckBox x:Name="NewPagePerClassCheckBox" Content="ขึ้นหน้าใหม่เมื่อเปลี่ยนห้อง" IsChecked="True"
                          Margin="0,0,0,14" Checked="RebuildPreview" Unchecked="RebuildPreview"/>

                <TextBlock Text="ข้อความท้ายใบ" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                <TextBox x:Name="FooterTextBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,18"
                         Text="เปลี่ยนรหัสตอนเข้าใช้ครั้งแรก ห้ามให้คนอื่นดู" TextChanged="RebuildPreview"/>

                <StackPanel VerticalAlignment="Bottom">
                    <Button x:Name="SaveAsPdfButton" Content="บันทึกเป็น PDF" Style="{StaticResource ButtonSecondary}"
                            Margin="0,0,0,8" Click="PrintOrSaveButton_Click"/>
                    <Button x:Name="PrintButton" Content="พิมพ์" Style="{StaticResource ButtonPrimary}" Click="PrintOrSaveButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource Brush.Background.Primary}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Border x:Name="PreviewHost" Margin="20" Background="White"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.2" Color="Black"/>
                    </Border.Effect>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
