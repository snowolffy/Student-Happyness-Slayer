<Window x:Class="OnionProcOparetor.RosterManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roster Manager · Onion ProcOparetor"
        Width="1000" Height="732"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- WP3-2 (2026-10-31): หน้าล็อกอินตาม docs/wireframes/nf-roster-login.dc.html - การ์ดลอยแบ่งสองฝั่ง
         (ภาพซ้าย/ฟอร์มขวา) บนพื้นจุดเรียงตาราง เหมือนแบบที่ Console WP7 ใช้ใน MainWindow.xaml ทุกจุด
         (คัดลอกโครงมาแล้วปรับข้อความ/ชื่อคลาสให้ตรงกับ Roster Manager)

         หมายเหตุจาก orchestrator (2026-10-31): DrawingBrush ของจุดพื้นหลังต้องกำหนด Viewbox 20x20
         Absolute คู่กับ Viewport 20x20 Absolute ชัดเจน ไม่ปล่อยให้เป็นค่า default (RelativeToBoundingBox
         0,0,1,1) เพราะ default จะยืด bounding box ของ EllipseGeometry (เส้นผ่านศูนย์กลาง ~2.4) ให้เต็ม
         ช่อง viewport ทั้งก้อน กลายเป็นจุดบวมเท่าขนาดช่อง - เป็นบั๊กที่เพิ่งเจอและแก้ใน Console -->
    <Grid>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile"
                              Viewport="0,0,20,20" ViewportUnits="Absolute"
                              Viewbox="0,0,20,20" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <SolidColorBrush Color="{DynamicResource Color.Border.Default}"/>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="10,10" RadiusX="1.2" RadiusY="1.2"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ==================== การ์ดล็อกอิน: สองฝั่ง ภาพ + ฟอร์ม ==================== -->
        <Border Width="860" Height="560" CornerRadius="18"
                Background="{DynamicResource Brush.Background.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.22" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== ซ้าย: ภาพ ==================== -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar.Background}">
                    <Border.Clip>
                        <RectangleGeometry RadiusX="18" RadiusY="18" Rect="0,0,340,560"/>
                    </Border.Clip>
                    <Grid>
                        <Image x:Name="HeroImage" Stretch="UniformToFill"/>
                        <!-- ไม่มีกล่องข้อความทับมุมภาพ: ภาพ LoginHero ที่ผู้ใช้เลือกมีชื่อโปรแกรมอยู่ในภาพแล้ว
                             ถ้าวางข้อความ XAML ทับจะซ้อนกันอ่านไม่ออก (ผู้ใช้สั่งเอาออก 3 พ.ย. 2569) -->
                    </Grid>
                </Border>

                <!-- ==================== ขวา: ฟอร์ม ==================== -->
                <Grid Grid.Column="1" Margin="48,0,48,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="40" Height="40" CornerRadius="10">
                                <!-- ไม่มีพื้นสี่เหลี่ยมหลังโลโก้ (ผู้ใช้สั่ง 3 พ.ย. 2569) -->
                                <Image Source="/Theme/logo-source.png" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Onion ProcOparetor" Style="{StaticResource Heading1}"/>
                                <TextBlock Text="Roster Manager" Style="{StaticResource Caption}" Opacity="0.75"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="เข้าสู่ระบบ" FontSize="22" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBlock Text="ใช้บัญชี Admin ของ Console (Teacher เข้าได้แบบดูอย่างเดียว + รีเซ็ตรหัส ถ้าเปิดสิทธิ์)"
                                   Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,18"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SERVER IP" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <TextBox x:Name="ServerIpBox" Style="{StaticResource RoundedTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PORT" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                                <TextBox x:Name="PortBox" Style="{StaticResource RoundedTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="UseHttpsCheckBox" Content="เชื่อมต่อด้วย HTTPS" Margin="0,0,0,16"/>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="USERNAME" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <TextBox x:Name="UsernameBox" Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,22">
                            <TextBlock Text="PASSWORD" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource RoundedPasswordBox}"/>
                        </StackPanel>

                        <Button x:Name="ConnectButton" Content="เชื่อมต่อ"
                                Style="{StaticResource ButtonPrimary}" Click="ConnectButton_Click"/>

                        <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
