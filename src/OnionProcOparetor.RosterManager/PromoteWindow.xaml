<Window x:Class="OnionProcOparetor.RosterManager.PromoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เลื่อนชั้นปีการศึกษาใหม่"
        Width="900" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Theme/icon.ico"
        Style="{StaticResource AppDialogWindow}">
    <!-- ตาม docs/wireframes/nf-promote.dc.html - ความต่างที่ตั้งใจ: "สรุป" ของ wireframe (เลื่อนชั้น 826
         คน · จบการศึกษา 414 คน) เป็นตัวเลขคงที่คำนวณจากการพิมพ์ในแต่ละแถวแบบสด แต่ที่นี่แสดงแค่จำนวนห้อง/
         คนทั้งหมดก่อนเลื่อน แล้วค่อยแสดงผลจริง (เลื่อนชั้น N คน / จบการศึกษา M คน) หลังกดยืนยันสำเร็จแทน
         (ไม่ผูก INotifyPropertyChanged เพิ่มสำหรับ dialog ที่ใช้ปีละครั้งเดียว) -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold"/>
            <TextBlock Text="ทำปีละครั้ง ก่อนเปิดเทอม · บัญชีและรหัสผ่านเดิมของนักเรียนใช้ต่อได้ · เว้นช่อง &quot;ย้ายไป&quot; ว่าง = ถือว่าจบการศึกษา"
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" CornerRadius="10" ClipToBounds="True"
                Background="{DynamicResource Brush.Background.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
            <DataGrid x:Name="RowsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="{DynamicResource Brush.Background.Card}"
                      AlternatingRowBackground="{DynamicResource Brush.Background.Card}"
                      HorizontalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                      VerticalGridLinesBrush="{DynamicResource Brush.Border.Default}"
                      RowHeight="40"
                      ColumnHeaderStyle="{StaticResource ConsoleGridColumnHeaderStyle}"
                      RowStyle="{StaticResource ConsoleGridRowStyle}"
                      CellStyle="{StaticResource ConsoleGridCellStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ห้องเดิม" Binding="{Binding ClassName}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="คน" Binding="{Binding Count}" Width="70" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="ย้ายไป (เว้นว่าง = จบการศึกษา)" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ToClassName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource RoundedTextBox}" Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2">
            <Border CornerRadius="10" Padding="16"
                    Background="{DynamicResource Brush.Background.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="สรุป" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="นักเรียนที่จบ (ม.3 / ม.6)" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="GraduateActionCombo" SelectedIndex="0">
                        <ComboBoxItem Content="ปิดใช้งานบัญชี (เก็บประวัติไว้)" Tag="0"/>
                        <ComboBoxItem Content="ลบบัญชีและประวัติ" Tag="1"/>
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border CornerRadius="10" Padding="12"
                    Background="{DynamicResource Brush.Status.Warning}" Margin="0,0,0,12">
                <TextBlock Text="ระบบสำรองฐานข้อมูลให้อัตโนมัติก่อนเลื่อนชั้น ย้อนกลับได้โดยผู้ดูแลระบบ"
                           TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource Brush.Text.OnStatusFill}"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="ยกเลิก" Style="{StaticResource ButtonSecondary}" Margin="0,0,8,0" Click="CancelButton_Click"/>
                <Button x:Name="PromoteAllButton" Content="เลื่อนชั้นทั้งหมด…" Style="{StaticResource ButtonPrimary}" Click="PromoteAllButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
