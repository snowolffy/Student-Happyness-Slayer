<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OnionProcOparetor.RosterManager</AssemblyName>
    <RootNamespace>OnionProcOparetor.RosterManager</RootNamespace>
    <ApplicationIcon>Theme\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WP UI-1a (2026-11-03): theme token/style/control ร่วมย้ายไปไลบรารีนี้ - โฟลเดอร์ Theme ของ
         Roster Manager ที่เคย copy มาจาก Console ตรงๆ (ดู docs/roadmap.md WP3-2 เดิม) เหลือแค่
         Accent.Light.xaml/Accent.Dark.xaml (สีเน้นฟ้า override) และภาพแบรนด์ของตัวเอง -->
    <ProjectReference Include="..\OnionProcOparetor.UI\OnionProcOparetor.UI.csproj" />

    <!-- Theme\logo.png / logo-source.png เลิกใช้แล้ว (WP UI-7c, 2026-11-03) - การ์ดล็อกอินเปลี่ยนไปใช้
         DrawingImage เวกเตอร์ (Logo.RosterApp) ใน Theme/Logos.xaml ของแอสเซมบลีนี้เองแทน -->
    <Resource Include="Theme\icon.ico" />

    <!-- หน้าล็อกอิน (WP3-2) - ภาพฝั่งซ้ายของการ์ดล็อกอิน (placeholder ตอนนี้ เหมือน Console's WP7) -
         สองรายการนี้ชี้ไฟล์เดียวกันโดยเจตนา คนละ item type (ดู Console.csproj comment เดิม):
           - Resource: ฝังเข้าตัว exe เป็น pack resource - fallback เมื่อไม่มีไฟล์ "ข้างแอป"
           - None + CopyToOutputDirectory: สำเนาไฟล์จริงที่ Assets\LoginHero.png ข้าง .exe ให้ครู
             เปลี่ยนภาพเองได้โดยไม่ต้อง build ใหม่ -->
    <Resource Include="Assets\LoginHero.png" />
    <None Include="Assets\LoginHero.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
