<Window x:Class="OnionProcOparetor.AgentTray.StaffSessionStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff session"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        Style="{StaticResource AppWindowStyle}">
    <!-- WP3-3 (2026-10-31) - ตาม wireframe docs/wireframes/st-staff-start.dc.html ขั้น 1 "กด 'สำหรับครู'
         ที่จอล็อกอิน -> การ์ดเปลี่ยนเป็นแบบครู" ใช้บัญชี Console เดียวกัน (ClientApiClient.LoginToServerAsync
         ที่มีอยู่แล้วจาก WP2 - ไม่ได้สร้างกลไก token ใหม่ ใช้ bypass/staff-session เดิมทั้งชุด) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource BrandHeaderBar}" Background="#B45309">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource LogoPlaceholder}">
                    <Image Source="/Theme/logo.png" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="เข้าใช้ด้วยบัญชีครู" Style="{StaticResource BrandHeaderTitleText}"/>
                    <TextBlock Text="กฎทั้งหมดของเครื่องนี้จะปิดชั่วคราว" Style="{StaticResource BrandHeaderSubText}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="ชื่อผู้ใช้" Style="{StaticResource LabelText}"/>
            <TextBox x:Name="UsernameBox" Margin="0,0,0,12"/>

            <TextBlock Text="รหัสผ่าน" Style="{StaticResource LabelText}"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,14"/>

            <TextBlock Text="ใช้นานเท่าไร" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="Minutes15" Content="15 นาที" GroupName="Duration" Margin="0,0,14,0"/>
                <RadioButton x:Name="Minutes30" Content="30 นาที" GroupName="Duration" IsChecked="True" Margin="0,0,14,0"/>
                <RadioButton x:Name="Minutes60" Content="60 นาที" GroupName="Duration"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                       Foreground="{StaticResource AccentRedBrush}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="ยกเลิก" Height="38" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"/>
                <Button Grid.Column="2" x:Name="StartButton" Content="เริ่ม Staff session" Height="38"
                        Style="{StaticResource PrimaryButton}" Click="StartButton_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
