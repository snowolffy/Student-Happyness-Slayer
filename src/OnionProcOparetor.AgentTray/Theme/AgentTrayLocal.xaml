<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================================================================================
         สไตล์เฉพาะของ AgentTray ที่ไม่มีอยู่ใน OnionProcOparetor.UI (WP UI-1b, 2026-11-03) - เดิมอยู่
         ใน Theme/AppTheme.xaml ของตัวเอง ตอนนี้ AppTheme.xaml ถูกลบแล้ว palette/accent/control หลักทั้งหมด
         มาจากไลบรารี (ดู App.xaml) เหลือแค่สไตล์หน้าเฉพาะของ AgentTray ที่ Console/RosterManager ไม่มี
         (แถบหัวแบรนด์แบบ "โลโก้ซ้าย + ชื่อแอป/คำอธิบายขวา" ที่จอนักเรียน/จอล็อกอินเครื่องใช้) ไฟล์นี้ต้อง
         merge *หลัง* Controls.xaml ของไลบรารีเสมอ (ดู App.xaml) เพื่อให้ key ชื่อเดียวกัน (ถ้ามี) จากไฟล์นี้
         ชนะ - แต่ตอนนี้ไม่มีชนกันเลย เพราะไลบรารีไม่มี key ชุดนี้

         ใช้ {DynamicResource} ชี้ไปที่ token ของไลบรารี (Brush.Accent.*, Brush.Background.Card ฯลฯ) แม้
         AgentTray จะใช้ธีมสว่าง/สีส้มตายตัวเสมอ (ไม่มีสลับมืด/สว่างแบบ Console) เพราะ DynamicResource คือ
         สิ่งที่ทุก control ในไลบรารีคาดหวังอยู่แล้ว (ดู comment ของ Controls.xaml) และทำให้ไฟล์นี้ยังทำงาน
         ถูกต้องเผื่ออนาคตอยากเปิดสลับธีมให้ AgentTray ด้วย -->

    <!-- ==================== TextBlock label (หัวข้อเล็กสีรอง) ==================== -->
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- ==================== Brand header bar (logo strip) ==================== -->
    <Style x:Key="BrandHeaderBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Default}"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <!-- ไม่มีพื้นสี่เหลี่ยม/กรอบหลังโลโก้แล้ว (ผู้ใช้สั่ง 3 พ.ย. 2569 - ดู commit 6347d48 ของ Console/
         RosterManager) เหลือแค่ขนาดกล่องไว้จัด layout เฉยๆ โลโก้หัวหอมใหม่มีรูปทรงโปร่งใสของตัวเองอยู่แล้ว -->
    <Style x:Key="LogoPlaceholder" TargetType="Border">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
    </Style>

    <Style x:Key="BrandHeaderTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- สีนี้เป็นสีตกแต่งเฉพาะ (ไม่ใช่ token ของไลบรารี) - ทองอ่อนที่อ่านออกบนพื้นสีเน้นส้มทึบเท่านั้น
         คงค่าเดิมจาก AppTheme.xaml เพราะ AgentTray ใช้สีเน้นส้มตายตัว ไม่ override เป็นสีอื่น -->
    <Style x:Key="BrandHeaderSubText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#F3E3D0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ====================================================================================
         Implicit styles ที่หายไปตอนลบ Theme/AppTheme.xaml (พบจากภาพตรวจ before/after, 2026-11-03)

         AppTheme.xaml เดิมมี implicit style (TargetType ล้วน ไม่มี x:Key) ของ TextBox/PasswordBox/
         ListView/GridViewColumnHeader/ListViewItem ที่ "ทุก control ชนิดนั้นในแอปได้ใช้เองอัตโนมัติ
         โดยไม่ต้องอ้าง Style=" - ตอน merge ไลบรารีเข้ามาแทน ไฟล์นี้มีแค่ LabelText/BrandHeaderBar ฯลฯ
         ไม่มี implicit style พวกนี้เลย (ไลบรารีของ Console ก็ไม่มีเหมือนกัน เพราะ Console ใช้ RoundedTextBox/
         RoundedPasswordBox แบบมี key เสมอ ไม่เคยพึ่ง implicit - และ Console ใช้ DataGrid ไม่ใช่
         ListView/GridView เลย) ผลคือ TextBox/PasswordBox ทุกกล่องใน AgentTray (ที่ไม่ได้ตั้ง Style=
         ไว้ตรงๆ) ตกไปใช้ template default ของ Fluent ตรงๆ (ขอบเหลี่ยม ไม่มี focus ring สีเน้น) และ
         ListView/GridViewColumnHeader ของ StatusWindow/LogTerminalWindow ก็เหมือนกัน - ต้องประกาศ
         implicit style ชุดนี้กลับคืนที่นี่ (ไม่แก้ไลบรารี เพราะ Console/RosterManager ไม่ต้องการ
         implicit style พวกนี้)

         TextBox/PasswordBox: BasedOn คีย์ RoundedTextBox/RoundedPasswordBox ของไลบรารีตรงๆ (ไม่ copy
         template มาเอง) เพื่อให้ได้มุมโค้ง + focus ring สีเน้นเหมือน Console ตามที่ orchestrator ยืนยันว่า
         "มุมโค้งแบบ Console โอเค" - แค่ทำให้เป็น implicit (ไม่มี x:Key) จะได้ไม่ต้องไล่เติม
         Style="{StaticResource RoundedTextBox}" ทุกกล่องในทุกไฟล์ xaml

         ListView/GridViewColumnHeader/ListViewItem: ไลบรารีไม่มี key ให้ BasedOn เลย (ไม่มีใครในไลบรารี
         ใช้ ListView) จึงประกาศเองทั้งชุด หน้าตา/ค่าตัวเลขเหมือน AppTheme.xaml เดิมทุกจุด เปลี่ยนแค่
         brush key ให้ชี้ไปที่ token ของไลบรารี (TableHeaderBgBrush -> Brush.Background.Sunken,
         RowHoverBgBrush -> Brush.Row.Hover) -->

    <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}"/>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource RoundedPasswordBox}"/>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Card}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Sunken}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Row.Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
