<Window x:Class="OnionProcOparetor.AgentTray.RaiseHandBadgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ยกมืออยู่"
        Width="220" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent">
    <!-- ป้ายมุมขวาล่าง "ยกมืออยู่ · คิวที่ N [ยกเลิก]" (WP4-2, 2026-11-01) - ตาม wireframe
         docs/wireframes/tc-raisehand.dc.html ขั้น 2 ("รอครู: ป้ายเล็กมุมขวาล่าง")

         รู้ขอบเขตที่ไม่ได้ทำ (เขียนไว้ตรงนี้กันลืม): ป้ายนี้ "ไม่" หายเองอัตโนมัติตอนครูกด "ไปช่วยแล้ว" จาก
         Console แบบที่ wireframe อธิบายไว้ - ต้องกด "ยกเลิก" เองเท่านั้น (หรือรอ AgentTray/คอมพิวเตอร์รีสตาร์ท)
         เพราะยังไม่มีช่องทาง push จาก Server กลับมาที่ Tray เฉพาะเครื่องนี้สำหรับเหตุการณ์นี้ - ไม่ได้อยู่ใน
         เกณฑ์เสร็จของ WP4-2 (ดู docs/roadmap.md) จึงเป็น known limitation ที่ตั้งใจเว้นไว้ -->
    <Border Background="#FDF3E7" BorderBrush="#B45309" BorderThickness="2" CornerRadius="8" Padding="12,8" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.28" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="ยกมืออยู่" FontSize="12" FontWeight="Bold" Foreground="#8A3C04"/>
                <TextBlock x:Name="InfoText" Text="" FontSize="11" Foreground="#8A3C04"/>
            </StackPanel>
            <Button x:Name="CancelRaiseHandButton" Content="ยกเลิก" Height="26" Padding="10,0" Click="CancelRaiseHandButton_Click"/>
        </StackPanel>
    </Border>
</Window>
