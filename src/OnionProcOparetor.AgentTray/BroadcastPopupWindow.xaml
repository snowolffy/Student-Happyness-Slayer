<Window x:Class="OnionProcOparetor.AgentTray.BroadcastPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ข้อความจากครู"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== Brand header ==================== -->
        <Border Grid.Row="0" Style="{StaticResource BrandHeaderBar}">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource LogoPlaceholder}">
                    <!-- โลโก้เวกเตอร์ (WP UI-7c) - "small" เพราะ LogoPlaceholder = 30px (≤32px) -->
                    <Image Source="{StaticResource Logo.App.Small}" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="TitleText" Text="ข้อความจากครู" Margin="10,0,0,0"
                           Style="{StaticResource BrandHeaderTitleText}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- UI-12: เลือก/คัดลอกข้อความได้ (เดิมเป็น TextBlock) - TextBox อ่านอย่างเดียว ไม่มีกรอบ/พื้น ให้หน้าตาเหมือนข้อความเดิม
                     ข้อความยาวห่อบรรทัดและเลื่อนดูได้ (MaxHeight) -->
                <TextBox Grid.Row="0" x:Name="MessageText" IsReadOnly="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent" Padding="0" FontSize="14" MaxWidth="380"
                         FontFamily="{StaticResource FontFamily.Primary}"
                         Foreground="{DynamicResource Brush.Text.Primary}"
                         SelectionBrush="{DynamicResource Brush.Accent.Default}"
                         VerticalScrollBarVisibility="Auto" MaxHeight="240"
                         PreviewMouseDown="MessageText_PreviewMouseDown"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CopyButton" Content="คัดลอก" MinWidth="88" Margin="0,0,8,0"
                            Style="{StaticResource ButtonSecondary}" Click="CopyButton_Click"/>
                    <Button x:Name="CloseButton" Content="ปิด"
                            Style="{StaticResource ButtonPrimary}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
