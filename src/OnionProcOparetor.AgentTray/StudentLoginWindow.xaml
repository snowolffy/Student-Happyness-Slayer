<Window x:Class="OnionProcOparetor.AgentTray.StudentLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เข้าสู่ระบบ"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}">
    <!--
        จอล็อกอินนักเรียน (WP3-3, 2026-10-31) - ตาม wireframe docs/wireframes/st-login.dc.html และ
        st-login-states.dc.html การ์ดลอยแบ่งสองฝั่ง: ซ้ายภาพ Assets\LoginHero.png + ข้อความจากหน้าตั้งค่า
        ขวาฟอร์ม (สลับเนื้อหาตาม FormState - ดู .xaml.cs) พื้นหลังจุดเรียงแบบตาราง (DrawingBrush ก๊อปจาก
        Console/MainWindow.xaml โครงสร้างเป๊ะๆ ตามที่ roadmap สั่ง เปลี่ยนแค่ brush key เป็นของ AgentTray
        เอง เพราะ AgentTray ไม่มี DynamicResource ธีมมืด/สว่างแบบ Console)

        ต่างจาก LockScreenWindow: ไม่มี keyboard/mouse hook เลย (นักเรียนต้องพิมพ์ในฟอร์มได้ปกติ) กัน
        แค่ Alt+F4/ปิดหน้าต่างผ่าน WPF (OnClosing cancel ใน .xaml.cs) - เป็น soft gate ระดับแอปตามที่
        docs/roadmap.md ระบุไว้ ("ล็อกอินที่ระดับแอปบนจอล็อกของ AgentTray" ไม่ใช่ OS-level lock)
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== พื้นหลังจุดเรียงแบบตาราง (Grid.RowSpan="3" ให้คลุมทั้งหน้าต่าง) ==================== -->
        <Rectangle Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute"
                              Viewbox="0,0,20,20" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <SolidColorBrush Color="{DynamicResource Color.Border.Default}"/>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="10,10" RadiusX="1.2" RadiusY="1.2"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ==================== แถบหัว ==================== -->
        <Grid Grid.Row="0" Margin="28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RoomHeaderText" Grid.Column="0" Text="ห้องปฏิบัติการคอมพิวเตอร์" FontSize="13"/>
            <TextBlock x:Name="ClockText" Grid.Column="1" Text="" FontSize="13"/>
        </Grid>

        <!-- ==================== การ์ดล็อกอิน ==================== -->
        <Border Grid.Row="1" Width="860" Height="480" CornerRadius="14"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Brush.Background.Card}"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.24" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== ซ้าย: ภาพ + ข้อความจากหน้าตั้งค่า ==================== -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.Accent.Default}">
                    <Border.Clip>
                        <RectangleGeometry RadiusX="14" RadiusY="14" Rect="0,0,340,480"/>
                    </Border.Clip>
                    <Grid>
                        <Image x:Name="HeroImage" Stretch="UniformToFill"/>
                        <!-- แถบไล่สีเข้มด้านล่าง: ภาพที่โรงเรียนใส่มาเองอาจมีตัวหนังสือหรือส่วนสว่างตรงนี้
                             (ภาพตัวอย่างมีชื่อแอปพิมพ์อยู่ในภาพ) ข้อความจากหน้าตั้งค่าต้องอ่านออกเสมอ -->
                        <Border VerticalAlignment="Bottom" Padding="20,36,20,20">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#CC000000" Offset="0.45"/>
                                    <GradientStop Color="#E6000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=LoginScreenMessageText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock x:Name="LoginScreenMessageText" Text="" FontSize="12"
                                       Foreground="White" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== ขวา: ฟอร์ม (สลับตาม FormState) ==================== -->
                <Grid Grid.Column="1" Margin="40,0">
                    <!-- state: Login (ปกติ/ผิด/ล็อก) -->
                    <StackPanel x:Name="LoginPanel" VerticalAlignment="Center">
                        <!-- WP3-4b (2026-10-31) - โชว์เฉพาะตอนติดต่อ Server ไม่ได้ "และ" เครื่องนี้ตั้งค่ารหัสฉุกเฉินไว้แล้วเท่านั้น
                             (ดู RefreshEmergencyAndConnectivityStateAsync ใน .xaml.cs) ตรงตามที่ roadmap ระบุ "โชว์เด่นตอน Server ล่ม" -->
                        <Border x:Name="ServerUnreachableBanner" Background="#FDECEA" BorderBrush="{DynamicResource Brush.Danger.Default}"
                                BorderThickness="1.5" CornerRadius="6" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="ติดต่อ Server ไม่ได้" FontWeight="Bold" FontSize="13.5"
                                           Foreground="{DynamicResource Brush.Danger.Default}"/>
                                <TextBlock Text="ล็อกอินนักเรียนใช้ไม่ได้ชั่วคราว - ครูปลดเครื่องนี้ด้วยรหัสฉุกเฉินได้"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <Button x:Name="OpenEmergencyFromBannerButton" Content="ปลดด้วยรหัสฉุกเฉิน..." Height="34"
                                        Padding="14,0" HorizontalAlignment="Left" Style="{StaticResource ButtonSecondary}"
                                        Click="OpenEmergencyFromBannerButton_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="เข้าสู่ระบบเพื่อใช้งานเครื่อง" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>

                        <Border x:Name="LoginErrorBanner" Background="#FDECEA" BorderBrush="{DynamicResource Brush.Danger.Default}"
                                BorderThickness="1.5" CornerRadius="6" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock x:Name="LoginErrorText" TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{DynamicResource Brush.Danger.Default}"/>
                        </Border>

                        <TextBlock Text="เมลโรงเรียน หรือ รหัสนักเรียน" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="IdentifierBox" Margin="0,0,0,12" FontSize="14" Padding="8,7"/>

                        <TextBlock Text="รหัสผ่าน" Style="{StaticResource LabelText}"/>
                        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,16" FontSize="14" Padding="8,7"
                                     KeyDown="PasswordBox_KeyDown"/>

                        <Button x:Name="LoginButton" Content="เข้าสู่ระบบ" Height="40"
                                Style="{StaticResource ButtonPrimary}" Click="LoginButton_Click"/>

                        <TextBlock Text="ลืมรหัสผ่าน กรุณาติดต่อครูผู้สอน" FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,10,0,0"/>

                        <Border BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="สำหรับครู: Staff session" FontSize="12.5" Foreground="{DynamicResource Brush.Accent.Dark}"
                                           Cursor="Hand" MouseLeftButtonUp="StaffSessionLink_Click" TextDecorations="Underline"/>
                                <!-- WP3-4b (2026-10-31) - เดิมเป็น TextBlock เฉยๆ เขียน "(ยังไม่พร้อมใช้งาน)" ตายตัว
                                     (WP3-4 ยังไม่ได้ต่อสาย) ตอนนี้สลับข้อความ/คลิกได้ตาม EmergencyCodeConfigured
                                     จริงจาก Agent /status (ดู ApplyEmergencyCodeAvailability ใน .xaml.cs) -->
                                <TextBlock x:Name="EmergencyCodeLinkText" Text="   รหัสฉุกเฉิน (ยังไม่พร้อมใช้งาน)" FontSize="12.5"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" Margin="18,0,0,0"
                                           MouseLeftButtonUp="EmergencyCodeLink_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- state: บัญชีใช้อยู่ที่เครื่องอื่น -->
                    <StackPanel x:Name="LoggedInElsewherePanel" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border Background="#FDF3E7" BorderBrush="#B45309" BorderThickness="1.5" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <TextBlock x:Name="LoggedInElsewhereText" TextWrapping="Wrap" FontSize="13"/>
                        </Border>
                        <Button x:Name="ForceLoginButton" Content="ใช้ที่เครื่องนี้แทน" Height="40"
                                Style="{StaticResource ButtonPrimary}" Margin="0,0,0,10" Click="ForceLoginButton_Click"/>
                        <Button x:Name="CancelForceLoginButton" Content="ยกเลิก" Height="36"
                                Style="{StaticResource ButtonSecondary}" Click="CancelForceLoginButton_Click"/>
                    </StackPanel>

                    <!-- state: บังคับตั้งรหัสใหม่ -->
                    <StackPanel x:Name="MustChangePasswordPanel" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="MustChangePasswordGreeting" Text="กรุณาตั้งรหัสผ่านใหม่ก่อนใช้งาน"
                                   FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <TextBlock Text="รหัสผ่านใหม่" Style="{StaticResource LabelText}"/>
                        <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,12" FontSize="14" Padding="8,7"/>
                        <TextBlock Text="ยืนยันรหัสผ่านใหม่" Style="{StaticResource LabelText}"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,8" FontSize="14" Padding="8,7"/>
                        <TextBlock x:Name="ChangePasswordErrorText" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource Brush.Danger.Default}" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <Button x:Name="SavePasswordButton" Content="บันทึกแล้วเข้าใช้งาน" Height="40"
                                Style="{StaticResource ButtonPrimary}" Click="SavePasswordButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== แถบล่าง: ปุ่มปิดเครื่อง/รีสตาร์ท (ใครก็กดได้ - ไม่มีตอนครูล็อก) ==================== -->
        <Grid Grid.Row="2" Margin="28,0,28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ShutdownButton" Content="ปิดเครื่อง" Height="38" Padding="14,0"
                        Style="{StaticResource ButtonSecondary}" Margin="0,0,8,0" Click="ShutdownButton_Click"/>
                <Button x:Name="RestartButton" Content="รีสตาร์ท" Height="38" Padding="14,0"
                        Style="{StaticResource ButtonSecondary}" Click="RestartButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
