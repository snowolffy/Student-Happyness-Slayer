<Window x:Class="OnionProcOparetor.AgentTray.StaffSessionBadgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff session"
        Width="260" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent">
    <!-- ป้ายมุมขวาล่าง "Staff session · kru.xxx · 28:12 [จบ]" (WP3-3, 2026-10-31) - ตาม wireframe
         st-session.dc.html แถวที่ 3 ("Staff session: ป้ายสีส้ม มีปุ่มจบในตัว") ซ่อนไม่ได้เหมือน
         ExamModeBadgeWindow (ไม่มี Visibility ให้ user กดปิดเฉยๆ - ต้องกด "จบ" จริงถึงจะหายไป) -->
    <Border Background="#FDF3E7" BorderBrush="#B45309" BorderThickness="2" CornerRadius="8" Padding="12,8" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.28" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="Staff session" FontSize="12" FontWeight="Bold" Foreground="#8A3C04"/>
                <TextBlock x:Name="InfoText" Text="" FontSize="11" Foreground="#8A3C04"/>
            </StackPanel>
            <Button x:Name="EndButton" Content="จบ" Height="26" Padding="10,0" Click="EndButton_Click"/>
        </StackPanel>
    </Border>
</Window>
