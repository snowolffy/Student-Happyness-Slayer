<Window x:Class="OnionProcOparetor.AgentTray.ShutdownNotifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OnionProcOparetor.AgentTray.Controls"
        Title="แจ้งเตือนจากผู้ดูแลระบบ"
        Width="380" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent">
    <!--
        ต่างจาก LockScreenWindow (ที่เป็น full-screen + keyboard hook บล็อกทุกอย่าง) โดยตั้งใจ:
        หน้านี้เป็นแค่ "แจ้งเตือน" ไม่ใช่ "ขัดขวาง" - user ต้องยังใช้เครื่องได้ตามปกติเพื่อ
        รีบเซฟงานให้ทันก่อนเครื่องดับ ซึ่งเป็นเหตุผลทั้งหมดที่มีการนับถอยหลังตั้งแต่แรก
        - ไม่ full-screen (มุมจอล่างขวา)  - ไม่ดัก keyboard  - ไม่ ShowActivated (ไม่แย่ง focus
          จากสิ่งที่ user กำลังพิมพ์อยู่)  - ไม่มีปุ่มปิด (ปิดไม่ได้จนกว่าจะนับถึง 0)
        AllowsTransparency + WindowStyle=None ทำให้มุมโค้งจริง ไม่มีขอบเหลี่ยมของ OS โผล่มา
    -->
    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1"
            CornerRadius="10" Padding="18" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="10" Height="10" CornerRadius="5"
                        Background="{StaticResource AccentRedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="แจ้งเตือนจากผู้ดูแลระบบ" Margin="8,0,0,0"
                           FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <controls:CountdownProgressBar x:Name="Countdown"/>

            <TextBlock x:Name="HintText" Margin="0,10,0,0"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="กรุณาบันทึกงานของท่านทันที"/>
        </StackPanel>
    </Border>
</Window>
