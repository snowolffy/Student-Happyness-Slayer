<Window x:Class="OnionProcOparetor.AgentTray.ExamModeBadgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="โหมดสอบ"
        Width="200" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent">
    <!--
        ป้ายมุมขวาล่าง "โหมดสอบ · เหลือ N นาที" (WP2-2, 2026-10-31) - ตาม wireframe st-session.dc.html
        แถวที่ 2 ("โหมดสอบ: ป้ายเล็กมุมขวาล่าง ซ่อนไม่ได้") สีเข้มคงที่ (#1f2328/ขาว) ไม่ตามธีม
        เพราะเป็นป้ายสถานะเตือน ไม่ใช่ UI chrome ของแอป (เหมือน LockScreenWindow ที่ใช้สีดำคงที่เสมอ)

        ไม่มีปุ่มปิด/ไม่ ShowActivated (เหตุผลเดียวกับ ShutdownNotifyWindow - ไม่แย่ง focus จากสิ่งที่
        นักเรียนกำลังทำอยู่) user ปิดไม่ได้เลย (ไม่ override OnClosing ให้ cancel เหมือน
        ShutdownNotifyWindow เพราะ "ซ่อนไม่ได้" ในที่นี้หมายถึง "นักเรียนซ่อนไม่ได้" - โปรแกรมเองยังต้อง
        ปิดมันได้ตอน Agent สั่งจบโหมดสอบ/โปรแกรมกำลังปิดตัว ถึงจะไม่มี UI ให้ user กดเองก็ตาม)
    -->
    <Border Background="#1F2328" CornerRadius="8" Padding="12,8" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="โหมดสอบ" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <TextBlock x:Name="RemainingText" Text="" Margin="8,0,0,0"
                       FontSize="12" Foreground="#D5D8DD" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
