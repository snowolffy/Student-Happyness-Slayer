<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- เฉพาะ System.Windows.Forms.Screen.AllScreens (multi-monitor enumeration สำหรับ LockScreenWindow -
         ไม่มี WPF API มาตรฐานสำหรับสิ่งนี้) เรียกแบบ fully-qualified เสมอ ไม่ using System.Windows.Forms
         เพื่อกันชนกับ System.Windows.MessageBox/Application ของ WPF -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OnionProcOparetor.AgentTray</AssemblyName>
    <RootNamespace>OnionProcOparetor.AgentTray</RootNamespace>
    <ApplicationIcon>Theme\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- UseWindowsForms=true (ด้านบน) auto-add global using System.Windows.Forms/System.Drawing มาชนกับ
       System.Windows.Application/MessageBox และ System.Windows.Media.Brush ของ WPF ทั่วทั้งโปรเจกต์ทันที
       (เจอจริงตอน build - ไม่ใช่แค่เดา) เอาสอง global using นี้ออกเฉพาะสองตัวนี้ (ไม่ปิด ImplicitUsings
       ทั้งหมด) - โค้ดที่ต้องใช้ System.Windows.Forms.Screen จริง (LockScreenWindow) เรียกแบบ
       fully-qualified อยู่แล้ว ไม่ได้พึ่ง global using ตัวนี้เลย -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- ไลบรารีธีม/สไตล์ร่วมกับ Console และ RosterManager (WP UI-1a) - AgentTray เข้าร่วมใน WP UI-1b -->
  <ItemGroup>
    <ProjectReference Include="..\OnionProcOparetor.UI\OnionProcOparetor.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
        ใช้ Hardcodet.NotifyIcon.Wpf (ไม่ใช่ .NetCore) - ตัว .NetCore เจอ
        MissingMethodException บน .NET 10 ใช้ไม่ได้ (บันทึกไว้จาก dev environment เดิม)
    -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Theme\logo.png เลิกใช้แล้ว (WP UI-7c, 2026-11-03) - โลโก้แถบหัวทุกหน้าต่างเปลี่ยนไปใช้
         DrawingImage เวกเตอร์ (Logo.App.Small) ใน OnionProcOparetor.UI/Theme/Logos.xaml แทน -->
    <Resource Include="Theme\icon.ico" />

    <!-- tray icon 3 สถานะ (WP UI-7b, 2026-11-03) - ฝัง Resource เข้าตัว exe เอง (ไม่ใช่ loose file บน
         disk) เพราะ disk freeze: ของที่เขียนลง disk ตอน runtime หายทุกรีบูต ไอคอนพวกนี้ต้องมาจาก
         MSI/build เท่านั้น โหลดผ่าน pack URI (Application.GetResourceStream) ใน App.xaml.cs -->
    <Resource Include="Theme\tray-connected.ico" />
    <Resource Include="Theme\tray-disconnected.ico" />
    <Resource Include="Theme\tray-error.ico" />

    <!-- จอล็อกอินนักเรียน (WP3-3, 2026-10-31) - ภาพฝั่งซ้ายของการ์ด ก๊อปมาจาก
         Console\Assets\LoginHero.png (placeholder เดียวกัน) สองรายการนี้ชี้ไฟล์เดียวกันโดยเจตนา
         คนละ item type แบบเดียวกับที่ Console/OnionProcOparetor.Console.csproj ทำกับไฟล์เดียวกันนี้:
           - Resource: ฝังเข้าตัว exe เป็น pack resource - fallback เมื่อไม่มีไฟล์ "ข้างแอป"
             (ดู StudentLoginWindow.xaml.cs LoadHeroImage)
           - None + CopyToOutputDirectory/CopyToPublishDirectory: สำเนาไฟล์จริงไว้ข้าง .exe ให้ครู
             เปลี่ยนภาพเองได้โดยไม่ต้อง build ใหม่ - CopyToPublishDirectory ทำให้ไฟล์นี้ไปอยู่ใน
             publish output ด้วย ซึ่ง installer/OnionProcOparetor.Agent.wxs harvest ทุกไฟล์ใต้
             publish\OnionProcOparetor.AgentTray\** อัตโนมัติอยู่แล้ว (ดู ClientTrayFiles
             ComponentGroup) ไม่ต้องแก้ .wxs เพิ่มเลย -->
    <Resource Include="Assets\LoginHero.png" />
    <None Include="Assets\LoginHero.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- UltraVNC server (winvnc.exe + DLLs/plugins it may load at runtime) bundled as-is from an
       official install - ย้ายมาจาก OnionProcOparetor.Agent เพราะ Windows Session 0 Isolation ทำให้
       Agent (Windows Service) capture หน้าจอของ user session ไม่ได้เลย ต้อง start จาก AgentTray
       (รันใน user session จริง) แทน - ดู Services/VncProcessManager.cs (ultravnc.ini deliberately
       NOT bundled here - เขียนใหม่ทุกครั้งที่ start จริง ไม่เก็บ password hash ไว้ใน source control). -->
  <ItemGroup>
    <None Include="VncBundle\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Easter egg มุกจอ shutdown (ดู Services/JokeShutdownController.cs) - ปิด default ผ่าน
       appsettings.json (JokeShutdown:Enabled=false) ไฟล์ต้องเป็น loose file บน disk (ไม่ใช่
       embedded Resource) เพราะ MediaPlayer เปิดเสียงจาก pack:// URI ไม่ได้ -->
  <ItemGroup>
    <None Include="Assets\Joke\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
