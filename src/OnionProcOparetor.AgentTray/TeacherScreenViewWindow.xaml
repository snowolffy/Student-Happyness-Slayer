<Window x:Class="OnionProcOparetor.AgentTray.TeacherScreenViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="จอครู"
        Background="Black"
        Icon="/Theme/icon.ico">
    <!-- "ส่งจอครู" (WP4-4, 2026-11-01) - ดู wireframe tc-broadcast-student.dc.html
         เลย์เอาต์เดียวกันทั้งสองโหมด (เต็มจอ/หน้าต่างลอย) ต่างกันแค่ property ของ Window เอง
         (WindowStyle/Topmost/ResizeMode ฯลฯ) ซึ่งตั้งค่าจากโค้ด (ดู TeacherScreenViewWindow.xaml.cs
         ว่าทำไมตั้งจากโค้ดไม่ใช่ XAML สองไฟล์แยก)

         ของที่ไม่ได้ทำตาม wireframe รอบนี้ (ดูรายงานของ WP4-4):
         - โหมดหน้าต่างลอยใช้ title bar ของ Windows เอง (native) ไม่ได้วาด title bar เอง (ไม่มีปุ่ม
           ย่อ/ขยายแบบในภาพ) - ปุ่มปิด (X) ของ native title bar "กดไม่มีผล" (OnClosing กันไว้เหมือน
           LockScreenWindow) แทนการซ่อนปุ่มนั้นไปเลย (ต้อง P/Invoke แก้ WS_SYSMENU ซึ่งเพิ่มความซับซ้อน
           เกินความจำเป็นของรอบนี้)
         - ไม่มีปุ่ม "หยุดชั่วคราว" (เห็นภาพค้าง) ตามที่ wireframe ฝั่งครูมี - มีแค่ "หยุดส่ง" เท่านั้น -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Image x:Name="FrameImage" Grid.Row="0" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <TextBlock x:Name="WaitingText" Grid.Row="0" Text="กำลังรอรับภาพจอครู..."
                   Foreground="#AAAAAA" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Border Grid.Row="1" Background="#1E3A5F">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLeftText" Grid.Column="0" Foreground="White" FontSize="12"
                           VerticalAlignment="Center" Text="กำลังดูจอครู"/>
                <TextBlock x:Name="StatusRightText" Grid.Column="1" Foreground="White" FontSize="12"
                           VerticalAlignment="Center" Text=""/>
            </Grid>
        </Border>
    </Grid>
</Window>
