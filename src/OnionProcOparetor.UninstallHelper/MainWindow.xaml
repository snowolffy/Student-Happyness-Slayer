<Window x:Class="OnionProcOparetor.UninstallHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall Onion ProcOparetor"
        Height="360" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="36" Height="36" CornerRadius="10" Background="#F5A623">
                <TextBlock Text="O" FontSize="16" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ProductNameText" Text="Onion ProcOparetor" FontSize="15" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Uninstall" FontSize="11" Foreground="#AAAAAA"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="IntroText" Grid.Row="1" Margin="0,0,0,16" TextWrapping="Wrap"
                   Foreground="#DDDDDD" FontSize="12"
                   Text="Are you sure you want to remove Onion ProcOparetor from this computer?"/>

        <StackPanel x:Name="FormPanel" Grid.Row="2" VerticalAlignment="Top">
            <StackPanel x:Name="PasswordPanel" Visibility="Collapsed" Margin="0,0,0,16">
                <TextBlock Text="SERVER ADMIN USERNAME (leave blank to use local password only)" FontSize="10" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox" Height="28" Padding="6,4" FontSize="12" Margin="0,0,0,10"/>
                <TextBlock Text="SERVER PASSWORD / LOCAL UNINSTALL PASSWORD" FontSize="10" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Height="28" Padding="6,4" FontSize="12"/>
            </StackPanel>

            <CheckBox x:Name="DeleteDataCheckBox" Foreground="#DDDDDD" FontSize="12" Margin="0,0,0,8"
                      Content="Also delete database, logs and rules (ProgramData) - cannot be undone"/>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="CANCEL" Width="90" Height="30" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="ActionButton" Content="UNINSTALL" Width="110" Height="30" Click="ActionButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
