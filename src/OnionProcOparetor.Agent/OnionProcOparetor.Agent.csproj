<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OnionProcOparetor.Agent</AssemblyName>
    <RootNamespace>OnionProcOparetor.Agent</RootNamespace>
    <UserSecretsId>dotnet-OnionProcOparetor.Agent-affe8416-9f77-4135-a5c3-72ec24294444</UserSecretsId>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- VncBundle ย้ายไป OnionProcOparetor.AgentTray แล้ว (Agent เอง Session 0 capture หน้าจอ user
       session ไม่ได้เลย ต้อง start winvnc.exe จาก AgentTray ที่รันใน user session จริงแทน - ดู
       comment เต็มใน Services/VncSessionManager.cs) -->

  <!-- Tailscale's official Windows MSI installer, bundled as-is (2026-08-25) - same
       CopyToPublishDirectory trick AgentTray's VncBundle uses, so it rides the installer's
       existing wildcard harvest of this project's publish output with zero new .wxs <Files>
       glob needed. Downloaded from https://pkgs.tailscale.com/stable/ and SHA-256 verified
       against the checksum published alongside it (see the .sha256 file in this folder) -
       pinned to a specific version deliberately (not a "latest" alias) for reproducible builds,
       same reasoning as pinning WiX itself (see publish-all.ps1's comment). Installed silently
       by the new InstallTailscale CustomAction in installer/OnionProcOparetor.Agent.wxs -
       actual tailnet enrollment happens later via the Agent's own "RunTailscaleLogin" remote
       command (CommandProcessor.cs), not baked in here. -->
  <ItemGroup>
    <None Include="TailscaleBundle\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
