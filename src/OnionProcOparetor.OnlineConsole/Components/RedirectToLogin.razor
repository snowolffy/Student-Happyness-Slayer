@* A plain redirect component (not an endpoint) so AuthorizeRouteView's <NotAuthorized> can trigger
   navigation. NavigationManager.NavigateTo with forceLoad does a real browser navigation to /login
   (a static page, not part of any Blazor circuit) rather than a client-side Blazor route change. *@
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
