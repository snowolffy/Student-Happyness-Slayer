@* Ported from AddEditRuleWindow (WPF) - one shared form for both "add new" (InitialRule is null or has
   Id 0) and "edit existing" (InitialRule.Id > 0), matching the WPF version's 2-in-1 window. Also used
   from RunningProcessesModal's CREATE RULE button, prefilled from a running process's publisher name. *@
@inject ApiClient Api

<ModalShell Title="@(_rule.Id == 0 ? "Add Rule" : "Edit Rule")" OnClose="OnClose">
    <div class="form-row">
        <label>Name</label>
        <input type="text" @bind="_rule.Name" />
    </div>
    <div class="form-row">
        <label>Publisher Name</label>
        <input type="text" @bind="_rule.PublisherName" />
    </div>
    <div class="form-row">
        <label>Process Name Contains (ไม่บังคับ)</label>
        <input type="text" @bind="_rule.ProcessNameContains" />
    </div>
    <div class="form-row">
        <label style="display:flex; align-items:center; gap:.4rem; min-height:auto; font-weight:400; text-transform:none">
            <input type="checkbox" @bind="_rule.RequireSignedMatch" /> Require Signed Match
        </label>
    </div>
    <div class="form-row">
        <label style="display:flex; align-items:center; gap:.4rem; min-height:auto; font-weight:400; text-transform:none">
            <input type="checkbox" @bind="_rule.KillProcess" /> Kill Process
        </label>
    </div>
    <div class="form-row">
        <label>Action Command (ไม่บังคับ)</label>
        <input type="text" @bind="_rule.ActionCommand" />
    </div>
    <div class="form-row">
        <label>Action Arguments (ไม่บังคับ)</label>
        <input type="text" @bind="_rule.ActionArguments" />
    </div>
    <div class="form-row">
        <label style="display:flex; align-items:center; gap:.4rem; min-height:auto; font-weight:400; text-transform:none">
            <input type="checkbox" @bind="_rule.IsEnabled" /> Enabled
        </label>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="error-text">@_error</div>
    }

    <div class="toolbar">
        <span class="spacer"></span>
        <button class="btn btn-secondary" @onclick="OnClose" disabled="@_busy">CANCEL</button>
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">SAVE</button>
    </div>
</ModalShell>

@code {
    [Parameter] public RuleDto? InitialRule { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private RuleDto _rule = new();
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        if (InitialRule is not null)
        {
            // copy so cancelling doesn't leave the caller's list holding a half-edited object
            _rule = new RuleDto
            {
                Id = InitialRule.Id,
                Name = InitialRule.Name,
                PublisherName = InitialRule.PublisherName,
                ProcessNameContains = InitialRule.ProcessNameContains,
                RequireSignedMatch = InitialRule.RequireSignedMatch,
                KillProcess = InitialRule.KillProcess,
                ActionCommand = InitialRule.ActionCommand,
                ActionArguments = InitialRule.ActionArguments,
                IsEnabled = InitialRule.IsEnabled
            };
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_rule.Name) || string.IsNullOrWhiteSpace(_rule.PublisherName))
        {
            _error = "กรอก Name และ Publisher Name ก่อน";
            return;
        }

        _busy = true;
        _error = null;

        var ok = _rule.Id == 0 ? await Api.AddRuleAsync(_rule) : await Api.UpdateRuleAsync(_rule);

        _busy = false;
        if (ok)
        {
            await OnSaved.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        else
        {
            _error = "บันทึกไม่สำเร็จ";
        }
    }
}
