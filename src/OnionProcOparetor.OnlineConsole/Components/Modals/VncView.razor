@* Used by ScreenView.razor - one machine, one stream, opened on demand. Negotiates a VNC session the
   same way DashboardWindow/VncSessionPool do in the WPF Console: send "StartVncSession" over the
   existing command channel, then wait for the matching VncSessionReady/VncSessionFailed event on this
   circuit's LabHubClient (filtered by ClientGuid - kept even though only one view is open at a time,
   because the hub event is broadcast to the whole console session either way).
   Once a port+password come back, hands them to noVNC via JS interop (see wwwroot/js/vncInterop.js and
   the design-note comment in VncBridgeEndpoint.cs for why the password goes straight to the browser
   instead of through the WebSocket).

   NOT built for tiling several of these at once. noVNC has no thumbnail mode - scaleViewport only
   scales the canvas AFTER a full-resolution framebuffer has already crossed the wire and been decoded
   in JS - so N views cost N full desktop streams. The WPF Console can do its CCTV grid because its own
   RfbClient has a real VncViewMode.Thumbnail (16bpp on the wire, downscale at decode, heavy update
   throttling); nothing equivalent exists here. That is why the web Live View grid was removed on
   2026-09-04. *@
@inject ApiClient Api
@inject LabHubClient LabHub
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="card" style="padding:.5rem">
    <div class="caption" style="margin-bottom:.4rem">@MachineName</div>
    <div class="vnc-canvas-wrap" style="@(Height is null ? "min-height:200px" : $"height:{Height}")">
        <div id="@_containerId" style="width:100%; height:100%"></div>
    </div>
    @if (!string.IsNullOrEmpty(_status))
    {
        <div class="status-text">@_status</div>
    }
    @if (_canRetry)
    {
        @* A failed VNC view used to be a permanent dead end: one grey line, and the only way to try
           again was to navigate away and back. Most failures here are transient (the machine was busy
           starting winvnc, the tailnet path flapped), so retrying in place is usually all it needs. *@
        <button class="btn btn-secondary btn-sm" style="margin-top:.4rem" @onclick="RetryAsync">
            <Icon Name="refresh-cw" Size="14" /> ลองใหม่
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public string ClientGuid { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string MachineName { get; set; } = string.Empty;
    [Parameter] public string? Height { get; set; }

    private readonly string _containerId = "vnc-" + Guid.NewGuid().ToString("N");
    private IJSObjectReference? _module;
    private TaskCompletionSource<(bool Ok, int Port, string Password, string? Reason)>? _pending;
    private string _status = "กำลังขอเปิด session...";
    private bool _canRetry;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return Task.CompletedTask;

        // Deliberately not in OnInitializedAsync - discovered live: this page prerenders once
        // (server-side, no browser attached yet) before the real interactive circuit connects. JS
        // interop is fundamentally impossible during that prerender pass (there's no browser to talk
        // to), and Blazor throws immediately on the attempt rather than silently no-op'ing. Worse,
        // OnInitializedAsync's returned Task is exactly what prerendering waits on before it can finish
        // producing the response - so even the negotiation step (which can legitimately take up to the
        // 20s timeout below) would have blocked the page load, JS crash aside. OnAfterRenderAsync is
        // never invoked during prerendering at all (the documented way to detect "this is the real
        // interactive render"), so everything below only ever runs once, after there's an actual browser
        // to negotiate a VNC session and hand it to.
        LabHub.VncSessionReady += OnReady;
        LabHub.VncSessionFailed += OnFailed;

        _ = StartAsync();
        return Task.CompletedTask;
    }

    private async Task StartAsync()
    {
        // Everything in here is wrapped, and that matters more than it looks: this method is started as
        // fire-and-forget (`_ = StartAsync()`), so before this try/catch ANY exception - most likely the
        // dynamic import of noVNC from the jsdelivr CDN failing, which is entirely possible on a school
        // network that blocks CDNs or a phone with no route off the tailnet - became an unobserved task
        // exception. The user saw "กำลังขอเปิด session..." forever, with nothing in the UI ever saying
        // what went wrong. Silent-forever is the single worst failure mode for a remote-view feature.
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/vncInterop.js");
            await NegotiateAndConnectAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit went away mid-negotiation (tab closed, network dropped) - nothing to report to.
        }
        catch (Exception ex)
        {
            Fail("เปิดหน้าจอไม่สำเร็จ: " + ex.Message +
                 " - ถ้าเครื่องนี้ต่อเน็ตนอกไม่ได้ ตัวถอดรหัสภาพ (noVNC) จะโหลดจาก CDN ไม่ได้");
        }
    }

    private void Fail(string message)
    {
        _status = message;
        _canRetry = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task RetryAsync()
    {
        _status = "กำลังขอเปิด session...";
        _canRetry = false;
        await StartAsync();
    }

    private async Task NegotiateAndConnectAsync()
    {
        _pending = new TaskCompletionSource<(bool, int, string, string?)>();

        await Api.SendCommandAsync(ClientGuid, "StartVncSession", new { requestingConsoleSessionId = LabHub.SessionId });

        var timeoutTask = Task.Delay(TimeSpan.FromSeconds(20));
        var completed = await Task.WhenAny(_pending.Task, timeoutTask);

        if (completed == timeoutTask)
        {
            Fail("หมดเวลารอ - เครื่องอาจไม่มีใคร login อยู่หน้าเครื่อง หรือ AgentTray ไม่ตอบสนอง");
            return;
        }

        var (ok, port, password, reason) = await _pending.Task;
        if (!ok)
        {
            Fail($"เปิดไม่สำเร็จ: {reason}");
            return;
        }

        _status = string.Empty;
        await InvokeAsync(StateHasChanged);
        await _module!.InvokeVoidAsync("connect", _containerId, ClientGuid, port, password, ClientGuid);
    }

    private void OnReady(string clientGuid, int port, string password)
    {
        if (clientGuid != ClientGuid) return;
        _pending?.TrySetResult((true, port, password, null));
    }

    private void OnFailed(string clientGuid, string reason)
    {
        if (clientGuid != ClientGuid) return;
        _pending?.TrySetResult((false, 0, string.Empty, reason));
    }

    public async ValueTask DisposeAsync()
    {
        LabHub.VncSessionReady -= OnReady;
        LabHub.VncSessionFailed -= OnFailed;

        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("disconnect", ClientGuid); }
            catch (JSDisconnectedException) { /* circuit already gone */ }

            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit already gone */ }
        }
    }
}
