<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v5 - Server + Console installer only (teacher/admin machine). Split out of the old single
  3-mode OnionProcOparetor.wxs (2026-08-10, "Stable 1" item 1). Keeps the original product's
  UpgradeCode/ProductCode identity and INSTALLFOLDER ("Onion ProcOparetor") since this is the
  closest successor to the old default Mode A - see installer/OnionProcOparetor.Agent.wxs for the
  Client Agent counterpart (fresh identity there: Mode C/Client Agent installs were already
  broken by the ADDLOCAL-snapshot bug this split fixes, so there's no working deployment to
  preserve an upgrade path for). No MODE property, no ModeDlg, no Level/Condition dance - this
  product only ever installs Server + Console, and has no interactive wizard pages of its own.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?ifndef PublishDir?>
  <?define PublishDir="..\publish"?>
  <?endif?>

  <Package Name="Onion ProcOparetor"
            Manufacturer="OnionProcOparetor"
            Version="1.2.5.0"
            UpgradeCode="8C2D41E6-5A6D-4D1A-95E2-FB74C37A6E5A"
            Scope="perMachine"
            InstallerVersion="500"
            Codepage="874">

    <SummaryInformation Keywords="Installer" Description="Onion ProcOparetor Server + Console Setup" />
    <!-- ดู installer\OnionProcOparetor.Agent.wxs's comment เดียวกันนี้สำหรับเหตุผลเต็ม - บั๊กเดียวกัน
         (Version ไม่เคย bump ทำให้ MajorUpgrade ไม่ trigger เพราะ AllowSameVersionUpgrades default เป็น
         "no") กระทบทั้ง 2 product เหมือนกัน แก้ด้วยวิธีเดียวกัน -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <!-- ==================== Branding ==================== -->
    <Icon Id="AppIcon.ico" SourceFile="Assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <!-- ขอกลับไปใช้ banner/dialog bitmap ค่า default ของ WiX เองก่อน - เหตุผลเดียวกับ Agent product's
         comment (ดู OnionProcOparetor.Agent.wxs) -->
    <!-- <WixVariable Id="WixUIBannerBmp" Value="Assets\banner.bmp" /> -->
    <!-- <WixVariable Id="WixUIDialogBmp" Value="Assets\dialog.bmp" /> -->

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Onion ProcOparetor Console" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="The Onion Core Service is now running as a Windows Service; use the Console shortcut to sign in." />

    <!-- ปุ่ม "Launch ... Console" ที่หน้าสุดท้าย เดิมเป็น checkbox ที่ติ๊กแล้วไม่เกิดอะไรขึ้นเลย
         (WixUI ต้องมี DoAction ผูกที่ปุ่ม Finish เอง ซึ่งไม่เคยมี) - ผูกให้จริงตอนนี้ พร้อมกับที่
         ต้องซ่อนมันอยู่แล้วเมื่อครูเลือกไม่ลง Console (ดู ControlEvent ที่ ComponentsDlg)
         Impersonate="yes" เพื่อให้ Console เปิดขึ้นในสิทธิ์ของผู้ใช้ ไม่ใช่สิทธิ์ยกระดับของ msiexec -->
    <Property Id="WixShellExecTarget" Value="[#ConsoleExeFile]" />
    <CustomAction Id="LaunchConsole" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
                  Impersonate="yes" Return="ignore" />

    <!-- ซ่อน ARP entry อัตโนมัติของ MSI เอง ใช้ synthetic ARP entry ของเราเอง
         (UninstallArpEntryComponent ข้างล่าง) แทน ที่ชี้ไปที่ OnionProcOparetor.UninstallHelper.exe
         ก่อน (โชว์ popup ได้จริงเพราะถูก Explorer เรียกตรงๆ) แล้วค่อยยิง msiexec /x {ProductCode}
         ตัวจริงต่อเบื้องหลังเอง - [ProductCode] เดิมยังใช้งานได้ปกติสำหรับ msiexec /x โดยตรง -->
    <Property Id="ARPSYSTEMCOMPONENT" Value="1" />

    <!-- Optional data wipe, gated purely on the DELETEDATA property (msiexec /x ... DELETEDATA=1)
         - no interactive prompt (MSI uninstalls run at UILevel=3/no desktop access). Default
         (DELETEDATA unset) keeps data, for a later reinstall. No uninstall-password gate on this
         product - that machinery (UNINSTPWD/CheckUninstallPasswordHeadless/UNINSTALLAUTHFLAG) is
         Agent-only (lab machines share one admin account); this is the teacher/admin machine, and
         once UninstallPwdDlg doesn't exist here, nothing would ever set a password anyway. -->
    <Property Id="DELETEDATA" Secure="yes" />

    <!-- ==================== เลือกว่าจะลงอะไร (2026-08-31) ====================
         ค่าเริ่มต้นติ๊กทั้งคู่ = พฤติกรรมเดิมทุกประการสำหรับคนที่กด Next รวด
         Secure="yes" เพื่อให้ส่งผ่าน command line ได้ตอน silent install:
             msiexec /i ... /qn INSTALLSERVER=0 INSTALLCONSOLE=1
         (หรือจะใช้ ADDLOCAL=SharedFeature,ConsoleFeature ตรงๆ แบบ MSI มาตรฐานก็ได้เหมือนกัน) -->
    <Property Id="INSTALLSERVER" Value="1" Secure="yes" />
    <Property Id="INSTALLCONSOLE" Value="1" Secure="yes" />

    <!-- อ่านว่าคราวก่อนลงอะไรไว้ เพื่อ pre-ติ๊กให้ตรงตอน upgrade
         สำคัญ: MajorUpgrade ของ product นี้เป็นแบบถอนเก่า-ลงใหม่ ถ้าไม่มีตรงนี้ การอัปเกรดเครื่องที่
         ลงแค่ Console ไว้จะกลับไปติ๊กทั้งคู่ตาม default แล้วแอบยัด Server กลับมาให้เงียบๆ ซึ่งเป็น
         ปัญหาเดิมที่ฟีเจอร์นี้ตั้งใจแก้พอดี - AppSearch รันก่อนที่ของเก่าจะถูกถอน จึงยังอ่านเจอ -->
    <Property Id="PREV_SERVER">
      <RegistrySearch Id="PrevServerSearch" Root="HKLM" Key="Software\OnionProcOparetor\Install"
                      Name="ServerInstalled" Type="raw" />
    </Property>
    <Property Id="PREV_CONSOLE">
      <RegistrySearch Id="PrevConsoleSearch" Root="HKLM" Key="Software\OnionProcOparetor\Install"
                      Name="ConsoleInstalled" Type="raw" />
    </Property>
    <!-- ตัวชี้ว่า "เวอร์ชันที่ติดตั้งอยู่รู้จักการเลือก feature แล้ว" (ดู UninstallArpEntryComponent)
         ต้องใช้ตัวนี้ ไม่ใช่ ARP DisplayName ที่ build เก่าก็มี - ไม่งั้นการอัปเกรดครั้งแรกจากทุก
         เครื่องที่ลงอยู่ตอนนี้จะติ๊กออกทั้งสองช่องแล้วกลายเป็นไม่ติดตั้งอะไรเลย -->
    <Property Id="PREV_LAYOUT">
      <RegistrySearch Id="PrevLayoutSearch" Root="HKLM" Key="Software\OnionProcOparetor\Install"
                      Name="FeatureSelectionSupported" Type="raw" />
    </Property>

    <!-- ติ๊กออกเฉพาะเมื่อ "เคยลงด้วย build ที่เลือก feature ได้ และตอนนั้นไม่ได้เลือกฝั่งนี้"
         อัปเกรดจาก build เก่า (ไม่มี PREV_LAYOUT) จะตกไปใช้ default = ติ๊กทั้งคู่ ซึ่งตรงกับ
         สิ่งที่เครื่องนั้นมีอยู่จริงพอดี เพราะ build เก่าลงทั้ง Server และ Console เสมอ -->
    <SetProperty Id="INSTALLSERVER" Value="0" After="AppSearch" Sequence="ui"
                 Condition="PREV_LAYOUT AND NOT PREV_SERVER" />
    <SetProperty Id="INSTALLCONSOLE" Value="0" After="AppSearch" Sequence="ui"
                 Condition="PREV_LAYOUT AND NOT PREV_CONSOLE" />

    <!-- ==================== Directory layout ====================
         Unchanged from before the split ("Onion ProcOparetor", not renamed) so this keeps
         installing to the same place existing Server+Console deployments already use. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Onion ProcOparetor">
        <Directory Id="ServerDir" Name="Server" />
        <Directory Id="ConsoleDir" Name="Console" />
        <Directory Id="UninstallHelperDir" Name="UninstallHelper" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="Onion ProcOparetor" />
    </StandardDirectory>

    <!-- ==================== Features (แยก 3 ตัว 2026-08-31) ====================
         เดิมเป็น feature เดียวรวมทุกอย่าง ทำให้ "ลงแค่ Console" ไม่ได้เลย - เครื่องครูที่ต้องการแค่
         หน้าจอควบคุมก็ได้ OnionCoreService ติดมาด้วยทุกครั้ง (พร้อม firewall rule เปิด port 8787
         และ service ที่รันตลอดเวลาโดยไม่มีใครใช้) ซึ่งเป็นทั้งความสับสนและพื้นที่โจมตีที่ไม่จำเป็น

         ===== ทำไมรอบนี้ปลอดภัยกว่าตอนที่เคยเลิกใช้ feature selection =====
         ตอน 2026-08-10 เคยถอย MODE property + ModeDlg ออกเพราะเจอบั๊ก 2 ตัว (ดู docs/architecture.md)
         ทั้งคู่มาจากการ "อนุมาน" feature state จาก property ผ่าน <Level> Condition:
           1. ADDLOCAL snapshot ผิดจังหวะตอน wizard
           2. REMOVE="ALL" หายไปจาก Level Condition ตอน uninstall จน uninstall ไม่ลบอะไรเลย
         รอบนี้จึง **ไม่ใช้ <Level> Condition แม้แต่ที่เดียว** - ทุก feature Level="1" คงที่ตลอดชีวิต
         การเลือกทำผ่าน ControlEvent AddLocal/Remove ที่ปุ่ม Next ของหน้าเลือก ซึ่งเป็นวิธีมาตรฐาน
         ของ MSI เอง มีผลเฉพาะ InstallUISequence และไม่แตะ ExecuteSequence ตอน uninstall เลย

         SharedFeature ต้องมีเสมอ (AllowAbsent="no") เพราะเป็น ARP entry + UninstallHelper -
         ถ้าถอดออกได้จะเกิดสภาพ "ติดตั้งแล้วแต่ถอนไม่ได้" -->
    <Feature Id="SharedFeature" Level="1" Display="hidden" AllowAbsent="no"
             Title="Shared" Description="ตัวถอนโปรแกรมและรายการใน Add/Remove Programs (จำเป็นเสมอ)">
      <ComponentGroupRef Id="UninstallHelperFiles" />
      <ComponentRef Id="UninstallHelperExeComponent" />
      <ComponentRef Id="UninstallArpEntryComponent" />
    </Feature>

    <Feature Id="ServerFeature" Level="1"
             Title="Onion Core Service (Server)"
             Description="ตัวเซิร์ฟเวอร์ที่เก็บกฎ สถานะ และ log ของทั้งห้อง รันเป็น Windows Service และเปิด port 8787 - ลงเครื่องเดียวในระบบก็พอ">
      <ComponentGroupRef Id="ServerFiles" />
      <ComponentRef Id="ServerExeComponent" />
      <ComponentRef Id="RunSetupComponent" />
    </Feature>

    <Feature Id="ConsoleFeature" Level="1"
             Title="Console (หน้าจอควบคุมของครู)"
             Description="โปรแกรมที่ครูใช้ดูสถานะและสั่งงานเครื่องนักเรียน ต่อไปยัง Server เครื่องไหนก็ได้ - ลงได้หลายเครื่อง">
      <ComponentGroupRef Id="ConsoleFiles" />
      <ComponentRef Id="ConsoleExeComponent" />
    </Feature>

    <!-- ==================== Harvested files ==================== -->
    <ComponentGroup Id="ServerFiles" Directory="ServerDir">
      <Files Include="$(var.PublishDir)\OnionProcOparetor.Server\**">
        <Exclude Files="$(var.PublishDir)\OnionProcOparetor.Server\OnionProcOparetor.Server.exe" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="ConsoleFiles" Directory="ConsoleDir">
      <Files Include="$(var.PublishDir)\OnionProcOparetor.Console\**">
        <Exclude Files="$(var.PublishDir)\OnionProcOparetor.Console\OnionProcOparetor.Console.exe" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="UninstallHelperFiles" Directory="UninstallHelperDir">
      <Files Include="$(var.PublishDir)\OnionProcOparetor.UninstallHelper\**">
        <Exclude Files="$(var.PublishDir)\OnionProcOparetor.UninstallHelper\OnionProcOparetor.UninstallHelper.exe" />
      </Files>
    </ComponentGroup>

    <!-- ==================== Anchor components ====================
         Server: OnionCoreService, started declaratively, + firewall rule for the SignalR/HTTP
         port. -->
    <Component Id="ServerExeComponent" Directory="ServerDir" Guid="*">
      <File Id="ServerExeFile" Source="$(var.PublishDir)\OnionProcOparetor.Server\OnionProcOparetor.Server.exe" KeyPath="yes" />
      <ServiceInstall Id="OnionCoreServiceInstall" Name="OnionCoreService" DisplayName="Onion Core Service"
                       Type="ownProcess" Start="auto" ErrorControl="normal" />
      <ServiceControl Id="OnionCoreServiceControl" Name="OnionCoreService" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      <fire:FirewallException Id="ServerFirewallRule" Name="OnionProcOparetor Server" Port="8787" Protocol="tcp" Scope="any" />

      <!-- ร่องรอยว่า "เครื่องนี้เลือกลง Server ไว้" - อยู่ใน component ของ Server เอง จึงมีอยู่ก็ต่อเมื่อ
           feature นี้ถูกติดตั้งจริง และหายไปเองเมื่อถูกถอด ไม่ต้องมีโค้ดคอยดูแลให้ตรง
           ใช้ตอน upgrade เพื่อ pre-ติ๊ก checkbox ให้ตรงกับของเดิม (ดู PREV_SERVER ด้านบน) -->
      <RegistryValue Root="HKLM" Key="Software\OnionProcOparetor\Install" Name="ServerInstalled"
                     Type="integer" Value="1" />
    </Component>

    <!-- Console: shortcut only, no service. -->
    <Component Id="ConsoleExeComponent" Directory="ConsoleDir" Guid="*">
      <File Id="ConsoleExeFile" Source="$(var.PublishDir)\OnionProcOparetor.Console\OnionProcOparetor.Console.exe" KeyPath="yes">
        <Shortcut Id="ConsoleShortcut" Directory="AppProgramMenuFolder" Name="Onion ProcOparetor Console"
                   WorkingDirectory="ConsoleDir" Advertise="no" Icon="AppIcon.ico" />
      </File>
      <RemoveFolder Id="RemoveAppProgramMenuFolder_Console" Directory="AppProgramMenuFolder" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\OnionProcOparetor\Install" Name="ConsoleInstalled"
                     Type="integer" Value="1" />
    </Component>

    <!-- Add/Remove Programs launches this .exe directly (see UninstallArpEntryComponent below) -
         it shows a real confirm/delete-data prompt then shells out to the real msiexec /x
         [ProductCode] itself. Same generic .exe as the Agent product's copy - it takes ProductCode
         as a command-line arg and resolves guard/flag/install paths relative to its own install
         location, so no per-product code or build variant is needed. This product never writes a
         guard file (no UninstallPwdDlg here), so the helper's password panel simply never shows. -->
    <Component Id="UninstallHelperExeComponent" Directory="UninstallHelperDir" Guid="*">
      <File Id="UninstallHelperExeFile" Source="$(var.PublishDir)\OnionProcOparetor.UninstallHelper\OnionProcOparetor.UninstallHelper.exe" KeyPath="yes" />
    </Component>

    <!-- Synthetic ARP entry - unchanged registry key name ("...\Uninstall\OnionProcOparetor")
         from before the split. The Agent product below uses a distinct
         "...\Uninstall\OnionProcOparetorAgent" key so both products' entries show up side by side
         in Add/Remove Programs without one overwriting the other. -->
    <Component Id="UninstallArpEntryComponent" Directory="INSTALLFOLDER" Guid="8C2D41E6-5A6D-4D1A-95E2-FB74C37A6E71">
      <!-- ธงบอกว่า "เวอร์ชันที่ติดตั้งอยู่รู้จักการเลือก feature" - อยู่ใน SharedFeature ซึ่งติดตั้ง
           เสมอ จึงมีค่าก็ต่อเมื่อเครื่องนี้เคยลงด้วย build ตั้งแต่ 2026-08-31 เป็นต้นไป

           จำเป็นเพราะ PREV_SERVER/PREV_CONSOLE ที่ว่างเปล่ามีได้ 2 ความหมายที่ต่างกันสุดขั้ว:
             (ก) เคยลงด้วย build เก่าที่ยังไม่มี marker เลย  -> ต้องติ๊กทั้งคู่ตาม default
             (ข) เคยลงด้วย build ใหม่แต่ไม่ได้เลือกฝั่งนั้น -> ต้องไม่ติ๊ก
           ถ้าใช้ ARP DisplayName เป็นตัวตัดสิน (ซึ่ง build เก่าก็มี) จะแยก 2 กรณีนี้ไม่ออก แล้ว
           การอัปเกรดครั้งแรกจากทุกเครื่องที่ลงอยู่ตอนนี้จะติ๊กออกทั้งสองช่อง = ไม่ได้ติดตั้งอะไรเลย -->
      <RegistryValue Root="HKLM" Key="Software\OnionProcOparetor\Install"
                     Name="FeatureSelectionSupported" Type="integer" Value="1" />
      <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\OnionProcOparetor">
        <RegistryValue Type="string" Name="DisplayName" Value="Onion ProcOparetor" KeyPath="yes" />
        <RegistryValue Type="string" Name="DisplayVersion" Value="[ProductVersion]" />
        <RegistryValue Type="string" Name="Publisher" Value="OnionProcOparetor" />
        <!-- ส่ง product display name เป็น arg ที่ 3 ด้วย (args[2]) - เหตุผลเดียวกับ Agent product's
             comment (ดู OnionProcOparetor.Agent.wxs) - UninstallHelper.exe เป็น binary เดียวกันที่
             bundle เข้าทั้ง 2 MSI ต้องบอกให้ชัดว่ากำลังลบเครื่องไหนอยู่

             args[3] = [INSTALLFOLDER] จริง, args[4] = "1" (product นี้รองรับ "delete data") - เหตุผล
             เดียวกับ Agent product's comment ทุกประการ (ดู OnionProcOparetor.Agent.wxs และ
             MainWindow.xaml.cs) -->
        <RegistryValue Type="string" Name="UninstallString" Value="&quot;[#UninstallHelperExeFile]&quot; [ProductCode] &quot;Onion ProcOparetor&quot; &quot;[INSTALLFOLDER]\&quot; &quot;1&quot;" />
        <RegistryValue Type="string" Name="DisplayIcon" Value="[#UninstallHelperExeFile]" />
        <RegistryValue Type="integer" Name="NoModify" Value="1" />
        <RegistryValue Type="integer" Name="NoRepair" Value="1" />
        <RegistryValue Type="integer" Name="EstimatedSize" Value="1" />
      </RegistryKey>
    </Component>

    <!-- run-setup.ps1 (unchanged from the .iss-era file). Untracked runtime-written files under
         INSTALLFOLDER (install log, ...) are swept on uninstall by RemoveInstallFolderExtras
         below. -->
    <Component Id="RunSetupComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="RunSetupPs1" Source="run-setup.ps1" KeyPath="yes" />
    </Component>

    <!-- ==================== Custom Actions ==================== -->

    <!-- Server setup: POST /api/auth/setup once OnionCoreService is actually running (retries
         internally, never fails the install - see run-setup.ps1). -->
    <CustomAction Id="SetupServerProps" Property="SetupServer"
      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#RunSetupPs1]&quot;" />
    <CustomAction Id="SetupServer" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
      Execute="deferred" Return="ignore" Impersonate="no" />

    <!-- บั๊กจริงที่เจอ (2026-08-20, รอบที่ 1): เดิม DeleteProgramData ใช้ pattern เดียวกับ SetupServer
         ข้างบน คือ อ้างอิงไฟล์ที่ install ไว้ ([#DeleteProgramDataPs1]) แต่ตัวมันเองถูก schedule ไว้ที่
         After="RemoveFiles" - เท่ากับพอถึงตอนที่ deferred CA นี้รันจริง ไฟล์ CustomActions\
         delete-programdata.ps1 (component ของมันเองก็โดน REMOVE=ALL ลบไปแล้วเหมือนกัน) ไม่มีอยู่บนดิสก์
         อีกต่อไป - powershell.exe -File ชี้ไปที่ไฟล์ที่ไม่มีอยู่จริง ล้มเหลวเงียบๆ (Return="ignore") ทุกครั้ง
         %ProgramData%\OnionProcOparetor เลยไม่เคยถูกลบจริงเลยไม่ว่าจะติ๊ก checkbox หรือไม่ก็ตาม - บทเรียน
         เดียวกันกับที่เคยเจอมาแล้วจริงกับ RemoveInstallFolderExtras ด้านล่าง แก้ด้วยการฝัง script เป็น
         -EncodedCommand ตรงๆ ไม่พึ่งไฟล์ที่ install ไว้อีกต่อไป

         บั๊กจริงที่เจอ (2026-08-20, รอบที่ 2 - ใหญ่กว่า): แก้รอบแรกแล้วยังลบ DB ไม่หมดอยู่ดี (live-tested:
         onionprocoparetor.db/-shm/-wal ยัง lock อยู่ครบ 3 ไฟล์ ทั้งที่ตอน uninstall เสร็จสมบูรณ์แล้วลบด้วย
         มือกลับไม่มี error เลย) ต้นตอจริงคือใช้ Execute="immediate" ซึ่งรันทันทีตอน engine เดินมาถึงจุดนั้น
         ใน sequence table - แต่ StopServices/RemoveFiles ที่แท้จริงเป็น deferred standard action แค่ถูก
         "คิว" ไว้ตอนนั้น ยังไม่ได้รันจริง (deferred action ทั้งหมดในคิวจะไปรันเป็นชุดพร้อมกันตอน
         InstallFinalize ท้ายสุดของทั้ง sequence) เท่ากับ DeleteProgramData (immediate) วิ่งไปลบ DB ก่อนที่
         service จะถูกสั่งหยุดจริงด้วยซ้ำ - แก้โดยเปลี่ยนกลับไปเป็น Execute="deferred" (pattern เดียวกับ
         SetupServer ข้างบนเป๊ะๆ) ให้ไปอยู่ในคิวเดียวกับ StopServices/RemoveFiles ตามลำดับจริง ไม่ใช่วิ่งแซง
         หน้า - ยังคงฝัง script เป็น -EncodedCommand ในตัว Value ของ "Props" CA ไม่พึ่งไฟล์ที่ install ไว้
         เหมือนเดิม (รวม 2 บทเรียนเข้าด้วยกัน) source ของ blob ยังเก็บไว้ที่ CustomActions\
         delete-programdata.ps1 เป็น source-of-truth สำหรับ regenerate (ไม่ได้ bundle เข้า MSI แล้ว - ดู
         comment ในไฟล์นั้นเอง) -->
    <CustomAction Id="DeleteProgramDataProps" Property="DeleteProgramData"
      Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -EncodedCommand " />
    <CustomAction Id="DeleteProgramData" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
      Execute="deferred" Return="ignore" Impersonate="no" />

    <!-- Final uninstall sweep for INSTALLFOLDER - replaces a broken util:RemoveFolderEx (its
         extension-provided deferred CA runs at a fixed sequence 799, before INSTALLFOLDER is
         resolved at CostFinalize/1000, so it always silently no-op'd - confirmed against the
         compiled MSI's own InstallExecuteSequence table, not assumed). Ships as a fixed
         -EncodedCommand block, not a reference to an installed .ps1 file, because by the time
         this runs (after RemoveFiles) any script file under INSTALLFOLDER may already be deleted.
         Trailing "\&quot;" (not just "&quot;") on the [INSTALLFOLDER] argument is required, not a
         typo: INSTALLFOLDER always ends in a backslash, and a single backslash immediately before
         a closing double quote escapes the quote instead of closing the argument - an even number
         of backslashes before the quote collapses to a literal backslash and closes correctly
         instead.

         บั๊กจริงที่เจอ (2026-08-20): เดิม Execute="immediate" เหมือนกับที่ DeleteProgramData เคยเป็น (ดู
         comment ยาวของมันด้านบนสำหรับเหตุผลเต็ม) - immediate รันทันทีตอน engine เดินถึงจุดนี้ใน sequence
         table แต่ RemoveFiles/StopServices ตัวจริงเป็น deferred แค่ถูกคิวไว้ ยังไม่รันจริงจนกว่าจะถึง
         InstallFinalize - เท่ากับ sweep นี้อาจวิ่งไปทับไฟล์ที่ยังไม่ถูกลบ/ยัง lock อยู่จริง (เช่น .exe ของ
         service ที่ยังไม่ถูกสั่งหยุด) ไม่ต่างจากปัญหาเดียวกับ DeleteProgramData แก้ด้วย pattern เดียวกัน:
         เปลี่ยนเป็น Execute="deferred" ผ่าน Props+CA คู่ - เนื้อ script/blob เดิมไม่เปลี่ยน แค่ scheduling -->
    <CustomAction Id="RemoveInstallFolderExtrasProps" Property="RemoveInstallFolderExtras"
      Value="cmd.exe /c &quot;set ONIONPROC_INSTALLDIR=[INSTALLFOLDER]&amp;&amp; powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -EncodedCommand &quot;" />
    <CustomAction Id="RemoveInstallFolderExtras" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
      Execute="deferred" Return="ignore" Impersonate="no" />

    <!-- ==================== Sequencing ==================== -->
    <InstallExecuteSequence>
      <!-- Condition="NOT REMOVE" - install/repair only, never on uninstall. Without this,
           StartServices (and this CA After it) still fires as a sequence point during uninstall
           too, needlessly POSTing to a service that's mid-shutdown/removal. SetupServer's
           Return="ignore" means this was never fatal the way the Agent's equivalent SetupClient
           (Return="check") was - confirmed live, that one's missing condition did abort the
           uninstall with exit 1603 - but it's still wrong to run setup on a product being
           removed, so the same guard is applied here for correctness. -->
      <!-- &amp;ServerFeature=3 = "feature นี้กำลังจะถูกติดตั้งแบบ local ในทรานแซกชันนี้"
           จำเป็นตั้งแต่ 2026-08-31 ที่แยก feature: run-setup.ps1 ยิง POST /api/auth/setup ไปที่
           OnionCoreService ซึ่งจะไม่มีอยู่เลยถ้าครูเลือกลงแค่ Console - ปล่อยให้รันจะรอ timeout
           เปล่าๆ ทุกครั้งที่ติดตั้ง แล้วจบด้วยความล้มเหลวเงียบๆ (Return="ignore") -->
      <Custom Action="SetupServerProps" Before="SetupServer" Condition="NOT REMOVE AND &amp;ServerFeature=3" />
      <Custom Action="SetupServer" After="StartServices" Condition="NOT REMOVE AND &amp;ServerFeature=3" />

      <Custom Action="DeleteProgramDataProps" Before="DeleteProgramData" Condition="REMOVE=&quot;ALL&quot; AND DELETEDATA=&quot;1&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="DeleteProgramData" After="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND DELETEDATA=&quot;1&quot; AND NOT UPGRADINGPRODUCTCODE" />

      <Custom Action="RemoveInstallFolderExtrasProps" Before="RemoveInstallFolderExtras" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveInstallFolderExtras" After="DeleteProgramData" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- ==================== หน้าเลือกว่าจะลงอะไร (2026-08-31) ====================
         แทรกเข้าไประหว่าง InstallDirDlg กับ VerifyReadyDlg ของ WixUI_InstallDir เดิม
         (Welcome -> InstallDir -> **ComponentsDlg** -> VerifyReady -> Progress -> Exit)
         ใช้ pattern เดียวกับที่ Agent product แทรก ServerConnDlg/UninstallPwdDlg ไว้แล้ว

         ทำไมเขียนหน้าเองแทนที่จะใช้ WixUI_FeatureTree ของสำเร็จรูป:
           - FeatureTree ใช้ CustomizeDlg ที่เป็น tree + dropdown "Will be installed on local hard
             drive" ซึ่งอ่านยากกว่ามากสำหรับคนที่แค่อยากติ๊ก 2 ช่อง
           - และมันจะแทน InstallDirDlg ทิ้ง ทำให้เลือกโฟลเดอร์ติดตั้งไม่ได้อีก (เป็นการถอย ไม่ใช่การเพิ่ม)
         หน้านี้ทำเรื่องเดียวคือ AddLocal/Remove ซึ่งเป็น ControlEvent มาตรฐานของ MSI เอง

         **ห้ามเปลี่ยนไปใช้ <Level> Condition เด็ดขาด** - นั่นคือสิ่งที่พังตอน 2026-08-10
         (ดู comment ยาวที่บล็อก Feature ด้านบน) -->
    <UI>
      <ProgressText Action="SetupServer" Message="Finishing Onion Core Service setup (creating the administrator account)..." />
      <ProgressText Action="DeleteProgramData" Message="Removing Onion ProcOparetor data (database, logs, rules)..." />
      <ProgressText Action="RemoveInstallFolderExtras" Message="Cleaning up remaining Onion ProcOparetor files..." />

      <Dialog Id="ComponentsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose what to install" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="เลือกเฉพาะส่วนที่เครื่องนี้ต้องใช้จริง" />

        <Control Id="ServerCheck" Type="CheckBox" X="24" Y="60" Width="330" Height="16"
                 Property="INSTALLSERVER" CheckBoxValue="1" Text="Onion Core Service (Server)" />
        <Control Id="ServerHelp" Type="Text" X="38" Y="78" Width="316" Height="34"
                 Text="เก็บกฎ สถานะ และ log ของทั้งห้อง รันเป็น Windows Service ตลอดเวลา และเปิด port 8787 - ทั้งระบบต้องการเครื่องเดียวเท่านั้น" />

        <Control Id="ConsoleCheck" Type="CheckBox" X="24" Y="122" Width="330" Height="16"
                 Property="INSTALLCONSOLE" CheckBoxValue="1" Text="Console (หน้าจอควบคุมของครู)" />
        <Control Id="ConsoleHelp" Type="Text" X="38" Y="140" Width="316" Height="34"
                 Text="หน้าจอที่ครูใช้ดูสถานะและสั่งงานเครื่องนักเรียน ต่อไปยัง Server เครื่องไหนก็ได้ - ลงกี่เครื่องก็ได้" />

        <Control Id="Hint" Type="Text" X="24" Y="188" Width="330" Height="34"
                 Text="ถ้าเครื่องนี้เป็นเครื่องครูที่ใช้คุมอย่างเดียว ให้ติ๊กแค่ Console - จะได้ไม่มี service และ firewall rule ที่ไม่ได้ใช้ค้างอยู่บนเครื่อง" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>

        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <!-- ลำดับสำคัญ: AddLocal/Remove ต้องมาก่อน NewDialog เสมอ เพราะ ControlEvent ทำงานตาม
               ลำดับที่ประกาศ - ถ้า NewDialog มาก่อน หน้า VerifyReady จะสรุปจาก state เก่า -->
          <Publish Event="AddLocal" Value="ServerFeature" Condition="INSTALLSERVER = &quot;1&quot;" />
          <Publish Event="Remove" Value="ServerFeature" Condition="INSTALLSERVER &lt;&gt; &quot;1&quot;" />
          <Publish Event="AddLocal" Value="ConsoleFeature" Condition="INSTALLCONSOLE = &quot;1&quot;" />
          <Publish Event="Remove" Value="ConsoleFeature" Condition="INSTALLCONSOLE &lt;&gt; &quot;1&quot;" />

          <!-- ไม่ติ๊กเลยสักอัน = ไม่มีอะไรให้ติดตั้ง ต้องกันไว้ ไม่งั้นจะได้ ARP entry เปล่าๆ
               ที่ชี้ไปยัง product ที่ไม่มีไฟล์อะไรเลย -->
          <!-- หน้าสุดท้ายต้องพูดตรงกับสิ่งที่ติดตั้งจริง - เครื่องที่ลงแค่ Console ไม่ควรถูกบอกว่า
               "Core Service กำลังรันอยู่" และไม่ควรมี checkbox เปิดโปรแกรมที่ไม่ได้ลง -->
          <Publish Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" Condition="INSTALLCONSOLE = &quot;1&quot;" />
          <Publish Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="{}" Condition="INSTALLCONSOLE &lt;&gt; &quot;1&quot;" />
          <Publish Property="WIXUI_EXITDIALOGOPTIONALTEXT"
                   Value="The Onion Core Service is now running as a Windows Service; use the Console shortcut to sign in."
                   Condition="INSTALLSERVER = &quot;1&quot; AND INSTALLCONSOLE = &quot;1&quot;" />
          <Publish Property="WIXUI_EXITDIALOGOPTIONALTEXT"
                   Value="The Onion Core Service is now running as a Windows Service on this machine. No Console was installed here."
                   Condition="INSTALLSERVER = &quot;1&quot; AND INSTALLCONSOLE &lt;&gt; &quot;1&quot;" />
          <Publish Property="WIXUI_EXITDIALOGOPTIONALTEXT"
                   Value="Console only - no service was installed on this machine. Point it at the machine running the Onion Core Service when you sign in."
                   Condition="INSTALLSERVER &lt;&gt; &quot;1&quot; AND INSTALLCONSOLE = &quot;1&quot;" />

          <Publish Event="SpawnDialog" Value="ErrorMsgDlg" Condition="INSTALLSERVER &lt;&gt; &quot;1&quot; AND INSTALLCONSOLE &lt;&gt; &quot;1&quot;" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Condition="INSTALLSERVER = &quot;1&quot; OR INSTALLCONSOLE = &quot;1&quot;" />
        </Control>

        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- popup เล็กๆ ตัวเดียวสำหรับ error ของหน้านี้ - pattern เดียวกับ ErrorMsgDlg ของ Agent product -->
      <Dialog Id="ErrorMsgDlg" Width="270" Height="105" Title="!(loc.InstallDirDlg_Title)" NoMinimize="yes">
        <Control Id="ErrorText" Type="Text" X="20" Y="20" Width="230" Height="45"
                 Text="ต้องเลือกอย่างน้อยหนึ่งอย่าง - จะไม่ติดตั้งทั้ง Server และ Console เลยก็เท่ากับไม่ได้ติดตั้งอะไร" />
        <Control Id="ErrorOk" Type="PushButton" X="100" Y="70" Width="70" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- แทรกหน้าใหม่เข้าไปในลำดับเดิม: InstallDir -> ComponentsDlg -> VerifyReady
           ต้อง publish ทับ ControlEvent เดิมของ 2 หน้านั้น (WiX รวม event จากทั้ง dialog set
           และของเราเข้าด้วยกัน ตัวที่ condition เป็นจริงและประกาศทีหลังจะชนะ) -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchConsole"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" Order="10" />

      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ComponentsDlg" Order="10" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ComponentsDlg" Order="10" />
    </UI>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>
</Wix>
